      padding-top: 0 !important;
      padding-bottom: 0 !important;
      border: 0 !important;
      border-bottom: 0 !important;
      box-shadow: none !important;
    }
    .cover-linked-value,
    .cover-letter-meta span,
    .cover-letter-meta input,
    .cover-letter-meta textarea {
      border: 0 !important;
