:root {
  --bg: #f8fafc;
  --card: #ffffff;
  --line: #cbd5e1;
  --text: #0f172a;
  --muted: #475569;
  --accent: #2563eb;
  --accent-dark: #1d4ed8;
  --danger: #dc2626;
  --soft: #eff6ff;
  --accent-gradient: linear-gradient(180deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
  --danger-gradient: linear-gradient(180deg, #f87171 0%, #dc2626 50%, #b91c1c 100%);
  --gloss-overlay: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.08) 50%, rgba(0, 0, 0, 0.03) 50%, rgba(0, 0, 0, 0.12) 100%);
  --gloss-light: linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 100%);
  --btn-shadow: 0 1px 2px rgba(15, 23, 42, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  --card-shadow: 0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.02);
  --active-shadow: inset 0 2px 4px rgba(15, 23, 42, 0.15);
}
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: var(--bg); color: var(--text); }
    .container {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding: 10px;
    }
    h1, h2 { margin: 0 0 8px; }
    p { margin: 0; color: var(--muted); }
    .header, .section-title, .sheet-nav, .toolbar, .work-actions, .totals-bar { display: flex; gap: 4px; align-items: center; }
    .work-actions { flex-wrap: nowrap; justify-content: center; white-space: nowrap; }
    .header, .section-title {
      justify-content: space-between;
      margin-bottom: 2px;
    }
    .header { align-items: flex-start; gap: 8px; }
    .header h1 { margin-bottom: 0; line-height: 1.1; font-size: 20px; }
    .header p { line-height: 1.1; }
    .sheet-nav { margin: 0 0 8px; }
    .toolbar { margin-top: 0; }
    .header-save-toolbar { justify-content: flex-end; align-items: flex-start; flex-wrap: wrap; gap: 3px; max-width: 72%; }
    .header-save-toolbar button { padding: 4px 7px; font-size: 11px; line-height: 1.15; }
    .header-save-toolbar .btn-primary { white-space: nowrap; }
    .header-save-btn, .header-json-btn, .header-excel-btn, .header-proposal-action { display: none; }
    .header-save-btn.active-save, .header-json-btn.active-save, .header-excel-btn.active-save, .header-proposal-action.active-save { display: inline-flex; }
    .totals-bar { justify-content: flex-end; margin-top: 8px; font-weight: 700; }
    .gantt-col-resizer:hover {
      background-color: rgba(255, 255, 255, 0.4);
    }
    .boq-col-resizer:hover {
      background-color: rgba(0, 0, 0, 0.1);
    }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 6px;
      margin-bottom: 8px;
      box-shadow: var(--card-shadow);
      position: relative;
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: rgba(255, 255, 255, 0.8);
      pointer-events: none;
      border-radius: 6px 6px 0 0;
    }
    .sheet { display: none; }
    .sheet.active { display: block; }
    button {
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 4px 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 12px;
      background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
      color: var(--text);
      box-shadow: var(--btn-shadow);
      position: relative;
      overflow: hidden;
      transition: background 0.1s ease, border-color 0.1s ease, box-shadow 0.1s ease, transform 0.1s ease;
    }
    button::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 50%;
      background: rgba(255, 255, 255, 0.12);
      pointer-events: none;
    }
    button:hover {
      background: linear-gradient(180deg, #ffffff 0%, #e2e8f0 100%);
      border-color: #94a3b8;
      box-shadow: 0 2px 4px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }
    button:active {
      box-shadow: var(--active-shadow);
      transform: translateY(0.5px);
    }
    .btn-primary {
      background: var(--accent-gradient);
      color: #ffffff;
      border-color: var(--accent-dark);
      border-top: 1px solid rgba(255, 255, 255, 0.35);
      text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.15);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
    .btn-primary:hover {
      background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
      border-color: #1e3a8a;
      box-shadow: 0 2px 4px rgba(15, 23, 42, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }
    .btn-secondary {
      background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
      color: #0f172a;
      border-color: #cbd5e1;
    }
    .btn-secondary:hover {
      background: linear-gradient(180deg, #f1f5f9 0%, #cbd5e1 100%);
      border-color: #94a3b8;
    }
    .btn-danger {
      background: var(--danger-gradient);
      color: #ffffff;
      border-color: #991b1b;
      border-top: 1px solid rgba(255, 255, 255, 0.35);
      text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.15);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
    .btn-danger:hover {
      background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
      border-color: #7f1d1d;
      box-shadow: 0 2px 4px rgba(15, 23, 42, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }
    .btn-tab {
      background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);
      color: #1e40af;
      border-color: #bfdbfe;
    }
    .btn-tab:hover {
      background: linear-gradient(180deg, #dbeafe 0%, #bfdbfe 100%);
      color: #1e3a8a;
    }
    .btn-tab.active {
      background: var(--accent-gradient);
      color: #ffffff;
      border-color: var(--accent-dark);
      text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.15);
      box-shadow: var(--active-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    .home-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .home-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .btn-small { padding: 2px 6px; font-size: 11px; }
    .plus-btn { min-width: 18px; width: 18px; height: 18px; padding: 0; font-size: 11px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }

    input[type="text"], input:not([type]) {
      text-transform: capitalize;
    }
    .toggle-btn {
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      min-width: 12px;
      width: 12px;
      height: 18px;
      padding: 0;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
      appearance: none;
      -webkit-appearance: none;
    }
    .toggle-btn::before {
      content: "";
      width: 6px;
      height: 6px;
      display: inline-block;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: rotate(45deg);
      transform-origin: center;
      margin-top: -2px;
    }
    .toggle-btn.collapsed::before {
      transform: rotate(-45deg);
      margin-top: 0;
      margin-left: -2px;
    }
    .grid, .summary { display: grid; grid-template-columns: repeat(4, minmax(180px, 1fr)); gap: 8px; }
    .project-info-grid { display: grid; grid-template-columns: repeat(3, minmax(180px, 1fr)); gap: 8px; }
    .project-subject-row { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 8px; }
    .project-subject-row input {
      width: 100%;
      height: 22px;
      padding: 2px 4px;
      border: 1px solid var(--line);
      border-radius: 4px;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      background: #ffffff;
      box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
      transition: border-color 0.1s ease, box-shadow 0.1s ease;
    }
    .project-subject-row input:focus {
      border-color: var(--accent);
      outline: none;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15), inset 0 1px 2px rgba(15, 23, 42, 0.05);
    }
    #boqSheet .section-title h2, #boqSheet .boq-title-row h2 { text-transform: uppercase !important; font-size: 14pt !important; line-height: 14pt !important; }
    @media (max-width: 980px) { .project-info-grid { grid-template-columns: repeat(2, minmax(180px, 1fr)); } }
    @media (max-width: 640px) { .project-info-grid { grid-template-columns: 1fr; } }
    .field label { display: block; font-size: 11px; color: var(--muted); margin-bottom: 2px; font-weight: 700; text-transform: uppercase; }
    .field input, td input, td select {
      width: 100%; min-width: 0; max-width: 100%; padding: 0 2px; font-size: 11px; border: none; outline: none; background: transparent; box-shadow: none; height: 18px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .field input {
      border: 1px solid var(--line);
      background: #ffffff;
      height: 22px;
      padding: 2px 4px;
      box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
      transition: border-color 0.1s ease, box-shadow 0.1s ease;
    }
    .field input:focus {
      border-color: var(--accent);
      outline: none;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15), inset 0 1px 2px rgba(15, 23, 42, 0.05);
    }
    .project-content-field { margin-top: 8px; }
    .field textarea {
      width: 100%;
      min-height: 80px;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 6px;
      font-size: 11px;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      resize: vertical;
      box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
      transition: border-color 0.1s ease, box-shadow 0.1s ease;
    }
    .field textarea:focus {
      border-color: var(--accent);
      outline: none;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15), inset 0 1px 2px rgba(15, 23, 42, 0.05);
    }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); }
    table {
      width: 100%;
      min-width: 980px;
      border-collapse: collapse;
      background: #fff;
      table-layout: fixed;
    }
    #ganttTaskTable, #qtyTaskTable {
      min-width: 0 !important;
    }
    th, td {
      border: 1px solid var(--line);
      padding: 2px 4px;
      vertical-align: middle;
      text-align: left;
      font-size: 11px; overflow: hidden; word-break: break-word; overflow-wrap: anywhere; white-space: normal; }
    thead th {
      background: var(--accent) !important;
      color: #ffffff !important;
      text-transform: uppercase !important;
      font-weight: bold !important;
      border: 1px solid var(--accent-dark) !important;
      position: sticky;
      top: 0;
      z-index: 1;
      text-align: center;
      vertical-align: middle;
    }
    thead th .toggle-btn {
      color: #ffffff !important;
    }
    .number { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; }
    .plus-cell { text-align: center; vertical-align: middle; white-space: nowrap; }
    .work-cell { min-width: 0; width: 100%; overflow: hidden; }
    .work-stack { display: grid; gap: 1px; }
    #priceListTable th, #priceListTable td { white-space: nowrap; }
    #priceListTable td:last-child, #priceListTable th:last-child { text-align: center; }
    #priceListTable td { padding-top: 1px; padding-bottom: 1px; }
    #priceListTable input, #priceListTable select { height: 16px; }

    /* Center Qty values and hide number input spinner controls in D.U.P.A. and BOQ tables */
    #analysisTable td:nth-child(5), #analysisTable td:nth-child(5) input,
    #boqTable td:nth-child(5), #boqTable td:nth-child(5) input {
      text-align: center;
    }
    #analysisTable td:nth-child(5) input[type="number"],
    #boqTable td:nth-child(5) input[type="number"] {
      appearance: textfield;
      -moz-appearance: textfield;
    }
    #analysisTable td:nth-child(5) input[type="number"]::-webkit-outer-spin-button,
    #analysisTable td:nth-child(5) input[type="number"]::-webkit-inner-spin-button,
    #boqTable td:nth-child(5) input[type="number"]::-webkit-outer-spin-button,
    #boqTable td:nth-child(5) input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    /* Center Qty and Unit column values in Price List, D.U.P.A., and BOQ tables */
    #priceListTable td:nth-child(5),
    #priceListTable td:nth-child(5) input,
    #analysisTable td:nth-child(5),
    #analysisTable td:nth-child(5) input,
    #analysisTable td:nth-child(6),
    #analysisTable td:nth-child(6) input,
    #boqTable td:nth-child(5),
    #boqTable td:nth-child(5) input,
    #boqTable td:nth-child(6),
    #boqTable td:nth-child(6) input {
      text-align: center;
    }
    .inline-cell { display: flex; align-items: center; gap: 0; min-width: 0; white-space: nowrap; overflow: hidden; }
    .inline-cell select, .inline-cell input { flex: 1 1 auto; min-width: 0; }
    .inline-cell .toggle-btn { flex: 0 0 12px; margin: 0; }
    .inline-cell .toggle-btn + select,
    .inline-cell .toggle-btn + input,
    .inline-cell .toggle-btn + span { margin-left: 0; }
    
    .gantt-summary-cell-wrapper {
      position: relative !important;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 4px;
      box-sizing: border-box;
      border-right: none !important;
      overflow: visible !important;
    }
    .gantt-summary-cell-wrapper::after {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background-color: var(--line);
      transform: translateX(50%);
      z-index: 1;
    }
    .gantt-summary-cell-wrapper:hover .dropdown-arrow {
      display: inline-block !important;
    }

    .price-inline { display: flex; align-items: center; gap: 0; min-width: 0; white-space: nowrap; overflow: hidden; }
    .price-inline .subcat-label { font-size: 10px; color: #6b7280; flex: 0 0 auto; white-space: nowrap; }
    .price-inline .material-input { flex: 1 1 auto; min-width: 0; }
    .indent-1 { padding-left: 0; font-weight: 700; }
    .indent-2 { padding-left: 4mm; }
    .indent-3 { padding-left: 8mm; }
    .indent-4 { padding-left: 12mm; }
    .row-category { background: #dbeafe; font-weight: bold !important; }
    .row-category td { border-top: 1px solid #93c5fd !important; border-bottom: 1px solid #93c5fd !important; color: #1e3a8a !important; }
    .row-subcategory { background: #fef3c7; font-weight: bold !important; }
    .row-subcategory td { border-top: 1px solid #fcd34d !important; border-bottom: 1px solid #fcd34d !important; color: #78350f !important; }
    .row-category td,
    .row-category input,
    .row-category select,
    .row-subcategory td,
    .row-subcategory input,
    .row-subcategory select {
      font-weight: bold !important;
    }
    .row-subsubcategory { background: #ffffff; font-style: italic; }
    .row-subsubsubcategory { background: #ffffff; font-style: italic; }
    .row-spacer td {
      height: 18px;
      padding: 0;
      border: 1px solid var(--line);
      background: var(--card);
    }

    /* BOQ hierarchy display updates */
    #boqTable tbody .row-subsubcategory.has-children { background: #dcfce7 !important; }
    #boqTable tbody .row-subsubcategory.has-children td { border-top: 1px solid #86efac !important; border-bottom: 1px solid #86efac !important; color: #14532d !important; }
    #boqTable tbody .row-subsubsubcategory,
    #boqTable tbody .row-subsubsubcategory td,
    #boqTable tbody .row-subsubsubcategory input,
    #boqTable tbody .row-subsubsubcategory select,
    #boqTable tbody .row-subsubsubcategory .number {
      font-style: italic !important;
      font-weight: 400 !important;
    }

    .row-total { background: #f1f5f9; font-weight: bold !important; font-style: normal !important; }
    .row-total td {
      border-top: 2px solid #64748b !important;
      border-bottom: 2px solid #64748b !important;
      color: #0f172a !important;
      text-align: center;
      vertical-align: middle;
      font-weight: bold !important;
      font-style: normal !important;
    }
    .row-grand-total { background: #bae6fd; font-weight: 800 !important; }
    .row-grand-total td {
      border-top: 2px solid #0284c7 !important;
      border-bottom: 2px solid #0284c7 !important;
      color: #0369a1 !important;
    }
    .row-total .number { text-align: right; font-weight: bold !important; font-style: normal !important; }
    .total-label { text-align: center; font-weight: bold !important; font-style: normal !important; text-transform: uppercase !important; }
    #boqTable .total-label { text-align: left; padding-left: 4px; }
    .boq-section-title { align-items: center; overflow-x: auto; white-space: nowrap; }
    .boq-title-row { display: flex; align-items: center; gap: 12px; flex-wrap: nowrap; width: 100%; min-width: max-content; }
    .boq-title-row h2 { margin-bottom: 0; flex: 0 0 auto; }
    .boq-multipliers { display: flex; flex-wrap: nowrap; gap: 8px; align-items: center; margin-top: 0; flex: 1 1 auto; width: 100%; }
    .boq-multiplier-field { display: inline-flex; align-items: center; gap: 4px; min-width: 0; white-space: nowrap; }
    .boq-multiplier-field label { font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase; }
    .percent-input-wrap { position: relative; display: inline-block; width: 2cm; flex: 0 0 2cm; }
    .boq-multiplier-field input { width: 2cm; height: 22px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 18px 2px 4px; text-align: center; font-size: 11px; background: #fff; appearance: textfield; -moz-appearance: textfield; }
    .boq-multiplier-field input::-webkit-outer-spin-button,
    .boq-multiplier-field input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    .boq-summary-btn { margin-left: auto; white-space: nowrap; }
    .summary-sheet-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
    .summary-area-field { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
    .summary-area-field input { width: 90px; height: 22px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 4px; text-align: center; font-size: 11px; background: #fff; }
    #boqSummaryTable th, #boqSummaryTable td { white-space: nowrap; }
    #boqSummaryTable tbody tr { height: 16pt !important; }
    #boqSummaryTable .row-subcategory td,
    #boqSummaryTable .row-subcategory td span { font-weight: normal !important; }
    #boqSummaryTable .summary-total-row { background: #f1f5f9; font-weight: bold !important; text-transform: uppercase; }
    #boqSummaryTable .summary-total-row td { border-top: 2px solid #64748b !important; border-bottom: 2px solid #64748b !important; color: #0f172a !important; }
    #boqSummaryTable .summary-total-row td,
    #boqSummaryTable .summary-total-row td span { font-weight: bold !important; }
    .percent-symbol { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-size: 11px; color: var(--muted); pointer-events: none; font-weight: 700; }
    #analysisTable tbody .row-category { background: #dbeafe; font-weight: 700; }
    #analysisTable tbody .row-category td { border-top: 1px solid #93c5fd !important; border-bottom: 1px solid #93c5fd !important; color: #1e3a8a !important; }
    #analysisTable tbody .row-subcategory { background: #fef3c7; }
    #analysisTable tbody .row-subcategory td { border-top: 1px solid #fcd34d !important; border-bottom: 1px solid #fcd34d !important; color: #78350f !important; }
    #analysisTable tbody .row-subsubcategory { background: #ffffff; font-style: italic; }
    #analysisTable tbody .row-subsubcategory input,
    #analysisTable tbody .row-subsubcategory select,
    #analysisTable tbody .row-subsubcategory .number { font-style: italic; }

    /* Gantt Chart Styles */
    .gantt-view-options button.activeScale {
      background-color: var(--accent) !important;
      color: white !important;
      border-color: var(--accent-dark) !important;
    }
    .gantt-divider {
      width: 6px;
      cursor: col-resize;
      background: var(--line, #cfd8e3);
      flex-shrink: 0;
      user-select: none;
      transition: background 0.15s;
      z-index: 15;
    }
    .gantt-divider:hover, .gantt-divider:active {
      background: var(--accent, #2563eb) !important;
    }
    .gantt-row {
      height: 36px;
      box-sizing: border-box;
    }
    .gantt-container th, .gantt-container td,
    #qtyTaskTable th, #qtyTaskTable td {
      border-top: none !important;
      box-sizing: border-box !important;
    }
    .gantt-row td {
      height: 36px;
      padding: 0 4px !important;
      vertical-align: middle;
      font-size: 11px;
      border-bottom: 1px solid var(--line);
      border-right: 1px solid var(--line);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      box-sizing: border-box;
    }
    .gantt-row td input {
      width: 100%;
      height: 24px;
      border: 1px solid transparent;
      background: transparent;
      padding: 2px 4px;
      font-size: 11px;
      box-sizing: border-box;
      text-align: center;
      transition: all 0.15s ease;
    }
    .gantt-row td input:focus, .gantt-row td input:hover {
      border-color: var(--accent-light);
      background: #fff;
    }
    .gantt-timeline-row {
      height: 36px;
      box-sizing: border-box;
      border-bottom: 1px solid var(--line);
      position: relative;
      z-index: 2;
      display: flex !important;
      flex-wrap: nowrap !important;
      min-width: 100% !important;
    }
    .gantt-grid-days {
      background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 28px 100%;
    }
    .gantt-grid-weeks {
      background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 64px 100%;
    }
    .gantt-grid-months {
      background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 120px 100%;
    }
    .gantt-bar-wrapper {
      position: absolute;
      height: 18px;
      top: 9px;
      display: flex;
      align-items: center;
      box-sizing: border-box;
    }
    .gantt-bar-wrapper:hover .gantt-bar-handle {
      opacity: 1 !important;
    }
    .gantt-bar {
      width: 100%;
      height: 100%;
      background: var(--gloss-overlay), linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
      border-radius: 3px;
      position: relative;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
      border: 1px solid #1e40af;
      box-sizing: border-box;
    }
    .gantt-progress-bar {
      height: 100%;
      background: var(--gloss-overlay), linear-gradient(90deg, #10b981 0%, #059669 100%);
      border-radius: 3px 0 0 3px;
      border-right: 1px solid #047857;
      box-sizing: border-box;
    }
    .gantt-summary-bar {
      width: 100%;
      height: 6px;
      background: var(--gloss-overlay), #0f172a;
      position: relative;
      top: 6px;
      box-sizing: border-box;
    }
    .gantt-summary-bar::before, .gantt-summary-bar::after {
      content: '';
      position: absolute;
      width: 0;
      height: 0;
      border-style: solid;
    }
    .gantt-summary-bar::before {
      left: 0;
      top: 0;
      border-width: 10px 0 0 10px;
      border-color: #0f172a transparent transparent transparent;
    }
    .gantt-summary-bar::after {
      right: 0;
      top: 0;
      border-width: 10px 10px 0 0;
      border-color: #0f172a transparent transparent transparent;
    }
    .gantt-bar-label {
      position: absolute;
      left: calc(100% + 8px);
      top: 50%;
      transform: translateY(-50%);
      font-size: 10px;
      font-weight: 700;
      color: #374151;
      white-space: nowrap;
      pointer-events: none;
    }
    .gantt-timeline-header-row {
      display: flex;
      box-sizing: border-box;
      border-bottom: 1px solid var(--line);
    }
    .gantt-header-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: bold;
      text-transform: uppercase;
      color: #374151;
      border-right: 1px solid var(--line) !important;
      box-sizing: border-box;
      height: 24px;
      background: #f1f5f9;
      overflow: visible !important;
      white-space: nowrap;
      text-overflow: ellipsis;
      position: relative !important;
    }
    .gantt-header-cell::after {
      display: none !important;
    }

    .cover-letter-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
    .cover-letter-page { background: #fff; border: 1px solid var(--line); width: 210mm; min-height: 297mm; max-width: 100%; padding: 10mm; margin: 0 auto; line-height: 1.45; box-sizing: border-box; }
    .cover-letter-header { text-align: center; margin-bottom: 18px; }
    .cover-company-logo {
      display: block;
      width: min(100%, 760px);
      max-height: 70px;
      object-fit: contain;
      margin: 0 auto 14px;
    }
    /* HARD FINAL META ALIGNMENT OVERRIDE: left labels, aligned colon, aligned linked values */
    .cover-letter-meta .cover-meta-row {
      display: grid !important;
      grid-template-columns: 32mm 5mm 3mm 10mm minmax(0, 1fr) !important;
      align-items: center !important;
      column-gap: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .cover-letter-meta .cover-meta-label { display: contents !important; }
    .cover-letter-meta .cover-meta-text {
      grid-column: 1 !important;
      justify-self: start !important;
      text-align: left !important;
      width: 32mm !important;
      min-width: 32mm !important;
      max-width: 32mm !important;
    }
    .cover-letter-meta .cover-meta-colon {
      grid-column: 3 !important;
      justify-self: start !important;
      text-align: left !important;
      width: 3mm !important;
      min-width: 3mm !important;
      max-width: 3mm !important;
    }
    .cover-letter-meta .cover-linked-value,
    #coverProposalDate, #coverProjectName, #coverClientName, #coverSubject {
      grid-column: 5 !important;
      margin-left: 0 !important;
      text-align: left !important;
      white-space: nowrap !important;
    }
    @media print {
      @page { size: A4; margin: 10mm; }
      .cover-company-logo { max-height: 70px !important; height: auto !important; }
      body.print-cover-proposal { background: #fff; }
      body.print-cover-proposal .header,
      body.print-cover-proposal .sheet-nav,
      body.print-cover-proposal .cover-letter-toolbar,
      body.print-cover-proposal .sheet:not(#coverLetterSheet) { display: none !important; }
      body.print-cover-proposal #coverLetterSheet { display: block !important; }
      body.print-cover-proposal #coverLetterSheet .card { box-shadow: none; border: 0; padding: 0; margin: 0; }
      body.print-cover-proposal .cover-letter-page { border: 0; width: auto; min-height: auto; max-width: none; padding: 0; margin: 0; box-sizing: border-box; }
      body.print-cover-proposal .cover-letter-page input,
      body.print-cover-proposal .cover-letter-page textarea,
      body.print-cover-proposal .cover-letter-body [contenteditable="true"] { min-height: 28px; border: 1px solid var(--line); border-radius: 4px; padding: 6px; outline: none; background: #fff; text-align: justify; font-size: 10pt; line-height: 1.45; }
      body.print-cover-proposal .container { padding: 0; }
    }

    .cover-letter-header h2 { margin-bottom: 4px; text-transform: uppercase; }
    .cover-letter-meta { display: grid; grid-template-columns: 32mm 5mm 3mm 10mm minmax(0, 1fr); row-gap: 1px; column-gap: 0; margin: 4px 0 6px; align-items: center; overflow: visible; }
    .cover-letter-meta label, .cover-letter-meta .cover-linked-value, .cover-meta-label { min-height: 18px; display: flex; align-items: center; line-height: 1.2; }
    .cover-linked-value { display: flex; align-items: center; width: 100%; min-width: 0; min-height: 18px; border: 0; padding: 0; font-size: 10pt; line-height: 1.2; background: transparent; color: var(--text); }
    #coverProjectName, #coverClientName { white-space: nowrap; overflow: visible; text-overflow: clip; }
    .cover-letter-meta label, .cover-letter-terms label, .cover-meta-label { font-size: 10pt; color: var(--muted); font-weight: 800; text-transform: uppercase; }
    .cover-letter-page input, .cover-letter-page textarea { width: 100%; border: 1px solid var(--line); border-radius: 4px; padding: 4px 6px; font-size: 12px; background: #fff; }
    .cover-letter-page textarea { min-height: 72px; resize: vertical; font-family: Arial, Helvetica, sans-serif; line-height: 1.4; }
    .cover-letter-body { display: grid; gap: 8px; margin: 12px 0; font-size: 10pt; }
    .cover-letter-body [contenteditable="true"] { min-height: 34px; border: 1px solid var(--line); border-radius: 4px; padding: 8px; outline: none; background: #fff; text-align: justify; line-height: 1.45; }
    .proposal-amount-box { border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 6px; padding: 10px; font-weight: 700; }
    .proposal-amount-box span { font-size: 15px; font-weight: 900; }
    .proposal-vat-note { font-size: 11px; color: var(--muted); margin: -4px 0 4px; font-weight: 700; }
    .cover-letter-section-title { margin: 16px 0 6px; font-size: 12px; font-weight: 900; text-transform: uppercase; color: #111827; letter-spacing: .02em; }
    .cover-letter-terms { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
    .cover-letter-terms > div {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 12px 14px;
      box-shadow: var(--card-shadow);
      position: relative;
      width: 100%;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .cover-letter-terms > div::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: rgba(255, 255, 255, 0.8);
      pointer-events: none;
      border-radius: 6px 6px 0 0;
    }
    .cover-summary-table { margin-top: 12px; overflow: visible; }
    .cover-summary-table table { width: 100%; min-width: 0; table-layout: fixed; }
    #coverSummaryTable th, #coverSummaryTable td { box-sizing: border-box; }
    #coverSummaryTable th { white-space: nowrap; font-size: 10px; padding: 4px 3px; }
    #coverSummaryTable td { font-size: 10px; padding: 4px 3px; }
    #coverSummaryTable .number { white-space: nowrap; }
    .cover-letter-signatures { display: flex; flex-direction: column; gap: 24px; margin-top: 28px; }
    .cover-letter-signature-line { border-bottom: 1px solid #111827; height: 38px; margin-bottom: 6px; }
    @media (max-width: 700px) { .cover-letter-terms, .cover-letter-signatures { grid-template-columns: 1fr; } .cover-letter-meta { display: grid; grid-template-columns: 32mm 5mm 3mm 10mm minmax(0, 1fr); row-gap: 1px; column-gap: 0; margin: 4px 0 6px; align-items: center; overflow: visible; } .cover-letter-page { width: 100%; min-height: auto; padding: 12px; } }

    .summary-box { background: var(--soft); border: 1px solid #dbe8ff; border-radius: 4px; padding: 8px; }
    .summary-box .label { font-size: 11px; color: var(--muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px; }
    .summary-box .value { font-size: 18px; font-weight: 800; }

    .boq-signatures {
      display: flex;
      justify-content: space-between;
      gap: 48px;
      margin-top: 34px;
      padding: 0 32px 10px;
    }
    .signature-block {
      flex: 1 1 0;
      max-width: 360px;
      text-align: center;
    }
    .signature-heading {
      text-align: left;
      font-weight: 700;
      font-size: 12px;
      margin-bottom: 34px;
    }
    .signature-line {
      border-bottom: 1px solid #111827;
      height: 28px;
      margin-bottom: 6px;
    }
    .signature-name-input,
    .signature-position-input {
      width: 100%;
      max-width: 260px;
      height: 20px;
      border: none;
      outline: none;
      background: transparent;
      text-align: center;
      color: var(--text);
      margin-top: 2px;
    }
    .signature-name-input {
      min-height: 18px;
      font-weight: 700;
      font-size: 12px;
    }
    .signature-position-input {
      font-size: 11px;
    }
    .signature-name-input::placeholder,
    .signature-position-input::placeholder {
      color: var(--muted);
    }
    @media (max-width: 700px) {
      .boq-signatures {
        flex-direction: column;
        gap: 24px;
        padding: 0 12px 10px;
      }
      .signature-block {
        max-width: none;
      }
    }



    .boq-review-section {
      margin: 20px 0 8px;
      padding: 0 6px;
    }
    .boq-review-title {
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .02em;
      margin: 0 0 6px;
      color: #111827;
    }
    #boqReviewTable { min-width: 900px; table-layout: fixed; }
    #boqReviewTable th { font-weight: 800; text-transform: uppercase; font-size: 10px; }
    #boqReviewTable td { height: 28px; background: #fff; }
    #boqReviewTable input,
    #boqReviewTable select,
    #boqReviewTable textarea {
      width: 100%;
      border: none;
      outline: none;
      background: transparent;
      font-size: 11px;
      font-family: Arial, Helvetica, sans-serif;
    }
    #boqReviewTable textarea { min-height: 24px; resize: vertical; overflow: hidden; padding: 2px; }
    #boqReviewTable select,
    #boqReviewTable input { text-align: center; height: 22px; }
    .boq-review-note { margin-top: 6px; font-size: 11px; color: var(--muted); font-weight: 700; }

    .pill { display: inline-block; background: #ecfeff; color: #0f766e; border: 1px solid #a5f3fc; padding: 2px 6px; border-radius: 999px; font-size: 11px; font-weight: 700; margin-left: 6px; }
    @media (max-width: 980px) { .grid, .summary { grid-template-columns: repeat(2, minmax(180px, 1fr)); } }
    @media (max-width: 640px) { .grid, .summary { grid-template-columns: 1fr; } }
  
    @media (max-width: 1200px) {
      .container { padding: 8px; }
      table { min-width: 860px; }
      th, td { font-size: 10px; padding: 2px 3px; }
      .field input, td input, td select { font-size: 10px; height: 18px; }
      button { font-size: 11px; padding: 3px 6px; }
    }

    @media (max-width: 900px) {
      .header, .section-title, .sheet-nav, .toolbar, .totals-bar {
        gap: 6px;
      }
      table { min-width: 760px; }
      th, td { font-size: 10px; padding: 1px 2px; }
      .grid, .summary { grid-template-columns: repeat(2, minmax(140px, 1fr)); }
    }

    @media (max-width: 640px) {
      .container { padding: 6px; }
      h1 { font-size: 18px; }
      h2 { font-size: 15px; }
      p { font-size: 11px; }
      .grid, .summary { grid-template-columns: 1fr; }
      .header { flex-direction: column; }
      .header-save-toolbar { max-width: 100%; justify-content: flex-start; }
      .table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      table { min-width: 680px; }
      th, td { font-size: 9px; }
      .field input, td input, td select { font-size: 9px; height: 17px; }
      button { font-size: 10px; padding: 3px 5px; }
      .plus-btn { min-width: 16px; width: 16px; height: 16px; font-size: 10px; }
    }

  
    /* Final cleanup: tight cover metadata and no underline lines */
    .cover-letter-meta,
    .cover-meta-row,
    .cover-letter-meta > div {
      gap: 2px !important;
      row-gap: 2px !important;
      margin-top: 1px !important;
