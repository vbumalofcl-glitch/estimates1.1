        </div>
      </div>

<div class="card">
        <div class="section-title boq-section-title">
          <div class="boq-title-row">
            <h2>BILL OF QUANTITY </h2>
            <div class="boq-indent-buttons" style="display: inline-flex; gap: 4px; margin-right: 12px; align-items: center;">
              <button class="btn-secondary" type="button" onclick="outdentSelectedBOQRow()" title="Outdent / Move to parent task (<)" style="padding: 2px 8px; font-weight: bold; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px;">&lt;</button>
              <button class="btn-secondary" type="button" onclick="indentSelectedBOQRow()" title="Indent / Move to sub task (>)" style="padding: 2px 8px; font-weight: bold; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px;">&gt;</button>
            </div>
            <div class="boq-multipliers" aria-label="BOQ multiplier factors">
              <div class="boq-multiplier-field"><label>Qty</label><span class="percent-input-wrap"><input id="boqQtyMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <div class="boq-multiplier-field"><label>Material Unit Cost</label><span class="percent-input-wrap"><input id="boqMaterialMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <div class="boq-multiplier-field"><label>LE Unit Cost</label><span class="percent-input-wrap"><input id="boqLEMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <div class="boq-multiplier-field"><label>Profit</label><span class="percent-input-wrap"><input id="boqProfitMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <div class="boq-multiplier-field"><label>Overhead Cost</label><span class="percent-input-wrap"><input id="boqOverheadMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <div class="boq-multiplier-field"><label>Tax</label><span class="percent-input-wrap"><input id="boqTaxMultiplier" type="number" step="0.01" value="0" onchange="updateBOQMultipliers()"><span class="percent-symbol">%</span></span></div>
              <button class="btn-primary boq-summary-btn" type="button" onclick="showBOQSummarySheet()">Summary of BOQ</button>
              <button class="btn-secondary" id="printBOQPdfInlineBtn" type="button" onclick="printBOQWithSummaryPdf()">Print BOQ + Summary to PDF</button>
            </div>
          </div>
        </div>
        <div class="table-wrap">
          <table id="boqTable">
            <thead>
              <tr>
                <th style="width: 40px;">+</th>
                <th style="width: 90px;">Item Code</th>
                <th style="width: 260px;"><button id="boqMasterToggle" class="toggle-btn" type="button" onclick="toggleAllBOQRows()" aria-label="Collapse or expand all BOQ rows"></button> Work Description</th>
                <th style="width: 190px;">Specification</th>
                <th style="width: 60px;">Qty</th>
                <th style="width: 55px;">Unit</th>
                <th style="width: 95px;">Material Unit Cost</th>
                <th style="width: 95px;">Total Material Cost</th>
                <th style="width: 95px;">LE Unit Cost</th>
                <th style="width: 120px;">Total LEC</th>
                <th style="width: 100px;">Grand Total Cost</th>
                <th style="width: 140px;">Condition</th>
                <th style="width: 70px;">Action</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="boq-signatures">
          <div class="signature-block">
            <div class="signature-heading">Submitted by:</div>
            <div class="signature-line"></div>
            <input id="submittedBySignatureName" class="signature-name-input" type="text" placeholder="Name" oninput="markUnsaved()" />
            <input id="submittedByPosition" class="signature-position-input" type="text" placeholder="Position" oninput="markUnsaved()" />
          </div>
          <div class="signature-block">
            <div class="signature-heading">Accepted by:</div>
            <div class="signature-line"></div>
            <input id="acceptedBySignatureName" class="signature-name-input" type="text" placeholder="Client Name" oninput="markUnsaved()" />
            <input id="acceptedByPosition" class="signature-position-input" type="text" placeholder="Position" oninput="markUnsaved()" />
          </div>
        </div>

        <div class="boq-review-section">
          <div class="boq-review-title">Management Review and Approval</div>
          <div class="table-wrap">
            <table id="boqReviewTable">
              <thead>
                <tr>
                  <th style="width: 170px;">Reviewer</th>
                  <th style="width: 230px;">Name / Final Input</th>
                  <th style="width: 320px;">Comments</th>
                  <th style="width: 150px;">Status</th>
                  <th style="width: 180px;">Approval</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>QS Manager</strong></td>
                  <td><input type="text" placeholder="Enter name / final input" oninput="markUnsaved()"></td>
                  <td><textarea placeholder="Enter comments" oninput="markUnsaved()"></textarea></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Status</option><option>For Review</option><option>Approved</option><option>Revise</option><option>Returned</option></select></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Approval</option><option>Ready for CEO Submission</option><option>Not Yet Ready</option></select></td>
                </tr>
                <tr>
                  <td><strong>QAQC Manager</strong></td>
                  <td><input type="text" placeholder="Enter name / final input" oninput="markUnsaved()"></td>
                  <td><textarea placeholder="Enter comments" oninput="markUnsaved()"></textarea></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Status</option><option>For Review</option><option>Approved</option><option>Revise</option><option>Returned</option></select></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Approval</option><option>Ready for CEO Submission</option><option>Not Yet Ready</option></select></td>
                </tr>
                <tr>
                  <td><strong>Operations Manager</strong></td>
                  <td><input type="text" placeholder="Enter name / final input" oninput="markUnsaved()"></td>
                  <td><textarea placeholder="Enter comments" oninput="markUnsaved()"></textarea></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Status</option><option>For Review</option><option>Approved</option><option>Revise</option><option>Returned</option></select></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Approval</option><option>Ready for CEO Submission</option><option>Not Yet Ready</option></select></td>
                </tr>
                <tr>
                  <td><strong>CEO Final Input</strong></td>
                  <td><input type="text" placeholder="CEO / authorized signatory" oninput="markUnsaved()"></td>
                  <td><textarea placeholder="Final comments or instructions" oninput="markUnsaved()"></textarea></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Status</option><option>For Final Review</option><option>Approved for Submission</option><option>Revise</option></select></td>
                  <td><select onchange="markUnsaved()"><option value="">Select Approval</option><option>Approved</option><option>Not Approved</option></select></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="boq-review-note">Note: This review table is prepared for internal checking and final CEO approval before client submission.</div>
        </div>

