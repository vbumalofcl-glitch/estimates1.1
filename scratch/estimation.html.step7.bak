<td style="width:33.33%; height:96px; text-align:center; vertical-align:middle; padding:1mm 4px;">
  <div class="boq-header-title">COST BREAKDOWN ESTIMATE</div>
</td>

              <td style="width:33.33%; padding:0;">
                <table class="boq-doc-control-table" style="width:100%; min-width:0; height:100%; table-layout:fixed; border-collapse:collapse;">
                  <tbody>
                    <tr>
                      <td class="boq-doc-label" style="width:50%; height:24px;">Doc. Code</td>
