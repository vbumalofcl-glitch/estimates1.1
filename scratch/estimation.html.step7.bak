<!-- Gantt Link Custom Modal -->
<div id="ganttLinkModal" class="custom-modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); justify-content: center; align-items: center;">
  <div style="background: var(--card, #ffffff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; width: 320px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.25); color: var(--text, #1f2937);">
    <h3 style="margin-top: 0; font-size: 14px; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line, #e2e8f0); padding-bottom: 10px;">Select Link Type</h3>
    <p style="font-size: 11px; color: var(--muted-dark, #4b5563); margin: 10px 0;">Create relationship between <strong id="ganttLinkPredCode"></strong> and <strong id="ganttLinkSuccCode"></strong>:</p>
    <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px;">
      <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: bold; cursor: pointer;">
        <input type="radio" name="ganttLinkType" value="FS" checked> FS - Finish-to-Start
      </label>
      <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: bold; cursor: pointer;">
        <input type="radio" name="ganttLinkType" value="SS"> SS - Start-to-Start
      </label>
      <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: bold; cursor: pointer;">
        <input type="radio" name="ganttLinkType" value="FF"> FF - Finish-to-Finish
      </label>
      <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: bold; cursor: pointer;">
        <input type="radio" name="ganttLinkType" value="SF"> SF - Start-to-Finish
      </label>
      <div style="display: flex; flex-direction: column; gap: 2px; margin-top: 4px;">
        <label style="font-size: 10px; font-weight: bold; color: var(--muted-dark, #4b5563);">Lag / Lead (days, e.g. +3 or -2):</label>
        <input type="number" id="ganttLinkLabelLag" value="0" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; width: 100%; box-sizing: border-box;">
      </div>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 8px;">
      <button class="btn-secondary" style="padding: 4px 12px; font-size: 11px;" onclick="closeGanttLinkModal()">Cancel</button>
      <button class="btn-primary" style="padding: 4px 12px; font-size: 11px;" onclick="saveGanttLink()">Create Link</button>
    </div>
  </div>
</div>

<!-- Gantt Print Options Modal -->
<div id="ganttPrintModal" class="custom-modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); justify-content: center; align-items: center;">
  <div style="background: var(--card, #ffffff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; width: 380px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.25); color: var(--text, #1f2937); display: flex; flex-direction: column; gap: 15px;">
    <h3 style="margin-top: 0; font-size: 14px; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line, #e2e8f0); padding-bottom: 10px; margin-bottom: 0;">Gantt PDF Print Options</h3>
    
    <div style="display: flex; flex-direction: column; gap: 10px; font-size: 12px;">
      <p style="margin: 0; color: var(--muted-dark);">Choose how you want the Gantt chart to fit on the printed PDF pages:</p>
      
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: bold;">
        <input type="radio" name="ganttPrintFitOption" value="fit" checked style="cursor: pointer;">
        Fit all columns to page width (1 page) (Recommended)
      </label>
      <div style="font-size: 10px; color: var(--muted); margin-left: 20px;">
        Shrinks and scales down the timeline columns so the entire chart fits within a single page width.
      </div>
      
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: bold; margin-top: 5px;">
        <input type="radio" name="ganttPrintFitOption" value="fit2" style="cursor: pointer;">
        Fit all columns to page width (2 pages)
      </label>
      <div style="font-size: 10px; color: var(--muted); margin-left: 20px;">
        Splits the timeline columns in half horizontally, printing them across two pages side-by-side with the left table visible on both.
      </div>
      
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: bold; margin-top: 5px;">
        <input type="radio" name="ganttPrintFitOption" value="actual" style="cursor: pointer;">
        Actual Size (100% Scale)
      </label>
      <div style="font-size: 10px; color: var(--muted); margin-left: 20px;">
        Prints at full scale. Wide timelines will overflow or span onto separate pages if needed.
      </div>
    </div>
    
    <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--line, #e2e8f0); padding-top: 12px; margin-top: 5px;">
      <button class="btn-secondary" style="padding: 6px 12px; font-size: 11px;" onclick="closeGanttPrintModal()">Cancel</button>
      <button class="btn-primary" id="confirmGanttPrintBtn" style="padding: 6px 16px; font-size: 11px;">Print PDF</button>
    </div>
  </div>
</div>

<!-- Gantt Style Settings Modal -->
<div id="ganttStyleSettingsModal" class="custom-modal" style="display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); justify-content: center; align-items: center; padding: 20px; box-sizing: border-box;">
  <div style="background: var(--card, #ffffff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; width: 1000px; max-width: 95vw; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box;">
    
    <!-- Modal Header -->
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--line, #e2e8f0); display: flex; justify-content: space-between; align-items: center;">
      <h3 style="margin: 0; font-size: 14px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); letter-spacing: 0.5px;">Gantt Chart Style Settings</h3>
      <button onclick="closeGanttStyleSettingsModal()" style="background: transparent; border: none; font-size: 18px; line-height: 1; cursor: pointer; color: var(--text-muted, #9ca3af); hover:color: var(--text, #1f2937); font-weight: bold;">&times;</button>
    </div>
    
    <!-- Modal Body (Scrollable Container) -->
    <div style="flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box;">
      
      <!-- 3-Column Grid Layout -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        
        <!-- Column 1: Layout & Dimensions -->
        <div style="display: flex; flex-direction: column; gap: 15px;">
          
          <!-- Section A: Grid Dimensions -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Grid Dimensions</span>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Row Height (px)</label>
                <input type="number" id="ganttSetRowHeight" min="30" max="100" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Left Header H (px)</label>
                <input type="number" id="ganttSetHeaderHeight" min="20" max="120" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Header Top (Tier 1)</label>
                <input type="number" id="ganttSetHeaderTopHeight" min="10" max="60" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Header Bottom (Tier 2)</label>
                <input type="number" id="ganttSetHeaderBottomHeight" min="10" max="60" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <label style="font-size: 10px; font-weight: bold;">Header Font Size (px)</label>
              <input type="number" id="ganttSetHeaderFontSize" min="8" max="24" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
            </div>
          </div>
          
          <!-- Section B: Bar Geometry & Gaps -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Bar Geometry & Gaps</span>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Task Bar H (px)</label>
                <input type="number" id="ganttSetTaskBarHeight" min="3" max="30" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Summary Bar H (px)</label>
                <input type="number" id="ganttSetSummaryBarHeight" min="3" max="30" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Bar Gap (px)</label>
                <input type="number" id="ganttSetBarGap" min="0" max="20" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Vertical Align</label>
                <select id="ganttSetBarVerticalAlign" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px;">
                  <option value="top">Top</option>
                  <option value="middle">Middle</option>
                  <option value="bottom">Bottom</option>
                </select>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <label style="font-size: 10px; font-weight: bold;">Bar Arrangement Style</label>
              <select id="ganttSetBarArrangement" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px;">
                <option value="planned_actual">Planned above Actual</option>
                <option value="actual_planned">Actual above Planned</option>
              </select>
            </div>
          </div>
          
          <!-- Section C: Column Widths -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Timeline Column Widths (px)</span>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px;">
              <div style="display: flex; flex-direction: column; gap: 2px; text-align: center;">
                <label style="font-size: 9px; font-weight: bold;">Days</label>
                <input type="number" id="ganttSetColWidthDays" min="10" max="200" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 10px; text-align: center;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; text-align: center;">
                <label style="font-size: 9px; font-weight: bold;">Weeks</label>
                <input type="number" id="ganttSetColWidthWeeks" min="20" max="300" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 10px; text-align: center;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; text-align: center;">
                <label style="font-size: 9px; font-weight: bold;">Months</label>
                <input type="number" id="ganttSetColWidthMonths" min="40" max="500" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 10px; text-align: center;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; text-align: center;">
                <label style="font-size: 9px; font-weight: bold;">Quarters</label>
                <input type="number" id="ganttSetColWidthQuarters" min="80" max="800" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 10px; text-align: center;">
              </div>
            </div>
          </div>
          
        </div>
        
        <!-- Column 2: Colors & Labels -->
        <div style="display: flex; flex-direction: column; gap: 15px;">
          
          <!-- Section A: Theme Colors -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Header & Coordinate Colors</span>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Table Header Bg</label>
                <input type="color" id="ganttSetHeaderLeftBg" style="width: 100%; height: 26px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Table Header Text</label>
                <input type="color" id="ganttSetHeaderLeftColor" style="width: 100%; height: 26px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Timeline Bg</label>
                <input type="color" id="ganttSetHeaderRightBg" style="width: 100%; height: 26px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Timeline Text</label>
                <input type="color" id="ganttSetHeaderRightColor" style="width: 100%; height: 26px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold; color: var(--accent);">Header Alt Bg</label>
                <input type="color" id="ganttSetHeaderAltBg" style="width: 100%; height: 26px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;" title="Alternating Month/Week Period Header Column Background">
              </div>
            </div>
            <div style="border-top: 1px dashed var(--line); margin-top: 4px; padding-top: 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Row Coord Bg</label>
                <input type="color" id="ganttSetCoordRowBg" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Row Coord Text</label>
                <input type="color" id="ganttSetCoordRowColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Col Coord Bg</label>
                <input type="color" id="ganttSetCoordHeaderBg" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Col Coord Text</label>
                <input type="color" id="ganttSetCoordHeaderColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Col Coord H</label>
                <input type="number" id="ganttSetCoordHeaderHeight" min="10" max="100" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 10px; height: 24px; box-sizing: border-box;">
              </div>
            </div>
          </div>
          
          <!-- Section B: Bar Fill Colors -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Planned & Actual Bar Colors</span>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; text-align: center;">
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Task (Cost)</label>
                <input type="color" id="ganttSetTaskColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Task (Day)</label>
                <input type="color" id="ganttSetTaskDayColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Summ (Cost)</label>
                <input type="color" id="ganttSetSummaryColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Summ (Day)</label>
                <input type="color" id="ganttSetSummaryDayColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; text-align: center;">
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Actual Task</label>
                <input type="color" id="ganttSetTaskActualColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Actual Sum</label>
                <input type="color" id="ganttSetSummaryActualColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Est Task Bg</label>
                <input type="color" id="ganttSetTaskBgColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Est Sum Bg</label>
                <input type="color" id="ganttSetSummaryBgColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; text-align: center; border-top: 1px dashed var(--line); padding-top: 6px; margin-top: 2px;">
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Actual Task Bg</label>
                <input type="color" id="ganttSetTaskActualBgColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px; align-items: center;">
                <label style="font-size: 8px; font-weight: bold; white-space: nowrap;">Actual Sum Bg</label>
                <input type="color" id="ganttSetSummaryActualBgColor" style="width: 100%; height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
              </div>
            </div>
          </div>
          
          <!-- Section C: Task Labels & S-Curve Text -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Task Labels & S-Curve Text</span>
            
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <label style="font-size: 10px; font-weight: bold;">Show Estimation Labels:</label>
              <div style="display: flex; gap: 15px; align-items: center;">
                <label style="font-size: 10px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                  <input type="checkbox" id="ganttSetShowCostLabel" style="cursor: pointer; margin: 0;"> Cost Bar
                </label>
                <label style="font-size: 10px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                  <input type="checkbox" id="ganttSetShowDayLabel" style="cursor: pointer; margin: 0;"> Day Bar
                </label>
                <label style="font-size: 10px; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                  <input type="checkbox" id="ganttSetShowActualLabel" style="cursor: pointer; margin: 0;"> Actual Bar
                </label>
              </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Label Scope</label>
                <select id="ganttSetBarLabelScope" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px;">
                  <option value="all">Show on All</option>
                  <option value="tasks">Tasks Only</option>
                  <option value="summary">Summary Only</option>
                  <option value="none">Hide All Labels</option>
                </select>
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Label Location</label>
                <select id="ganttSetBarLabelLocation" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px;">
                  <option value="right">Right of Bar</option>
                  <option value="center">Center of Bar</option>
                  <option value="top">Top of Cell</option>
                  <option value="bottom">Bottom of Cell</option>
                  <option value="progress">At Progress Fill</option>
                  <option value="current_date">At Current Date</option>
                </select>
              </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Label Size (px)</label>
                <input type="number" id="ganttSetBarLabelSize" min="5" max="24" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px; box-sizing: border-box;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">Bar Decimals</label>
                <input type="number" id="ganttSetBarLabelDecimals" min="0" max="4" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px; box-sizing: border-box;">
              </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; border-top: 1px dashed var(--line); padding-top: 6px; margin-top: 2px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">S-Curve Decimals</label>
                <input type="number" id="ganttSetScurveLabelDecimals" min="0" max="4" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px; box-sizing: border-box;">
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 10px; font-weight: bold;">S-Curve Size (px)</label>
                <input type="number" id="ganttSetScurveLabelSize" min="5" max="24" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 25px; box-sizing: border-box;">
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center; margin-top: 2px;">
              <label style="font-size: 10px; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                <input type="checkbox" id="ganttSetShowScurveDayLabel" style="cursor: pointer; margin: 0;"> S-Curve Day Labels
              </label>
              <label style="font-size: 10px; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;">
                <input type="checkbox" id="ganttSetShowScurveCostLabel" style="cursor: pointer; margin: 0;"> S-Curve Cost Labels
              </label>
            </div>
          </div>
          
        </div>
        
        <!-- Column 3: Gridlines & Connectors -->
        <div style="display: flex; flex-direction: column; gap: 15px;">
          
          <!-- Section A: Gridline Details -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Timeline Gridline Details</span>
            
            <!-- Row Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Row Grid:</span>
              <input type="number" id="ganttSetGridRowWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridRowStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridRowColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Table Vertical Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Table Vert:</span>
              <input type="number" id="ganttSetGridColWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridColStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridColColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Day Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Day Grid:</span>
              <input type="number" id="ganttSetGridDayWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridDayStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridDayColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Week Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Week Grid:</span>
              <input type="number" id="ganttSetGridWeekWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridWeekStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridWeekColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Month Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Month Grid:</span>
              <input type="number" id="ganttSetGridMonthWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridMonthStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridMonthColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Table Header Grid -->
            <div style="display: flex; gap: 6px; align-items: center; border-top: 1px dashed var(--line); padding-top: 6px; margin-top: 2px;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Table Hdr Grid:</span>
              <input type="number" id="ganttSetGridHeaderLeftWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridHeaderLeftStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridHeaderLeftColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Timeline Header Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Timeline Hdr Grid:</span>
              <input type="number" id="ganttSetGridHeaderRightWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridHeaderRightStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridHeaderRightColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Outer Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Outer Border:</span>
              <input type="number" id="ganttSetGridOuterWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridOuterStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridOuterColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Projected Line -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Projected Line:</span>
              <input type="number" id="ganttSetGridProjWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridProjStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridProjColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- % Curve Grid -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">% Curve Grid:</span>
              <input type="number" id="ganttSetGridCurveWeight" min="0" max="5" step="0.1" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetGridCurveStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
                <option value="double">Double</option>
                <option value="none">None</option>
              </select>
              <input type="color" id="ganttSetGridCurveColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>
          </div>
          
          <!-- Section B: Connector Line Settings -->
          <div style="background: var(--bg, #f8fafc); border: 1px solid var(--line, #e2e8f0); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--accent, #2563eb); border-bottom: 1px solid var(--line); padding-bottom: 4px; display: block;">Task Link Connectors</span>
            
            <!-- Connector Line Style -->
            <div style="display: flex; gap: 6px; align-items: center;">
              <span style="font-size: 9px; font-weight: bold; width: 85px; flex-shrink: 0; color: var(--muted-dark);">Line Style:</span>
              <input type="number" id="ganttSetConnectorWeight" min="0.5" max="10" step="0.5" placeholder="Wt" style="width: 45px; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
              <select id="ganttSetConnectorStyle" style="flex: 1; padding: 3px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                <option value="solid">Solid</option>
                <option value="dashed">Dashed</option>
                <option value="dotted">Dotted</option>
              </select>
              <input type="color" id="ganttSetConnectorColor" style="width: 30px; height: 23px; border: 1px solid var(--line); border-radius: 4px; padding: 1px; cursor: pointer;">
            </div>

            <!-- Connector Heads -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">Start Head</label>
                <select id="ganttSetConnectorStartHead" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                  <option value="none">None</option>
                  <option value="arrow">Arrow</option>
                  <option value="circle">Circle</option>
                  <option value="square">Square</option>
                  <option value="diamond">Diamond</option>
                </select>
              </div>
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <label style="font-size: 9px; font-weight: bold;">End Head</label>
                <select id="ganttSetConnectorEndHead" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px; height: 23px;">
                  <option value="arrow">Arrow</option>
                  <option value="circle">Circle</option>
                  <option value="square">Square</option>
                  <option value="diamond">Diamond</option>
                  <option value="none">None</option>
                </select>
              </div>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <label style="font-size: 10px; font-weight: bold;">Head Size (px)</label>
              <input type="number" id="ganttSetConnectorHeadSize" min="2" max="20" style="padding: 4px; border: 1px solid var(--line); border-radius: 4px; font-size: 11px;">
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
    
    <!-- Modal Footer Actions -->
    <div style="padding: 12px 20px; border-top: 1px solid var(--line, #e2e8f0); display: flex; justify-content: flex-end; gap: 8px; background: var(--bg, #f8fafc); border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
      <button class="btn-secondary" style="padding: 6px 16px; font-size: 11px; font-weight: bold; border-radius: 4px;" onclick="closeGanttStyleSettingsModal()">Cancel</button>
      <button class="btn-primary" style="padding: 6px 20px; font-size: 11px; font-weight: bold; border-radius: 4px;" onclick="saveGanttStyleSettings()">Apply Settings</button>
    </div>
    
  </div>
</div>

<!-- Qty Inst Modal -->
<div id="ganttQtyInstModal" class="custom-modal" style="display: none; position: fixed; z-index: 1001; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
  <div style="background: var(--card, #ffffff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; width: 95vw; height: 90vh; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.25); color: var(--text, #1f2937); display: flex; flex-direction: column; gap: 15px;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
      <h3 style="margin: 0; font-size: 16px; text-transform: uppercase; color: var(--accent, #2563eb);">Update Quantity Installed (Accomplishment)</h3>
      <div style="display: flex; gap: 10px; align-items: center;">
        <span style="font-size: 11px; font-weight: bold; color: var(--muted-dark);">Scale:</span>
        <button class="btn-secondary btn-small" type="button" id="qtyScaleDays" onclick="setQtyModalScale('days')">Days</button>
        <button class="btn-secondary btn-small" type="button" id="qtyScaleWeeks" onclick="setQtyModalScale('weeks')">Weeks</button>
        <button class="btn-secondary btn-small" type="button" id="qtyScaleMonths" onclick="setQtyModalScale('months')">Months</button>
        <button class="btn-secondary btn-small" type="button" id="qtyScaleQuarters" onclick="setQtyModalScale('quarters')">Quarters</button>
        
        <div class="dropdown" style="display: inline-block; position: relative;">
          <button class="btn-secondary" id="qtyHighlightRowBtn" type="button" style="padding: 4px 10px; font-size: 11px; font-weight: bold; height: 24px; display: inline-flex; align-items: center; gap: 4px;" onclick="toggleQtyHighlightDropdown(event)">
            Row Highlight: Yellow <span style="font-size: 9px; vertical-align: middle; line-height: 1;">▼</span>
          </button>
          <div class="dropdown-content" id="qtyHighlightDropdown" style="display: none; position: absolute; left: 0; top: 100%; background-color: #fff; min-width: 160px; box-shadow: 0px 4px 12px rgba(0,0,0,0.15); border: 1px solid var(--line); border-radius: 4px; z-index: 1000; margin-top: 2px;">
            <a href="#" onclick="setGanttHighlightMode('none', event)" style="color: var(--text); padding: 8px 12px; text-decoration: none; display: block; font-size: 11px; font-weight: 600;">Disable Highlight</a>
            <a href="#" onclick="setGanttHighlightMode('yellow', event)" style="color: var(--text); padding: 8px 12px; text-decoration: none; display: block; font-size: 11px; font-weight: 600; border-top: 1px solid var(--line); background-color: #fef08a;">Highlight Row (Yellow)</a>
            <a href="#" onclick="setGanttHighlightMode('blue', event)" style="color: var(--text); padding: 8px 12px; text-decoration: none; display: block; font-size: 11px; font-weight: 600; border-top: 1px solid var(--line); background-color: #bfdbfe;">Highlight Row (Blue)</a>
            <a href="#" onclick="setGanttHighlightMode('green', event)" style="color: var(--text); padding: 8px 12px; text-decoration: none; display: block; font-size: 11px; font-weight: 600; border-top: 1px solid var(--line); background-color: #bbf7d0;">Highlight Row (Green)</a>
            <a href="#" onclick="setGanttHighlightMode('orange', event)" style="color: var(--text); padding: 8px 12px; text-decoration: none; display: block; font-size: 11px; font-weight: 600; border-top: 1px solid var(--line); background-color: #fed7aa;">Highlight Row (Orange)</a>
          </div>
        </div>
        
        <button class="btn-secondary" style="padding: 4px 10px; font-size: 11px; font-weight: bold; height: 24px; display: inline-flex; align-items: center; gap: 4px;" type="button" onclick="openGanttStyleSettingsModal()">🎨 Style Settings</button>
        <button class="btn-primary" style="padding: 4px 12px; font-size: 11px;" onclick="closeGanttQtyInstModal()">Save & Close</button>
      </div>
    </div>
    <!-- View Selector Tabs -->
    <div style="display: flex; gap: 6px; align-items: center; background: #f1f5f9; padding: 6px; border-radius: 6px; border: 1px solid var(--line); margin-bottom: -5px;">
      <span style="font-size: 11px; font-weight: bold; color: var(--muted-dark); margin-right: 6px;">SELECT TABLE:</span>
      <button class="btn-tab btn-small active" type="button" id="qtyViewTab-quantity" onclick="setQtyModalView('quantity')">Quantity Installed</button>
      <button class="btn-tab btn-small" type="button" id="qtyViewTab-accomplishment" onclick="setQtyModalView('accomplishment')">Summary of Accomplishment</button>
      <button class="btn-tab btn-small" type="button" id="qtyViewTab-progress_cost" onclick="setQtyModalView('progress_cost')">Progress % (Cost) Summary</button>
      <button class="btn-tab btn-small" type="button" id="qtyViewTab-progress_day" onclick="setQtyModalView('progress_day')">Progress % (Day) Summary</button>
      <button class="btn-tab btn-small" type="button" id="qtyViewTab-cash_flow_estimated" onclick="setQtyModalView('cash_flow_estimated')">Cash Flow (Estimated)</button>
      <button class="btn-tab btn-small" type="button" id="qtyViewTab-cash_flow_day" onclick="setQtyModalView('cash_flow_day')">Cash Flow (Day)</button>
    </div>
    <div class="gantt-container" style="display: flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--card); flex-grow: 1;">
      <!-- Left side: Task list table -->
      <div class="qty-left-panel" id="qtyLeftPanel" style="width: 550px; flex-shrink: 0; overflow-y: hidden; overflow-x: scroll; background: var(--bg); border-right: 2px solid var(--line);">
        <table id="qtyTaskTable" style="width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed;">
          <thead></thead>
          <tbody></tbody>
        </table>
      </div>
      <!-- Divider -->
      <div id="qtyModalDivider" class="gantt-divider"></div>
      <!-- Right side: Time Table with inputs -->
      <div class="qty-right-panel" id="qtyRightPanel" style="flex-grow: 1; overflow-y: auto; overflow-x: scroll; position: relative;">
        <div id="qtyTimelineHeader" style="position: sticky; top: 0; z-index: 20; background: var(--card); border-bottom: 1px solid var(--line); height: 48px;"></div>
        <div id="qtyTimelineBody" style="position: relative;"></div>
      </div>
    </div>
  </div>
</div>

<!-- Billing Record Modal -->
<div id="ganttBillingRecordModal" class="custom-modal" style="display: none; position: fixed; z-index: 1001; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
  <div style="background: var(--card, #ffffff); border: 1px solid var(--line, #e2e8f0); border-radius: 8px; width: 95vw; height: 90vh; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.25); color: var(--text, #1f2937); display: flex; flex-direction: column; gap: 15px;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
      <h3 style="margin: 0; font-size: 16px; text-transform: uppercase; color: var(--accent, #2563eb);">Interactive Billing Record</h3>
      <button class="btn-primary" style="padding: 4px 12px; font-size: 11px;" onclick="closeGanttBillingRecordModal()">Close</button>
    </div>
    
    <!-- Controls row -->
    <div style="display: flex; gap: 20px; flex-wrap: wrap; background: var(--bg); padding: 10px; border-radius: 4px; border: 1px solid var(--line); font-size: 11px;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="font-weight: bold;">Previous Billing Date:</span>
        <input id="billingPrevDate" type="date" onchange="recalculateBillingTable()" style="height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 4px;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="font-weight: bold;">Current Billing Date (As To Date):</span>
        <input id="billingCurrDate" type="date" onchange="recalculateBillingTable()" style="height: 24px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 4px;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="font-weight: bold;">Retention Rate (%):</span>
        <input id="billingRetentionRate" type="number" min="0" max="100" value="10" oninput="recalculateBillingTable()" style="height: 24px; width: 60px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 4px; text-align: center;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="font-weight: bold;">DP Recovery Rate (%):</span>
        <input id="billingDPRate" type="number" min="0" max="100" value="15" oninput="recalculateBillingTable()" style="height: 24px; width: 60px; border: 1px solid var(--line); border-radius: 4px; padding: 2px 4px; text-align: center;">
      </div>
      <div style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
        <button class="btn-secondary" style="height: 24px; padding: 2px 10px; font-size: 11px; font-weight: bold; display: inline-flex; align-items: center;" onclick="exportBillingToExcel()">Export Billing to Excel</button>
      </div>
    </div>
    
    <!-- Table wrapper -->
    <div style="flex-grow: 1; overflow: auto; border: 1px solid var(--line); border-radius: 4px;">
      <table id="billingRecordTable" style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 11px;">
        <thead>
          <tr style="height: 48px; border-bottom: 2px solid var(--line); background: var(--accent); color: white; position: sticky; top: 0; z-index: 10;">
            <th style="width: 70px; text-align: center; border-right: 1px solid var(--accent-dark);">Code</th>
            <th style="width: 220px; text-align: left; padding-left: 8px; border-right: 1px solid var(--accent-dark);">Work Description</th>
            <th style="width: 90px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">Contract Amount</th>
            
            <th style="width: 80px; text-align: center; border-right: 1px solid var(--accent-dark);">Prev. Qty</th>
            <th style="width: 90px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">Prev. Cost</th>
            
            <th style="width: 80px; text-align: center; border-right: 1px solid var(--accent-dark);">Curr. Qty</th>
            <th style="width: 90px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">Curr. Cost</th>
            
            <th style="width: 80px; text-align: center; border-right: 1px solid var(--accent-dark);">Cum. Qty</th>
            <th style="width: 95px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">Cum. Cost</th>
            
            <th style="width: 90px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">Retention</th>
            <th style="width: 90px; text-align: right; padding-right: 8px; border-right: 1px solid var(--accent-dark);">DP Recovery</th>
            <th style="width: 100px; text-align: right; padding-right: 8px;">Net Billing</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<!-- Excel Grid Active Cell Selection Box & Autofill Handle -->
<div id="appCellSelectionBox">
  <div id="appCellFillHandle" title="Drag to autofill cells"></div>
</div>
<div id="appCellFillPreviewBox"></div>

<!-- Live Selection Status Bar -->
<div id="appGridStatusBar" class="app-grid-status-bar" style="display: none;">
  <div class="stat-item"><span class="stat-label">AVERAGE:</span><span id="appStatAverage" class="stat-val">-</span></div>
  <div class="stat-item"><span class="stat-label">COUNT:</span><span id="appStatCount" class="stat-val">0</span></div>
  <div class="stat-item"><span class="stat-label">MIN:</span><span id="appStatMin" class="stat-val">-</span></div>
  <div class="stat-item"><span class="stat-label">MAX:</span><span id="appStatMax" class="stat-val">-</span></div>
  <div class="stat-item"><span class="stat-label">SUM:</span><span id="appStatSum" class="stat-val">-</span></div>
</div>

</body>
</html>