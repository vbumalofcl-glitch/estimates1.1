            <div class="analysis-indent-buttons" style="display: inline-flex; gap: 4px; align-items: center;">
              <button class="btn-secondary" type="button" onclick="outdentSelectedAnalysisRow()" title="Outdent / Move to parent task (<)" style="padding: 2px 8px; font-weight: bold; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px;">&lt;</button>
              <button class="btn-secondary" type="button" onclick="indentSelectedAnalysisRow()" title="Indent / Move to sub task (>)" style="padding: 2px 8px; font-weight: bold; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px;">&gt;</button>
            </div>
