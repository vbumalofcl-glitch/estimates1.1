    };
    let ganttSettings = {};

    let ganttScale = 'days';

    const DEFAULT_GANTT_COLUMNS = [
      { id: 'predNo', name: 'Pred. No.', width: 60, visible: true, isCustom: false },
      { id: 'code', name: 'Code', width: 50, visible: true, isCustom: false },
      { id: 'title', name: 'Work Description', width: 180, visible: true, isCustom: false },
      { id: 'specification', name: 'Specification', width: 150, visible: true, isCustom: false },
      { id: 'startDate', name: 'Start Date', width: 90, visible: true, isCustom: false },
      { id: 'finishDate', name: 'Finish Date', width: 90, visible: true, isCustom: false },
      { id: 'actualStartDate', name: 'Actual Start', width: 110, visible: true, isCustom: false },
      { id: 'actualFinishDate', name: 'Actual Finish', width: 110, visible: true, isCustom: false },
      { id: 'days', name: 'Duration', width: 60, visible: true, isCustom: false },
      { id: 'remainingDays', name: 'Remaining Days', width: 90, visible: true, isCustom: false },
      { id: 'predecessors', name: 'Predecessors', width: 80, visible: true, isCustom: false },
      { id: 'cost', name: 'Cost', width: 100, visible: true, isCustom: false },
      { id: 'estQty', name: 'EST. QTY', width: 80, visible: true, isCustom: false },
      { id: 'instQty', name: 'INST. QTY', width: 80, visible: true, isCustom: false },
      { id: 'qtyAccmpCost', name: 'QTY ACCMP. COST', width: 110, visible: true, isCustom: false },
      { id: 'progress', name: 'Progress % (Cost)', width: 95, visible: true, isCustom: false },
      { id: 'progressDay', name: 'Progress % (Day)', width: 95, visible: true, isCustom: false }
    ];
    let ganttColumns = [];
    const ganttUndoStack = [];

    function initGanttColumns() {
      try {
        const saved = JSON.parse(localStorage.getItem('cost_estimate_gantt_columns_v2'));
        if (Array.isArray(saved) && saved.length > 0) {
          const hasVisible = saved.some(c => c.visible);
          if (!hasVisible) {
            ganttColumns = JSON.parse(JSON.stringify(DEFAULT_GANTT_COLUMNS));
            saveGanttColumns();
            return;
          }
          saved.forEach(c => {
            if (c.id === 'progress') {
              c.name = 'Progress % (Cost)';
              if (c.width === 50) c.width = 95;
            }
            if (c.id === 'days') {
              c.name = 'Duration';
            }
          });
          
          const savedIds = saved.map(c => c.id);
          const missingDefaultCols = DEFAULT_GANTT_COLUMNS.filter(c => !savedIds.includes(c.id));
          
          if (missingDefaultCols.length > 0) {
            const merged = [...saved];
            missingDefaultCols.forEach(col => {
              const defaultIdx = DEFAULT_GANTT_COLUMNS.findIndex(c => c.id === col.id);
              if (defaultIdx > 0) {
                const prevId = DEFAULT_GANTT_COLUMNS[defaultIdx - 1].id;
                const prevIdxInMerged = merged.findIndex(c => c.id === prevId);
                if (prevIdxInMerged >= 0) {
                  merged.splice(prevIdxInMerged + 1, 0, col);
                  return;
                }
              }
              merged.push(col);
            });
            ganttColumns = merged;
            saveGanttColumns();
          } else {
            ganttColumns = saved;
          }
        } else {
          ganttColumns = JSON.parse(JSON.stringify(DEFAULT_GANTT_COLUMNS));
        }
      } catch (e) {
        ganttColumns = JSON.parse(JSON.stringify(DEFAULT_GANTT_COLUMNS));
      }
    }
    initGanttColumns();
    initGanttSettings();

    function saveGanttColumns() {
      localStorage.setItem('cost_estimate_gantt_columns_v2', JSON.stringify(ganttColumns));
    }



    function getParentRowIndex(rows, index) {
      const row = rows[index];
      if (!row) return -1;
      const currentLevel = levelOf(row);
      for (let i = index - 1; i >= 0; i--) {
        if (levelOf(rows[i]) < currentLevel) {
          return i;
        }
      }
      return -1;
    }

    function shouldHideGanttHierarchyRow(index) {
      const row = boqData[index];
      if (!row) return false;
      
      let parentIndex = getParentRowIndex(boqData, index);
      while (parentIndex !== -1) {
        if (boqData[parentIndex].ganttCollapsed) {
          return true;
        }
        parentIndex = getParentRowIndex(boqData, parentIndex);
      }
      
      return false;
    }

    function shouldHideQtyHierarchyRow(index) {
      const row = boqData[index];
      if (!row) return false;
      
      let parentIndex = getParentRowIndex(boqData, index);
      while (parentIndex !== -1) {
        if (boqData[parentIndex].qtyCollapsed) {
          return true;
        }
        parentIndex = getParentRowIndex(boqData, parentIndex);
      }
      
      return false;
    }

    function getColLetter(index) {
      let temp = index;
      let letter = '';
      while (temp >= 0) {
        letter = String.fromCharCode((temp % 26) + 65) + letter;
        temp = Math.floor(temp / 26) - 1;
      }
      return letter;
    }

    function toggleGanttCoordinates() {
      ganttSettings.showCoordinates = !ganttSettings.showCoordinates;
      saveGanttSettings();
      renderGanttChart();
    }
    window.toggleGanttCoordinates = toggleGanttCoordinates;

    function setGanttScale(scale) {
      ganttScale = scale;
      document.getElementById('scaleDaysBtn').classList.toggle('activeScale', scale === 'days');
      document.getElementById('scaleWeeksBtn').classList.toggle('activeScale', scale === 'weeks');
      document.getElementById('scaleMonthsBtn').classList.toggle('activeScale', scale === 'months');
      if (document.getElementById('scaleQuartersBtn')) {
        document.getElementById('scaleQuartersBtn').classList.toggle('activeScale', scale === 'quarters');
      }
      renderGanttChart();
    }

    function getTodayDateString() {
      const today = new Date();
      return formatDateString(today);
    }

    function getGanttProjectStartDate() {
      let saved = localStorage.getItem('cost_estimate_gantt_start_v1');
      if (saved) return saved;
      
      let earliest = null;
      boqData.forEach(row => {
        if (row.ganttStartDate) {
          const d = new Date(row.ganttStartDate);
          if (!isNaN(d.getTime())) {
            if (!earliest || d < earliest) earliest = d;
          }
        }
      });
      
      if (earliest) return formatDateString(earliest);
      
      const propDateInput = document.getElementById('proposalDate');
      if (propDateInput && propDateInput.value) {
        return propDateInput.value;
      }
      
      return getTodayDateString();
    }

    function updateGanttProjectStart() {
      const input = document.getElementById('ganttProjectStartInput');
      if (input && input.value) {
        pushGanttUndoState();
        localStorage.setItem('cost_estimate_gantt_start_v1', input.value);
        markUnsaved();
        renderGanttChart();
      }
    }

    function updateGanttCurrentDateLine() {
      const input = document.getElementById('ganttCurrentDateInput');
      if (input && input.value) {
        localStorage.setItem('cost_estimate_gantt_current_date_v1', input.value);
        renderGanttChart();
      }
    }
    
    function recalculateProgressPercentDay() {
      const input = document.getElementById('ganttCurrentDateInput');
      if (input) {
        const todayStr = getTodayDateString();
        input.value = todayStr;
        localStorage.setItem('cost_estimate_gantt_current_date_v1', todayStr);
        localStorage.setItem('cost_estimate_gantt_percent_date_v1', todayStr);
        markUnsaved();
        renderGanttChart();
      }
    }
    function getGanttTaskAccomplishedCost(index) {
      const row = boqData[index];
      if (!row) return 0;
      
      const childExists = hasChildRow(boqData, index);
      if (!childExists) {
        const displayValues = computeBOQDisplayValues(row);
        const grandTotalCost = displayValues.grandTotalCost || 0;
        const estQty = displayValues.qty || 0;
        const instQty = getInstalledQty(index);
        const unitCost = estQty > 0 ? (grandTotalCost / estQty) : 0;
        return instQty * unitCost;
      }
      
      let sum = 0;
      const parentLevel = levelOf(row.type);
      for (let i = index + 1; i < boqData.length; i++) {
        if (levelOf(boqData[i].type) <= parentLevel) {
          break;
        }
        if (!hasChildRow(boqData, i)) {
          sum += getGanttTaskAccomplishedCost(i);
        }
      }
      return sum;
    }

    function getInstalledQty(index) {
      const row = boqData[index];
      if (!row) return 0;
      
      if (hasChildRow(boqData, index)) {
        const leaves = getLeafDescendents(index);
        let sum = 0;
        leaves.forEach(leafIdx => {
          sum += getInstalledQty(leafIdx);
        });
        return sum;
      }
      
      if (row.ganttPeriodQty && Object.keys(row.ganttPeriodQty).length > 0) {
        return getPeriodQtyTotal(index);
      }
      
      if (row.hasOwnProperty('ganttInstalledQty')) {
        return parseFloat(row.ganttInstalledQty) || 0;
      }
      
      return 0;
    }

    function getGanttTaskDayProgress(index) {
      const taskInfo = getGanttTaskTimeInfo(index);
      if (!taskInfo || !taskInfo.startDate || !taskInfo.duration) return 0;
      
      const duration = taskInfo.duration;
      if (duration <= 0) return 0;
      
      const remaining = getGanttRemainingDays(index, taskInfo);
      const progress = (1 - (remaining / duration)) * 100;
      return Math.min(100, Math.max(0, Math.round(progress)));
    }

    function getGanttRemainingDays(index, taskInfo) {
      const row = boqData[index];
      if (!row) return 0;
      const info = taskInfo || getGanttTaskTimeInfo(index);
      const finishStr = info ? info.endDate : row.ganttEndDate;
      if (!finishStr) return 0;
      
      const finish = new Date(finishStr);
      finish.setHours(12, 0, 0, 0);
      
      const curInput = document.getElementById('ganttCurrentDateInput');
      const curStr = (curInput && curInput.value) || localStorage.getItem('cost_estimate_gantt_current_date_v1');
      const current = curStr ? new Date(curStr) : new Date();
      current.setHours(12, 0, 0, 0);
      
      const diffTime = finish - current;
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
      return Math.max(0, diffDays);
    }

    function getGanttTaskCostProgress(index) {
      const row = boqData[index];
      if (!row) return 0;
      
      const isParent = hasChildRow(boqData, index);
      const accomplishedCost = getGanttTaskAccomplishedCost(index) || 0;
      
      let totalCost = 0;
      if (isParent) {
        totalCost = (computeBOQCategorySummary(index) || {}).totalCost || 0;
      } else {
        const displayValues = computeBOQDisplayValues(row) || {};
        totalCost = displayValues.grandTotalCost || 0;
      }
      
      if (totalCost <= 0) return 0;
      return (accomplishedCost / totalCost) * 100;
    }

    function formatDateString(date) {
      if (!date || isNaN(date.getTime())) return '';
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, '0');
      const d = String(date.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function getQuarterLabel(date, short = false) {
      if (!date || isNaN(date.getTime())) return '';
      const q = Math.floor(date.getMonth() / 3) + 1;
      if (short) return `Q${q}`;
      if (q === 1) return '1st Quarter';
      if (q === 2) return '2nd Quarter';
      if (q === 3) return '3rd Quarter';
      return '4th Quarter';
    }

    function parseSafeDate(value, fallback = new Date()) {
      if (!value) return fallback;
      if (value instanceof Date) {
        return isNaN(value.getTime()) ? fallback : new Date(value);
      }
      const d = new Date(value);
      if (isNaN(d.getTime())) return fallback;
      return d;
    }

    function getGanttActualDates(index) {
      const row = boqData[index];
      if (!row) return { startDate: '', finishDate: '' };
      
      const isParent = hasChildRow(boqData, index);
      if (!isParent) {
        return {
          startDate: row.ganttActualStartDate || '',
          finishDate: row.ganttActualFinishDate || ''
        };
      }
      
      let earliestStart = null;
      let latestFinish = null;
      
      function collectLeafChildren(pIdx) {
        let leafs = [];
        boqData.forEach((r, idx) => {
          if (getParentRowIndex(boqData, idx) === pIdx) {
            if (hasChildRow(boqData, idx)) {
              leafs = leafs.concat(collectLeafChildren(idx));
            } else {
              leafs.push(idx);
            }
          }
        });
        return leafs;
      }
      
      const leafIdxs = collectLeafChildren(index);
      leafIdxs.forEach(childIdx => {
        const childRow = boqData[childIdx];
        if (childRow) {
          if (childRow.ganttActualStartDate) {
            const d = new Date(childRow.ganttActualStartDate);
            if (!isNaN(d.getTime())) {
              if (!earliestStart || d < earliestStart) earliestStart = d;
            }
          }
          if (childRow.ganttActualFinishDate) {
            const d = new Date(childRow.ganttActualFinishDate);
            if (!isNaN(d.getTime())) {
              if (!latestFinish || d > latestFinish) latestFinish = d;
            }
          }
        }
      });
      
      return {
        startDate: earliestStart ? formatDateString(earliestStart) : '',
        finishDate: latestFinish ? formatDateString(latestFinish) : ''
      };
    }

    function parsePredecessor(entry) {
      let cleanEntry = entry.trim();
      let pCode = cleanEntry;
      let type = 'FS';
      let lag = 0;
      
      // 1. First check if the entire entry is an exact match for a code or index in boqData
      let pIdx = findTaskIndexByCodeOrRow(cleanEntry);
      if (pIdx !== -1) {
        return { pCode: cleanEntry, type: 'FS', lag: 0, index: pIdx };
      }
      
      // 2. Check if it matches code + relation type suffix (e.g. 14FF or D-01-01-01SS)
      const suffixMatch = cleanEntry.match(/(FS|SS|FF|SF)$/i);
      if (suffixMatch) {
        const base = cleanEntry.slice(0, -2).trim();
        pIdx = findTaskIndexByCodeOrRow(base);
        if (pIdx !== -1) {
          return { pCode: base, type: suffixMatch[1].toUpperCase(), lag: 0, index: pIdx };
        }
      }
      
      // 3. Otherwise, parse with lag
      const lagMatch = pCode.match(/([+-]\d+)$/);
      if (lagMatch) {
        lag = parseInt(lagMatch[1], 10) || 0;
        pCode = pCode.slice(0, -lagMatch[1].length).trim();
      }
      
      const suffixMatch2 = pCode.match(/(FS|SS|FF|SF)$/i);
      if (suffixMatch2) {
        type = suffixMatch2[1].toUpperCase();
        pCode = pCode.slice(0, -2).trim();
      }
      
      pIdx = findTaskIndexByCodeOrRow(pCode);
      if (pIdx !== -1) {
        return { pCode, type, lag, index: pIdx };
      }
      
      return null;
    }

    function findTaskIndexByCodeOrRow(codeOrRow) {
      if (!codeOrRow) return -1;
      if (/^\d+$/.test(codeOrRow)) {
        const idx = parseInt(codeOrRow, 10) - 1;
        if (idx >= 0 && idx < boqData.length) {
          return idx;
        }
      }
      const upper = codeOrRow.toUpperCase();
      return boqData.findIndex(r => (r.code || '').toUpperCase() === upper);
    }

    const ganttTimeCache = new Map();

    function getGanttTaskTimeInfo(index, visited = new Set()) {
      if (visited.size === 0 && ganttTimeCache.has(index)) {
        return ganttTimeCache.get(index);
      }
      
      const row = boqData[index];
      if (!row) return null;
      
      const isParent = hasChildRow(boqData, index);
      const projStartStr = document.getElementById('ganttProjectStartInput')?.value || getTodayDateString();
      const projStartDate = parseSafeDate(projStartStr);
      
      if (visited.has(index)) {
        const fallbackStart = parseSafeDate(projStartDate);
        const fallbackEnd = new Date(fallbackStart);
        fallbackEnd.setDate(fallbackStart.getDate() + 4);
        const res = {
          isParent: isParent,
          startDate: fallbackStart,
          endDate: fallbackEnd,
          startStr: formatDateString(fallbackStart),
          duration: 5,
          progress: 0,
          hasCycle: true
        };
        if (visited.size === 0) {
          ganttTimeCache.set(index, res);
        }
        return res;
      }
      
      visited.add(index);
      
      if (!isParent) {
        const predecessorsStr = row.ganttPredecessors || '';
        let calculatedStartDate = null;
        let hasValidPredecessor = false;
        const duration = parseInt(row.ganttDuration, 10) || 5;
        
        if (predecessorsStr.trim() !== '') {
          const entries = predecessorsStr.split(',').map(s => s.trim().toUpperCase());
          
          entries.forEach(entry => {
            if (entry !== '') {
              const parsed = parsePredecessor(entry);
              if (parsed && parsed.index !== index) {
                const pIndex = parsed.index;
                const type = parsed.type;
                const lag = parsed.lag;
                
                const pInfo = getGanttTaskTimeInfo(pIndex, new Set(visited));
                if (pInfo && pInfo.startDate && pInfo.endDate) {
                  hasValidPredecessor = true;
                  let targetStart = null;
                  
                  if (type === 'FS') {
                    targetStart = parseSafeDate(pInfo.endDate);
                    targetStart.setDate(targetStart.getDate() + 1 + lag);
                  } else if (type === 'SS') {
                    targetStart = parseSafeDate(pInfo.startDate);
                    targetStart.setDate(targetStart.getDate() + lag);
                  } else if (type === 'FF') {
                    targetStart = parseSafeDate(pInfo.endDate);
                    targetStart.setDate(targetStart.getDate() - duration + 1 + lag);
                  } else if (type === 'SF') {
                    targetStart = parseSafeDate(pInfo.startDate);
                    targetStart.setDate(targetStart.getDate() - duration + 1 + lag);
                  }
                  
                  if (targetStart) {
                    if (!calculatedStartDate || targetStart > calculatedStartDate) {
                      calculatedStartDate = targetStart;
                    }
                  }
                }
              }
            }
          });
        }
        
        const startDate = calculatedStartDate || parseSafeDate(row.ganttStartDate, projStartDate);
        const progress = getGanttTaskCostProgress(index);
        
        const endDate = new Date(startDate);
        endDate.setDate(startDate.getDate() + duration - 1);
        
        const res = {
          isParent: false,
          startDate: startDate,
          endDate: endDate,
          startStr: formatDateString(startDate),
          duration: duration,
          progress: progress,
          hasPredecessors: hasValidPredecessor
        };
        if (visited.size === 0) {
          ganttTimeCache.set(index, res);
        }
        return res;
      } else {
        let minStart = null;
        let maxEnd = null;
        const parentLevel = levelOf(row.type);
        let i = index + 1;
        
        while (i < boqData.length && levelOf(boqData[i].type) > parentLevel) {
          if (!hasChildRow(boqData, i)) {
            const childInfo = getGanttTaskTimeInfo(i, visited);
            if (childInfo) {
              const cs = parseSafeDate(childInfo.startDate, null);
              const ce = parseSafeDate(childInfo.endDate, null);
              if (cs && ce) {
                if (!minStart || cs < minStart) minStart = cs;
                if (!maxEnd || ce > maxEnd) maxEnd = ce;
              }
            }
          }
          i++;
        }
        
        if (minStart && maxEnd) {
          const duration = Math.round((maxEnd - minStart) / (1000 * 60 * 60 * 24)) + 1;
          const progress = getGanttTaskCostProgress(index);
          const res = {
            isParent: true,
            startDate: minStart,
            endDate: maxEnd,
            startStr: formatDateString(minStart),
            duration: duration,
            progress: progress
          };
          if (visited.size === 0) {
            ganttTimeCache.set(index, res);
          }
          return res;
        } else {
          const startDate = parseSafeDate(projStartDate);
          const endDate = new Date(startDate);
          endDate.setDate(startDate.getDate() + 4);
          const progress = getGanttTaskCostProgress(index);
          const res = {
            isParent: true,
            startDate: startDate,
            endDate: endDate,
            startStr: formatDateString(startDate),
            duration: 5,
            progress: progress
          };
          if (visited.size === 0) {
            ganttTimeCache.set(index, res);
          }
          return res;
        }
      }
    }

    function ganttGetCoords(startDate, duration, projectStartDate, scale, colWidth) {
      let defaultColW = 28;
      if (scale === 'weeks') defaultColW = 64;
      else if (scale === 'months') defaultColW = 120;
      else if (scale === 'quarters') defaultColW = 180;
      
      const colW = colWidth || defaultColW;
      
      let left = 0;
      let width = 0;
      
      const start = parseSafeDate(startDate);
      start.setHours(0, 0, 0, 0);
      
      const end = new Date(start);
      end.setDate(start.getDate() + duration);
      
      const projStart = parseSafeDate(projectStartDate);
      projStart.setHours(0, 0, 0, 0);
      
      if (scale === 'days') {
        const dayDiff = (start - projStart) / (1000 * 60 * 60 * 24);
        left = dayDiff * colW;
        width = duration * colW;
      } else if (scale === 'weeks') {
        const dayDiff = (start - projStart) / (1000 * 60 * 60 * 24);
        left = dayDiff * (colW / 7);
        width = duration * (colW / 7);
      } else if (scale === 'quarters') {
        const getXOfDateQ = (target) => {
          let count = 0;
          let temp = new Date(projStart);
          temp.setMonth(Math.floor(temp.getMonth() / 3) * 3, 1);
          temp.setHours(0, 0, 0, 0);
          
          let t = new Date(target);
          t.setMonth(Math.floor(t.getMonth() / 3) * 3, 1);
          t.setHours(0, 0, 0, 0);
          
          while (temp < t) {
            count++;
            temp.setMonth(temp.getMonth() + 3);
          }
          
          const startOfQ = new Date(target.getFullYear(), Math.floor(target.getMonth() / 3) * 3, 1);
          const nextQ = new Date(target.getFullYear(), Math.floor(target.getMonth() / 3) * 3 + 3, 1);
          const daysInQ = (nextQ - startOfQ) / (1000 * 60 * 60 * 24);
          
          const dayOfQIndex = (target - startOfQ) / (1000 * 60 * 60 * 24);
          const fraction = dayOfQIndex / daysInQ;
          
          return (count + fraction) * colW;
        };
        
        left = getXOfDateQ(start);
        width = getXOfDateQ(end) - left;
      } else {
        // months scale
        const getXOfDateM = (target) => {
          let count = 0;
          let temp = new Date(projStart);
          temp.setDate(1);
          temp.setHours(0, 0, 0, 0);
          
          let t = new Date(target);
          t.setDate(1);
          t.setHours(0, 0, 0, 0);
          
          while (temp < t) {
            count++;
            temp.setMonth(temp.getMonth() + 1);
          }
          
          const startOfMonth = new Date(target.getFullYear(), target.getMonth(), 1);
          const nextMonth = new Date(target.getFullYear(), target.getMonth() + 1, 1);
          const daysInMonth = (nextMonth - startOfMonth) / (1000 * 60 * 60 * 24);
          
          const dayOfMonthIndex = (target - startOfMonth) / (1000 * 60 * 60 * 24);
          const fraction = dayOfMonthIndex / daysInMonth;
          
          return (count + fraction) * colW;
        };
        
        left = getXOfDateM(start);
        width = getXOfDateM(end) - left;
      }
      
      return { left, width };
    }

    function pushGanttUndoState() {
      const projStart = document.getElementById('ganttProjectStartInput')?.value || '';
      const snapshot = {
        projStart: projStart,
        tasks: boqData.map(row => ({
          ganttStartDate: row.ganttStartDate,
          ganttDuration: row.ganttDuration,
          ganttPredecessors: row.ganttPredecessors,
          ganttActualStartDate: row.ganttActualStartDate,
          ganttActualFinishDate: row.ganttActualFinishDate,
          ganttProgress: row.ganttProgress,
          ganttInstalledQty: row.ganttInstalledQty,
          ganttCustomValues: row.ganttCustomValues ? JSON.parse(JSON.stringify(row.ganttCustomValues)) : undefined
        }))
      };
      ganttUndoStack.push(snapshot);
      if (ganttUndoStack.length > 50) {
        ganttUndoStack.shift();
      }
      updateGanttUndoButtonState();
    }

    function undoGanttAction() {
      if (ganttUndoStack.length === 0) return;
      
      const prevState = ganttUndoStack.pop();
      
      const input = document.getElementById('ganttProjectStartInput');
      if (input && prevState.projStart) {
        input.value = prevState.projStart;
        localStorage.setItem('cost_estimate_gantt_start_v1', prevState.projStart);
      }
      
      prevState.tasks.forEach((savedRow, idx) => {
        if (boqData[idx]) {
          boqData[idx].ganttStartDate = savedRow.ganttStartDate;
          boqData[idx].ganttDuration = savedRow.ganttDuration;
          boqData[idx].ganttPredecessors = savedRow.ganttPredecessors;
          boqData[idx].ganttActualStartDate = savedRow.ganttActualStartDate;
          boqData[idx].ganttActualFinishDate = savedRow.ganttActualFinishDate;
          boqData[idx].ganttProgress = savedRow.ganttProgress;
          boqData[idx].ganttInstalledQty = savedRow.ganttInstalledQty;
          if (savedRow.ganttCustomValues) {
            boqData[idx].ganttCustomValues = savedRow.ganttCustomValues;
          } else {
            delete boqData[idx].ganttCustomValues;
          }
        }
      });
      
      markUnsaved();
      renderGanttChart();
      
      const qtyModal = document.getElementById('ganttQtyInstModal');
      if (qtyModal && qtyModal.style.display !== 'none') {
        renderQtyModalTable();
      }
      
      updateGanttUndoButtonState();
    }

    function updateGanttUndoButtonState() {
      const btn = document.getElementById('ganttUndoBtn');
      if (btn) {
        btn.disabled = (ganttUndoStack.length === 0);
      }
    }

    window.undoGanttAction = undoGanttAction;

    function updateGanttTask(index, field, value) {
      if (!boqData[index]) return;
      pushGanttUndoState();
      
      if (field === 'ganttStartDate') {
        boqData[index].ganttStartDate = value;
      } else if (field === 'ganttActualStartDate') {
        boqData[index].ganttActualStartDate = value;
      } else if (field === 'ganttActualFinishDate') {
        boqData[index].ganttActualFinishDate = value;
      } else if (field === 'ganttDuration') {
        let val = parseInt(value, 10);
        if (isNaN(val) || val < 1) val = 1;
        boqData[index].ganttDuration = val;
      } else if (field === 'ganttProgress') {
        let val = parseInt(value, 10);
        if (isNaN(val) || val < 0) val = 0;
        if (val > 100) val = 100;
        boqData[index].ganttProgress = val;
        
        // Sync Installed Qty
        const displayValues = computeBOQDisplayValues(boqData[index]);
        const estQty = displayValues ? displayValues.qty : 0;
        boqData[index].ganttInstalledQty = parseFloat(((val / 100) * estQty).toFixed(2));
      } else if (field === 'ganttInstalledQty' || field === 'instQty') {
        let val = parseFloat(value);
        if (isNaN(val) || val < 0) val = 0;
        boqData[index].ganttInstalledQty = val;
        
        // Sync Progress
        const displayValues = computeBOQDisplayValues(boqData[index]);
        const estQty = displayValues ? displayValues.qty : 0;
        if (estQty > 0) {
          const calculatedProgress = Math.min(100, Math.max(0, Math.round((val / estQty) * 100)));
          boqData[index].ganttProgress = calculatedProgress;
        } else {
          boqData[index].ganttProgress = 0;
        }
      } else if (field === 'ganttPredecessors') {
        boqData[index].ganttPredecessors = value;
      } else if (field === 'ganttFinishDate') {
        const taskInfo = getGanttTaskTimeInfo(index);
        if (taskInfo && taskInfo.startDate && value) {
          const newFinish = new Date(value);
          const start = new Date(taskInfo.startDate);
          newFinish.setHours(12, 0, 0, 0);
          start.setHours(12, 0, 0, 0);
          
          let diffDays = Math.round((newFinish - start) / (1000 * 60 * 60 * 24)) + 1;
          if (diffDays < 1) diffDays = 1;
          
          boqData[index].ganttDuration = diffDays;
        }
      }
      
      markUnsaved();
      renderGanttChart();
    }

    function showGanttSheet() {
      ganttTimeCache.clear();
      renderBOQTable();
      showSheet('ganttSheet');
      
      const savedWidth = localStorage.getItem('cost_estimate_gantt_left_width_v1');
      if (savedWidth) {
        const leftPanel = document.querySelector('.gantt-left-panel');
        if (leftPanel) leftPanel.style.width = savedWidth;
      }
      
      const input = document.getElementById('ganttProjectStartInput');
      if (input && !input.value) {
        input.value = getGanttProjectStartDate();
      }
      
      const curDateInput = document.getElementById('ganttCurrentDateInput');
      if (curDateInput && !curDateInput.value) {
        const savedCurDate = localStorage.getItem('cost_estimate_gantt_current_date_v1');
        curDateInput.value = savedCurDate || getTodayDateString();
      }
      
      renderGanttChart();
      setupGanttScrollSync();
      setupGanttDividerResize();
      setupGanttLinkDragging();
      setupGanttTimelineContextMenu();
      updateGanttUndoButtonState();
    }

    function setupGanttScrollSync() {
      const leftPanel = document.querySelector('.gantt-left-panel');
      const rightPanel = document.querySelector('.gantt-right-panel');
      if (!leftPanel || !rightPanel) return;
      
      let activeScroll = null;
      
      leftPanel.addEventListener('scroll', () => {
        if (activeScroll === 'right') {
          window.requestAnimationFrame(updateGanttTimelineViewport);
          return;
        }
        activeScroll = 'left';
        window.requestAnimationFrame(() => {
          rightPanel.scrollTop = leftPanel.scrollTop;
          updateGanttTimelineViewport();
          activeScroll = null;
        });
      }, { passive: true });
      
      rightPanel.addEventListener('scroll', () => {
        if (activeScroll === 'left') {
          window.requestAnimationFrame(updateGanttTimelineViewport);
          return;
        }
        activeScroll = 'right';
        window.requestAnimationFrame(() => {
          leftPanel.scrollTop = rightPanel.scrollTop;
          updateGanttTimelineViewport();
          activeScroll = null;
        });
      }, { passive: true });
    }

    function setupGanttDividerResize() {
      const container = document.querySelector('.gantt-container');
      const leftPanel = document.querySelector('.gantt-left-panel');
      const divider = document.querySelector('.gantt-divider');
      if (!container || !leftPanel || !divider) return;
      
      if (divider.dataset.resizeInitialized) return;
      divider.dataset.resizeInitialized = 'true';
      
      let isDragging = false;
      
      divider.addEventListener('mousedown', (e) => {
        isDragging = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        
        const containerRect = container.getBoundingClientRect();
        let newWidth = e.clientX - containerRect.left;
        
        const minW = 200;
        const maxW = containerRect.width - 200;
        if (newWidth < minW) newWidth = minW;
        if (newWidth > maxW) newWidth = maxW;
        
        leftPanel.style.width = newWidth + 'px';
        renderGanttChart();
      });
      
      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          localStorage.setItem('cost_estimate_gantt_left_width_v1', leftPanel.style.width);
        }
      });
    }
 
    let isDraggingLink = false;
    let linkSourceIndex = null;
    let linkSourceType = null; // 'start' or 'finish'
    let dragStartX = 0;
    let dragStartY = 0;
    let pendingLinkPredecessorIndex = null;
    let pendingLinkSuccessorIndex = null;
    
    function setupGanttLinkDragging() {
      const timelineBody = document.getElementById('ganttTimelineBody');
      if (!timelineBody) return;
      
      if (timelineBody.dataset.dragInitialized) return;
      timelineBody.dataset.dragInitialized = 'true';
      
      timelineBody.addEventListener('mousedown', (e) => {
        const handle = e.target.closest('.gantt-bar-handle');
        if (!handle) return;
        
        e.stopPropagation();
        e.preventDefault();
        
        isDraggingLink = true;
        linkSourceIndex = parseInt(handle.dataset.index, 10);
        linkSourceType = handle.dataset.type;
        
        const bodyRect = timelineBody.getBoundingClientRect();
        const handleRect = handle.getBoundingClientRect();
        
        dragStartX = handleRect.left - bodyRect.left + handleRect.width / 2 + timelineBody.scrollLeft;
        dragStartY = handleRect.top - bodyRect.top + handleRect.height / 2 + timelineBody.scrollTop;
        
        let svg = document.getElementById('ganttSvgOverlay');
        if (!svg) return;
        
        let tempPath = document.getElementById('tempDragPath');
        if (!tempPath) {
          tempPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          tempPath.setAttribute('id', 'tempDragPath');
          tempPath.setAttribute('fill', 'none');
          tempPath.setAttribute('stroke', 'var(--accent, #2563eb)');
          tempPath.setAttribute('stroke-width', '2');
          tempPath.setAttribute('stroke-dasharray', '4,4');
          tempPath.setAttribute('marker-end', 'url(#arrowhead-active)');
          svg.appendChild(tempPath);
        }
        
        tempPath.setAttribute('d', `M ${dragStartX} ${dragStartY} L ${dragStartX} ${dragStartY}`);
        tempPath.style.display = 'block';
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDraggingLink) return;
        
        const tempPath = document.getElementById('tempDragPath');
        const svg = document.getElementById('ganttSvgOverlay');
        if (!tempPath || !svg) return;
        
        const svgRect = svg.getBoundingClientRect();
        const mouseX = e.clientX - svgRect.left + timelineBody.scrollLeft;
        const mouseY = e.clientY - svgRect.top + timelineBody.scrollTop;
        
        tempPath.setAttribute('d', `M ${dragStartX} ${dragStartY} L ${mouseX} ${mouseY}`);
      });
      
      document.addEventListener('mouseup', (e) => {
        if (!isDraggingLink) return;
        isDraggingLink = false;
        
        const tempPath = document.getElementById('tempDragPath');
        if (tempPath) tempPath.style.display = 'none';
        
        const targetHandle = document.elementFromPoint(e.clientX, e.clientY)?.closest('.gantt-bar-handle');
        const targetBar = targetHandle ? null : document.elementFromPoint(e.clientX, e.clientY)?.closest('.gantt-bar-wrapper');
        
        let targetIndex = null;
        let targetType = 'start';
        
        if (targetHandle) {
          targetIndex = parseInt(targetHandle.dataset.index, 10);
          targetType = targetHandle.dataset.type;
        } else if (targetBar) {
          const leftHandle = targetBar.querySelector('.handle-left');
          if (leftHandle) {
            targetIndex = parseInt(leftHandle.dataset.index, 10);
          }
        }
        
        if (targetIndex !== null && targetIndex !== linkSourceIndex) {
          showGanttLinkTypeModal(linkSourceIndex, targetIndex, linkSourceType, targetType);
        }
      });
    }
    
    function showGanttLinkTypeModal(predIndex, succIndex, sourceType, targetType) {
      pendingLinkPredecessorIndex = predIndex;
      pendingLinkSuccessorIndex = succIndex;
      
      const predRow = boqData[predIndex];
      const succRow = boqData[succIndex];
      if (!predRow || !succRow) return;
      
      const predCode = predRow.code || `Row ${predIndex + 1}`;
      const succCode = succRow.code || `Row ${succIndex + 1}`;
      
      const predDisplay = document.getElementById('ganttLinkPredCode');
      const succDisplay = document.getElementById('ganttLinkSuccCode');
      if (predDisplay) predDisplay.textContent = predCode;
      if (succDisplay) succDisplay.textContent = succCode;
      
      let defaultType = 'FS';
      if (sourceType === 'finish' && targetType === 'start') defaultType = 'FS';
      else if (sourceType === 'start' && targetType === 'start') defaultType = 'SS';
      else if (sourceType === 'finish' && targetType === 'finish') defaultType = 'FF';
      else if (sourceType === 'start' && targetType === 'finish') defaultType = 'SF';
      
      const radio = document.querySelector(`input[name="ganttLinkType"][value="${defaultType}"]`);
      if (radio) radio.checked = true;
      
      const modal = document.getElementById('ganttLinkModal');
      if (modal) modal.style.display = 'flex';
    }
    
    function closeGanttLinkModal() {
      const modal = document.getElementById('ganttLinkModal');
      if (modal) modal.style.display = 'none';
      const lagInput = document.getElementById('ganttLinkLabelLag');
      if (lagInput) lagInput.value = '0';
      pendingLinkPredecessorIndex = null;
      pendingLinkSuccessorIndex = null;
    }
    
    function saveGanttLink() {
      if (pendingLinkPredecessorIndex === null || pendingLinkSuccessorIndex === null) return;
      
      const predRow = boqData[pendingLinkPredecessorIndex];
      const succRow = boqData[pendingLinkSuccessorIndex];
      if (!predRow || !succRow) return;
      
      pushGanttUndoState();
      
      const lagInput = document.getElementById('ganttLinkLabelLag');
      const lagValue = parseInt(lagInput ? lagInput.value : '0', 10) || 0;
      
      const predRef = (pendingLinkPredecessorIndex + 1).toString();
      const selectedRadio = document.querySelector('input[name="ganttLinkType"]:checked');
      const linkType = selectedRadio ? selectedRadio.value : 'FS';
      
      let currentPreds = (succRow.ganttPredecessors || '').trim();
      
      let suffix = linkType === 'FS' ? '' : linkType;
      let lagStr = '';
      if (lagValue > 0) {
        lagStr = '+' + lagValue;
      } else if (lagValue < 0) {
        lagStr = lagValue.toString();
      }
      const newEntry = predRef + suffix + lagStr;
      
      if (currentPreds === '') {
        currentPreds = newEntry;
      } else {
        const existingList = currentPreds.split(',').map(s => s.trim().toUpperCase());
        if (!existingList.includes(newEntry.toUpperCase())) {
          currentPreds += ', ' + newEntry;
        }
      }
      
      succRow.ganttPredecessors = currentPreds;
      
      closeGanttLinkModal();
      markUnsaved();
      renderGanttChart();
    }

    function initGanttSettings() {
      try {
        const saved = JSON.parse(localStorage.getItem('cost_estimate_gantt_settings_v1'));
        if (saved && typeof saved === 'object') {
          ganttSettings = { ...DEFAULT_GANTT_SETTINGS, ...saved };
        } else {
          ganttSettings = JSON.parse(JSON.stringify(DEFAULT_GANTT_SETTINGS));
        }
      } catch (e) {
        ganttSettings = JSON.parse(JSON.stringify(DEFAULT_GANTT_SETTINGS));
      }
      if (ganttSettings.ganttHighlightMode === undefined) {
        ganttSettings.ganttHighlightMode = 'yellow';
      }
      applyGanttSettingsStyles();
      updateHighlightBtnLabels();
    }

    function updateHighlightBtnLabels() {
      const mode = ganttSettings.ganttHighlightMode || 'yellow';
      const labels = {
        'none': 'Row Highlight: Off',
        'yellow': 'Row Highlight: Yellow',
        'blue': 'Row Highlight: Blue',
        'green': 'Row Highlight: Green',
        'orange': 'Row Highlight: Orange'
      };
      const gBtn = document.getElementById('ganttHighlightRowBtn');
      if (gBtn) gBtn.innerHTML = `${labels[mode] || 'Row Highlight'} <span style="font-size: 9px; vertical-align: middle; line-height: 1;">▼</span>`;
      const qBtn = document.getElementById('qtyHighlightRowBtn');
      if (qBtn) qBtn.innerHTML = `${labels[mode] || 'Row Highlight'} <span style="font-size: 9px; vertical-align: middle; line-height: 1;">▼</span>`;
    }

    function saveGanttSettings() {
      localStorage.setItem('cost_estimate_gantt_settings_v1', JSON.stringify(ganttSettings));
      applyGanttSettingsStyles();
    }

    function applyGanttSettingsStyles() {
      let styleTag = document.getElementById('ganttDynamicStyles');
      if (!styleTag) {
        styleTag = document.createElement('style');
        styleTag.id = 'ganttDynamicStyles';
        document.head.appendChild(styleTag);
      }
      
      const rWeight = ganttSettings.gridRowWeight !== undefined ? ganttSettings.gridRowWeight : 1;
      const rStyle = ganttSettings.gridRowStyle || 'solid';
      const rColor = ganttSettings.gridRowColor || '#e2e8f0';
      
      const cWeight = ganttSettings.gridColWeight !== undefined ? ganttSettings.gridColWeight : 1;
      const cStyle = ganttSettings.gridColStyle || 'solid';
      const cColor = ganttSettings.gridColColor || '#e2e8f0';
      
      const oWeight = ganttSettings.gridOuterWeight !== undefined ? ganttSettings.gridOuterWeight : 1;
      const oStyle = ganttSettings.gridOuterStyle || 'solid';
      const oColor = ganttSettings.gridOuterColor || '#cbd5e1';
      
      const crvWeight = ganttSettings.gridCurveWeight !== undefined ? ganttSettings.gridCurveWeight : 1;
      const crvStyle = ganttSettings.gridCurveStyle || 'solid';
      const crvColor = ganttSettings.gridCurveColor || '#cbd5e1';

      const coordHeaderHeight = ganttSettings.coordHeaderHeight !== undefined ? ganttSettings.coordHeaderHeight : 24;
      const coordHeaderBg = ganttSettings.coordHeaderBg || '#1e3a8a';
      const coordHeaderColor = ganttSettings.coordHeaderColor || '#ffffff';

      const hHeight = ganttSettings.headerHeight !== undefined ? ganttSettings.headerHeight : 48;
      const hTopHeight = Math.floor(hHeight / 2);
      const hBottomHeight = hHeight - hTopHeight;
      const hTotalHeight = hTopHeight + hBottomHeight + (ganttSettings.showCoordinates ? coordHeaderHeight : 0);
      const hFontSize = ganttSettings.headerFontSize !== undefined ? ganttSettings.headerFontSize : 11;
      const hLeftBg = ganttSettings.headerLeftBg || '#2563eb';
      const hLeftColor = ganttSettings.headerLeftColor || '#ffffff';
      const hRightBg = ganttSettings.headerRightBg || '#ffffff';
      const hRightColor = ganttSettings.headerRightColor || '#1f2937';

      const hlWeight = ganttSettings.gridHeaderLeftWeight !== undefined ? ganttSettings.gridHeaderLeftWeight : 1;
      const hlStyle = ganttSettings.gridHeaderLeftStyle || 'solid';
      const hlColor = ganttSettings.gridHeaderLeftColor || '#cbd5e1';
      
      const hrWeight = ganttSettings.gridHeaderRightWeight !== undefined ? ganttSettings.gridHeaderRightWeight : 1;
      const hrStyle = ganttSettings.gridHeaderRightStyle || 'solid';
      const hrColor = ganttSettings.gridHeaderRightColor || '#e2e8f0';

      const coordRowBg = ganttSettings.coordRowBg || '#f3f4f6';
      const coordRowColor = ganttSettings.coordRowColor || '#6b7280';

      styleTag.innerHTML = `
        .gantt-row, .gantt-row td {
          height: ${ganttSettings.rowHeight}px !important;
          line-height: 1.3 !important;
          box-sizing: border-box !important;
        }
        .gantt-timeline-row {
          height: ${ganttSettings.rowHeight}px !important;
          line-height: ${ganttSettings.rowHeight}px !important;
          box-sizing: border-box !important;
          display: flex !important;
          flex-wrap: nowrap !important;
          min-width: 100% !important;
        }
        .gantt-row td {
          padding-top: 0 !important;
          padding-bottom: 0 !important;
          vertical-align: middle !important;
        }
        .gantt-row td input {
          height: ${ganttSettings.rowHeight - 6}px !important;
          line-height: ${ganttSettings.rowHeight - 6}px !important;
          box-sizing: border-box !important;
          margin: 0 !important;
          vertical-align: middle !important;
        }
        #qtyTaskTable tbody tr {
          height: ${ganttSettings.rowHeight}px !important;
        }
        #qtyTaskTable tbody td {
          height: ${ganttSettings.rowHeight}px !important;
          padding: 0 4px !important;
          box-sizing: border-box !important;
          overflow: hidden !important;
          vertical-align: middle !important;
        }
        #qtyTimelineBody .gantt-timeline-row {
          height: ${ganttSettings.rowHeight}px !important;
          box-sizing: border-box !important;
          display: flex !important;
          align-items: center !important;
          flex-wrap: nowrap !important;
          min-width: 100% !important;
        }
        #qtyTaskTable tbody td input[type="date"],
        #qtyTaskTable tbody td input[type="number"],
        #qtyTaskTable tbody td input[type="text"]:not(.qty-summary-input) {
          height: ${ganttSettings.rowHeight - 6}px !important;
          line-height: normal !important;
          padding: 0 4px !important;
          margin: 0 !important;
          box-sizing: border-box !important;
        }
        /* Hide spin buttons for numeric inputs in schedule tables */
        .gantt-row td input[type=number]::-webkit-outer-spin-button,
        .gantt-row td input[type=number]::-webkit-inner-spin-button,
        #qtyTaskTable td input[type=number]::-webkit-outer-spin-button,
        #qtyTaskTable td input[type=number]::-webkit-inner-spin-button,
        .qty-period-input::-webkit-outer-spin-button,
        .qty-period-input::-webkit-inner-spin-button {
          -webkit-appearance: none !important;
          margin: 0 !important;
        }
        .gantt-row td input[type=number],
        #qtyTaskTable td input[type=number],
        .qty-period-input {
          -moz-appearance: textfield !important;
        }
        .gantt-bar-cost {
          height: ${ganttSettings.taskBarHeight}px !important;
          background: ${ganttSettings.taskBarColor} !important;
        }
        .gantt-bar-day {
          height: ${ganttSettings.taskBarHeight}px !important;
          background: ${ganttSettings.taskBarDayColor} !important;
        }
        .gantt-summary-bar-cost {
          background: ${ganttSettings.summaryBarColor} !important;
        }
        .gantt-summary-bar-day {
          background: ${ganttSettings.summaryBarDayColor} !important;
        }
        .gantt-bar-bg-task {
          background: ${ganttSettings.taskBarBgColor || '#e5e7eb'} !important;
        }
        .gantt-summary-bar-bg {
          background: ${ganttSettings.summaryBarBgColor || '#9ca3af'} !important;
        }
        .gantt-bar-actual {
          height: ${ganttSettings.taskBarHeight}px !important;
          background: ${ganttSettings.taskBarActualColor || '#f59e0b'} !important;
        }
        .gantt-summary-bar-actual {
          background: ${ganttSettings.summaryBarActualColor || '#b45309'} !important;
        }
        .gantt-bar-bg-actual {
          background: ${ganttSettings.taskBarActualBgColor || '#e5e7eb'} !important;
        }
        .gantt-summary-bar-bg-actual {
          background: ${ganttSettings.summaryBarActualBgColor || '#9ca3af'} !important;
        }
        
        #ganttTaskTable tbody tr, #ganttTaskTable td, #qtyTaskTable tbody tr, #qtyTaskTable td, .gantt-timeline-row, .qty-period-cell {
          border-bottom: ${rWeight}px ${rStyle} ${rColor} !important;
        }
        .gantt-timeline-header-row {
          border-bottom: none !important;
        }
        
        /* Column Grid (Inside Vertical) */
        #ganttTaskTable td:not(:last-child), #ganttTaskTable th:not(:last-child), #qtyTaskTable td:not(:last-child), #qtyTaskTable th:not(:last-child), .gantt-header-cell, .qty-period-cell {
          border-right: ${cWeight}px ${cStyle} ${cColor} !important;
        }
        
        /* % Curve Column Boundary Gridline */
        .gantt-curve-cell {
          border-left: ${crvWeight}px ${crvStyle} ${crvColor} !important;
          border-right: ${crvWeight}px ${crvStyle} ${crvColor} !important;
          box-sizing: border-box !important;
        }
        
        /* Outer Border */
        .gantt-container {
          border: ${oWeight}px ${oStyle} ${oColor} !important;
        }
        
        .qty-period-cell {
          height: ${ganttSettings.rowHeight}px !important;
        }
        
        .gantt-row-highlighted, .gantt-row-highlighted td, .gantt-row-highlighted div:not(.gantt-bar-day):not(.gantt-bar-cost):not(.gantt-bar-actual):not(.gantt-bar-bg-task):not(.gantt-bar-bg-actual):not(.gantt-bar-wrapper) {
          background-color: ${getHighlightColorValue(ganttSettings.ganttHighlightMode)} !important;
        }
        .qty-row-highlighted, .qty-row-highlighted td, .qty-row-highlighted div:not(.qty-period-input) {
          background-color: ${getHighlightColorValue(ganttSettings.ganttHighlightMode)} !important;
        }
        .gantt-row-highlighted input {
          background-color: transparent !important;
        }
        .qty-row-highlighted input {
          background-color: transparent !important;
        }

        /* Headers Height and Fonts */
        #ganttTaskTable thead tr:not(.gantt-coord-header-row), #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          height: ${hHeight}px !important;
          box-sizing: border-box !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          padding-top: 0 !important;
          padding-bottom: 0 !important;
          line-height: ${hHeight}px !important;
          vertical-align: middle !important;
          white-space: nowrap !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
        }
        #ganttTimelineHeader, #qtyTimelineHeader {
          height: ${hTotalHeight}px !important;
          box-sizing: border-box !important;
          border-bottom: none !important;
        }
        .gantt-timeline-header-row.row-top {
          height: ${hTopHeight}px !important;
          line-height: ${hTopHeight}px !important;
          box-sizing: border-box !important;
        }
        .gantt-timeline-header-row.row-bottom {
          height: ${hBottomHeight}px !important;
          line-height: ${hBottomHeight}px !important;
          box-sizing: border-box !important;
        }
        .gantt-header-cell {
          height: 100% !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th, .gantt-header-cell {
          font-size: ${hFontSize}px !important;
        }
        
        /* Left Header Colors */
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) {
          background: ${hLeftBg} !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          color: ${hLeftColor} !important;
        }
        
        /* Right Header Colors */
        #ganttTimelineHeader, .gantt-timeline-header-row {
          background: ${hRightBg} !important;
        }
        .gantt-header-cell {
          color: ${hRightColor} !important;
          background: ${hRightBg};
        }

        #ganttTaskTable thead th,
        #qtyTaskTable thead th {
          border: none !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th,
        #qtyTaskTable thead tr:not(.gantt-coord-header-row) th {
          border-bottom: ${hrWeight}px ${hrStyle} ${hrColor} !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th:not(:last-child),
        #qtyTaskTable thead tr:not(.gantt-coord-header-row) th:not(:last-child) {
          border-right: ${hlWeight}px ${hlStyle} ${hlColor} !important;
        }
        
        /* Right Header Gridlines */
        .gantt-header-cell {
          border-bottom: ${hrWeight}px ${hrStyle} ${hrColor} !important;
          border-right: ${hrWeight}px ${hrStyle} ${hrColor} !important;
        }

        /* Coordinates Styling */
        #ganttTaskTable thead tr.gantt-coord-header-row,
        #qtyTaskTable thead tr.gantt-coord-header-row {
          background: ${coordHeaderBg} !important;
          height: ${coordHeaderHeight}px !important;
          box-sizing: border-box !important;
        }
        #ganttTaskTable thead tr.gantt-coord-header-row th,
        #qtyTaskTable thead tr.gantt-coord-header-row th {
          height: ${coordHeaderHeight}px !important;
          line-height: ${coordHeaderHeight}px !important;
          color: ${coordHeaderColor} !important;
          font-size: 10px !important;
          font-weight: bold !important;
          text-align: center !important;
          padding: 0 !important;
          border-bottom: ${hrWeight}px ${hrStyle} ${hrColor} !important;
          border-right: ${hrWeight}px ${hrStyle} ${hrColor} !important;
          box-sizing: border-box !important;
        }

        /* Sticky headers positioning to prevent overlap/misalignment when coordHeaderHeight changes */
        #ganttTaskTable thead tr.gantt-coord-header-row th,
        #qtyTaskTable thead tr.gantt-coord-header-row th {
          position: sticky !important;
          top: 0 !important;
          z-index: 12 !important;
        }
        #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          position: sticky !important;
          top: ${ganttSettings.showCoordinates ? coordHeaderHeight : 0}px !important;
          z-index: 11 !important;
        }
        #qtyTaskTable thead th {
          padding: 0 4px !important;
          box-sizing: border-box !important;
          height: 24px !important;
          line-height: 24px !important;
        }
        #qtyTaskTable thead tr.gantt-coord-header-row th {
          height: ${coordHeaderHeight}px !important;
          line-height: ${coordHeaderHeight}px !important;
          padding: 0 !important;
        }
        #qtyTaskTable thead tr:nth-child(${ganttSettings.showCoordinates ? 2 : 1}) th {
          position: sticky !important;
          top: ${ganttSettings.showCoordinates ? coordHeaderHeight : 0}px !important;
          z-index: 11 !important;
        }
        #qtyTaskTable thead tr:nth-child(${ganttSettings.showCoordinates ? 3 : 2}) th {
          position: sticky !important;
          top: ${ganttSettings.showCoordinates ? coordHeaderHeight + 24 : 24}px !important;
          z-index: 10 !important;
        }
        #ganttTaskTable td.gantt-coord-cell,
        #qtyTaskTable td.gantt-coord-cell {
          background: ${coordRowBg} !important;
          color: ${coordRowColor} !important;
          text-align: center !important;
          font-weight: bold !important;
          font-size: 10px !important;
          padding: 0 !important;
          border-right: 1px solid var(--line) !important;
          border-bottom: 1px solid var(--line) !important;
          box-sizing: border-box !important;
        }
        
        /* Hide coordinates on print */
        body.print-gantt-pdf .gantt-coord-header-row,
        body.print-gantt-pdf .gantt-coord-cell,
        body.print-gantt-pdf .gantt-coord-th,
        body.print-gantt-pdf .gantt-timeline-header-row.row-coord {
          display: none !important;
        }

        .gantt-timeline-header-row.row-coord {
          height: ${coordHeaderHeight}px !important;
          line-height: ${coordHeaderHeight}px !important;
          background: ${coordHeaderBg} !important;
          display: flex !important;
          box-sizing: border-box !important;
        }
        .gantt-timeline-header-row.row-coord .gantt-header-cell {
          height: ${coordHeaderHeight}px !important;
          line-height: ${coordHeaderHeight}px !important;
          color: ${coordHeaderColor} !important;
          font-size: 10px !important;
          font-weight: bold !important;
          background: ${coordHeaderBg} !important;
          border-bottom: ${hrWeight}px ${hrStyle} ${hrColor} !important;
          border-right: ${hrWeight}px ${hrStyle} ${hrColor} !important;
          box-sizing: border-box !important;
        }
      `;
    }

    function openGanttStyleSettingsModal() {
      const modal = document.getElementById('ganttStyleSettingsModal');
      if (!modal) return;
      
      document.getElementById('ganttSetRowHeight').value = ganttSettings.rowHeight;
      document.getElementById('ganttSetTaskBarHeight').value = ganttSettings.taskBarHeight;
      document.getElementById('ganttSetSummaryBarHeight').value = ganttSettings.summaryBarHeight;
      document.getElementById('ganttSetTaskColor').value = ganttSettings.taskBarColor;
      document.getElementById('ganttSetTaskDayColor').value = ganttSettings.taskBarDayColor;
      document.getElementById('ganttSetSummaryColor').value = ganttSettings.summaryBarColor;
      document.getElementById('ganttSetSummaryDayColor').value = ganttSettings.summaryBarDayColor;
      document.getElementById('ganttSetTaskBgColor').value = ganttSettings.taskBarBgColor || '#e5e7eb';
      document.getElementById('ganttSetSummaryBgColor').value = ganttSettings.summaryBarBgColor || '#9ca3af';
      
      document.getElementById('ganttSetTaskActualColor').value = ganttSettings.taskBarActualColor || '#f59e0b';
      document.getElementById('ganttSetSummaryActualColor').value = ganttSettings.summaryBarActualColor || '#b45309';
      document.getElementById('ganttSetTaskActualBgColor').value = ganttSettings.taskBarActualBgColor || '#e5e7eb';
      document.getElementById('ganttSetSummaryActualBgColor').value = ganttSettings.summaryBarActualBgColor || '#9ca3af';
      document.getElementById('ganttSetBarArrangement').value = ganttSettings.barArrangement || 'planned_actual';
      document.getElementById('ganttSetBarVerticalAlign').value = ganttSettings.barVerticalAlign || 'middle';
      document.getElementById('ganttSetBarGap').value = ganttSettings.barGap !== undefined ? ganttSettings.barGap : 2;
      document.getElementById('ganttSetShowCostLabel').checked = ganttSettings.showCostLabel !== false;
      document.getElementById('ganttSetShowDayLabel').checked = ganttSettings.showDayLabel !== false;
      document.getElementById('ganttSetShowActualLabel').checked = ganttSettings.showActualLabel !== false;
      document.getElementById('ganttSetBarLabelLocation').value = ganttSettings.barLabelLocation || 'right';
      document.getElementById('ganttSetBarLabelScope').value = ganttSettings.barLabelScope || 'all';
      document.getElementById('ganttSetBarLabelSize').value = ganttSettings.barLabelSize !== undefined ? ganttSettings.barLabelSize : 8;
