      font-weight: 500 !important;
    }

    @media print {
      body.print-cover-proposal,
      body.print-cover-proposal .cover-letter-page,
      body.print-cover-proposal .cover-letter-page input,
      body.print-cover-proposal .cover-letter-page textarea,
      body.print-cover-proposal .cover-letter-body [contenteditable="true"],
      body.print-cover-proposal table,
      body.print-cover-proposal th,
      body.print-cover-proposal td {
        font-family: Arial, Helvetica, sans-serif !important;
        font-weight: 400;
      }
      body.print-cover-proposal strong,
      body.print-cover-proposal b,
      body.print-cover-proposal h1,
      body.print-cover-proposal h2,
      body.print-cover-proposal h3,
      body.print-cover-proposal .cover-letter-section-title,
      body.print-cover-proposal .cover-letter-meta label,
      body.print-cover-proposal .cover-letter-terms label,
      body.print-cover-proposal .cover-meta-label,
      body.print-cover-proposal .cover-meta-text,
      body.print-cover-proposal .cover-meta-colon,
      body.print-cover-proposal .proposal-amount-box,
      body.print-cover-proposal thead th {
        font-weight: 500 !important;
        letter-spacing: 0.01em;
      }
    }

    

    /* FINAL BOQ PDF FIX: clean single print value, top-flushed, no hidden duplicate text */
    @media print {
      body.print-boq-pdf #boqTable tbody td,
      body.print-boq-pdf #boqSummaryTable tbody td {
        vertical-align: top !important;
        padding-top: 2mm !important;
        padding-bottom: 2mm !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        line-height: 1.35 !important;
      }
      body.print-boq-pdf #boqTable tbody td > :not(.boq-print-wrapped-text),
      body.print-boq-pdf #boqSummaryTable tbody td > :not(.boq-print-wrapped-text) {
        display: none !important;
        visibility: hidden !important;
      }
      body.print-boq-pdf #boqTable tbody td .boq-print-wrapped-text,
      body.print-boq-pdf #boqSummaryTable tbody td .boq-print-wrapped-text {
        display: block !important;
        visibility: visible !important;
        position: static !important;
        float: none !important;
        transform: none !important;
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        line-height: 1.35 !important;
        white-space: pre-wrap !important;
        word-break: normal !important;
        overflow-wrap: anywhere !important;
        overflow: visible !important;
        text-align: inherit !important;
        vertical-align: top !important;
      }
      body.print-boq-pdf #boqTable tbody td:nth-child(4) .boq-print-wrapped-text {
        display: block !important;
        vertical-align: top !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
      }
    }
    </style>`;
      let attachmentsHtml = '';
      if (Array.isArray(coverAttachments) && coverAttachments.length > 0) {
        let annexIdx = 0;
        coverAttachments.forEach(att => {
          const annexLetter = String.fromCharCode(65 + (annexIdx % 26));
          annexIdx++;
          const pages = (Array.isArray(att.pages) && att.pages.length > 0)
            ? att.pages
            : [{ pageNum: 1, totalPages: 1, orientation: att.orientation || 'portrait', dataUrl: att.dataUrl }];

          pages.forEach(page => {
            const isLandscape = page.orientation === 'landscape';
            const displayTitle = att.caption || att.name.replace(/\.[^/.]+$/, '').replace(/[-_]+/g, ' ');
            attachmentsHtml += `
              <br clear="all" style="mso-special-character:line-break; page-break-before:always">
              <div class="word-attachment-page" style="page-break-before:always; padding: 20px; font-family: Arial, sans-serif;">
                <div style="border-bottom: 2px solid #0f2744; padding-bottom: 8px; margin-bottom: 12px; display: flex; justify-content: space-between;">
                  <span style="font-weight: bold; color: #0f2744; font-size: 11pt;">ANNEX ${annexLetter}: ${escapeHtml(displayTitle)}${pages.length > 1 ? ` (Page ${page.pageNum} of ${pages.length})` : ''}</span>
                  <span style="font-size: 9pt; color: #64748b;">${escapeHtml(att.name)}</span>
                </div>
                <div style="text-align: center; margin: 20px 0;">
                  ${page.dataUrl && page.dataUrl.startsWith('data:image') ? `<img src="${page.dataUrl}" style="max-width: 100%; max-height: ${isLandscape ? '5.5in' : '7.5in'}; object-fit: contain;">` : `<p style="color:#64748b;">[Attached Document: ${escapeHtml(att.name)}]</p>`}
                </div>
                <div style="border-top: 1px solid #cbd5e1; padding-top: 6px; margin-top: 12px; font-size: 8pt; color: #64748b; display: flex; justify-content: space-between;">
                  <span>CONFIDENTIAL &bull; ATTACHMENT ANNEX</span>
                  <span>${escapeHtml(att.name)} (${escapeHtml(att.size)})</span>
                </div>
              </div>
            `;
          });
        });
      }
      const html = `<!DOCTYPE html><html><head><meta charset="utf-8">${styles}</head><body>${proposalHtml}${attachmentsHtml}</body></html>`;
      const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${safeName}_Cost_Proposal.doc`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function cleanupLegacyCoverLetterText() {
      const bad = /respectfully\s+submitted,?/gi;
      document.querySelectorAll('.cover-letter-page, .cover-letter-body, .cover-letter-signatures').forEach(scope => {
        scope.querySelectorAll('*').forEach(el => {
          if (el.children.length === 0 && bad.test(el.textContent || '')) {
            el.textContent = (el.textContent || '').replace(bad, '').trim();
          }
        });
      });
      try {
        Object.keys(localStorage).forEach(key => {
          const value = localStorage.getItem(key);
          if (value && bad.test(value)) localStorage.setItem(key, value.replace(bad, ''));
        });
      } catch (e) {}
    }
    document.addEventListener('DOMContentLoaded', cleanupLegacyCoverLetterText);

    function escapeHtml(value) { return String(value ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    function escapeAttr(value) { return escapeHtml(value); }

    function updateHeaderSaveButtons(sheetId) {
      const buttonMap = {
        priceListSheet: ['savePriceListBtn', 'exportPriceListJsonBtn', 'loadPriceListJsonBtn', 'exportPriceListExcelBtn', 'loadPriceListExcelBtn', 'exportPriceListFormattedExcelBtn', 'versionHistoryBtn'],
        estimateSheet: ['saveDUPABtn', 'exportDUPAJsonBtn', 'loadDUPAJsonBtn', 'exportDUPAExcelBtn', 'loadDUPAExcelBtn', 'exportDUPAFormattedExcelBtn', 'versionHistoryBtn'],
        boqSheet: ['saveBOQBtn', 'exportBOQJsonBtn', 'loadBOQJsonBtn', 'exportBOQExcelBtn', 'loadBOQExcelBtn', 'exportBOQFormattedExcelBtn', 'printBOQPdfBtn', 'versionHistoryBtn'],
        boqSummarySheet: ['saveBOQBtn', 'exportBOQJsonBtn', 'loadBOQJsonBtn', 'exportBOQExcelBtn', 'loadBOQExcelBtn', 'exportBOQFormattedExcelBtn', 'printBOQPdfBtn', 'versionHistoryBtn'],
        ganttSheet: ['saveBOQBtn', 'publishGanttBtn', 'lookaheadBtn', 'exportBOQJsonBtn', 'loadBOQJsonBtn', 'versionHistoryBtn'],
        coverLetterSheet: ['saveCoverLetterBtn', 'exportCoverJsonBtn', 'loadCoverJsonBtn', 'printCoverPdfBtn', 'wordCoverBtn', 'versionHistoryBtn']
      };
      document.querySelectorAll('.header-save-btn, .header-json-btn, .header-excel-btn, .header-proposal-action').forEach(button => button.classList.remove('active-save'));
      (buttonMap[sheetId] || []).forEach(id => {
        const activeButton = document.getElementById(id);
        if (activeButton) activeButton.classList.add('active-save');
      });
    }

    function togglePublishDropdown(event) {
      event.stopPropagation();
      const menu = document.getElementById('publishDropdownMenu');
      if (menu) {
        menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
      }
    }
    
    document.addEventListener('click', (e) => {
      const menu = document.getElementById('publishDropdownMenu');
      if (menu && menu.style.display === 'block') {
        const btn = document.getElementById('publishGanttBtn');
        if (btn && e.target !== btn && !btn.contains(e.target) && !menu.contains(e.target)) {
          menu.style.display = 'none';
        }
      }
    });

    function showSheet(sheetId) {
      document.querySelectorAll('.sheet').forEach(sheet => sheet.classList.remove('active'));
      document.getElementById(sheetId).classList.add('active');
      document.getElementById('navPriceList').classList.toggle('active', sheetId === 'priceListSheet');
      document.getElementById('navEstimate').classList.toggle('active', sheetId === 'estimateSheet');
      document.getElementById('navBoq').classList.toggle('active', sheetId === 'boqSheet');
      const navBoqSummary = document.getElementById('navBoqSummary');
      if (navBoqSummary) navBoqSummary.classList.toggle('active', sheetId === 'boqSummarySheet');
      const navGantt = document.getElementById('navGantt');
      if (navGantt) navGantt.classList.toggle('active', sheetId === 'ganttSheet');
      const navCoverLetter = document.getElementById('navCoverLetter');
      if (navCoverLetter) navCoverLetter.classList.toggle('active', sheetId === 'coverLetterSheet');
      if (sheetId === 'boqSummarySheet') renderBOQSummaryTable();
      if (sheetId === 'boqSheet') {
        resizeAllBOQSpecificationTextareas();
        setTimeout(resizeAllBOQSpecificationTextareas, 50);
      }
      if (sheetId === 'coverLetterSheet') renderCoverLetter();
      updateHeaderSaveButtons(sheetId);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function levelOf(rowOrType) {
      if (!rowOrType) return 4;
      let type = '';
      let code = '';
      if (typeof rowOrType === 'object') {
        type = rowOrType.type || '';
        code = rowOrType.code || rowOrType.itemCode || '';
      } else if (typeof rowOrType === 'string') {
        if (rowOrType.includes('.')) {
          code = rowOrType;
        } else {
          type = rowOrType;
        }
      }

      const normalizedType = String(type || '').trim().toLowerCase();
      if (normalizedType === 'category') return 1;
      if (normalizedType === 'subcategory') return 2;
      if (normalizedType === 'subsubcategory') return 3;
      if (normalizedType === 'subsubsubcategory' || normalizedType === 'material' || normalizedType === 'item') return 4;

      if (code) {
        const parts = String(code).split('.').map(s => s.trim());
        if (parts.length === 4 && parts.every(p => /^\d+$/.test(p))) {
          const nonZero = parts.filter(p => p !== '00' && p !== '0');
          if (nonZero.length === 1) return 1;
          if (nonZero.length === 2) return 2;
          if (nonZero.length === 3) return 3;
          if (nonZero.length >= 4) return 4;
        }
      }

      return 4;
    }
    function hasChildRow(rows, index) { if (index < 0 || index >= rows.length - 1) return false; return levelOf(rows[index + 1]) > levelOf(rows[index]); }
    function findInsertIndex(rows, parentIndex) { const parentLevel = levelOf(rows[parentIndex]); let i = parentIndex + 1; while (i < rows.length && levelOf(rows[i]) > parentLevel) i++; return i; }
    function shouldHideHierarchyRow(rows, index) {
      const row = rows[index];
      if (!row) return false;

      let parentIndex = getParentRowIndex(rows, index);
      while (parentIndex !== -1) {
        if (rows[parentIndex].collapsed) {
          return true;
        }
        parentIndex = getParentRowIndex(rows, parentIndex);
      }
      return false;
    }

    function getBOQCategoryBlockBounds(index) {
      if (index < 0 || index >= boqData.length || boqData[index].type !== 'category') return null;
      let end = index + 1;
      while (end < boqData.length && boqData[end].type !== 'category') end += 1;
      return { start: index, end: end };
    }

    function getBOQCategoryBlock(index) {
      const bounds = getBOQCategoryBlockBounds(index);
      if (!bounds) return [];
      return boqData.slice(bounds.start, bounds.end);
    }

    function removeBOQCategoryBlock(index) {
      const bounds = getBOQCategoryBlockBounds(index);
      if (!bounds) return [];
      return boqData.splice(bounds.start, bounds.end - bounds.start);
    }

    function insertBOQCategoryBlockAtTop(block) {
      boqData.unshift(...block);
    }

    function moveBOQCategoryBlockToTop(index) {
      const block = removeBOQCategoryBlock(index);
      if (!block.length) return;
      insertBOQCategoryBlockAtTop(block);
    }

    function findBOQCategoryIndexByTitle(title) {
      const normalized = String(title || '').trim().toLowerCase();
      if (!normalized) return -1;
      return boqData.findIndex(row => row.type === 'category' && String(row.title || '').trim().toLowerCase() === normalized);
    }

    function isBlankBOQCategoryBlock(index) {
      if (index < 0 || index >= boqData.length) return false;
      const row = boqData[index];
      if (!row || row.type !== 'category') return false;
      const bounds = getBOQCategoryBlockBounds(index);
      if (!bounds) return false;
      return !String(row.title || '').trim() && bounds.end === index + 1;
    }

    function createBOQCategoryRow(name = '') {
      return { type: 'category', title: name || '', specification: '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' };
    }

    function addBOQCategoryRowAtTop(name = '') {
      markUnsaved();
      const existingIndex = findBOQCategoryIndexByTitle(name);
      if (existingIndex >= 0) {
        moveBOQCategoryBlockToTop(existingIndex);
      } else {
        insertBOQCategoryBlockAtTop([createBOQCategoryRow(name)]);
      }
      recomputeCodes(boqData);
      renderBOQTable();
    }

    function updateBOQCategorySelection(index, value) {
      if (value === '__manage_categories__') {
        renderBOQTable();
        openManageCategoriesModal();
        return;
      }
      markUnsaved();
      const selected = String(value || '').trim();
      if (boqData[index]) {
        boqData[index].title = selected;
      }
      recomputeCodes(boqData);
      renderBOQTable();
    }

    function recomputeCodes(rows) {
      let cat = 0, sub = 0, subsub = 0, subsubsub = 0;
      rows.forEach(row => {
        if (row.type === 'category') { cat += 1; sub = 0; subsub = 0; subsubsub = 0; row.code = `${String(cat).padStart(2,'0')}.00.00.00`; }
        else if (row.type === 'subcategory') { sub += 1; subsub = 0; subsubsub = 0; row.code = `${String(cat).padStart(2,'0')}.${String(sub).padStart(2,'0')}.00.00`; }
        else if (row.type === 'subsubcategory') { subsub += 1; subsubsub = 0; row.code = `${String(cat).padStart(2,'0')}.${String(sub).padStart(2,'0')}.${String(subsub).padStart(2,'0')}.00`; }
        else { subsubsub += 1; row.code = `${String(cat).padStart(2,'0')}.${String(sub).padStart(2,'0')}.${String(subsub).padStart(2,'0')}.${String(subsubsub).padStart(2,'0')}`; }
      });
    }

    function getCategoryPrefix(category) {
      const letters = String(category || '').replace(/[^a-zA-Z]/g, '').toUpperCase();
      return letters ? letters.slice(0, 2).padEnd(2, 'X') : 'XX';
    }

    function getSubCategoryPrefix(subCategory) {
      const cleaned = String(subCategory || '').replace(/&/g, ' ').trim();
      return cleaned ? cleaned.charAt(0).toUpperCase() : '0';
    }



    function recomputeAnalysisCodes() {
      let currentMainCategory = '';
      let currentMainPrefix = '';
      let currentSubCategory = '';
      let currentSubPrefix = '0';
      const subSubCounters = {};

      analysisData.forEach(row => {
        if (row.type === 'category') {
          currentMainCategory = row.title || '';
          currentMainPrefix = getCategoryPrefix(currentMainCategory);
          currentSubCategory = '';
          currentSubPrefix = '0';
          row.code = currentMainCategory ? `D-${currentMainPrefix}-0-00` : '';
        } else if (row.type === 'subcategory') {
          currentSubCategory = row.title || '';
          currentSubPrefix = getSubCategoryPrefix(currentSubCategory);
          row.code = currentMainCategory && currentSubCategory ? `D-${currentMainPrefix}-${currentSubPrefix}-00` : '';
        } else if (row.type === 'subsubcategory') {
          if (currentMainCategory && currentSubCategory) {
            const key = `${currentMainCategory}|||${currentSubCategory}`;
            subSubCounters[key] = (subSubCounters[key] || 0) + 1;
            row.code = `D-${currentMainPrefix}-${currentSubPrefix}-${String(subSubCounters[key]).padStart(2, '0')}`;
          } else if (currentMainCategory) {
            const key = `${currentMainCategory}|||`;
            subSubCounters[key] = (subSubCounters[key] || 0) + 1;
            row.code = `D-${currentMainPrefix}-0-${String(subSubCounters[key]).padStart(2, '0')}`;
          } else {
            row.code = '';
          }
        }
      });
    }
    function recomputePriceListCodes() {
      const materialCounters = {};
      priceListData.forEach(row => {
        const mainPrefix = getCategoryPrefix(row.mainCategory);
        const subPrefix = getSubCategoryPrefix(row.subCategory);

        if (row.type === 'category') {
          row.itemCode = row.mainCategory ? `P-${mainPrefix}-0-00` : '';
        } else if (row.type === 'subcategory') {
          row.itemCode = row.mainCategory && row.subCategory ? `P-${mainPrefix}-${subPrefix}-00` : '';
        } else if (row.type === 'material') {
          if (row.mainCategory && row.subCategory) {
            const key = `${row.mainCategory}|||${row.subCategory}`;
            materialCounters[key] = (materialCounters[key] || 0) + 1;
            row.itemCode = `P-${mainPrefix}-${subPrefix}-${String(materialCounters[key]).padStart(2, '0')}`;
          } else {
            row.itemCode = '';
          }
        }
      });
    }
    function buildCategorySelect(onchangeJs, currentValue) {
      const selectedValue = String(currentValue || '').trim();
      const selectedLower = selectedValue.toLowerCase();
      const options = ['<option value="">Select category</option>'];
      let hasSelectedOption = false;

      categoryOptions.forEach(option => {
        const isSelected = option.toLowerCase() === selectedLower;
        if (isSelected) hasSelectedOption = true;
        options.push(`<option value="${escapeAttr(option)}" ${isSelected ? 'selected' : ''}>${escapeHtml(option)}</option>`);
      });

      if (selectedValue && !hasSelectedOption) {
        options.push(`<option value="${escapeAttr(selectedValue)}" selected>${escapeHtml(selectedValue)}</option>`);
      }

      options.push('<option value="__manage_categories__" style="color: var(--accent); font-weight: bold;">+ Add/Edit Category List...</option>');

      return `<select class="boq-category-select" onchange="${onchangeJs}">${options.join('')}</select>`;
    }

    let isMouseDown = false;
    let isDragging = false;
    let dragStartIndex = -1;
    window.activeDragTable = null;

    // BOQ Selection Functions
    function selectBOQRows(indices) {
      selectedBOQRowIndices = new Set(indices);
      document.querySelectorAll('#boqTable tbody td.work-cell').forEach(td => {
        const index = parseInt(td.getAttribute('data-index'), 10);
        if (selectedBOQRowIndices.has(index)) {
          td.classList.add('selected-work-cell');
          td.closest('tr').classList.add('selected-row');
        } else {
          td.classList.remove('selected-work-cell');
          td.closest('tr').classList.remove('selected-row');
        }
      });
    }

    function selectBOQRow(index, preventFocus = false) {
      selectBOQRows([index]);
      lastSelectedBOQRowIndex = index;
      if (!preventFocus) {
        const activeTd = document.querySelector(`#boqTable tbody td.work-cell[data-index="${index}"]`);
        if (activeTd) {
          const input = activeTd.querySelector('input, select');
          if (input && document.activeElement !== input) {
            input.focus();
          }
        }
      }
    }

    function handleWorkCellMouseDown(event, index) {
      if (event.button !== 0) return;
      isMouseDown = true;
      dragStartIndex = index;
      isDragging = false;
      window.activeDragTable = 'boqTable';

      if (event.ctrlKey) {
        if (selectedBOQRowIndices.has(index)) {
          selectedBOQRowIndices.delete(index);
        } else {
          selectedBOQRowIndices.add(index);
          lastSelectedBOQRowIndex = index;
        }
        selectBOQRows(selectedBOQRowIndices);
        event.preventDefault();
      } else if (event.shiftKey && lastSelectedBOQRowIndex !== -1) {
        const start = Math.min(lastSelectedBOQRowIndex, index);
        const end = Math.max(lastSelectedBOQRowIndex, index);
        const newSelection = new Set(selectedBOQRowIndices);
        for (let i = start; i <= end; i++) {
          newSelection.add(i);
        }
        selectBOQRows(newSelection);
        event.preventDefault();
      } else {
        if (event.target.tagName !== 'INPUT' && event.target.tagName !== 'SELECT') {
          selectBOQRow(index, true);
          event.preventDefault();
        }
      }
    }

    function handleWorkCellMouseEnter(event, index) {
      if (!isMouseDown || window.activeDragTable !== 'boqTable') return;
      
      if (index !== dragStartIndex) {
        if (!isDragging) {
          isDragging = true;
          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) {
            document.activeElement.blur();
          }
        }
      }
      
      if (isDragging) {
        window.getSelection().removeAllRanges();
        const start = Math.min(dragStartIndex, index);
        const end = Math.max(dragStartIndex, index);
        const indices = [];
        for (let i = start; i <= end; i++) {
          indices.push(i);
        }
        selectBOQRows(indices);
      }
    }

    // D.U.P.A. Selection Functions
    function selectAnalysisRows(indices) {
      selectedAnalysisRowIndices = new Set(indices);
      document.querySelectorAll('#analysisTable tbody td.work-cell').forEach(td => {
        const index = parseInt(td.getAttribute('data-index'), 10);
        if (selectedAnalysisRowIndices.has(index)) {
          td.classList.add('selected-work-cell');
          td.closest('tr').classList.add('selected-row');
        } else {
          td.classList.remove('selected-work-cell');
          td.closest('tr').classList.remove('selected-row');
        }
      });
    }

    function selectAnalysisRow(index, preventFocus = false) {
