        } else {
          selectedAnalysisRowIndices.add(index);
          lastSelectedAnalysisRowIndex = index;
        }
        selectAnalysisRows(selectedAnalysisRowIndices);
        event.preventDefault();
      } else if (event.shiftKey && lastSelectedAnalysisRowIndex !== -1) {
        const start = Math.min(lastSelectedAnalysisRowIndex, index);
        const end = Math.max(lastSelectedAnalysisRowIndex, index);
        const newSelection = new Set(selectedAnalysisRowIndices);
        for (let i = start; i <= end; i++) {
          newSelection.add(i);
        }
        selectAnalysisRows(newSelection);
        event.preventDefault();
      } else {
        if (event.target.tagName !== 'INPUT' && event.target.tagName !== 'SELECT') {
          selectAnalysisRow(index, true);
          event.preventDefault();
        }
      }
    }

    function handleAnalysisCellMouseEnter(event, index) {
      if (!isMouseDown || window.activeDragTable !== 'analysisTable') return;
      
      if (index !== dragStartIndex) {
        if (!isDragging) {
          isDragging = true;
          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) {
            document.activeElement.blur();
          }
        }
      }
      
      if (isDragging) {
        window.getSelection().removeAllRanges();
        const start = Math.min(dragStartIndex, index);
        const end = Math.max(dragStartIndex, index);
        const indices = [];
        for (let i = start; i <= end; i++) {
          indices.push(i);
