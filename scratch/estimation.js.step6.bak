        selectAnalysisRows(indices);
      }
    }

    // Price List Selection Functions
    function selectPriceListRows(indices) {
      selectedPriceListRowIndices = new Set(indices);
      document.querySelectorAll('#priceListTable tbody td.work-cell').forEach(td => {
