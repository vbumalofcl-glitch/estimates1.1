      ganttSettings.showCostLabel = document.getElementById('ganttSetShowCostLabel').checked;
      ganttSettings.showDayLabel = document.getElementById('ganttSetShowDayLabel').checked;
      ganttSettings.showActualLabel = document.getElementById('ganttSetShowActualLabel').checked;
      ganttSettings.barLabelLocation = document.getElementById('ganttSetBarLabelLocation').value || 'right';
      ganttSettings.barLabelScope = document.getElementById('ganttSetBarLabelScope').value || 'all';
      ganttSettings.barLabelSize = parseInt(document.getElementById('ganttSetBarLabelSize').value, 10) || 8;
      ganttSettings.barLabelDecimals = parseInt(document.getElementById('ganttSetBarLabelDecimals').value, 10);
      if (isNaN(ganttSettings.barLabelDecimals)) ganttSettings.barLabelDecimals = 0;
      ganttSettings.scurveLabelDecimals = parseInt(document.getElementById('ganttSetScurveLabelDecimals').value, 10);
      if (isNaN(ganttSettings.scurveLabelDecimals)) ganttSettings.scurveLabelDecimals = 2;
      ganttSettings.showScurveDayLabel = document.getElementById('ganttSetShowScurveDayLabel').checked;
      ganttSettings.showScurveCostLabel = document.getElementById('ganttSetShowScurveCostLabel').checked;
      ganttSettings.scurveLabelSize = parseInt(document.getElementById('ganttSetScurveLabelSize').value, 10) || 8;
      
      ganttSettings.gridRowWeight = parseFloat(document.getElementById('ganttSetGridRowWeight').value) || 0;
      ganttSettings.gridRowStyle = document.getElementById('ganttSetGridRowStyle').value || 'solid';
      ganttSettings.gridRowColor = document.getElementById('ganttSetGridRowColor').value;
      
      ganttSettings.gridColWeight = parseFloat(document.getElementById('ganttSetGridColWeight').value) || 0;
      ganttSettings.gridColStyle = document.getElementById('ganttSetGridColStyle').value || 'solid';
      ganttSettings.gridColColor = document.getElementById('ganttSetGridColColor').value;
      
      ganttSettings.gridDayWeight = parseFloat(document.getElementById('ganttSetGridDayWeight').value) || 0;
      ganttSettings.gridDayStyle = document.getElementById('ganttSetGridDayStyle').value || 'solid';
      ganttSettings.gridDayColor = document.getElementById('ganttSetGridDayColor').value;
      
      ganttSettings.gridWeekWeight = parseFloat(document.getElementById('ganttSetGridWeekWeight').value) || 0;
      ganttSettings.gridWeekStyle = document.getElementById('ganttSetGridWeekStyle').value || 'solid';
      ganttSettings.gridWeekColor = document.getElementById('ganttSetGridWeekColor').value;
      
      ganttSettings.gridMonthWeight = parseFloat(document.getElementById('ganttSetGridMonthWeight').value) || 0;
      ganttSettings.gridMonthStyle = document.getElementById('ganttSetGridMonthStyle').value || 'solid';
      ganttSettings.gridMonthColor = document.getElementById('ganttSetGridMonthColor').value;
      
      ganttSettings.gridOuterWeight = parseFloat(document.getElementById('ganttSetGridOuterWeight').value) || 0;
      ganttSettings.gridOuterStyle = document.getElementById('ganttSetGridOuterStyle').value || 'solid';
      ganttSettings.gridOuterColor = document.getElementById('ganttSetGridOuterColor').value;
      
      ganttSettings.gridProjWeight = parseFloat(document.getElementById('ganttSetGridProjWeight').value) || 0;
      ganttSettings.gridProjStyle = document.getElementById('ganttSetGridProjStyle').value || 'solid';
      ganttSettings.gridProjColor = document.getElementById('ganttSetGridProjColor').value;
      
      ganttSettings.gridCurveWeight = parseFloat(document.getElementById('ganttSetGridCurveWeight').value) || 0;
      ganttSettings.gridCurveStyle = document.getElementById('ganttSetGridCurveStyle').value || 'solid';
      ganttSettings.gridCurveColor = document.getElementById('ganttSetGridCurveColor').value;

      ganttSettings.headerHeight = parseInt(document.getElementById('ganttSetHeaderHeight').value, 10) || 48;
      ganttSettings.headerTopHeight = parseInt(document.getElementById('ganttSetHeaderTopHeight').value, 10) || 24;
      ganttSettings.headerBottomHeight = parseInt(document.getElementById('ganttSetHeaderBottomHeight').value, 10) || 24;
      ganttSettings.headerFontSize = parseInt(document.getElementById('ganttSetHeaderFontSize').value, 10) || 11;
      ganttSettings.headerLeftBg = document.getElementById('ganttSetHeaderLeftBg').value;
      ganttSettings.headerLeftColor = document.getElementById('ganttSetHeaderLeftColor').value;
      ganttSettings.headerRightBg = document.getElementById('ganttSetHeaderRightBg').value;
      ganttSettings.headerRightColor = document.getElementById('ganttSetHeaderRightColor').value;
      ganttSettings.headerAltBgColor = document.getElementById('ganttSetHeaderAltBg').value;
      ganttSettings.coordRowBg = document.getElementById('ganttSetCoordRowBg').value;
      ganttSettings.coordRowColor = document.getElementById('ganttSetCoordRowColor').value;
      ganttSettings.coordHeaderBg = document.getElementById('ganttSetCoordHeaderBg').value;
      ganttSettings.coordHeaderColor = document.getElementById('ganttSetCoordHeaderColor').value;
      ganttSettings.coordHeaderHeight = parseInt(document.getElementById('ganttSetCoordHeaderHeight').value, 10) || 24;

      ganttSettings.gridHeaderLeftWeight = parseFloat(document.getElementById('ganttSetGridHeaderLeftWeight').value) || 0;
      ganttSettings.gridHeaderLeftStyle = document.getElementById('ganttSetGridHeaderLeftStyle').value || 'solid';
      ganttSettings.gridHeaderLeftColor = document.getElementById('ganttSetGridHeaderLeftColor').value;
      
      ganttSettings.gridHeaderRightWeight = parseFloat(document.getElementById('ganttSetGridHeaderRightWeight').value) || 0;
      ganttSettings.gridHeaderRightStyle = document.getElementById('ganttSetGridHeaderRightStyle').value || 'solid';
      ganttSettings.gridHeaderRightColor = document.getElementById('ganttSetGridHeaderRightColor').value;

      ganttSettings.colWidthDays = parseInt(document.getElementById('ganttSetColWidthDays').value, 10) || 28;
      ganttSettings.colWidthWeeks = parseInt(document.getElementById('ganttSetColWidthWeeks').value, 10) || 64;
      ganttSettings.colWidthMonths = parseInt(document.getElementById('ganttSetColWidthMonths').value, 10) || 120;
      ganttSettings.colWidthQuarters = parseInt(document.getElementById('ganttSetColWidthQuarters').value, 10) || 180;
      
      ganttSettings.connectorWeight = parseFloat(document.getElementById('ganttSetConnectorWeight').value) || 1.5;
      ganttSettings.connectorStyle = document.getElementById('ganttSetConnectorStyle').value || 'solid';
      ganttSettings.connectorColor = document.getElementById('ganttSetConnectorColor').value || '#6b7280';
      ganttSettings.connectorStartHead = document.getElementById('ganttSetConnectorStartHead').value || 'none';
      ganttSettings.connectorEndHead = document.getElementById('ganttSetConnectorEndHead').value || 'arrow';
      ganttSettings.connectorHeadSize = parseInt(document.getElementById('ganttSetConnectorHeadSize').value, 10) || 6;
      
      saveGanttSettings();
      closeGanttStyleSettingsModal();
      renderGanttChart();
      
      const qtyModal = document.getElementById('ganttQtyInstModal');
      if (qtyModal && qtyModal.style.display === 'flex') {
        renderQtyModalTable();
      }
    }

    function showGanttTimelineContextMenu(clientX, clientY) {
      let menu = document.getElementById('ganttTimelineContextMenu');
      if (!menu) {
        menu = document.createElement('div');
        menu.id = 'ganttTimelineContextMenu';
        menu.className = 'custom-context-menu';
        document.body.appendChild(menu);
      }
      
      menu.innerHTML = `
        <div class="custom-context-menu-item" onclick="openGanttStyleSettingsModal()">
          <span style="font-size: 14px;">🎨</span> Gantt Style Settings...
        </div>
      `;
      menu.style.display = 'block';
      
      const menuRect = menu.getBoundingClientRect();
      let left = clientX;
      let top = clientY;
      
      if (left + menuRect.width > window.innerWidth) {
        left = window.innerWidth - menuRect.width - 10;
      }
      if (top + menuRect.height > window.innerHeight) {
        top = window.innerHeight - menuRect.height - 10;
      }
      
      menu.style.left = left + 'px';
      menu.style.top = top + 'px';
    }

    function hideGanttTimelineContextMenu() {
      const menu = document.getElementById('ganttTimelineContextMenu');
      if (menu) menu.style.display = 'none';
    }

    function setupGanttTimelineContextMenu() {
      const timelineBody = document.getElementById('ganttTimelineBody');
      const taskTableBody = document.querySelector('#ganttTaskTable tbody');
      
      const qtyTimelineBody = document.getElementById('qtyTimelineBody');
      const qtyTaskTableBody = document.querySelector('#qtyTaskTable tbody');
      
      if (timelineBody && !timelineBody.dataset.contextMenuInitialized) {
        timelineBody.dataset.contextMenuInitialized = 'true';
        timelineBody.addEventListener('contextmenu', (e) => {
          if (e.target.closest('.gantt-bar-handle')) return;
          e.preventDefault();
          showGanttTimelineContextMenu(e.clientX, e.clientY);
        });
      }
      
      if (taskTableBody && !taskTableBody.dataset.contextMenuInitialized) {
        taskTableBody.dataset.contextMenuInitialized = 'true';
        taskTableBody.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          showGanttTimelineContextMenu(e.clientX, e.clientY);
        });
      }

      if (qtyTimelineBody && !qtyTimelineBody.dataset.contextMenuInitialized) {
        qtyTimelineBody.dataset.contextMenuInitialized = 'true';
        qtyTimelineBody.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          showGanttTimelineContextMenu(e.clientX, e.clientY);
        });
      }

      if (qtyTaskTableBody && !qtyTaskTableBody.dataset.contextMenuInitialized) {
        qtyTaskTableBody.dataset.contextMenuInitialized = 'true';
        qtyTaskTableBody.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          showGanttTimelineContextMenu(e.clientX, e.clientY);
        });
      }
    }

    window.closeGanttStyleSettingsModal = closeGanttStyleSettingsModal;
    window.saveGanttStyleSettings = saveGanttStyleSettings;
    window.openGanttStyleSettingsModal = openGanttStyleSettingsModal;
    window.showGanttTimelineContextMenu = showGanttTimelineContextMenu;
    window.hideGanttTimelineContextMenu = hideGanttTimelineContextMenu;
    window.setupGanttTimelineContextMenu = setupGanttTimelineContextMenu;
    window.initGanttSettings = initGanttSettings;

    function showGanttHeaderContextMenu(clientX, clientY, colId) {
      let menu = document.getElementById('ganttHeaderContextMenu');
      if (!menu) {
        menu = document.createElement('div');
        menu.id = 'ganttHeaderContextMenu';
        menu.className = 'custom-context-menu';
        document.body.appendChild(menu);
      }
      
      const col = ganttColumns.find(c => c.id === colId);
      if (!col) return;
      
      let html = '';
      
      if (col.isCustom) {
        html += `<div class="custom-context-menu-item" onclick="renameGanttColumn('${col.id}')"><span style="font-size: 14px;">✏️</span> Rename Column</div>`;
      }
      
      if (col.id !== 'title') {
        html += `<div class="custom-context-menu-item" onclick="hideGanttColumn('${col.id}')"><span style="font-size: 14px;">❌</span> Hide Column</div>`;
      }
      
      html += `<div style="border-top: 1px solid var(--line); margin: 4px 0;"></div>`;
      html += `<div class="custom-context-menu-item" onclick="addGanttColumn()"><span style="font-size: 14px;">➕</span> Add Column at End</div>`;
      
      const hiddenCols = ganttColumns.filter(c => !c.visible);
      
      html += `
        <div class="custom-context-menu-item has-submenu">
          <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="font-size: 14px;">📥</span> Insert Column Right
            </div>
            <span style="font-size: 9px; color: var(--muted-dark);">▶</span>
          </div>
          <div class="custom-context-submenu">
            <div class="custom-context-menu-item" onclick="insertGanttColumn('${col.id}', 'blank')">New Blank Column</div>
      `;
      
      if (hiddenCols.length > 0) {
        html += `<div style="border-top: 1px solid var(--line); margin: 4px 0;"></div>`;
        hiddenCols.forEach(hc => {
          html += `<div class="custom-context-menu-item" onclick="insertGanttColumn('${col.id}', '${hc.id}')">Restore: ${escapeHtml(hc.name)}</div>`;
        });
      }
      
      html += `
          </div>
        </div>
      `;
      
      const anyCatCollapsed = boqData.some(row => row.type === 'category' && row.ganttCollapsed);
      const catText = anyCatCollapsed ? "Unhide Categories" : "Hide Categories";

      const anySubCatCollapsed = boqData.some(row => row.type === 'subcategory' && row.ganttCollapsed);
      const subCatText = anySubCatCollapsed ? "Unhide Sub-Categories" : "Hide Sub-Categories";

      const anySubSubCatCollapsed = boqData.some(row => row.type === 'subsubcategory' && row.ganttCollapsed);
      const subSubCatText = anySubSubCatCollapsed ? "Unhide Sub-Sub-Categories" : "Hide Sub-Sub-Categories";

      html += `<div style="border-top: 1px solid var(--line); margin: 4px 0;"></div>`;
      html += `<div class="custom-context-menu-item" onclick="toggleGanttCategories()"><span style="font-size: 14px;">👁️</span> ${catText}</div>`;
      html += `<div class="custom-context-menu-item" onclick="toggleGanttSubcategories()"><span style="font-size: 14px;">👁️</span> ${subCatText}</div>`;
      html += `<div class="custom-context-menu-item" onclick="toggleGanttSubsubcategories()"><span style="font-size: 14px;">👁️</span> ${subSubCatText}</div>`;
      html += `<div class="custom-context-menu-item" onclick="showAllGanttRows()"><span style="font-size: 14px;">👁️</span> Show All</div>`;
      
      menu.innerHTML = html;
      menu.style.display = 'block';
      
      const menuRect = menu.getBoundingClientRect();
      let left = clientX;
      let top = clientY;
      
      if (left + menuRect.width > window.innerWidth) {
        left = window.innerWidth - menuRect.width - 10;
      }
      if (top + menuRect.height > window.innerHeight) {
        top = window.innerHeight - menuRect.height - 10;
      }
      
      menu.style.left = left + 'px';
      menu.style.top = top + 'px';
    }
    
    function hideGanttHeaderContextMenu() {
      const menu = document.getElementById('ganttHeaderContextMenu');
      if (menu) menu.style.display = 'none';
    }
    
    function renameGanttColumn(colId) {
      const col = ganttColumns.find(c => c.id === colId);
      if (!col) return;
      
      const newName = prompt('Enter new column name:', col.name);
      if (newName !== null) {
        const cleanName = newName.trim();
        if (cleanName) {
          col.name = cleanName;
          saveGanttColumns();
          renderGanttChart();
        }
      }
      hideGanttHeaderContextMenu();
    }
    
    function hideGanttColumn(colId) {
      if (colId === 'title') {
        alert("Cannot hide the primary columns.");
        hideGanttHeaderContextMenu();
        return;
      }
      const col = ganttColumns.find(c => c.id === colId);
      if (col) {
        col.visible = false;
        saveGanttColumns();
        renderGanttChart();
      }
      hideGanttHeaderContextMenu();
    }
    
    function addGanttColumn() {
      const name = prompt("Enter new column name:");
      if (name !== null) {
        const cleanName = name.trim();
        if (cleanName) {
          const newCol = {
            id: 'custom_' + Date.now(),
            name: cleanName,
            width: 100,
            visible: true,
            isCustom: true
          };
          ganttColumns.push(newCol);
          saveGanttColumns();
          renderGanttChart();
        }
      }
      hideGanttHeaderContextMenu();
    }
    
    function insertGanttColumn(targetColId, sourceColId) {
      const targetIdx = ganttColumns.findIndex(c => c.id === targetColId);
      if (targetIdx === -1) {
        hideGanttHeaderContextMenu();
        return;
      }
      
      if (sourceColId === 'blank') {
        const name = prompt("Enter new column name:");
        if (name !== null) {
          const cleanName = name.trim();
          if (cleanName) {
            const newCol = {
              id: 'custom_' + Date.now(),
              name: cleanName,
              width: 100,
              visible: true,
              isCustom: true
            };
            ganttColumns.splice(targetIdx + 1, 0, newCol);
            saveGanttColumns();
            renderGanttChart();
          }
        }
      } else {
        const col = ganttColumns.find(c => c.id === sourceColId);
        if (col) {
          col.visible = true;
          const currentIdx = ganttColumns.indexOf(col);
          ganttColumns.splice(currentIdx, 1);
          
          const newTargetIdx = ganttColumns.findIndex(c => c.id === targetColId);
          ganttColumns.splice(newTargetIdx + 1, 0, col);
          
          saveGanttColumns();
          renderGanttChart();
        }
      }
      hideGanttHeaderContextMenu();
    }
    
    function updateGanttCustomValue(index, colId, value) {
      if (!boqData[index]) return;
      boqData[index].ganttCustomValues = boqData[index].ganttCustomValues || {};
      boqData[index].ganttCustomValues[colId] = value;
      markUnsaved();
    }

    function toggleGanttCategories() {
      const anyCollapsed = boqData.some(row => row.type === 'category' && row.ganttCollapsed);
      boqData.forEach((row, index) => {
        if (row.type === 'category' && hasChildRow(boqData, index)) {
          row.ganttCollapsed = !anyCollapsed;
        }
      });
      renderGanttChart();
      hideGanttHeaderContextMenu();
    }

    function toggleGanttSubcategories() {
      const anyCollapsed = boqData.some(row => row.type === 'subcategory' && row.ganttCollapsed);
      boqData.forEach((row, index) => {
        if (row.type === 'subcategory' && hasChildRow(boqData, index)) {
          row.ganttCollapsed = !anyCollapsed;
        }
      });
      renderGanttChart();
      hideGanttHeaderContextMenu();
    }

    function toggleGanttSubsubcategories() {
      const anyCollapsed = boqData.some(row => row.type === 'subsubcategory' && row.ganttCollapsed);
      boqData.forEach((row, index) => {
        if (row.type === 'subsubcategory' && hasChildRow(boqData, index)) {
          row.ganttCollapsed = !anyCollapsed;
        }
      });
      renderGanttChart();
      hideGanttHeaderContextMenu();
    }

    function showAllGanttRows() {
      boqData.forEach(row => {
        if (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory') {
          row.ganttCollapsed = false;
        }
      });
      renderGanttChart();
      hideGanttHeaderContextMenu();
    }
    
    function toggleGanttRowCollapse(index) {
      if (!boqData[index]) return;
      boqData[index].ganttCollapsed = !boqData[index].ganttCollapsed;
      
      const modal = document.getElementById('ganttQtyInstModal');
      const isModalOpen = modal && modal.style.display === 'flex';
      
      if (!isModalOpen) {
        renderGanttChart();
      } else {
        renderQtyModalTable();
      }
    }

    function toggleQtyRowCollapse(index) {
      if (!boqData[index]) return;
      boqData[index].qtyCollapsed = !boqData[index].qtyCollapsed;
      renderQtyModalTable();
    }
    
    window.renameGanttColumn = renameGanttColumn;
    window.hideGanttColumn = hideGanttColumn;
    window.addGanttColumn = addGanttColumn;
    window.insertGanttColumn = insertGanttColumn;
    window.updateGanttCustomValue = updateGanttCustomValue;
    window.hideGanttHeaderContextMenu = hideGanttHeaderContextMenu;
    window.toggleGanttCategories = toggleGanttCategories;
    window.toggleGanttSubcategories = toggleGanttSubcategories;
    window.toggleGanttSubsubcategories = toggleGanttSubsubcategories;
    window.showAllGanttRows = showAllGanttRows;
    window.toggleGanttRowCollapse = toggleGanttRowCollapse;
    window.toggleQtyRowCollapse = toggleQtyRowCollapse;

    let ganttSummaryCellFunctions = {};

    function loadGanttSummaryCellFunctions() {
      try {
        const saved = localStorage.getItem('cost_estimate_gantt_summary_functions_v1');
        ganttSummaryCellFunctions = saved ? JSON.parse(saved) : {};
      } catch (e) {
        ganttSummaryCellFunctions = {};
      }
    }

    function saveGanttSummaryCellFunctions() {
      try {
        localStorage.setItem('cost_estimate_gantt_summary_functions_v1', JSON.stringify(ganttSummaryCellFunctions));
      } catch (e) {}
    }

    function getGanttSummaryCellFunction(rowLabel, colId) {
      if (!ganttSummaryCellFunctions[rowLabel]) {
        ganttSummaryCellFunctions[rowLabel] = {};
      }
      return ganttSummaryCellFunctions[rowLabel][colId] || 'none';
    }

    function setGanttSummaryCellFunction(rowLabel, colId, value) {
      if (!ganttSummaryCellFunctions[rowLabel]) {
        ganttSummaryCellFunctions[rowLabel] = {};
      }
      ganttSummaryCellFunctions[rowLabel][colId] = value;
      saveGanttSummaryCellFunctions();
      markUnsaved();
      renderGanttChart();
    }

     function getGanttSummaryTaskValue(taskIdx, rowLabel, colId) {
      const row = boqData[taskIdx];
      if (!row) return 0;
      
      const isParent = hasChildRow(boqData, taskIdx);
      const displayValues = computeBOQDisplayValues(row) || {};
      
      const totalCost = isParent ? ((computeBOQCategorySummary(taskIdx) || {}).totalCost || 0) : (displayValues.grandTotalCost || 0);
      const estQty = isParent ? 0 : (displayValues.qty || 0);
      
      const progressCost = getGanttTaskCostProgress(taskIdx);
      const progressDay = getGanttTaskDayProgress(taskIdx) || 0;
      const instQty = getInstalledQty(taskIdx);
      const accomplishedCost = getGanttTaskAccomplishedCost(taskIdx) || 0;
      
      const taskInfo = getGanttTaskTimeInfo(taskIdx);
      const duration = taskInfo ? taskInfo.duration : 5;
      const remainingDays = getGanttRemainingDays(taskIdx, taskInfo);
      
      if (colId === 'cost') return totalCost;
      if (colId === 'qtyAccmpCost') return accomplishedCost;
      if (colId === 'remainingDays') return remainingDays;
      
      if (rowLabel === "Summary of Accomplishment") {
        if (colId === 'progress') return progressCost;
        if (colId === 'progressDay') return progressDay;
        if (colId === 'estQty') return isParent ? 0 : (progressCost / 100) * estQty;
        if (colId === 'instQty') return instQty;
        if (colId === 'days') return (progressDay / 100) * duration;
      } else if (rowLabel === "Progress % (Cost) Summary") {
        if (colId === 'progress') return progressCost;
        if (colId === 'progressDay') return progressDay;
        if (colId === 'estQty') return progressCost;
        if (colId === 'instQty') return progressCost;
        if (colId === 'days') return progressCost;
      } else if (rowLabel === "Progress % (Day) Summary") {
        if (colId === 'progress') return progressCost;
        if (colId === 'progressDay') return progressDay;
        if (colId === 'estQty') return progressDay;
        if (colId === 'instQty') return progressDay;
        if (colId === 'days') return progressDay;
      } else if (rowLabel === "Cash Flow (Estimated)") {
        if (colId === 'progress') return progressCost;
        if (colId === 'progressDay') return progressDay;
        if (colId === 'estQty') return estQty;
        if (colId === 'instQty') return instQty;
        if (colId === 'days') return duration;
      } else if (rowLabel === "Cash Flow (Day)") {
        if (colId === 'progress') return progressCost;
        if (colId === 'progressDay') return progressDay;
        if (colId === 'estQty') return duration;
        if (colId === 'instQty') return duration;
        if (colId === 'days') return duration;
      }
      
      return 0;
    }

    function getGanttLeafTasksDateRange() {
      let minStart = null;
      let maxEnd = null;
      
      boqData.forEach((row, idx) => {
        if (!hasChildRow(boqData, idx)) {
          const taskInfo = getGanttTaskTimeInfo(idx);
          if (taskInfo) {
            if (taskInfo.startDate) {
              const s = new Date(taskInfo.startDate);
              if (!isNaN(s.getTime())) {
                if (!minStart || s < minStart) minStart = s;
              }
            }
            if (taskInfo.endDate) {
              const e = new Date(taskInfo.endDate);
              if (!isNaN(e.getTime())) {
                if (!maxEnd || e > maxEnd) maxEnd = e;
              }
            }
          }
        }
      });
      
      return { minStart, maxEnd };
    }

    function getGanttPeriodDateRange(p, scale, timelineStartDate) {
      let start = new Date(timelineStartDate);
      let end = new Date(timelineStartDate);
      
      if (scale === 'days') {
        start.setDate(timelineStartDate.getDate() + p);
        start.setHours(0, 0, 0, 0);
        end.setDate(timelineStartDate.getDate() + p);
        end.setHours(23, 59, 59, 999);
      } else if (scale === 'weeks') {
        start.setDate(timelineStartDate.getDate() + p * 7);
        start.setHours(0, 0, 0, 0);
        end.setDate(timelineStartDate.getDate() + p * 7 + 6);
        end.setHours(23, 59, 59, 999);
      } else if (scale === 'quarters') {
        let qDate = new Date(timelineStartDate);
        qDate.setMonth(Math.floor(qDate.getMonth() / 3) * 3, 1);
        qDate.setMonth(qDate.getMonth() + p * 3);
        start = new Date(qDate);
        start.setHours(0, 0, 0, 0);
        
        let endQDate = new Date(qDate);
        endQDate.setMonth(endQDate.getMonth() + 3);
        endQDate.setDate(0);
        end = new Date(endQDate);
        end.setHours(23, 59, 59, 999);
      } else { // months
        let mDate = new Date(timelineStartDate);
        mDate.setDate(1);
        mDate.setMonth(mDate.getMonth() + p);
        start = new Date(mDate);
        start.setHours(0, 0, 0, 0);
        
        let endMDate = new Date(mDate);
        endMDate.setMonth(endMDate.getMonth() + 1);
        endMDate.setDate(0);
        end = new Date(endMDate);
        end.setHours(23, 59, 59, 999);
      }
      
      return { start, end };
    }

    function getGanttTaskOverlapDays(taskIdx, pStart, pEnd) {
      const taskInfo = getGanttTaskTimeInfo(taskIdx);
      if (!taskInfo || !taskInfo.startDate || !taskInfo.endDate) return 0;
      
      const tStart = new Date(taskInfo.startDate);
      const tEnd = new Date(taskInfo.endDate);
      tStart.setHours(0, 0, 0, 0);
      tEnd.setHours(0, 0, 0, 0);
      
      const pStartCopy = new Date(pStart);
      pStartCopy.setHours(0, 0, 0, 0);
      const pEndCopy = new Date(pEnd);
      pEndCopy.setHours(0, 0, 0, 0);
      
      const overlapStart = new Date(Math.max(tStart, pStartCopy));
      const overlapEnd = new Date(Math.min(tEnd, pEndCopy));
      
      if (overlapStart > overlapEnd) return 0;
      
      const diffTime = overlapEnd - overlapStart;
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24)) + 1;
      return Math.max(0, diffDays);
    }

    function getGanttSummaryTaskTimelineValue(taskIdx, rowLabel, pStart, pEnd) {
      const row = boqData[taskIdx];
      if (!row) return 0;
      
      if (rowLabel === "Progress % (Day) Summary") {
        const curInput = document.getElementById('ganttCurrentDateInput');
        const curStr = (curInput && curInput.value) || localStorage.getItem('cost_estimate_gantt_current_date_v1');
        const current = curStr ? parseSafeDate(curStr) : new Date();
        
        const pStartCopy = new Date(pStart);
        pStartCopy.setHours(0, 0, 0, 0);
        
        const currentCopy = new Date(current);
        currentCopy.setHours(0, 0, 0, 0);
        
        if (pStartCopy.getTime() > currentCopy.getTime()) return null;
      }
      
      const isParent = hasChildRow(boqData, taskIdx);
      
      if (rowLabel === "Summary of Accomplishment") {
        if (isParent) {
          const leaves = getLeafDescendents(taskIdx);
          let sum = 0;
          leaves.forEach(leafIdx => {
            sum += getGanttSummaryTaskTimelineValue(leafIdx, rowLabel, pStart, pEnd);
          });
          return sum;
        } else {
          const cellQty = getAccumulatedPeriodQty(taskIdx, pStart, pEnd);
          const displayValues = computeBOQDisplayValues(row) || {};
          const estQty = displayValues.qty || 0;
          const totalCost = displayValues.grandTotalCost || 0;
          const unitCost = estQty > 0 ? (totalCost / estQty) : 0;
          return cellQty * unitCost;
        }
      }
      
      if (rowLabel === "Progress % (Cost) Summary") {
        if (isParent) {
          const leaves = getLeafDescendents(taskIdx);
          let accomplishedCostSum = 0;
          let totalCostSum = 0;
          leaves.forEach(leafIdx => {
            const leafRow = boqData[leafIdx];
            const leafDisplay = computeBOQDisplayValues(leafRow) || {};
            totalCostSum += leafDisplay.grandTotalCost || 0;
            accomplishedCostSum += getGanttSummaryTaskTimelineValue(leafIdx, "Summary of Accomplishment", pStart, pEnd);
          });
          return totalCostSum > 0 ? (accomplishedCostSum / totalCostSum) * 100 : 0;
        } else {
          const cellQty = getAccumulatedPeriodQty(taskIdx, pStart, pEnd);
          const displayValues = computeBOQDisplayValues(row) || {};
          const estQty = displayValues.qty || 0;
          return estQty > 0 ? (cellQty / estQty) * 100 : 0;
        }
      }
      
      // Default overlap-based logic for other rows
      const taskInfo = getGanttTaskTimeInfo(taskIdx);
      if (!taskInfo || !taskInfo.startDate || !taskInfo.endDate) return 0;
      const duration = taskInfo.duration || 5;
      
      const overlapDays = getGanttTaskOverlapDays(taskIdx, pStart, pEnd);
      if (overlapDays <= 0) return 0;
      
      const displayValues = computeBOQDisplayValues(row) || {};
      const totalCost = isParent ? ((computeBOQCategorySummary(taskIdx) || {}).totalCost || 0) : (displayValues.grandTotalCost || 0);
      
      const progressDay = getGanttTaskDayProgress(taskIdx) || 0;
      
      if (rowLabel === "Progress % (Day) Summary") {
        return (overlapDays / duration) * 100;
      } else if (rowLabel === "Cash Flow (Estimated)") {
        return totalCost * (overlapDays / duration);
      } else if (rowLabel === "Cash Flow (Day)") {
        return overlapDays;
      }
      
      return 0;
    }

    function aggregateSummaryValues(values, func) {
      if (!values || values.length === 0) return 0;
      if (func === 'none') return '';
      if (func === 'sum' || func === 'subtotal') {
        let s = 0;
        for (let i = 0; i < values.length; i++) {
          const v = parseFloat(values[i]);
          if (!isNaN(v)) s += v;
        }
        return s;
      }
      if (func === 'max') {
        const valid = values.map(v => parseFloat(v)).filter(v => !isNaN(v));
        return valid.length > 0 ? Math.max(...valid) : 0;
      }
      if (func === 'min') {
        const valid = values.map(v => parseFloat(v)).filter(v => !isNaN(v));
        return valid.length > 0 ? Math.min(...valid) : 0;
      }
      return '';
    }

    window.setGanttSummaryCellFunction = setGanttSummaryCellFunction;

     function renderGanttChart() {
       try {
         ganttTimeCache.clear();
         const taskTableBody = document.querySelector('#ganttTaskTable tbody');
         const timelineHeader = document.getElementById('ganttTimelineHeader');
         const timelineBody = document.getElementById('ganttTimelineBody');
         const rightPanel = document.getElementById('ganttRightPanel');
         if (!taskTableBody || !timelineHeader || !timelineBody || !rightPanel) return;
         
         const coordH = ganttSettings.coordHeaderHeight !== undefined ? ganttSettings.coordHeaderHeight : 24;
         const rowH = ganttSettings.rowHeight || 40;
         ganttCoordinateValues = {};
         const barLabelDecimals = ganttSettings.barLabelDecimals !== undefined ? ganttSettings.barLabelDecimals : 0;
         const scurveLabelDecimals = ganttSettings.scurveLabelDecimals !== undefined ? ganttSettings.scurveLabelDecimals : 2;

         function getGanttBarLabelStyle(location, fontSize, type, isCostOrDayOrActual, percent, progressDay, curDateRelativeX) {
           let styleStr = `font-size: ${fontSize}px; line-height: 1; pointer-events: none; position: absolute; white-space: nowrap; z-index: 10;`;
           if (location === 'center') {
             styleStr += ` left: 50%; top: 50%; transform: translate(-50%, -50%); color: #ffffff !important; text-shadow: 0 1px 2px rgba(0,0,0,0.8); font-weight: bold;`;
           } else if (location === 'top') {
             styleStr += ` left: 0; bottom: calc(100% + 2px); top: auto; transform: none; color: var(--text); font-weight: bold;`;
           } else if (location === 'bottom') {
             styleStr += ` left: 0; top: calc(100% + 2px); transform: none; color: var(--text); font-weight: bold;`;
           } else if (location === 'progress') {
              if (isCostOrDayOrActual === 'day') {
                styleStr += ` left: ${curDateRelativeX}px; top: 50%; transform: translate(-50%, -50%); color: var(--text); font-weight: bold; background: rgba(255, 255, 255, 0.85); border: 1px solid var(--line); padding: 1px 3px; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);`;
              } else {
                let leftPercent = 100;
                if (isCostOrDayOrActual === 'cost') {
                  leftPercent = percent !== undefined ? percent : 100;
                }
                styleStr += ` left: ${leftPercent}%; top: 50%; transform: translate(-50%, -50%); color: var(--text); font-weight: bold; background: rgba(255, 255, 255, 0.85); border: 1px solid var(--line); padding: 1px 3px; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);`;
              };
           } else if (location === 'current_date') {
             let leftPx = 0;
             if (typeof curDateRelativeX === 'number' && !isNaN(curDateRelativeX)) {
               leftPx = curDateRelativeX;
             }
             let textColor = 'var(--text)';
             if (percent !== undefined && progressDay !== undefined) {
               if (percent > progressDay) {
                 textColor = (isCostOrDayOrActual === 'cost') ? '#166534' : '#991b1b';
               } else if (percent < progressDay) {
                 textColor = (isCostOrDayOrActual === 'cost') ? '#991b1b' : '#166534';
               }
             }
             // 4mm is approximately 15px. Place label after the vertical line.
             styleStr += ` left: ${leftPx + 15}px; top: 50%; transform: translateY(-50%); color: ${textColor} !important; font-weight: bold; background: rgba(255, 255, 255, 0.9); border: 1px solid var(--line); padding: 1px 4px; border-radius: 3px; box-shadow: 0 1px 2px rgba(0,0,0,0.15);`;
           } else {
             // default 'right'
             styleStr += ` left: calc(100% + 8px); top: 50%; transform: translateY(-50%); color: var(--text); font-weight: bold;`;
           }
           return styleStr;
         }

      // Save scroll positions to prevent jumping
      const savedScrollY = window.scrollY;
      const savedScrollX = window.scrollX;
      const leftPanel = document.querySelector('.gantt-left-panel');
      const savedLeftScrollTop = leftPanel ? leftPanel.scrollTop : 0;
      const savedLeftScrollLeft = leftPanel ? leftPanel.scrollLeft : 0;
      const savedRightScrollTop = rightPanel.scrollTop;
      const savedRightScrollLeft = rightPanel.scrollLeft;
      
      ganttVisibleIndices = [];
      boqData.forEach((row, index) => {
        if (!shouldHideGanttHierarchyRow(index)) {
          ganttVisibleIndices.push(index);
        }
      });
      
      const taskTableHead = document.querySelector('#ganttTaskTable thead');
      const activeCols = ganttColumns.filter(c => c.visible);
      if (taskTableHead) {
        let theadHtml = '';
        if (ganttSettings.showCoordinates) {
          theadHtml += '<tr class="gantt-coord-header-row" style="position: sticky; top: 0; z-index: 10;">';
          theadHtml += '<th style="width: 40px; border-right: 1px solid var(--accent);"></th>'; // Blank cell for coordinate column
          activeCols.forEach((col, idx) => {
            const borderStyle = idx < activeCols.length - 1 ? 'border-right: 1px solid var(--accent);' : '';
            const colIdxInFull = ganttColumns.indexOf(col);
            theadHtml += `<th style="width: ${col.width}px; ${borderStyle}">${getColLetter(colIdxInFull)}</th>`;
          });
          theadHtml += '</tr>';
        }

        const topOffset = ganttSettings.showCoordinates ? `${coordH}px` : '0px';
        theadHtml += `<tr style="height: 48px; border-bottom: 1px solid var(--line); background: var(--accent); position: sticky; top: ${topOffset}; z-index: 10;">`;
        if (ganttSettings.showCoordinates) {
          theadHtml += '<th class="gantt-coord-th" style="width: 40px; color: white; text-align: center; font-size: 10px; font-weight: bold; text-transform: uppercase; border-right: 1px solid var(--accent-dark);">#</th>';
        }
        activeCols.forEach((col, idx) => {
          const borderStyle = idx < activeCols.length - 1 ? 'border-right: 1px solid var(--accent-dark);' : '';
          const alignStyle = (col.id === 'title' || col.id === 'specification') ? 'text-align: left; padding-left: 8px;' : 'text-align: center;';
          const isDragging = (window.activeGanttDragColId === col.id);
          const dragStyle = isDragging ? 'opacity: 0.6; background: #3b82f6 !important; border: 1px dashed white !important;' : '';
          const cursorStyle = isDragging ? 'cursor: grabbing;' : 'cursor: grab;';
          theadHtml += `<th style="width: ${col.width}px; position: relative; color: white; ${alignStyle} font-size: 10px; font-weight: bold; text-transform: uppercase; ${borderStyle} ${dragStyle} ${cursorStyle}" data-col-id="${col.id}">
            ${escapeHtml(col.name)}
            <div class="gantt-col-resizer" style="position: absolute; right: 0; top: 0; width: 6px; height: 100%; cursor: col-resize; z-index: 2;"></div>
          </th>`;
        });
        theadHtml += '</tr>';
        taskTableHead.innerHTML = theadHtml;
        
        if (!taskTableHead.dataset.listenersAttached) {
          taskTableHead.dataset.listenersAttached = 'true';
          
          taskTableHead.addEventListener('contextmenu', (e) => {
            const th = e.target.closest('th');
            if (!th) return;
            const colId = th.dataset.colId;
            if (!colId) return;
            e.preventDefault();
            showGanttHeaderContextMenu(e.clientX, e.clientY, colId);
          });
          
          taskTableHead.addEventListener('mousedown', (e) => {
            const resizer = e.target.closest('.gantt-col-resizer');
            if (resizer) {
              e.preventDefault();
              e.stopPropagation();
              
              const th = resizer.closest('th');
              const colId = th.dataset.colId;
              if (!colId) return;
              const col = ganttColumns.find(c => c.id === colId);
              if (!col) return;
              
              const startX = e.clientX;
              const startWidth = col.width;
              
              const onMouseMove = (moveEvent) => {
                const deltaX = moveEvent.clientX - startX;
                const newWidth = Math.max(30, startWidth + deltaX);
                col.width = newWidth;
                
                th.style.width = newWidth + 'px';
                
                const activeCols = ganttColumns.filter(c => c.visible);
                const extraWidthForCoords = ganttSettings.showCoordinates ? 40 : 0;
                const totalW = activeCols.reduce((sum, c) => sum + c.width, 0) + extraWidthForCoords;
                document.getElementById('ganttTaskTable').style.width = totalW + 'px';
              };
              
              const onMouseUp = () => {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
                saveGanttColumns();
                renderGanttChart();
              };
              
              document.addEventListener('mousemove', onMouseMove);
              document.addEventListener('mouseup', onMouseUp);
              return;
            }
            
            // Dragging logic
            if (e.button !== 0) return; // Left click only
            const th = e.target.closest('th');
            if (!th) return;
            
            const colId = th.dataset.colId;
            if (!colId) return;
            const col = ganttColumns.find(c => c.id === colId);
            if (!col) return;
            
            e.preventDefault();
            
            window.activeGanttDragColId = colId;
            renderGanttChart(); // Re-render to show visual feedback (opacity, grabbed cursor)
            
            const onMouseMove = (moveEvent) => {
              const ths = Array.from(taskTableHead.querySelectorAll('th'));
              const hoveredTh = ths.find(otherTh => {
                const rect = otherTh.getBoundingClientRect();
                return moveEvent.clientX >= rect.left && moveEvent.clientX <= rect.right;
              });
              
              if (hoveredTh && hoveredTh.dataset.colId !== window.activeGanttDragColId) {
                const targetColId = hoveredTh.dataset.colId;
                if (targetColId) {
                  const dragIdx = ganttColumns.findIndex(c => c.id === window.activeGanttDragColId);
                  const targetIdx = ganttColumns.findIndex(c => c.id === targetColId);
                  
                  if (dragIdx !== -1 && targetIdx !== -1 && dragIdx !== targetIdx) {
                    const [draggedCol] = ganttColumns.splice(dragIdx, 1);
                    ganttColumns.splice(targetIdx, 0, draggedCol);
                    saveGanttColumns();
                    renderGanttChart();
                  }
                }
              }
            };
            
            const onMouseUp = () => {
              document.removeEventListener('mousemove', onMouseMove);
              document.removeEventListener('mouseup', onMouseUp);
              window.activeGanttDragColId = null;
              renderGanttChart();
            };
            
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
          });
        }
        
        const extraWidthForCoords = ganttSettings.showCoordinates ? 40 : 0;
        const totalW = activeCols.reduce((sum, c) => sum + c.width, 0) + extraWidthForCoords;
        document.getElementById('ganttTaskTable').style.width = totalW + 'px';
        if (leftPanel && !localStorage.getItem('cost_estimate_gantt_left_width_v1')) {
          leftPanel.style.width = totalW + 'px';
        }
      }
      
      taskTableBody.innerHTML = '';
      const taskTableFragment = document.createDocumentFragment();
      timelineHeader.innerHTML = '';
      timelineBody.innerHTML = '';
      
      const projStartStr = document.getElementById('ganttProjectStartInput')?.value || getTodayDateString();
      const projStartDate = parseSafeDate(projStartStr);
      
      const taskInfos = boqData.map((row, index) => getGanttTaskTimeInfo(index));
      
      let maxTaskEndDate = null;
      taskInfos.forEach(info => {
        if (info && info.endDate) {
          const d = parseSafeDate(info.endDate, null);
          if (d) {
            if (!maxTaskEndDate || d > maxTaskEndDate) {
              maxTaskEndDate = new Date(d);
            }
          }
        }
      });
      
      const finishDisplay = document.getElementById('ganttProjectFinishDisplay');
      if (finishDisplay) {
        finishDisplay.textContent = maxTaskEndDate && !isNaN(maxTaskEndDate.getTime()) ? formatDateString(maxTaskEndDate) : ' - ';
      }
      
      const timelineStartDate = parseSafeDate(projStartDate);
      
      let totalDays = 60;
      if (maxTaskEndDate) {
        totalDays = Math.round((maxTaskEndDate - timelineStartDate) / (1000 * 60 * 60 * 24)) + 1;
        if (totalDays < 1) totalDays = 1;
      }
      
      const timelineEndDate = new Date(timelineStartDate);
      timelineEndDate.setDate(timelineStartDate.getDate() + totalDays - 1);
      
      const rightPanelWidth = rightPanel.clientWidth || 0;
      let activeColW = 28;
      let totalWeeks = 0;
      let totalMonthsCols = 0;
      let totalQuartersCols = 0;
      
      if (ganttScale === 'days') {
        const minW = ganttSettings.colWidthDays !== undefined ? ganttSettings.colWidthDays : 28;
        activeColW = minW;
      } else if (ganttScale === 'weeks') {
        totalWeeks = Math.ceil(totalDays / 7);
        const minW = ganttSettings.colWidthWeeks !== undefined ? ganttSettings.colWidthWeeks : 64;
        activeColW = minW;
      } else if (ganttScale === 'quarters') {
        let tempQ = new Date(timelineStartDate);
        tempQ.setMonth(Math.floor(tempQ.getMonth() / 3) * 3, 1);
        while (tempQ <= timelineEndDate) {
          totalQuartersCols++;
          tempQ.setMonth(tempQ.getMonth() + 3);
        }
        const minW = ganttSettings.colWidthQuarters !== undefined ? ganttSettings.colWidthQuarters : 180;
        activeColW = minW;
      } else {
        let tempMonth = new Date(timelineStartDate);
        tempMonth.setDate(1);
        while (tempMonth <= timelineEndDate) {
          totalMonthsCols++;
          tempMonth.setMonth(tempMonth.getMonth() + 1);
        }
        const minW = ganttSettings.colWidthMonths !== undefined ? ganttSettings.colWidthMonths : 120;
        activeColW = minW;
      }
      
      // Auto-resize / stretch columns if there is space on the right to fit the container width
      if (rightPanelWidth > 0) {
        let totalPeriods = 0;
        if (ganttScale === 'days') {
          totalPeriods = totalDays;
        } else if (ganttScale === 'weeks') {
          totalPeriods = totalWeeks;
        } else if (ganttScale === 'quarters') {
          totalPeriods = totalQuartersCols;
        } else {
          totalPeriods = totalMonthsCols;
        }
        
        if (totalPeriods > 0) {
          // Account for the % Curve column width (80px) and a small buffer to avoid scrollbars
          const minRequiredWidth = totalPeriods * activeColW + 80;
          if (minRequiredWidth < rightPanelWidth) {
            const stretchedW = (rightPanelWidth - 85) / totalPeriods;
            if (stretchedW > activeColW) {
              activeColW = Math.floor(stretchedW);
            }
          }
        }
      }
      
      // Get coordinate for the Current Date line early
      const curDateInput = document.getElementById('ganttCurrentDateInput');
      const curDateStr = curDateInput?.value || localStorage.getItem('cost_estimate_gantt_current_date_v1') || getTodayDateString();
      const curDateCoords = ganttGetCoords(curDateStr, 0, timelineStartDate, ganttScale, activeColW);
      let colW_day = activeColW;
      if (ganttScale === 'weeks') colW_day = activeColW / 7;
      else if (ganttScale === 'months') colW_day = activeColW / 30;
      else if (ganttScale === 'quarters') colW_day = activeColW / 90;
      const curDateX = curDateCoords.left + colW_day;

      let headerRow1Html = '';
      let headerRow2Html = '';
      const altBgColor = ganttSettings.headerAltBgColor || '#dbeafe';
      const rightBgColor = ganttSettings.headerRightBg || '#ffffff';
      
      if (ganttScale === 'days') {
        let currentMonth = '';
        let currentMonthCols = 0;
        let monthIndex = -1;
        const dayMonthIndices = [];
        for (let i = 0; i < totalDays; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          if (mLabel !== currentMonth) {
            monthIndex++;
            currentMonth = mLabel;
          }
          dayMonthIndices.push(monthIndex);
        }

        currentMonth = '';
        currentMonthCols = 0;
        monthIndex = -1;
        for (let i = 0; i < totalDays; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          const dayLabel = d.getDate();
          const dayMonthIdx = dayMonthIndices[i];
          const dayBg = dayMonthIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (mLabel !== currentMonth) {
            if (currentMonth !== '') {
              const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentMonth}</div>`;
            }
            monthIndex++;
            currentMonth = mLabel;
            currentMonthCols = 1;
          } else {
            currentMonthCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; font-size: 8px; justify-content: center; border-right: 1px solid var(--line); ${dayBg}">${dayLabel}</div>`;
        }
        if (currentMonth !== '') {
          const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentMonth}</div>`;
        }
      } else if (ganttScale === 'weeks') {
        let currentMonth = '';
        let currentMonthCols = 0;
        let monthIndex = -1;
        const weekMonthIndices = [];
        for (let w = 0; w < totalWeeks; w++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + w * 7);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          if (mLabel !== currentMonth) {
            monthIndex++;
            currentMonth = mLabel;
          }
          weekMonthIndices.push(monthIndex);
        }

        currentMonth = '';
        currentMonthCols = 0;
        monthIndex = -1;
        for (let w = 0; w < totalWeeks; w++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + w * 7);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          const wkLabel = `W${w + 1}`;
          const wkBg = w % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (mLabel !== currentMonth) {
            if (currentMonth !== '') {
              const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentMonth}</div>`;
            }
            monthIndex++;
            currentMonth = mLabel;
            currentMonthCols = 1;
          } else {
            currentMonthCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; font-size: 9px; justify-content: center; border-right: 1px solid var(--line); ${wkBg}" title="Starts ${formatDateString(d)}">${wkLabel}</div>`;
        }
        if (currentMonth !== '') {
          const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentMonth}</div>`;
        }
      } else if (ganttScale === 'quarters') {
        let currentYear = '';
        let currentYearCols = 0;
        let yearIndex = -1;
        const qYearIndices = [];
        for (let q = 0; q < totalQuartersCols; q++) {
          const d = new Date(timelineStartDate);
          d.setMonth(d.getMonth() + q * 3);
          const yLabel = d.getFullYear().toString();
          if (yLabel !== currentYear) {
            yearIndex++;
            currentYear = yLabel;
          }
          qYearIndices.push(yearIndex);
        }

        currentYear = '';
        currentYearCols = 0;
        yearIndex = -1;
        for (let q = 0; q < totalQuartersCols; q++) {
          const d = new Date(timelineStartDate);
          d.setMonth(d.getMonth() + q * 3);
          const yLabel = d.getFullYear().toString();
          const qLabel = `Q${Math.floor(d.getMonth() / 3) + 1}`;
          const qBg = q % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (yLabel !== currentYear) {
            if (currentYear !== '') {
              const bgStyle = yearIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentYear}</div>`;
            }
            yearIndex++;
            currentYear = yLabel;
            currentYearCols = 1;
          } else {
            currentYearCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; justify-content: center; border-right: 1px solid var(--line); ${qBg}">${qLabel}</div>`;
        }
        if (currentYear !== '') {
          const bgStyle = yearIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentYear}</div>`;
        }
      } else {
        let currentYear = '';
        let currentYearCols = 0;
        const mYearIndices = [];
        let yIdx = -1;
        let cMonth = new Date(timelineStartDate);
        cMonth.setDate(1);
        while (cMonth <= timelineEndDate) {
          const yLabel = cMonth.getFullYear();
          if (yLabel !== currentYear) {
            yIdx++;
            currentYear = yLabel;
          }
          mYearIndices.push(yIdx);
          cMonth.setMonth(cMonth.getMonth() + 1);
        }

        currentYear = '';
        currentYearCols = 0;
        yIdx = -1;
        cMonth = new Date(timelineStartDate);
        cMonth.setDate(1);
        let mIdx = 0;
        while (cMonth <= timelineEndDate) {
          const yLabel = cMonth.getFullYear();
          const mLabel = cMonth.toLocaleDateString('en-US', { month: 'short' });
          const mBg = mIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (yLabel !== currentYear) {
            if (currentYear !== '') {
              const bgStyle = yIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentYear}</div>`;
            }
            yIdx++;
            currentYear = yLabel;
            currentYearCols = 1;
          } else {
            currentYearCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; justify-content: center; border-right: 1px solid var(--line); ${mBg}">${mLabel}</div>`;
          mIdx++;
          cMonth.setMonth(cMonth.getMonth() + 1);
        }
        if (currentYear !== '') {
          const bgStyle = yIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); ${bgStyle}">${currentYear}</div>`;
        }
      }
      
      headerRow1Html += `<div class="gantt-header-cell gantt-curve-cell" style="width: 80px; flex-shrink: 0; font-weight: bold; justify-content: center; border-bottom: 1px solid var(--line);">% Curve</div>`;
      headerRow2Html += `<div class="gantt-header-cell gantt-curve-cell" style="width: 80px; flex-shrink: 0; justify-content: center;"></div>`;
      
      const hHeight = ganttSettings.headerHeight !== undefined ? ganttSettings.headerHeight : 48;
      const hTopHeight = Math.floor(hHeight / 2);
      const hBottomHeight = hHeight - hTopHeight;
      
      let headerRowCoordHtml = '';
      if (ganttSettings.showCoordinates) {
        const startIdx = activeCols.length;
        const totalPeriods = ganttScale === 'days' ? totalDays 
                           : ganttScale === 'weeks' ? totalWeeks 
                           : ganttScale === 'quarters' ? totalQuartersCols 
                           : totalMonthsCols;
        for (let p = 0; p < totalPeriods; p++) {
          const letter = getColLetter(startIdx + p);
          headerRowCoordHtml += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; justify-content: center; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); font-weight: bold; font-size: 10px;">${letter}</div>`;
        }
        const curveLetter = getColLetter(startIdx + totalPeriods);
        headerRowCoordHtml += `<div class="gantt-header-cell gantt-curve-cell" style="width: 80px; flex-shrink: 0; justify-content: center; border-bottom: 1px solid var(--line); font-weight: bold; font-size: 10px;">${curveLetter}</div>`;
      }

      if (ganttSettings.showCoordinates) {
        timelineHeader.innerHTML = `
          <div class="gantt-timeline-header-row row-coord" style="height: ${coordH}px; line-height: ${coordH}px;">${headerRowCoordHtml}</div>
          <div class="gantt-timeline-header-row row-top" style="height: ${hTopHeight}px; line-height: ${hTopHeight}px;">${headerRow1Html}</div>
          <div class="gantt-timeline-header-row row-bottom" style="height: ${hBottomHeight}px; line-height: ${hBottomHeight}px;">${headerRow2Html}</div>
        `;
      } else {
        timelineHeader.innerHTML = `
          <div class="gantt-timeline-header-row row-top" style="height: ${hTopHeight}px; line-height: ${hTopHeight}px;">${headerRow1Html}</div>
          <div class="gantt-timeline-header-row row-bottom" style="height: ${hBottomHeight}px; line-height: ${hBottomHeight}px;">${headerRow2Html}</div>
        `;
      }
      
      timelineBody.className = '';
      timelineBody.style.backgroundImage = 'none';
      
      let timelineHtml = '';
      
      let visibleRowIndex = 0;
      boqData.forEach((row, index) => {
        if (shouldHideGanttHierarchyRow(index)) return;
        visibleRowIndex++;
        const isParent = hasChildRow(boqData, index);
        const taskInfo = taskInfos[index];
        
        populateGanttCoordinateValuesForTask(index, visibleRowIndex, activeCols, taskInfo, row);
        
        // Populate period cell values for standard task
        const startIdx = activeCols.length;
        const totalPeriods = ganttScale === 'days' ? totalDays 
                           : ganttScale === 'weeks' ? totalWeeks 
                           : ganttScale === 'quarters' ? totalQuartersCols 
                           : totalMonthsCols;
        for (let p = 0; p < totalPeriods; p++) {
          const { start: pStart, end: pEnd } = getGanttPeriodDateRange(p, ganttScale, timelineStartDate);
          let val = 0;
          if (isParent) {
            const leaves = getLeafDescendents(index);
            leaves.forEach(lIdx => {
              const lRow = boqData[lIdx];
              if (lRow.ganttPeriodQty) {
                for (const dateStr in lRow.ganttPeriodQty) {
                  const qDate = parseSafeDate(dateStr);
                  if (qDate >= pStart && qDate <= pEnd) {
                    val += parseFloat(lRow.ganttPeriodQty[dateStr]) || 0;
                  }
                }
              }
            });
          } else {
            if (row.ganttPeriodQty) {
              for (const dateStr in row.ganttPeriodQty) {
                const qDate = parseSafeDate(dateStr);
                if (qDate >= pStart && qDate <= pEnd) {
                  val += parseFloat(row.ganttPeriodQty[dateStr]) || 0;
                }
              }
            }
          }
          const colLetter = getColLetter(startIdx + p);
          const cellCoord = `${colLetter}${visibleRowIndex}`;
          ganttCoordinateValues[cellCoord] = val;
        }

        const isSub = row.type === 'subcategory';
        const isSubSub = row.type === 'subsubcategory';
        
        let rowClass = 'gantt-row';
        let indentStyle = '';
        if (row.type === 'category') {
          rowClass += ' row-category';
        } else if (isSub) {
          rowClass += ' row-subcategory';
          indentStyle = 'padding-left: 12px;';
        } else if (isSubSub) {
          rowClass += ' row-subsubcategory';
          indentStyle = 'padding-left: 24px;';
        } else {
          indentStyle = 'padding-left: 36px;';
        }
        
        const tr = document.createElement('tr');
        tr.className = rowClass;
        tr.id = `ganttLeftRow-${index}`;
        tr.dataset.index = index;
        tr.onclick = (e) => {
          highlightGanttRow(index, e);
        };
        
        let cellsHtml = '';
        activeCols.forEach((col, colIdx) => {
          const colIdxInFull = ganttColumns.indexOf(col);
          const colLetter = getColLetter(colIdxInFull);
          const cellCoord = `${colLetter}${visibleRowIndex}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${cellCoord}` : '';
          if (col.id === 'predNo') {
            cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--text-muted);">${index + 1}</td>`;
          } else if (col.id === 'code') {
            cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold;">${escapeHtml(row.code || '')}</td>`;
          } else if (col.id === 'title') {
            const toggleBtnHtml = isParent && (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory')
              ? `<button class="toggle-btn ${row.ganttCollapsed ? 'collapsed' : ''}" type="button" onclick="toggleGanttRowCollapse(${index})" aria-label="Toggle row" style="margin-right: 6px; vertical-align: middle;"></button>`
              : '<span style="display: inline-block; width: 18px;"></span>';
            cellsHtml += `<td style="${indentStyle} font-weight: bold; border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(row.title || '')}${coordTooltip ? ' (' + coordTooltip + ')' : ''}">${toggleBtnHtml}<span style="vertical-align: middle;">${escapeHtml(row.title || '')}</span></td>`;
          } else if (col.id === 'specification') {
            const specVal = row.specification || '';
            const weightStyle = isParent ? 'font-weight: bold; color: var(--muted);' : 'font-size: 11px;';
            cellsHtml += `<td title="${escapeHtml(specVal)}${coordTooltip ? ' (' + coordTooltip + ')' : ''}" style="text-align: left; border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ${weightStyle}">${escapeHtml(specVal)}</td>`;
          } else if (isParent) {
            if (col.id === 'startDate') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? formatDateString(taskInfo.startDate) : ''}</td>`;
            } else if (col.id === 'finishDate') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? formatDateString(taskInfo.endDate) : ''}</td>`;
            } else if (col.id === 'actualStartDate') {
              const actInfo = getGanttActualDates(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${actInfo.startDate}</td>`;
            } else if (col.id === 'actualFinishDate') {
              const actInfo = getGanttActualDates(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${actInfo.finishDate}</td>`;
            } else if (col.id === 'days') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? taskInfo.duration : ''}</td>`;
            } else if (col.id === 'remainingDays') {
              const rem = getGanttRemainingDays(index, taskInfo);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${rem}</td>`;
            } else if (col.id === 'predecessors') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);"></td>`;
            } else if (col.id === 'cost') {
              const parentSummary = computeBOQCategorySummary(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold; color: var(--muted);">${parentSummary && parentSummary.totalCost ? peso(parentSummary.totalCost) : ''}</td>`;
            } else if (col.id === 'estQty') {
              const estQtyVal = getParentEstQty(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${estQtyVal > 0 ? estQtyVal : ''}</td>`;
            } else if (col.id === 'instQty') {
              const instQtyVal = getInstalledQty(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${instQtyVal > 0 ? instQtyVal.toFixed(2) : ''}</td>`;
            } else if (col.id === 'qtyAccmpCost') {
              const accmpCost = getGanttTaskAccomplishedCost(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold; color: var(--muted);">${accmpCost ? peso(accmpCost) : '₱0.00'}</td>`;
            } else if (col.id === 'progress') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; font-weight: bold; color: var(--muted);">${taskInfo ? taskInfo.progress : 0}%</td>`;
            } else if (col.id === 'progressDay') {
              const progressDay = getGanttTaskDayProgress(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; font-weight: bold; color: var(--muted);">${progressDay}%</td>`;
            } else if (col.isCustom) {
              const customVal = (row.ganttCustomValues && row.ganttCustomValues[col.id]) || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: left; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${escapeHtml(customVal)}</td>`;
            }
          } else {
            const startVal = taskInfo ? taskInfo.startStr : projStartStr;
            const durationVal = taskInfo ? taskInfo.duration : 5;
            const progressVal = taskInfo ? taskInfo.progress : 0;
            const predVal = row.ganttPredecessors || '';
            
            if (col.id === 'startDate') {
              if (taskInfo && taskInfo.hasPredecessors) {
                cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--muted);">${startVal}</td>`;
              } else {
                cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${startVal}" onchange="updateGanttTask(${index}, 'ganttStartDate', this.value)"></td>`;
              }
            } else if (col.id === 'finishDate') {
              const finishVal = taskInfo && taskInfo.endDate ? formatDateString(taskInfo.endDate) : '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${finishVal}" onchange="updateGanttTask(${index}, 'ganttFinishDate', this.value)"></td>`;
            } else if (col.id === 'actualStartDate') {
              const actStartVal = row.ganttActualStartDate || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${actStartVal}" onchange="updateGanttTask(${index}, 'ganttActualStartDate', this.value)"></td>`;
            } else if (col.id === 'actualFinishDate') {
              const actFinishVal = row.ganttActualFinishDate || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${actFinishVal}" onchange="updateGanttTask(${index}, 'ganttActualFinishDate', this.value)"></td>`;
            } else if (col.id === 'days') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="number" min="1" value="${durationVal}" onchange="updateGanttTask(${index}, 'ganttDuration', this.value)"></td>`;
            } else if (col.id === 'remainingDays') {
              const rem = getGanttRemainingDays(index, taskInfo);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${rem}</td>`;
            } else if (col.id === 'predecessors') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="text" value="${predVal}" placeholder="e.g. 1" style="text-align: left; padding: 2px 6px;" onchange="updateGanttTask(${index}, 'ganttPredecessors', this.value)"></td>`;
            } else if (col.id === 'cost') {
              const leafValues = computeBOQDisplayValues(row);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-size: 11px; font-weight: bold; color: var(--text);">${leafValues && leafValues.grandTotalCost ? peso(leafValues.grandTotalCost) : '₱0.00'}</td>`;
            } else if (col.id === 'estQty') {
              const displayValues = computeBOQDisplayValues(row);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${displayValues ? displayValues.qty : 0}</td>`;
            } else if (col.id === 'instQty') {
              const displayValues = computeBOQDisplayValues(row);
              const estQty = displayValues ? displayValues.qty : 0;
              const progress = parseInt(row.ganttProgress, 10) || 0;
             const instQtyVal = getInstalledQty(index).toFixed(2);
             cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="number" min="0" step="any" value="${instQtyVal}" onchange="updateGanttTask(${index}, 'ganttInstalledQty', this.value)"></td>`;
            } else if (col.id === 'qtyAccmpCost') {
              const accmpCost = getGanttTaskAccomplishedCost(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-size: 11px; font-weight: bold; color: var(--text);">${accmpCost ? peso(accmpCost) : '₱0.00'}</td>`;
            } else if (col.id === 'progress') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${progressVal.toFixed(2)}%</td>`;
            } else if (col.id === 'progressDay') {
              const progressDay = getGanttTaskDayProgress(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--muted);">${progressDay}%</td>`;
            } else if (col.isCustom) {
              const customVal = (row.ganttCustomValues && row.ganttCustomValues[col.id]) || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: left; border-right: 1px solid var(--line);"><input type="text" value="${escapeHtml(customVal)}" placeholder="Text..." style="text-align: left; padding: 2px 6px;" onchange="updateGanttCustomValue(${index}, '${col.id}', this.value)"></td>`;
            }
          }
        });
        
        if (ganttSettings.showCoordinates) {
          cellsHtml = `<td class="gantt-coord-cell" style="width: 40px; text-align: center; font-weight: bold;">${visibleRowIndex}</td>` + cellsHtml;
        }
        tr.innerHTML = cellsHtml;
        taskTableFragment.appendChild(tr);
        
        let barHtml = '';
        if (taskInfo) {
          const coords = ganttGetCoords(taskInfo.startDate, taskInfo.duration, timelineStartDate, ganttScale, activeColW);
          const percent = taskInfo.progress || 0;
          const curDateRelativeX = curDateX - coords.left;
          
          const actDates = getGanttActualDates(index);
          let actualCoords = null;
          let actualDuration = 0;
          if (actDates.startDate && actDates.finishDate) {
            const aStart = parseSafeDate(actDates.startDate);
            const aFinish = parseSafeDate(actDates.finishDate);
            aStart.setHours(12, 0, 0, 0);
            aFinish.setHours(12, 0, 0, 0);
            actualDuration = Math.round((aFinish - aStart) / (1000 * 60 * 60 * 24)) + 1;
            if (actualDuration < 1) actualDuration = 1;
            actualCoords = ganttGetCoords(actDates.startDate, actualDuration, timelineStartDate, ganttScale, activeColW);
          }
          const curDateRelativeX_actual = actualCoords ? curDateX - actualCoords.left : 0;

          const labelLoc = ganttSettings.barLabelLocation || 'right';
          const labelSize = ganttSettings.barLabelSize !== undefined ? ganttSettings.barLabelSize : 8;
          const labelScope = ganttSettings.barLabelScope || 'all';
          const isScopeMatch = labelScope === 'all' || 
                               (labelScope === 'tasks' && !isParent) || 
                               (labelScope === 'summary' && isParent);

          const showCostLabel = (ganttSettings.showCostLabel !== false) && isScopeMatch;
          const showDayLabel = (ganttSettings.showDayLabel !== false) && isScopeMatch;
          const showActualLabel = (ganttSettings.showActualLabel !== false) && isScopeMatch;
          
          const hVal = isParent ? ganttSettings.summaryBarHeight : ganttSettings.taskBarHeight;
          const gapVal = ganttSettings.barGap !== undefined ? ganttSettings.barGap : 2;
          
          const hasActual = !!actualCoords;
          const numBars = hasActual ? 3 : 2;
          const totalBarsHeight = numBars * hVal + (numBars - 1) * gapVal;
          
          let topOffset = 0;
          const barAlign = ganttSettings.barVerticalAlign || 'middle';
          if (barAlign === 'top') {
            topOffset = 2;
          } else if (barAlign === 'bottom') {
            topOffset = ganttSettings.rowHeight - totalBarsHeight - 2;
          } else {
            topOffset = (ganttSettings.rowHeight - totalBarsHeight) / 2;
          }
          if (topOffset < 0) topOffset = 0;
          
          const arrange = ganttSettings.barArrangement || 'planned_actual';
          let plannedTop = 0;
          let actualTop = 0;
          if (hasActual) {
            if (arrange === 'planned_actual') {
              plannedTop = topOffset;
              actualTop = topOffset + 2 * hVal + 2 * gapVal;
            } else {
              actualTop = topOffset;
              plannedTop = topOffset + hVal + gapVal;
            }
          } else {
            plannedTop = topOffset;
          }

          if (isParent) {
            const progressDay = getGanttTaskDayProgress(index);
            barHtml = `
              <div class="gantt-bar-wrapper" style="position: absolute; left: ${coords.left}px; width: ${coords.width}px; flex-direction: column; gap: ${gapVal}px; align-items: stretch; justify-content: space-between; height: ${2 * hVal + gapVal}px; top: ${plannedTop}px;" title="${escapeHtml(row.title)}: ${taskInfo.duration} days (${formatDateString(taskInfo.startDate)} to ${formatDateString(taskInfo.endDate)})\nProgress (Cost): ${percent.toFixed(barLabelDecimals)}%\nProgress (Day): ${progressDay.toFixed(barLabelDecimals)}%">
                <!-- Cost Summary Bar -->
                <div class="gantt-summary-bar-bg" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 1px;">
                  <div class="gantt-summary-bar-cost" style="width: ${percent}%; height: 100%; border-radius: 1px 0 0 1px;"></div>
                  ${showCostLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'parent', 'cost', percent, progressDay, curDateRelativeX)}">${percent.toFixed(barLabelDecimals)}% (Cost)</span>` : ''}
                </div>
                <!-- Day Summary Bar -->
                <div class="gantt-summary-bar-bg" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 1px; overflow: visible;">
                  <div class="gantt-summary-bar-day" style="position: absolute; right: calc(100% - ${curDateRelativeX}px); width: ${progressDay}%; height: 100%; border-radius: 1px 0 0 1px;"></div>
                  ${showDayLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'parent', 'day', percent, progressDay, curDateRelativeX)}">${progressDay.toFixed(barLabelDecimals)}% (Day)</span>` : ''}
                </div>
              </div>
            `;
            
            if (actualCoords) {
              barHtml += `
                <div class="gantt-bar-wrapper actual-bar-wrapper" style="position: absolute; left: ${actualCoords.left}px; width: ${actualCoords.width}px; flex-direction: column; justify-content: center; height: ${hVal}px; top: ${actualTop}px;" title="Actual: ${actualDuration} days (${formatDateString(parseSafeDate(actDates.startDate))} to ${formatDateString(parseSafeDate(actDates.finishDate))})">
                  <!-- Actual Summary Bar -->
                  <div class="gantt-summary-bar-bg-actual" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 1px;">
                    <div class="gantt-summary-bar-actual" style="width: 100%; height: 100%; border-radius: 1px 0 0 1px;"></div>
                    ${showActualLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'parent', 'actual', percent, progressDay, curDateRelativeX_actual)}">Actual</span>` : ''}
                  </div>
                </div>
              `;
            }
          } else {
            const progressDay = getGanttTaskDayProgress(index);
            const handleTop = Math.max(0, Math.floor(((2 * hVal + gapVal) - 12) / 2));
            barHtml = `
              <div class="gantt-bar-wrapper" style="position: absolute; left: ${coords.left}px; width: ${coords.width}px; flex-direction: column; gap: ${gapVal}px; align-items: stretch; justify-content: space-between; height: ${2 * hVal + gapVal}px; top: ${plannedTop}px;" title="${escapeHtml(row.title)}: ${taskInfo.duration} days (${formatDateString(taskInfo.startDate)} to ${formatDateString(taskInfo.endDate)})\nProgress (Cost): ${percent.toFixed(barLabelDecimals)}%\nProgress (Day): ${progressDay.toFixed(barLabelDecimals)}%">
                <!-- Cost Bar -->
                <div class="gantt-bar-bg-task" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 2px; overflow: visible; box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);">
                  <div class="gantt-bar-cost" style="width: ${percent}%; height: 100%; border-radius: 2px 0 0 2px;"></div>
                  ${showCostLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'child', 'cost', percent, progressDay, curDateRelativeX)}">${percent.toFixed(barLabelDecimals)}% (Cost)</span>` : ''}
                </div>
                <!-- Day Bar -->
                <div class="gantt-bar-bg-task" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 2px; overflow: visible; box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);">
                  <div class="gantt-bar-day" style="position: absolute; right: calc(100% - ${curDateRelativeX}px); width: ${progressDay}%; height: 100%; border-radius: 2px 0 0 2px;"></div>
                  ${showDayLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'child', 'day', percent, progressDay, curDateRelativeX)}">${progressDay.toFixed(barLabelDecimals)}% (Day)</span>` : ''}
                </div>
                <div class="gantt-bar-handle handle-left" data-index="${index}" data-type="start" title="Drag to create link (Start)" style="position: absolute; left: -6px; top: ${handleTop}px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: 2px solid white; cursor: crosshair; z-index: 10; opacity: 0; transition: opacity 0.15s;"></div>
                <div class="gantt-bar-handle handle-right" data-index="${index}" data-type="finish" title="Drag to create link (Finish)" style="position: absolute; right: -6px; top: ${handleTop}px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: 2px solid white; cursor: crosshair; z-index: 10; opacity: 0; transition: opacity 0.15s;"></div>
              </div>
            `;
            
            if (actualCoords) {
              barHtml += `
                <div class="gantt-bar-wrapper actual-bar-wrapper" style="position: absolute; left: ${actualCoords.left}px; width: ${actualCoords.width}px; flex-direction: column; justify-content: center; height: ${hVal}px; top: ${actualTop}px;" title="Actual: ${actualDuration} days (${formatDateString(parseSafeDate(actDates.startDate))} to ${formatDateString(parseSafeDate(actDates.finishDate))})">
                  <!-- Actual Task Bar -->
                  <div class="gantt-bar-bg-actual" style="width: 100%; height: ${hVal}px; position: relative; border-radius: 2px; overflow: visible; box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);">
                    <div class="gantt-bar-actual" style="width: 100%; height: 100%; border-radius: 2px 0 0 2px;"></div>
                    ${showActualLabel ? `<span class="gantt-bar-label" style="${getGanttBarLabelStyle(labelLoc, labelSize, 'child', 'actual', percent, progressDay, curDateRelativeX_actual)}">Actual</span>` : ''}
                  </div>
                </div>
              `;
            }
          }
        }
        
        const vIdx = ganttVisibleIndices.indexOf(index);
        const remainingVisible = ganttVisibleIndices.length - vIdx;
        const weightVal = ((remainingVisible / ganttVisibleIndices.length) * 100).toFixed(scurveLabelDecimals) + '%';
        const curveColLetter = getColLetter(startIdx + totalPeriods);
        const curveCoord = `${curveColLetter}${visibleRowIndex}`;
        const curveCoordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${curveCoord}` : '';
        barHtml += `
          <div class="gantt-curve-cell" style="position: absolute; right: 0; top: 0; width: 80px; height: 100%; background: var(--card, #ffffff); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 11px; z-index: 8;" title="${curveCoordTooltip}">
            ${weightVal}
          </div>
        `;
        
        ganttRightRowHtmlCache[index] = barHtml;
        timelineHtml += `<div class="gantt-timeline-row" id="ganttRightRow-${index}" onclick="highlightGanttRow(${index}, event)" style="height: ${rowH}px; display: flex; position: relative;"></div>`;
      });
      
      const totalVisibleTaskRows = visibleRowIndex;
      
      // Append 5 blank "Summary of Accomplishment" rows at the end of the Gantt task table and timeline
      const accomplishmentLabels = [
        "Summary of Accomplishment",
        "Progress % (Cost) Summary",
        "Progress % (Day) Summary",
        "Cash Flow (Estimated)",
        "Cash Flow (Day)"
      ];
      
      const leafDateRange = getGanttLeafTasksDateRange();
      const minStartStr = leafDateRange.minStart ? formatDateString(leafDateRange.minStart) : '';
      const maxEndStr = leafDateRange.maxEnd ? formatDateString(leafDateRange.maxEnd) : '';

      let totalProjectCost = 0;
      boqData.forEach((row, idx) => {
        if (!hasChildRow(boqData, idx)) {
          const displayValues = computeBOQDisplayValues(row) || {};
          totalProjectCost += displayValues.grandTotalCost || 0;
        }
      });

      for (let i = 0; i < 5; i++) {
        visibleRowIndex++;
        const label = accomplishmentLabels[i];
        const tr = document.createElement('tr');
        tr.className = 'gantt-row gantt-accomplishment-row';
        tr.id = `ganttLeftRow-${boqData.length + i}`;
        tr.onclick = (e) => {
          highlightGanttRow(boqData.length + i, e);
        };
        
        let cellsHtml = '';
        activeCols.forEach((col, colIdx) => {
          const colIdxInFull = ganttColumns.indexOf(col);
          const colLetter = getColLetter(colIdxInFull);
          const cellCoord = `${colLetter}${boqData.length + i + 1}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${colLetter}${visibleRowIndex}` : '';
          if (col.id === 'title') {
            cellsHtml += `<td title="${coordTooltip}" style="font-weight: bold; border-right: 1px solid var(--line); padding-left: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: var(--bg);" title="${escapeHtml(label)}${coordTooltip ? ' (' + coordTooltip + ')' : ''}">${escapeHtml(label)}</td>`;
          } else if (col.id === 'startDate') {
            cellsHtml += `
              <td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: var(--bg); vertical-align: middle; padding: 0 !important; height: 100%;">
                <div class="gantt-summary-cell-wrapper" style="justify-content: center; height: 100%; display: flex; align-items: center;">
                  <span style="font-size: 10px; font-weight: bold;">${escapeHtml(minStartStr)}</span>
                </div>
              </td>
            `;
          } else if (col.id === 'finishDate') {
            cellsHtml += `
              <td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: var(--bg); vertical-align: middle; padding: 0 !important; height: 100%;">
                <div class="gantt-summary-cell-wrapper" style="justify-content: center; height: 100%; display: flex; align-items: center;">
                  <span style="font-size: 10px; font-weight: bold;">${escapeHtml(maxEndStr)}</span>
                </div>
              </td>
            `;
          } else if (['days', 'remainingDays', 'cost', 'estQty', 'instQty', 'qtyAccmpCost', 'progress', 'progressDay'].includes(col.id)) {
            const func = getGanttSummaryCellFunction(label, col.id);
            const leafValues = [];
            boqData.forEach((row, idx) => {
              if (func === 'subtotal') {
                if (row.type === 'category') {
                  leafValues.push(getGanttSummaryTaskValue(idx, label, col.id));
                }
              } else {
                if (!hasChildRow(boqData, idx)) {
                  leafValues.push(getGanttSummaryTaskValue(idx, label, col.id));
                }
              }
            });
            const computedVal = aggregateSummaryValues(leafValues, func);
            
            let formulaStr = ganttSummaryFormulas[cellCoord] || '';
            let displayVal = '';
            let val = computedVal;
            
            if (formulaStr) {
              const evalRes = evaluateCellFormula(formulaStr, ganttCoordinateValues);
              val = typeof evalRes === 'number' ? evalRes : computedVal;
              if (typeof evalRes === 'number') {
                if (col.id === 'cost' || col.id === 'qtyAccmpCost') displayVal = peso(evalRes);
                else if (col.id === 'progress' || col.id === 'progressDay') displayVal = evalRes.toFixed(barLabelDecimals) + '%';
                else displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              } else {
                displayVal = evalRes;
              }
            } else {
              if (func !== 'none') {
                if (col.id === 'cost' || col.id === 'qtyAccmpCost') {
                  displayVal = peso(computedVal);
                } else if (col.id === 'progress' || col.id === 'progressDay') {
                  displayVal = computedVal.toFixed(barLabelDecimals) + '%';
                } else {
                  displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                }
              }
            }
            ganttCoordinateValues[cellCoord] = val;
            
            cellsHtml += `
              <td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: var(--bg); vertical-align: middle; padding: 0 !important; height: 100%;">
                <div class="gantt-summary-cell-wrapper" style="height: 100%; display: flex; align-items: center; justify-content: flex-end; padding: 0 4px; box-sizing: border-box;">
                  <span style="font-size: 10px; font-weight: bold; text-align: right; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(displayVal)}">
                    ${displayVal}
                  </span>
                  <span class="dropdown-arrow" style="font-size: 7px; color: #9ca3af; margin-left: 4px; display: none; pointer-events: none;">▼</span>
                  <select onchange="setGanttSummaryCellFunction('${escapeHtml(label)}', '${col.id}', this.value)" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;">
                    <option value="none" ${func === 'none' ? 'selected' : ''}>- None</option>
                    <option value="subtotal" ${func === 'subtotal' ? 'selected' : ''}>Subtotal</option>
                    <option value="max" ${func === 'max' ? 'selected' : ''}>Max</option>
                    <option value="min" ${func === 'min' ? 'selected' : ''}>Min</option>
                    <option value="sum" ${func === 'sum' ? 'selected' : ''}>Sum</option>
                  </select>
                </div>
              </td>
            `;
          } else {
            cellsHtml += `<td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: var(--bg); padding: 0 !important;"></td>`;
          }
        });
        if (ganttSettings.showCoordinates) {
          cellsHtml = `<td class="gantt-coord-cell" style="width: 40px; text-align: center; font-weight: bold;">${visibleRowIndex}</td>` + cellsHtml;
        }
        tr.innerHTML = cellsHtml;
        taskTableFragment.appendChild(tr);
        
        let periodCellsHtml = '';
        const totalPeriods = ganttScale === 'days' ? totalDays 
                           : ganttScale === 'weeks' ? totalWeeks 
                           : ganttScale === 'quarters' ? totalQuartersCols 
                           : totalMonthsCols;
        
        let lastActiveP = -1;
        if (['Summary of Accomplishment', 'Progress % (Cost) Summary'].includes(label)) {
          for (let p = 0; p < totalPeriods; p++) {
            const { start: pStart, end: pEnd } = getGanttPeriodDateRange(p, ganttScale, timelineStartDate);
            let periodAccomplishment = 0;
            boqData.forEach((row, idx) => {
              if (!hasChildRow(boqData, idx)) {
                periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
              }
            });
            if (periodAccomplishment > 0) {
              lastActiveP = p;
            }
          }
        }

        let runningAccomplishment = 0;
        let runningCashFlowEstimated = 0;
        let rowSum = 0;
        const startIdx = activeCols.length;
        for (let p = 0; p < totalPeriods; p++) {
          const { start: pStart, end: pEnd } = getGanttPeriodDateRange(p, ganttScale, timelineStartDate);
          const colId = `period_${p}`;
          const periodColLetter = getColLetter(startIdx + p);
          const periodCellCoord = `${periodColLetter}${boqData.length + i + 1}`;
          const periodCoordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${periodColLetter}${visibleRowIndex}` : '';
          const isFormulaRow = [
            'Summary of Accomplishment',
            'Progress % (Cost) Summary',
            'Progress % (Day) Summary',
            'Cash Flow (Estimated)'
          ].includes(label);
          
          let displayVal = '';
          const left = p * activeColW;
          
          let computedVal = 0;
          if (isFormulaRow) {
            if (label === 'Summary of Accomplishment') {
              let periodAccomplishment = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
                }
              });
              runningAccomplishment += periodAccomplishment;
              computedVal = runningAccomplishment;
              displayVal = peso(computedVal);
            } else if (label === 'Progress % (Cost) Summary') {
              let periodAccomplishment = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
                }
              });
              runningAccomplishment += periodAccomplishment;
              computedVal = totalProjectCost > 0 ? (runningAccomplishment / totalProjectCost) * 100 : 0;
              displayVal = computedVal.toFixed(scurveLabelDecimals) + '%';
            } else if (label === 'Progress % (Day) Summary') {
              let totalOverlapDays = 0;
              let totalDuration = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  const taskInfo = taskInfos[idx];
                  if (taskInfo && taskInfo.startDate && taskInfo.endDate) {
                    const tStart = taskInfo.startDate;
                    const duration = taskInfo.duration || 0;
                    if (duration > 0) {
                      const overlapDays = getGanttTaskOverlapDays(idx, tStart, pEnd);
                      totalOverlapDays += overlapDays;
                      totalDuration += duration;
                    }
                  }
                }
              });
              computedVal = totalDuration > 0 ? (totalOverlapDays / totalDuration) * 100 : 0;
              displayVal = computedVal.toFixed(scurveLabelDecimals) + '%';
            } else if (label === 'Cash Flow (Estimated)') {
              let periodCostFlow = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodCostFlow += getGanttSummaryTaskTimelineValue(idx, 'Cash Flow (Estimated)', pStart, pEnd);
                }
              });
              runningCashFlowEstimated += periodCostFlow;
              computedVal = runningCashFlowEstimated;
              displayVal = peso(computedVal);
            }
          } else {
            const func = getGanttSummaryCellFunction(label, colId);
            const leafValues = [];
            boqData.forEach((row, idx) => {
              if (func === 'subtotal') {
                if (row.type === 'category') {
                  leafValues.push(getGanttSummaryTaskTimelineValue(idx, label, pStart, pEnd));
                }
              } else {
                if (!hasChildRow(boqData, idx)) {
                  leafValues.push(getGanttSummaryTaskTimelineValue(idx, label, pStart, pEnd));
                }
              }
            });
            
            computedVal = aggregateSummaryValues(leafValues, func);
            
            if (func !== 'none') {
              if (label === 'Summary of Accomplishment' || label === 'Cash Flow (Estimated)') {
                displayVal = peso(computedVal);
              } else if (label === 'Progress % (Cost) Summary' || label === 'Progress % (Day) Summary') {
                displayVal = computedVal.toFixed(scurveLabelDecimals) + '%';
              } else if (label === 'Cash Flow (Day)') {
                displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
              } else {
                displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              }
            }
          }
          
          let formulaStr = ganttSummaryFormulas[periodCellCoord] || '';
          let val = computedVal;
          if (formulaStr) {
            const evalRes = evaluateCellFormula(formulaStr, ganttCoordinateValues);
            val = typeof evalRes === 'number' ? evalRes : computedVal;
            if (typeof evalRes === 'number') {
              if (label === 'Summary of Accomplishment' || label === 'Cash Flow (Estimated)') {
                displayVal = peso(evalRes);
              } else if (label === 'Progress % (Cost) Summary' || label === 'Progress % (Day) Summary') {
                displayVal = evalRes.toFixed(scurveLabelDecimals) + '%';
              } else if (label === 'Cash Flow (Day)') {
                displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
              } else {
                displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              }
            } else {
              displayVal = evalRes;
            }
          }
          if (['Summary of Accomplishment', 'Progress % (Cost) Summary'].includes(label)) {
            const curDateInput = document.getElementById('ganttCurrentDateInput');
            const curStr = (curDateInput && curDateInput.value) || localStorage.getItem('cost_estimate_gantt_current_date_v1');
            const current = curStr ? parseSafeDate(curStr) : new Date();
            
            const pStartCopy = new Date(pStart);
            pStartCopy.setHours(0, 0, 0, 0);
            
            const currentCopy = new Date(current);
            currentCopy.setHours(0, 0, 0, 0);
            
            if (pStartCopy.getTime() > currentCopy.getTime()) {
              displayVal = '';
            } else if (p > lastActiveP) {
              displayVal = '';
            }
          }
          if (isFormulaRow) {
            rowSum = val;
          } else {
            rowSum += val;
          }
          ganttCoordinateValues[periodCellCoord] = val;
          
          if (isFormulaRow) {
            periodCellsHtml += `
              <div class="gantt-timeline-summary-cell" style="position: absolute; left: ${left}px; width: ${activeColW}px; height: 100%; border-right: 1px solid var(--line); box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: var(--bg); overflow: hidden; z-index: 6; padding: 0 2px;" title="${periodCoordTooltip}">
                <span style="font-size: 10px; font-weight: bold; text-align: center; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(displayVal)}">
                  ${displayVal}
                </span>
              </div>
            `;
          } else {
            const func = getGanttSummaryCellFunction(label, colId);
            periodCellsHtml += `
              <div class="gantt-timeline-summary-cell" style="position: absolute; left: ${left}px; width: ${activeColW}px; height: 100%; border-right: 1px solid var(--line); box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: var(--bg); overflow: hidden; z-index: 6; padding: 0 2px;" title="${periodCoordTooltip}">
                <span style="font-size: 10px; font-weight: bold; text-align: center; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(displayVal)}">
                  ${displayVal}
                </span>
                <span class="dropdown-arrow" style="font-size: 7px; color: #9ca3af; margin-left: 2px; display: none; pointer-events: none;">▼</span>
                <select onchange="setGanttSummaryCellFunction('${escapeHtml(label)}', '${colId}', this.value)" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;">
                  <option value="none" ${func === 'none' ? 'selected' : ''}>-</option>
                  <option value="subtotal" ${func === 'subtotal' ? 'selected' : ''}>Sub</option>
                  <option value="max" ${func === 'max' ? 'selected' : ''}>Max</option>
                  <option value="min" ${func === 'min' ? 'selected' : ''}>Min</option>
                  <option value="sum" ${func === 'sum' ? 'selected' : ''}>Sum</option>
                </select>
              </div>
            `;
          }
        }
        
        let displaySumStr = '';
        if (label === 'Summary of Accomplishment' || label === 'Cash Flow (Estimated)') {
          displaySumStr = peso(rowSum);
        } else if (label === 'Progress % (Cost) Summary' || label === 'Progress % (Day) Summary') {
          displaySumStr = rowSum.toFixed(scurveLabelDecimals) + '%';
        } else if (label === 'Cash Flow (Day)') {
          displaySumStr = rowSum.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
        } else {
          displaySumStr = rowSum.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }
        
        const curveColLetter = getColLetter(startIdx + totalPeriods);
        const curveCellCoord = `${curveColLetter}${visibleRowIndex}`;
        const curveCoordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${curveCellCoord}` : '';
        const curveHtml = `
          <div class="gantt-curve-cell" style="position: absolute; right: 0; top: 0; width: 80px; height: 100%; background: var(--bg, #f9fafb); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 10px; z-index: 8;" title="${curveCoordTooltip}">
            ${displaySumStr}
          </div>
        `;
        ganttRightRowHtmlCache[boqData.length + i] = `${periodCellsHtml}${curveHtml}`;
        timelineHtml += `<div class="gantt-timeline-row gantt-accomplishment-timeline-row" id="ganttRightRow-${boqData.length + i}" onclick="highlightGanttRow(${boqData.length + i}, event)" style="position: relative; height: ${rowH}px; display: flex; background: transparent;"></div>`;
      }
      taskTableBody.appendChild(taskTableFragment);
      
      let gridLinesHtml = '';
      if (ganttScale === 'days') {
        for (let i = 1; i < totalDays; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i);
          let x = i * activeColW;
          
          if (d.getDate() === 1) {
            // Month boundary
            if ((ganttSettings.gridMonthStyle || 'solid') !== 'none') {
              const weight = ganttSettings.gridMonthWeight !== undefined ? ganttSettings.gridMonthWeight : 1;
              const color = ganttSettings.gridMonthColor || '#94a3b8';
              const dash = ganttSettings.gridMonthStyle === 'dashed' ? '4,4' : (ganttSettings.gridMonthStyle === 'dotted' ? '1,3' : 'none');
              gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
            }
          } else if (d.getDay() === 1) {
            // Week boundary
            if ((ganttSettings.gridWeekStyle || 'solid') !== 'none') {
              const weight = ganttSettings.gridWeekWeight !== undefined ? ganttSettings.gridWeekWeight : 1;
              const color = ganttSettings.gridWeekColor || '#cbd5e1';
              const dash = ganttSettings.gridWeekStyle === 'dashed' ? '4,4' : (ganttSettings.gridWeekStyle === 'dotted' ? '1,3' : 'none');
              gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
            }
          } else {
            // Day boundary
            if ((ganttSettings.gridDayStyle || 'solid') !== 'none') {
              const weight = ganttSettings.gridDayWeight !== undefined ? ganttSettings.gridDayWeight : 1;
              const color = ganttSettings.gridDayColor || '#f1f5f9';
              const dash = ganttSettings.gridDayStyle === 'dashed' ? '4,4' : (ganttSettings.gridDayStyle === 'dotted' ? '1,3' : 'none');
              gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
            }
          }
        }
      } else if (ganttScale === 'weeks') {
        const totalWeeks = Math.ceil(totalDays / 7);
        for (let i = 1; i < totalWeeks; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i * 7);
          let x = i * activeColW;
          
          const prevD = new Date(d);
          prevD.setDate(d.getDate() - 7);
          
          if (d.getMonth() !== prevD.getMonth()) {
            // Month boundary
            if ((ganttSettings.gridMonthStyle || 'solid') !== 'none') {
              const weight = ganttSettings.gridMonthWeight !== undefined ? ganttSettings.gridMonthWeight : 1;
              const color = ganttSettings.gridMonthColor || '#94a3b8';
              const dash = ganttSettings.gridMonthStyle === 'dashed' ? '4,4' : (ganttSettings.gridMonthStyle === 'dotted' ? '1,3' : 'none');
              gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
            }
          } else {
            // Week boundary
            if ((ganttSettings.gridWeekStyle || 'solid') !== 'none') {
              const weight = ganttSettings.gridWeekWeight !== undefined ? ganttSettings.gridWeekWeight : 1;
              const color = ganttSettings.gridWeekColor || '#cbd5e1';
              const dash = ganttSettings.gridWeekStyle === 'dashed' ? '4,4' : (ganttSettings.gridWeekStyle === 'dotted' ? '1,3' : 'none');
              gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
            }
          }
        }
      } else if (ganttScale === 'quarters') {
        for (let i = 1; i < totalQuartersCols; i++) {
          let x = i * activeColW;
          if ((ganttSettings.gridMonthStyle || 'solid') !== 'none') {
            const weight = ganttSettings.gridMonthWeight !== undefined ? ganttSettings.gridMonthWeight : 1;
            const color = ganttSettings.gridMonthColor || '#94a3b8';
            const dash = ganttSettings.gridMonthStyle === 'dashed' ? '4,4' : (ganttSettings.gridMonthStyle === 'dotted' ? '1,3' : 'none');
            gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
          }
        }
      } else if (ganttScale === 'months') {
        let temp = new Date(timelineStartDate);
        temp.setDate(1);
        let colIndex = 1;
        while (true) {
          temp.setMonth(temp.getMonth() + 1);
          if (temp > timelineEndDate) break;
          
          let x = colIndex * activeColW;
          if ((ganttSettings.gridMonthStyle || 'solid') !== 'none') {
            const weight = ganttSettings.gridMonthWeight !== undefined ? ganttSettings.gridMonthWeight : 1;
            const color = ganttSettings.gridMonthColor || '#94a3b8';
            const dash = ganttSettings.gridMonthStyle === 'dashed' ? '4,4' : (ganttSettings.gridMonthStyle === 'dotted' ? '1,3' : 'none');
            gridLinesHtml += `<line x1="${x}" y1="0" x2="${x}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />`;
          }
          colIndex++;
        }
      }

      // Draw Current Date line using early calculated coordinates and add a date pill at header height
      let currentDateLineHtml = '';
      if (curDateX >= 0) {
        const weight = ganttSettings.gridProjWeight !== undefined ? ganttSettings.gridProjWeight : 2;
        const color = ganttSettings.gridProjColor || '#ef4444';
        const style = ganttSettings.gridProjStyle || 'dashed';
        const dash = style === 'dashed' ? '4,4' : (style === 'dotted' ? '1,3' : 'none');
        if (style !== 'none') {
          let dateDisplay = 'Today';
          try {
            const dObj = new Date(curDateStr);
            if (!isNaN(dObj.getTime())) {
              const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
              dateDisplay = `${dObj.getDate()} ${months[dObj.getMonth()]}`;
            }
          } catch(e) {}
          
          const coordH = ganttSettings.coordHeaderHeight !== undefined ? ganttSettings.coordHeaderHeight : 24;
          const barLabelDecimals = ganttSettings.barLabelDecimals !== undefined ? ganttSettings.barLabelDecimals : 0;
          const scurveLabelDecimals = ganttSettings.scurveLabelDecimals !== undefined ? ganttSettings.scurveLabelDecimals : 2;
          const textY = Math.floor(coordH / 2) + 3;
          const rectY = Math.floor(coordH / 2) - 8;
          currentDateLineHtml = `
            <line x1="${curDateX}" y1="0" x2="${curDateX}" y2="100%" stroke="${color}" stroke-width="${weight}" stroke-dasharray="${dash}" />
            <g transform="translate(${curDateX}, 0)">
              <rect x="-24" y="${rectY}" width="48" height="15" rx="3" fill="${color}" opacity="0.9" />
              <text x="0" y="${textY}" fill="#ffffff" font-size="8px" font-weight="bold" text-anchor="middle">${dateDisplay}</text>
            </g>
          `;
        }
      }

      const connColor = ganttSettings.connectorColor || '#6b7280';
      const connWeight = ganttSettings.connectorWeight !== undefined ? ganttSettings.connectorWeight : 1.5;
      const connStyle = ganttSettings.connectorStyle || 'solid';
      const connStart = ganttSettings.connectorStartHead || 'none';
      const connEnd = ganttSettings.connectorEndHead || 'arrow';
      const connHeadSize = ganttSettings.connectorHeadSize !== undefined ? ganttSettings.connectorHeadSize : 6;
      
      const connDash = connStyle === 'dashed' ? '4,4' : (connStyle === 'dotted' ? '1,3' : 'none');
      
      let startMarkerHtml = '';
      if (connStart !== 'none') {
        let pathHtml = '';
        if (connStart === 'arrow') {
          pathHtml = `<path d="M 7 1.5 L 0 5 L 7 8.5 z" fill="${connColor}"></path>`;
        } else if (connStart === 'circle') {
          pathHtml = `<circle cx="5" cy="5" r="3.5" fill="${connColor}"></circle>`;
        } else if (connStart === 'square') {
          pathHtml = `<rect x="1.5" y="1.5" width="7" height="7" fill="${connColor}"></rect>`;
        } else if (connStart === 'diamond') {
          pathHtml = `<path d="M 5 1.5 L 8.5 5 L 5 8.5 L 1.5 5 z" fill="${connColor}"></path>`;
        }
        startMarkerHtml = `<marker id="conn-start" viewBox="0 0 10 10" refX="4" refY="5" markerWidth="${connHeadSize}" markerHeight="${connHeadSize}" markerUnits="userSpaceOnUse" orient="auto-start-reverse">${pathHtml}</marker>`;
      }

      let endMarkerHtml = '';
      if (connEnd !== 'none') {
        let pathHtml = '';
        if (connEnd === 'arrow') {
          pathHtml = `<path d="M 0 1.5 L 7 5 L 0 8.5 z" fill="${connColor}"></path>`;
        } else if (connEnd === 'circle') {
          pathHtml = `<circle cx="5" cy="5" r="3.5" fill="${connColor}"></circle>`;
        } else if (connEnd === 'square') {
          pathHtml = `<rect x="1.5" y="1.5" width="7" height="7" fill="${connColor}"></rect>`;
        } else if (connEnd === 'diamond') {
          pathHtml = `<path d="M 5 1.5 L 8.5 5 L 5 8.5 L 1.5 5 z" fill="${connColor}"></path>`;
        }
        endMarkerHtml = `<marker id="conn-end" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="${connHeadSize}" markerHeight="${connHeadSize}" markerUnits="userSpaceOnUse" orient="auto-start-reverse">${pathHtml}</marker>`;
      }

      const markerStartAttr = connStart !== 'none' ? 'marker-start="url(#conn-start)"' : '';
      const markerEndAttr = connEnd !== 'none' ? 'marker-end="url(#conn-end)"' : '';
      const dashAttr = connDash !== 'none' ? `stroke-dasharray="${connDash}"` : '';

      timelineBody.innerHTML = `
        <svg id="ganttSvgOverlay" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; pointer-events: none; z-index: 15; overflow: visible;">
          <defs>
            ${startMarkerHtml}
            ${endMarkerHtml}
            <marker id="arrowhead" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
              <path d="M 0 1.5 L 7 5 L 0 8.5 z" fill="var(--muted-dark, #6b7280)"></path>
            </marker>
            <marker id="arrowhead-active" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
              <path d="M 0 1.5 L 7 5 L 0 8.5 z" fill="var(--accent, #2563eb)"></path>
            </marker>
            <linearGradient id="daySCurveAreaGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.15" />
              <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="costSCurveAreaGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.15" />
              <stop offset="100%" stop-color="#60a5fa" stop-opacity="0" />
            </linearGradient>
            <filter id="sCurveShadow" x="-10%" y="-10%" width="120%" height="120%">
              <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.3"/>
            </filter>
          </defs>
          ${gridLinesHtml}
          ${currentDateLineHtml}
        </svg>
        ${timelineHtml}
      `;
      
      const svgOverlay = document.getElementById('ganttSvgOverlay');
      if (svgOverlay) {
        const bodyHeight = timelineBody.scrollHeight || timelineBody.offsetHeight;
        svgOverlay.style.height = bodyHeight + 'px';
        
        const visualBars = boqData.map((row, idx) => {
          const taskInfo = taskInfos[idx];
          if (!taskInfo) return null;
          const vIdx = ganttVisibleIndices.indexOf(idx);
          if (vIdx === -1) return null;
          const coords = ganttGetCoords(taskInfo.startDate, taskInfo.duration, timelineStartDate, ganttScale, activeColW);
          return {
            left: coords.left,
            width: coords.width,
            top: vIdx * rowH + Math.floor(rowH / 2)
          };
        });
        
        let pathElements = '';
        boqData.forEach((row, idx) => {
          const predsStr = row.ganttPredecessors || '';
          if (predsStr.trim() !== '') {
            const entries = predsStr.split(',').map(s => s.trim().toUpperCase());
            entries.forEach(entry => {
              if (entry !== '') {
                const parsed = parsePredecessor(entry);
                if (parsed && parsed.index !== idx) {
                  const pIdx = parsed.index;
                  const type = parsed.type;
                  
                  const pBar = visualBars[pIdx];
                  const sBar = visualBars[idx];
                  if (pBar && sBar) {
                    let x1 = 0, y1 = pBar.top;
                    let x2 = 0, y2 = sBar.top;
                    
                    if (type === 'FS') {
                      x1 = pBar.left + pBar.width;
                      x2 = sBar.left;
                    } else if (type === 'SS') {
                      x1 = pBar.left;
                      x2 = sBar.left;
                    } else if (type === 'FF') {
                      x1 = pBar.left + pBar.width;
                      x2 = sBar.left + sBar.width;
                    } else if (type === 'SF') {
                      x1 = pBar.left;
                      x2 = sBar.left + sBar.width;
                    }
                      
                      let d = '';
                      if (type === 'FS') {
                        if (x2 >= x1 + 10) {
                          d = `M ${x1} ${y1} H ${x1 + 6} V ${y2} H ${x2}`;
                        } else {
                          const midY = y1 + (y2 - y1) / 2;
                          d = `M ${x1} ${y1} H ${x1 + 6} V ${midY} H ${x2 - 10} V ${y2} H ${x2}`;
                        }
                      } else if (type === 'SS') {
                        const minX = Math.min(x1, x2) - 10;
                        d = `M ${x1} ${y1} H ${minX} V ${y2} H ${x2}`;
                      } else if (type === 'FF') {
                        const maxX = Math.max(x1, x2) + 10;
                        d = `M ${x1} ${y1} H ${maxX} V ${y2} H ${x2}`;
                      } else {
                        const midY = y1 + (y2 - y1) / 2;
                        d = `M ${x1} ${y1} H ${x1 - 6} V ${midY} H ${x2 + 6} V ${y2} H ${x2}`;
                      }
                      
                      pathElements += `<path data-p-idx="${pIdx}" data-s-idx="${idx}" d="${d}" fill="none" stroke="${connColor}" stroke-width="${connWeight}" ${dashAttr} ${markerStartAttr} ${markerEndAttr}></path>`;
                    }
                  }
                }
              });
            }
          });
        // Draw the S-Curve Line Graphs visually over the Gantt chart cells
        const daySCurveValues = [];
        const costSCurveValues = [];
        
        let totalDurationForSCurve = 0;
        boqData.forEach((row, idx) => {
          if (!hasChildRow(boqData, idx)) {
            const taskInfo = taskInfos[idx];
            if (taskInfo && taskInfo.startDate && taskInfo.endDate) {
              const d = taskInfo.duration || 0;
              if (d > 0) totalDurationForSCurve += d;
            }
          }
        });
        
        let runningAccomplishment = 0;
        const totalPeriodsForSCurve = ganttScale === 'days' ? totalDays 
                                    : ganttScale === 'weeks' ? totalWeeks 
                                    : ganttScale === 'quarters' ? totalQuartersCols 
                                    : totalMonthsCols;
                                    
        for (let p = 0; p < totalPeriodsForSCurve; p++) {
          const { start: pStart, end: pEnd } = getGanttPeriodDateRange(p, ganttScale, timelineStartDate);
          
          // 1. Day Progress S-Curve
          let totalOverlapDays = 0;
          boqData.forEach((row, idx) => {
            if (!hasChildRow(boqData, idx)) {
              const taskInfo = taskInfos[idx];
              if (taskInfo && taskInfo.startDate && taskInfo.endDate) {
                const tStart = taskInfo.startDate;
                const duration = taskInfo.duration || 0;
                if (duration > 0) {
                  const overlapDays = getGanttTaskOverlapDays(idx, tStart, pEnd);
                  totalOverlapDays += overlapDays;
                }
              }
            }
          });
          const dayPct = totalDurationForSCurve > 0 ? (totalOverlapDays / totalDurationForSCurve) * 100 : 0;
          daySCurveValues.push(dayPct);
          
          // 2. Cost Progress S-Curve
          let periodAccomplishment = 0;
          boqData.forEach((row, idx) => {
            if (!hasChildRow(boqData, idx)) {
              periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
            }
          });
          runningAccomplishment += periodAccomplishment;
          const costPct = totalProjectCost > 0 ? (runningAccomplishment / totalProjectCost) * 100 : 0;
          costSCurveValues.push(costPct);
        }
        
        const plotHeight = totalVisibleTaskRows * rowH; // Dynamic bound to the bottom of the last visible task row
        const totalW = totalPeriodsForSCurve * activeColW + 80;
        
        // S-curves start at bottom-left corner of first period of the last visible task row (X=0, Y=plotHeight)
        const dayPoints = [{ x: 0, y: plotHeight, val: 0 }];
        const costPoints = [{ x: 0, y: plotHeight, val: 0 }];
        
        const curDateInputForSCurve = document.getElementById('ganttCurrentDateInput');
        const curStrForSCurve = (curDateInputForSCurve && curDateInputForSCurve.value) || localStorage.getItem('cost_estimate_gantt_current_date_v1');
        const currentCopyForSCurve = curStrForSCurve ? parseSafeDate(curStrForSCurve) : new Date();
        if (currentCopyForSCurve) currentCopyForSCurve.setHours(0, 0, 0, 0);
        
        for (let p = 0; p < totalPeriodsForSCurve; p++) {
          // X-coordinate is at the end boundary of the period column
          const x = (p + 1) * activeColW;
          const { start: pStart } = getGanttPeriodDateRange(p, ganttScale, timelineStartDate);
          
          const dayVal = daySCurveValues[p];
          const dayY = (1 - dayVal / 100) * plotHeight;
          dayPoints.push({ x, y: dayY, val: dayVal });
          
          const pStartCopy = new Date(pStart);
          pStartCopy.setHours(0, 0, 0, 0);
          
          if (!currentCopyForSCurve || pStartCopy.getTime() <= currentCopyForSCurve.getTime()) {
            const costVal = costSCurveValues[p];
            const costY = (1 - costVal / 100) * plotHeight;
            costPoints.push({ x, y: costY, val: costVal });
          }
        }
        
        // Plot Day S-Curve (Thick Blue Line & Fill)
        if (dayPoints.length > 0) {
          // 1. Smooth Line Path (Thick Royal Blue, thickness reduced to 1.5)
          let lineD = `M ${dayPoints[0].x} ${dayPoints[0].y}`;
          for (let i = 0; i < dayPoints.length - 1; i++) {
            const p1 = dayPoints[i];
            const p2 = dayPoints[i + 1];
            const cp1x = p1.x + (p2.x - p1.x) / 3;
            const cp1y = p1.y + (p2.y - p1.y) * 0.25;
            const cp2x = p2.x - (p2.x - p1.x) / 3;
            const cp2y = p2.y - (p2.y - p1.y) * 0.25;
            lineD += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2.x} ${p2.y}`;
          }
          pathElements += `<path d="${lineD}" fill="none" stroke="#1d4ed8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" pointer-events="none"></path>`;
          
          dayPoints.forEach(pt => {
            pathElements += `
              <circle cx="${pt.x}" cy="${pt.y}" r="2.5" fill="#000000" stroke="#1d4ed8" stroke-width="1.5" pointer-events="all" style="cursor: help;">
                <title>S-Curve (Day Progress): ${pt.val.toFixed(scurveLabelDecimals)}%</title>
              </circle>
            `;
            if (ganttSettings.showScurveDayLabel === true) {
              const scurveLabelSize = ganttSettings.scurveLabelSize !== undefined ? ganttSettings.scurveLabelSize : 8;
              pathElements += `
                <text x="${pt.x}" y="${pt.y - 7}" fill="#1d4ed8" font-size="${scurveLabelSize}px" font-weight="bold" text-anchor="middle" pointer-events="none" style="text-shadow: 0 1px 1px #ffffff, 0 -1px 1px #ffffff, 1px 0 1px #ffffff, -1px 0 1px #ffffff;">${pt.val.toFixed(scurveLabelDecimals)}%</text>
              `;
            }
          });
        }
        
        // Plot Cost S-Curve (Green Line, area fill removed)
        if (costPoints.length > 0) {
          // 1. Smooth Line Path (Green, thickness adapted to 1.5)
          let lineD = `M ${costPoints[0].x} ${costPoints[0].y}`;
          for (let i = 0; i < costPoints.length - 1; i++) {
            const p1 = costPoints[i];
            const p2 = costPoints[i + 1];
            const cp1x = p1.x + (p2.x - p1.x) / 3;
            const cp1y = p1.y + (p2.y - p1.y) * 0.25;
            const cp2x = p2.x - (p2.x - p1.x) / 3;
            const cp2y = p2.y - (p2.y - p1.y) * 0.25;
            lineD += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2.x} ${p2.y}`;
          }
          pathElements += `<path d="${lineD}" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" pointer-events="none"></path>`;
          
          costPoints.forEach(pt => {
            pathElements += `
              <circle cx="${pt.x}" cy="${pt.y}" r="2.5" fill="#000000" stroke="#16a34a" stroke-width="1.5" pointer-events="all" style="cursor: help;">
                <title>S-Curve (Cost Progress / % Curve): ${pt.val.toFixed(scurveLabelDecimals)}%</title>
              </circle>
            `;
            if (ganttSettings.showScurveCostLabel === true) {
              const scurveLabelSize = ganttSettings.scurveLabelSize !== undefined ? ganttSettings.scurveLabelSize : 8;
              pathElements += `
                <text x="${pt.x}" y="${pt.y + 10}" fill="#16a34a" font-size="${scurveLabelSize}px" font-weight="bold" text-anchor="middle" pointer-events="none" style="text-shadow: 0 1px 1px #ffffff, 0 -1px 1px #ffffff, 1px 0 1px #ffffff, -1px 0 1px #ffffff;">${pt.val.toFixed(scurveLabelDecimals)}%</text>
              `;
            }
          });
        }

        svgOverlay.innerHTML += pathElements;
      }
      
      if (ganttScale === 'days') {
        const w = (totalDays * activeColW + 80) + 'px';
        timelineBody.style.width = w;
        timelineHeader.style.width = w;
      } else if (ganttScale === 'weeks') {
        const w = (totalWeeks * activeColW + 80) + 'px';
        timelineBody.style.width = w;
        timelineHeader.style.width = w;
      } else if (ganttScale === 'quarters') {
        const w = (totalQuartersCols * activeColW + 80) + 'px';
        timelineBody.style.width = w;
        timelineHeader.style.width = w;
      } else {
        const w = (totalMonthsCols * activeColW + 80) + 'px';
        timelineBody.style.width = w;
        timelineHeader.style.width = w;
      }

      // Restore scroll positions to prevent jumping
      if (leftPanel) {
        leftPanel.scrollTop = savedLeftScrollTop;
        leftPanel.scrollLeft = savedLeftScrollLeft;
      }
      if (rightPanel) {
        rightPanel.scrollTop = savedRightScrollTop;
        rightPanel.scrollLeft = savedRightScrollLeft;
      }
      
      if (activeGanttHighlightIdx !== -1) {
        highlightGanttRow(activeGanttHighlightIdx);
      }
      
      window.scrollTo(savedScrollX, savedScrollY);
      
      updateGanttTimelineViewport();
      setTimeout(updateGanttTimelineViewport, 50);
      setTimeout(updateGanttTimelineViewport, 200);
      
      const modal = document.getElementById('ganttQtyInstModal');
      if (modal && modal.style.display === 'flex') {
        renderQtyModalTable();
      }
    } catch (err) {
      console.error("Error in renderGanttChart:", err);
      alert("Error rendering Gantt Chart: " + err.message + "\n" + err.stack);
    }
  }

    function updateGanttTimelineViewport() {
      const rightPanel = document.getElementById('ganttRightPanel');
      if (!rightPanel) return;
      
      const scrollTop = rightPanel.scrollTop;
      const viewportHeight = rightPanel.clientHeight;
      const rowH = ganttSettings.rowHeight || 40;
      
      const totalTaskRows = ganttVisibleIndices.length;
      const totalRows = totalTaskRows + 5;
      
      const visibleStart = Math.floor(scrollTop / rowH);
      const visibleEnd = Math.ceil((scrollTop + viewportHeight) / rowH);
      
      const buffer = 8;
      const startIdx = Math.max(0, visibleStart - buffer);
      const endIdx = Math.min(totalRows - 1, visibleEnd + buffer);
      
      for (let i = 0; i < totalRows; i++) {
        const isVisible = (i >= startIdx && i <= endIdx);
        const index = i < totalTaskRows ? ganttVisibleIndices[i] : boqData.length + (i - totalTaskRows);
        const rowEl = document.getElementById(`ganttRightRow-${index}`);
        if (!rowEl) continue;
        
        if (isVisible) {
          if (rowEl.dataset.rendered !== 'true') {
            rowEl.innerHTML = ganttRightRowHtmlCache[index] || '';
            rowEl.dataset.rendered = 'true';
          }
        } else {
          if (rowEl.dataset.rendered === 'true') {
            rowEl.innerHTML = '';
            rowEl.dataset.rendered = 'false';
          }
        }
      }
      
      // Update SVG path connector line visibility
      const svgOverlay = document.getElementById('ganttSvgOverlay');
      if (svgOverlay) {
        const paths = svgOverlay.querySelectorAll('path[data-p-idx]');
        paths.forEach(path => {
          const pIdx = parseInt(path.getAttribute('data-p-idx'), 10);
          const sIdx = parseInt(path.getAttribute('data-s-idx'), 10);
          
          const vPIdx = ganttVisibleIndices.indexOf(pIdx);
          const vSIdx = ganttVisibleIndices.indexOf(sIdx);
          
          const isPVisible = (vPIdx >= startIdx && vPIdx <= endIdx);
          const isSVisible = (vSIdx >= startIdx && vSIdx <= endIdx);
          
          if (isPVisible || isSVisible) {
            path.style.display = '';
          } else {
            path.style.display = 'none';
          }
        });
      }
    }

    window.setGanttScale = setGanttScale;
    window.updateGanttProjectStart = updateGanttProjectStart;
    window.updateGanttTask = updateGanttTask;
    window.showGanttSheet = showGanttSheet;
    window.renderGanttChart = renderGanttChart;
    window.updateGanttTimelineViewport = updateGanttTimelineViewport;

    // --- Gantt Summary Manual Formulas Support ---
    let ganttSummaryFormulas = {};
    let ganttCoordinateValues = {};

    function loadGanttSummaryFormulas() {
      const saved = localStorage.getItem('cost_estimate_gantt_summary_formulas_v1');
      ganttSummaryFormulas = saved ? JSON.parse(saved) : {};
    }

    function saveGanttSummaryFormulas() {
      localStorage.setItem('cost_estimate_gantt_summary_formulas_v1', JSON.stringify(ganttSummaryFormulas));
    }

    function colLetterToIndex(letter) {
      let index = 0;
      for (let i = 0; i < letter.length; i++) {
        index = index * 26 + (letter.charCodeAt(i) - 64);
      }
      return index - 1;
    }

    function evaluateCellFormula(formulaText, coordValues) {
      console.log("[FormulaEval] Evaluating:", formulaText, "with coordinates:", coordValues);
      if (!formulaText || typeof formulaText !== 'string') {
        console.log("[FormulaEval] Input is not a string or is empty.");
        return formulaText;
      }
      const trimmed = formulaText.trim();
      if (!trimmed.startsWith('=')) {
        console.log("[FormulaEval] Formula does not start with '=': returning raw value.");
        return formulaText;
      }
      let expr = trimmed.substring(1).toUpperCase().trim();
      console.log("[FormulaEval] Expression to evaluate:", expr);
      
      // Helper to expand a range like D2:D10 to an array of cell coordinates
      function expandRange(rangeStr) {
        const parts = rangeStr.split(':');
        if (parts.length !== 2) return [rangeStr];
        const startCell = parts[0].trim();
        const endCell = parts[1].trim();
        
        const startMatch = startCell.match(/^([A-Z]+)([0-9]+)$/);
        const endMatch = endCell.match(/^([A-Z]+)([0-9]+)$/);
        if (!startMatch || !endMatch) return [startCell, endCell];
        
        const startCol = colLetterToIndex(startMatch[1]);
        const startRow = parseInt(startMatch[2], 10);
        const endCol = colLetterToIndex(endMatch[1]);
        const endRow = parseInt(endMatch[2], 10);
        
        const minCol = Math.min(startCol, endCol);
        const maxCol = Math.max(startCol, endCol);
        const minRow = Math.min(startRow, endRow);
        const maxRow = Math.max(startRow, endRow);
        
        const cells = [];
        for (let r = minRow; r <= maxRow; r++) {
          for (let c = minCol; c <= maxCol; c++) {
            cells.push(getColLetter(c) + r);
          }
        }
        return cells;
      }

      // Handle SUM, AVERAGE, MIN, MAX
      const funcRegex = /(SUM|AVERAGE|MIN|MAX)\(([^)]+)\)/g;
      let matchesFound = true;
      let iterations = 0;
      while (matchesFound && iterations < 10) {
        matchesFound = false;
        iterations++;
        expr = expr.replace(funcRegex, (match, func, argsStr) => {
          matchesFound = true;
          const argParts = argsStr.split(',');
          let resolvedVals = [];
          argParts.forEach(arg => {
            arg = arg.trim();
            if (arg.includes(':')) {
              const cells = expandRange(arg);
              cells.forEach(cell => {
                const val = parseFloat(coordValues[cell]);
                resolvedVals.push(isNaN(val) ? 0 : val);
              });
            } else {
              if (/^[A-Z]+[0-9]+$/.test(arg)) {
                const val = parseFloat(coordValues[arg]);
                resolvedVals.push(isNaN(val) ? 0 : val);
              } else {
                const val = parseFloat(arg);
                resolvedVals.push(isNaN(val) ? 0 : val);
              }
            }
          });
          
          if (func === 'SUM') {
            return resolvedVals.reduce((sum, v) => sum + v, 0);
          } else if (func === 'AVERAGE') {
            return resolvedVals.length ? (resolvedVals.reduce((sum, v) => sum + v, 0) / resolvedVals.length) : 0;
          } else if (func === 'MIN') {
            return resolvedVals.length ? Math.min(...resolvedVals) : 0;
          } else if (func === 'MAX') {
            return resolvedVals.length ? Math.max(...resolvedVals) : 0;
          }
          return 0;
        });
      }
      
      // Replace remaining single cell coordinates (e.g. D2, E3) with their values
      expr = expr.replace(/[A-Z]+[0-9]+/g, (cell) => {
        const val = parseFloat(coordValues[cell]);
        console.log("[FormulaEval] Replacing coordinate cell:", cell, "value is:", val);
        return isNaN(val) ? 0 : val;
      });
      console.log("[FormulaEval] Replaced expression:", expr);
      
      // Safe math evaluation
      try {
        if (/^[0-9+\-*/().\s]+$/.test(expr)) {
          const result = Function(`"use strict"; return (${expr});`)();
          const finalResult = typeof result === 'number' && !isNaN(result) ? result : 0;
          console.log("[FormulaEval] Final evaluated value:", finalResult);
          return finalResult;
        } else {
          console.log("[FormulaEval] Replaced expression did not pass safety regex test.");
        }
      } catch (e) {
        console.error("[FormulaEval] Math evaluation error:", e);
        return "#ERROR!";
      }
      
      return "#VALUE!";
    }

    function updateGanttSummaryFormula(cellCoord, value) {
      if (value.trim() === '') {
        delete ganttSummaryFormulas[cellCoord];
      } else {
        ganttSummaryFormulas[cellCoord] = value.trim();
      }
      saveGanttSummaryFormulas();
      saveBOQSection(true);
      
      const rightPanel = document.getElementById('qtyRightPanel');
      const savedScrollTop = rightPanel ? rightPanel.scrollTop : 0;
      const savedScrollLeft = rightPanel ? rightPanel.scrollLeft : 0;
      
      renderQtyModalTable();
      renderGanttChart();
      
      if (rightPanel) {
        rightPanel.scrollTop = savedScrollTop;
        rightPanel.scrollLeft = savedScrollLeft;
      }
    }
    window.updateGanttSummaryFormula = updateGanttSummaryFormula;
    window.evaluateCellFormula = evaluateCellFormula;

    function populateGanttCoordinateValuesForTask(index, visibleRowIndex, activeCols, taskInfo, row) {
      const isParent = hasChildRow(boqData, index);
      const displayValues = computeBOQDisplayValues(row) || {};
      const estQty = isParent ? getParentEstQty(index) : (displayValues.qty || 0);
      const instQtyVal = getPeriodQtyTotal(index);
      const accomplishedCost = getGanttTaskAccomplishedCost(index) || 0;
      const progressCost = getGanttTaskCostProgress(index);
      const progressDay = getGanttTaskDayProgress(index) || 0;
      const durationVal = taskInfo ? taskInfo.duration : 5;
      const costVal = isParent ? (computeBOQCategorySummary(index)?.totalCost || 0) : (displayValues.grandTotalCost || 0);
      
      const remainingDaysVal = getGanttRemainingDays(index, taskInfo);
      
      activeCols.forEach((col, colIdx) => {
        const colIdxInFull = ganttColumns.indexOf(col);
        const colLetter = getColLetter(colIdxInFull);
        const cellCoord = `${colLetter}${visibleRowIndex}`;
        
        let rawVal = 0;
        if (col.id === 'days') rawVal = durationVal;
        else if (col.id === 'remainingDays') rawVal = remainingDaysVal;
        else if (col.id === 'cost') rawVal = costVal;
        else if (col.id === 'estQty') rawVal = estQty;
        else if (col.id === 'instQty') rawVal = instQtyVal;
        else if (col.id === 'qtyAccmpCost') rawVal = accomplishedCost;
        else if (col.id === 'progress') rawVal = progressCost;
        else if (col.id === 'progressDay') rawVal = progressDay;
        else if (col.isCustom) {
          const customVal = parseFloat((row.ganttCustomValues && row.ganttCustomValues[col.id])) || 0;
          rawVal = customVal;
        }
        
        ganttCoordinateValues[cellCoord] = rawVal;
      });
    }
    window.populateGanttCoordinateValuesForTask = populateGanttCoordinateValuesForTask;

    function showCoverLetterSheet() {
      renderBOQTable();
      renderBOQSummaryTable();
      renderCoverLetter();
      showSheet('coverLetterSheet');
      setTimeout(fitCoverPreview, 80);
    }

    function formatDisplayDate(value) {
      if (!value) return '';
      const parts = String(value).split('-');
      if (parts.length !== 3) return value;
      const date = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
      if (Number.isNaN(date.getTime())) return value;
      return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    function setCoverLinkedText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value || '';
    }

    function fitCoverMetaSingleLine() {
      ['coverProjectName', 'coverClientName'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.whiteSpace = 'nowrap';
        el.style.fontSize = '10pt';
        const minPt = 7.5;
        let current = 10;
        while (el.scrollWidth > el.clientWidth && current > minPt) {
          current -= 0.25;
          el.style.fontSize = current + 'pt';
        }
      });
    }

    function resizeAllCoverTextareas() {
      setTimeout(() => {
        document.querySelectorAll('.cover-letter-page textarea').forEach(textarea => {
          textarea.style.height = 'auto';
          textarea.style.height = (textarea.scrollHeight + 4) + 'px';
        });
      }, 0);
    }

    function syncCoverLetterFields() {
      const projectName = document.getElementById('projectName')?.value || '';
      const clientName = document.getElementById('clientName')?.value || '';
      const preparedBy = document.getElementById('preparedBy')?.value || '';
      const proposalDate = document.getElementById('proposalDate')?.value || '';
      const submittedPosition = document.getElementById('submittedByPosition')?.value || '';
      const acceptedPosition = document.getElementById('acceptedByPosition')?.value || '';
      const subjectText = projectName ? `Cost Proposal for ${projectName}` : 'Cost Proposal';

      setCoverLinkedText('coverProjectName', projectName);
      setCoverLinkedText('coverClientName', clientName);
      const clientOrg = document.getElementById('coverSignatureClientOrg');
      if (clientOrg) {
        clientOrg.textContent = clientName ? `${clientName.toUpperCase()} CONFORME` : 'CLIENT / OWNER CONFORME';
      }
      setCoverLinkedText('coverProposalDate', formatDisplayDate(proposalDate));
      setCoverLinkedText('coverSubject', subjectText);
      fitCoverMetaSingleLine();

      const pairs = [
        ['coverSubmittedBy', preparedBy],
        ['coverAcceptedBy', clientName],
        ['coverSubmittedPosition', submittedPosition],
        ['coverAcceptedPosition', acceptedPosition]
      ];
      pairs.forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el && !el.dataset.edited && value) el.value = value;
      });
    }

    function updateCoverVatMode(totalVat) {
      const isNonVat = numberOrZero(totalVat) <= 0;
      const label = isNonVat ? 'Non-VAT' : 'VAT';
      ['coverVatHeader', 'coverVatText1', 'coverVatText2'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = label;
      });
      const note = document.getElementById('coverVatNote');
      if (note) note.textContent = isNonVat
        ? ''
        : 'VAT is included based on the BOQ tax cost adjustment factor.';
      return label;
    }

    
    function updateCoverPageCount() {
      const mainPageEl = document.querySelector('.cover-letter-page:not(.cover-attachment-sheet)');
      const countSpan = document.getElementById('coverPageCount');
      if (!countSpan) return;

      const dims = (typeof getCoverPageDimensions === 'function')
        ? getCoverPageDimensions()
        : { widthMm: 210, heightMm: 297, sizeKey: 'A4' };

      let mainPages = 1;
      if (mainPageEl) {
        const clientWidth = mainPageEl.clientWidth || (dims.widthMm * (96 / 25.4));
        const singlePageHeight = clientWidth * (dims.heightMm / dims.widthMm);
        const contentHeight = Math.max(mainPageEl.scrollHeight, mainPageEl.offsetHeight);
        mainPages = Math.max(1, Math.ceil((contentHeight - 10) / singlePageHeight));
      }

      const attachmentSheets = document.querySelectorAll('.cover-attachment-sheet');
      const totalAttachmentPages = attachmentSheets.length;
      const grandTotalPages = mainPages + totalAttachmentPages;

      const scopeSelect = document.getElementById('sbCoverPrintScope') || document.getElementById('toolbarCoverPrintScope');
      const currentScope = scopeSelect ? (scopeSelect.value || 'all') : 'all';

      countSpan.textContent = grandTotalPages;

      const pageBadge = document.getElementById('coverPageBadge');
      if (pageBadge) {
        if (currentScope === 'proposal') {
          pageBadge.textContent = `${mainPages} Pgs (Proposal Only)`;
        } else if (currentScope === 'attachments') {
          pageBadge.textContent = `${totalAttachmentPages} Pgs (Attachments Only)`;
        } else {
          pageBadge.textContent = grandTotalPages === 1 ? '1 Page' : `${grandTotalPages} Pages (Whole)`;
        }
      }

      // Update sequential page number on each attachment sheet footer
      attachmentSheets.forEach((sheet, idx) => {
        const sheetGlobalNum = (currentScope === 'attachments') ? (idx + 1) : (mainPages + idx + 1);
        const totalScopePages = (currentScope === 'attachments') ? totalAttachmentPages : grandTotalPages;
        const pageNumEl = sheet.querySelector('.cover-attachment-footer-page-val');
        if (pageNumEl) {
          pageNumEl.textContent = `Page ${sheetGlobalNum} of ${totalScopePages}`;
        }
      });
    }

    function syncCoverPrintScope(scope) {
      const val = scope || 'all';
      const sbSelect = document.getElementById('sbCoverPrintScope');
      const tbSelect = document.getElementById('toolbarCoverPrintScope');
      if (sbSelect && sbSelect.value !== val) sbSelect.value = val;
      if (tbSelect && tbSelect.value !== val) tbSelect.value = val;
      applyCoverPrintScopePreview(val);
      markUnsaved();
    }

    function applyCoverPrintScopePreview(scope) {
      const mainProposal = document.querySelector('.cover-letter-page:not(.cover-attachment-sheet)');
      const attachmentsContainer = document.getElementById('coverAttachmentsContainer');
      
      if (scope === 'proposal') {
        if (mainProposal) mainProposal.style.display = 'flex';
        if (attachmentsContainer) attachmentsContainer.style.display = 'none';
      } else if (scope === 'attachments') {
        if (mainProposal) mainProposal.style.display = 'none';
        if (attachmentsContainer) attachmentsContainer.style.display = (coverAttachments && coverAttachments.length > 0) ? 'flex' : 'none';
      } else {
        // 'all' (whole document)
        if (mainProposal) mainProposal.style.display = 'flex';
        if (attachmentsContainer) attachmentsContainer.style.display = (coverAttachments && coverAttachments.length > 0) ? 'flex' : 'none';
      }

      updateCoverPageCount();
      if (typeof fitCoverPreview === 'function') fitCoverPreview();
    }

    /* ==========================================================================
       COVER LETTER LIVE PREVIEW & SIDEBAR CONFIGURATION CONTROLLER
       ========================================================================== */
    const COVER_PAPER_DIMENSIONS = {
      'A4': { widthMm: 210, heightMm: 297, label: 'A4' },
      'Letter': { widthMm: 215.9, heightMm: 279.4, label: 'Letter' },
      'Legal': { widthMm: 215.9, heightMm: 355.6, label: 'Legal' }
    };

    function getCoverPageDimensions() {
      const sizeSelect = document.getElementById('sbCoverPaperSize');
      const orientSelect = document.getElementById('sbCoverOrientation');
      const sizeKey = sizeSelect ? (sizeSelect.value || 'A4') : 'A4';
      const orientKey = orientSelect ? (orientSelect.value || 'portrait') : 'portrait';
      const dim = COVER_PAPER_DIMENSIONS[sizeKey] || COVER_PAPER_DIMENSIONS['A4'];

      const isLandscape = orientKey === 'landscape';
      const widthMm = isLandscape ? dim.heightMm : dim.widthMm;
      const heightMm = isLandscape ? dim.widthMm : dim.heightMm;

      return {
        sizeKey,
        orientKey,
        widthMm,
        heightMm,
        label: `${dim.label} ${isLandscape ? 'Landscape' : 'Portrait'}`
      };
    }

    function fitCoverDocTitle() {
      const titleEl = document.getElementById('coverDocTitle');
      const cellEl = document.querySelector('.cover-header-col2');
      if (!titleEl || !cellEl) return;

      titleEl.style.fontSize = '20pt';
      const maxHeight = (cellEl.clientHeight || 75) - 2;
      const maxWidth = (cellEl.clientWidth || 320) - 4;

      let currentPt = 20;
      while ((titleEl.scrollHeight > maxHeight || titleEl.scrollWidth > maxWidth) && currentPt > 11) {
        currentPt -= 0.5;
        titleEl.style.fontSize = currentPt + 'pt';
      }
    }

    function applyCoverPageSetup() {
      const pageEl = document.querySelector('.cover-letter-page:not(.cover-attachment-sheet)');
      const formatBadge = document.getElementById('coverPageFormatBadge');
      const dims = getCoverPageDimensions();

      if (pageEl) {
        pageEl.style.setProperty('--cover-page-width', `${dims.widthMm}mm`);
        pageEl.style.setProperty('--cover-page-height', `${dims.heightMm}mm`);
        pageEl.style.width = `${dims.widthMm}mm`;
        pageEl.style.minWidth = `${dims.widthMm}mm`;
        pageEl.style.maxWidth = `${dims.widthMm}mm`;
        pageEl.style.minHeight = `${dims.heightMm}mm`;
      }

      const baseDim = COVER_PAPER_DIMENSIONS[dims.sizeKey] || COVER_PAPER_DIMENSIONS['A4'];
      const wrapper = document.getElementById('coverPreviewWrapper');
      if (wrapper) {
        wrapper.style.setProperty('--cover-page-portrait-width', `${baseDim.widthMm}mm`);
        wrapper.style.setProperty('--cover-page-portrait-height', `${baseDim.heightMm}mm`);
        wrapper.style.setProperty('--cover-page-landscape-width', `${baseDim.heightMm}mm`);
        wrapper.style.setProperty('--cover-page-landscape-height', `${baseDim.widthMm}mm`);
      }

      // Update all rendered attachment sheets to respect the updated paper size
      const attachmentSheets = document.querySelectorAll('.cover-attachment-sheet');
      attachmentSheets.forEach(sheet => {
        const isLandscape = sheet.classList.contains('orientation-landscape');
        const wMm = isLandscape ? baseDim.heightMm : baseDim.widthMm;
        const hMm = isLandscape ? baseDim.widthMm : baseDim.heightMm;
        sheet.style.width = `${wMm}mm`;
        sheet.style.minWidth = `${wMm}mm`;
        sheet.style.maxWidth = `${wMm}mm`;
        sheet.style.minHeight = `${hMm}mm`;
        sheet.style.height = `${hMm}mm`;
      });

      if (formatBadge) {
        formatBadge.textContent = dims.label;
      }

      fitCoverDocTitle();
      fitCoverPreview();
      updateCoverPageCount();
    }

    function onCoverPageSetupChange() {
      applyCoverPageSetup();
      markUnsaved();
    }

    let coverPreviewZoom = 1.0;

    function setCoverZoom(zoom) {
      if (typeof zoom === 'number' && !isNaN(zoom)) {
        coverPreviewZoom = Math.min(2.0, Math.max(0.3, Math.round(zoom * 100) / 100));
      }
      const wrapper = document.getElementById('coverPreviewWrapper');
      const label = document.getElementById('coverZoomLabel');
      if (wrapper) {
        wrapper.style.transform = `scale(${coverPreviewZoom})`;
      }
      if (label) {
        label.textContent = `${Math.round(coverPreviewZoom * 100)}%`;
      }
    }

    function changeCoverZoom(delta) {
      setCoverZoom(coverPreviewZoom + delta);
    }

    function fitCoverPreview() {
      const area = document.getElementById('coverPreviewArea');
      const page = document.querySelector('.cover-letter-page');
      if (!area || !page) return;
      const availableWidth = area.clientWidth - 40;
      const dims = (typeof getCoverPageDimensions === 'function') ? getCoverPageDimensions() : null;
      
      let nominalPageWidth = dims ? Math.round(dims.widthMm * (96 / 25.4)) : (page.offsetWidth || 794);
      const landscapeSheets = document.querySelectorAll('.cover-attachment-sheet.orientation-landscape');
      if (landscapeSheets.length > 0 && dims) {
        const baseDim = COVER_PAPER_DIMENSIONS[dims.sizeKey] || COVER_PAPER_DIMENSIONS['A4'];
        const landscapePx = Math.round(baseDim.heightMm * (96 / 25.4));
        nominalPageWidth = Math.max(nominalPageWidth, landscapePx);
      }

      if (availableWidth > 0 && nominalPageWidth > 0) {
        const optimalZoom = Math.min(1.0, Math.max(0.35, Math.round((availableWidth / nominalPageWidth) * 100) / 100));
        setCoverZoom(optimalZoom);
      }
    }

    function toggleCoverSidebar(forceCollapse) {
      const sidebar = document.getElementById('coverSidebar');
      const toggleText = document.getElementById('toggleCoverSidebarText');
      if (!sidebar) return;

      const shouldCollapse = forceCollapse !== undefined ? forceCollapse : !sidebar.classList.contains('collapsed');
      if (shouldCollapse) {
        sidebar.classList.add('collapsed');
        if (toggleText) toggleText.textContent = 'Show Settings';
      } else {
        sidebar.classList.remove('collapsed');
        if (toggleText) toggleText.textContent = 'Hide Settings';
      }
      setTimeout(fitCoverPreview, 260);
    }

    const COVER_SYNC_MAPPINGS = [
      // Top Header & Doc Control
      { sbId: 'sbCoverDocTitle', docId: 'coverDocTitle', isContent: true },
      { sbId: 'sbCoverDocNo', docId: 'coverDocNo', isContent: true },
      { sbId: 'sbCoverRevNo', docId: 'coverRevNo', isContent: true },
      { sbId: 'sbCoverEffectiveDate', docId: 'coverEffectiveDate', isContent: true },

      // Project & Client info
      { sbId: 'sbCoverProposalDate', docId: 'coverProposalDate', isDate: true },
      { sbId: 'sbCoverProjectName', docId: 'coverProjectName', isMeta: true },
      { sbId: 'sbCoverClientName', docId: 'coverClientName', isMeta: true },
      { sbId: 'sbCoverSubject', docId: 'coverSubject', isContent: true },

      // Intro & Body
      { sbId: 'sbCoverSalutation', docId: 'coverSalutation', isContent: true },
      { sbId: 'sbCoverOpeningText', docId: 'coverOpeningText', isContent: true },
      { sbId: 'sbCoverScopeIntro', docId: 'coverScopeIntro', isContent: true },
      { sbId: 'sbCoverBreakdownIntro', docId: 'coverBreakdownIntro', isContent: true },

      // Key Deliverables & Methodologies
      { sbId: 'sbCoverKeyDeliverables', docId: 'coverKeyDeliverables', isValue: true },
      { sbId: 'sbCoverMethodologies', docId: 'coverMethodologies', isValue: true },

      // Commercial Terms
      { sbId: 'sbCoverPaymentTerms', docId: 'coverPaymentTerms', isValue: true },
      { sbId: 'sbCoverQuotationDuration', docId: 'coverQuotationDuration', isValue: true },
      { sbId: 'sbCoverProjectDuration', docId: 'coverProjectDuration', isValue: true },
      { sbId: 'sbCoverSpecialConditions', docId: 'coverSpecialConditions', isValue: true },

      // Scope Clarifications & Exclusions
      { sbId: 'sbCoverExcludedItems', docId: 'coverExcludedItems', isValue: true },
      { sbId: 'sbCoverClientMaterials', docId: 'coverClientMaterials', isValue: true },
      { sbId: 'sbCoverOtherContractors', docId: 'coverOtherContractors', isValue: true },

      // Attached Documents
      { sbId: 'sbCoverAttachedDocuments', docId: 'coverAttachedDocuments', isValue: true },

      // Signatures & Confidentiality Notice
      { sbId: 'sbCoverSubmittedBy', docId: 'coverSubmittedBy', isValue: true },
      { sbId: 'sbCoverSubmittedPosition', docId: 'coverSubmittedPosition', isValue: true },
      { sbId: 'sbCoverAcceptedBy', docId: 'coverAcceptedBy', isValue: true },
      { sbId: 'sbCoverAcceptedPosition', docId: 'coverAcceptedPosition', isValue: true },
      { sbId: 'sbCoverConfidentiality', docId: 'coverConfidentialityNotice', isContent: true }
    ];

    let isSyncingCoverFields = false;

    function syncSidebarFromCover() {
      if (isSyncingCoverFields) return;
      isSyncingCoverFields = true;
      try {
        COVER_SYNC_MAPPINGS.forEach(m => {
          const sbEl = document.getElementById(m.sbId);
          const docEl = document.getElementById(m.docId);
          if (!sbEl || !docEl) return;

          if (m.isDate) {
            const origDate = document.getElementById('proposalDate');
            if (origDate && origDate.value) {
              sbEl.value = origDate.value;
            } else {
              sbEl.value = '';
            }
          } else if (m.isValue) {
            sbEl.value = docEl.value || '';
          } else {
            sbEl.value = (docEl.textContent || '').trim();
          }
        });
        const durText = document.getElementById('coverProjectDuration')?.value || '';
        const calMatch = durText.match(/(\d+)\s+Calendar Days/i);
        const workMatch = durText.match(/(\d+)\s+Working Days/i);
        const calInput = document.getElementById('sbCoverDurationDays');
        const workInput = document.getElementById('sbCoverWorkingDays');
        if (calMatch && calInput) calInput.value = calMatch[1];
        if (workMatch && workInput) workInput.value = workMatch[1];
      } finally {
        isSyncingCoverFields = false;
      }
    }

    function generateCoverDeliverablesFromBOQ() {
      const deliverables = [];
      if (Array.isArray(boqData) && boqData.length > 0) {
        boqData.forEach((row, idx) => {
          if (row && row.type === 'category') {
            const summary = (typeof computeBOQCategorySummary === 'function')
              ? computeBOQCategorySummary(idx)
              : { itemCode: row.code || '', workDescription: row.title || '' };
            const codeStr = summary.itemCode ? `[${summary.itemCode}] ` : '';
            const titleStr = (summary.workDescription || row.title || '').trim();
            if (!titleStr) return;

            const subScopes = [];
            let i = idx + 1;
            while (i < boqData.length && levelOf(boqData[i]) > levelOf(row)) {
              const child = boqData[i];
              if (child && child.title && (child.type === 'subcategory' || child.type === 'subsubcategory')) {
                const subTitle = child.title.trim();
                if (subTitle && !subScopes.includes(subTitle)) subScopes.push(subTitle);
              }
              i++;
            }

            let deliverableLine = `${codeStr}${titleStr}`;
            if (subScopes.length > 0) {
              const preview = subScopes.slice(0, 4).join(', ');
              const more = subScopes.length > 4 ? ', and associated works' : '';
              deliverableLine += `: Comprehensive supply of materials, labor, specialized equipment, and engineering supervision for ${preview}${more}, fully compliant with project plans and specifications.`;
            } else {
              deliverableLine += `: Complete procurement, fabrication, installation, and testing of all works in strict conformance with the approved drawings and specifications.`;
            }
            deliverables.push(deliverableLine);
          }
        });
      }

      if (deliverables.length === 0) {
        return [
          '1. General Requirements & Mobilization: Complete site establishment, temporary facilities, construction health & safety programs (DOLE-OSHC compliant), engineering supervision, project signboards, and final site demobilization.',
          '2. Earthworks & Substructure: Site clearing, precision excavation for column footings and tie beams, soil poisoning/anti-termite treatment, backfilling, and mechanized layer-by-layer compaction.',
          '3. Reinforced Concrete & Structural Works: Fabrication and installation of standard deformed reinforcing steel bars (Grade 40/60), formworks and falsework scaffolding, and ready-mix structural concrete pouring for footings, columns, beams, and suspended slabs.',
          '4. Masonry & Plastering Works: Laying of load-bearing/non-load-bearing Concrete Hollow Blocks (CHB) with required dowel rebar reinforcement, and cement plaster finishing on all exposed concrete/masonry surfaces.',
          '5. Architectural Finishes & Specialties: Ceramic and porcelain floor/wall tiling, thermal/moisture ceiling systems, doors, windows, and premium multi-coat interior/exterior painting systems.',
          '6. MEPF Services Infrastructure: Complete roughing-ins and fixture terminations for sanitary drainage, potable water distribution, electrical power/lighting distribution boards, and fire protection provisions in strict compliance with the National Building Code.'
        ].join('\n\n');
      }

      return deliverables.map((item, idx) => `${idx + 1}. ${item}`).join('\n\n');
    }

    function generateCoverMethodologiesFromBOQ() {
      const catKeywords = (boqData || [])
        .filter(r => r && r.type === 'category' && r.title)
        .map(r => r.title.toLowerCase())
        .join(' ');

      const methods = [];
      methods.push('1. Mobilization & Health/Safety Protocols: Rapid deployment of equipment, construction safety barriers, PPE enforcement, and securing required building clearances prior to breaking ground in full compliance with DOLE DO-13 standards.');

      if (!catKeywords || catKeywords.includes('earth') || catKeywords.includes('civil') || catKeywords.includes('substructure') || catKeywords.includes('foundation') || catKeywords.includes('site')) {
        methods.push('2. Substructure & Civil Execution: Systematic excavation guided by optical laser benchmarks, rigorous soil sub-grade verification, and controlled backfill compaction with field density testing (FDT) prior to concrete footing placement.');
      }

      if (!catKeywords || catKeywords.includes('concrete') || catKeywords.includes('structural') || catKeywords.includes('structure') || catKeywords.includes('steel') || catKeywords.includes('superstructure')) {
        methods.push('3. Structural Reinforced Concrete Works: Pre-pour joint inspections checking rebar lap splices, spacing, and concrete cover chairs; continuous slump testing on site; and mandatory 7-day, 14-day, and 28-day laboratory concrete cylinder compressive strength tests.');
      }

      if (!catKeywords || catKeywords.includes('masonry') || catKeywords.includes('architectural') || catKeywords.includes('finish') || catKeywords.includes('tile') || catKeywords.includes('paint')) {
        methods.push('4. Architectural Fit-Out & Finishes: Mechanical keying and slurry bonding application prior to wall plastering; rigorous leveling using optical lasers for screeds, tiles, and ceiling grids; and moisture testing before primer and topcoat paint applications.');
      }

      if (!catKeywords || catKeywords.includes('electrical') || catKeywords.includes('plumbing') || catKeywords.includes('sanitary') || catKeywords.includes('mechanical') || catKeywords.includes('mepf') || catKeywords.includes('utilities')) {
        methods.push('5. MEPF Testing & Commissioning: 24-hour hydrostatic pressure testing (minimum 100 psi) on all water piping; flood/smoke testing on drainage and vent piping; continuity and megger insulation testing on electrical wiring prior to final circuit energization.');
      }

      methods.push(`${methods.length + 1}. Quality Assurance & Final Turnover: Multi-tier quality audits with the Project Manager, systematic rectification of snag lists, handover of complete As-Built drawings, and turnover of manufacturer warranty certificates.`);

      return methods.join('\n\n');
    }

    function syncCoverDeliverablesFromBOQ() {
      const delivText = generateCoverDeliverablesFromBOQ();
      const methodText = generateCoverMethodologiesFromBOQ();
      
      const sbDeliv = document.getElementById('sbCoverKeyDeliverables');
      const docDeliv = document.getElementById('coverKeyDeliverables');
      const sbMethod = document.getElementById('sbCoverMethodologies');
      const docMethod = document.getElementById('coverMethodologies');

      if (sbDeliv) sbDeliv.value = delivText;
      if (docDeliv) { docDeliv.value = delivText; docDeliv.dataset.edited = 'true'; }
      if (sbMethod) sbMethod.value = methodText;
      if (docMethod) { docMethod.value = methodText; docMethod.dataset.edited = 'true'; }

      resizeAllCoverTextareas();
      updateCoverPageCount();
      markUnsaved();
      alert('Key Deliverables and Construction Methodologies have been synchronized based on current BOQ categories.');
    }

    function calcCoverWorkingDays(calDays, basis) {
      const c = Math.max(1, parseInt(calDays, 10) || 0);
      if (basis === '5-day') return Math.max(1, Math.round(c * 5 / 7));
      if (basis === 'consecutive') return c;
      return Math.max(1, Math.round(c * 6 / 7)); // default 6-day
    }

    function calcCoverCalendarDays(workDays, basis) {
      const w = Math.max(1, parseInt(workDays, 10) || 0);
      if (basis === '5-day') return Math.max(1, Math.round(w * 7 / 5));
      if (basis === 'consecutive') return w;
      return Math.max(1, Math.round(w * 7 / 6)); // default 6-day
    }

    function updateProjectDurationClause(calDays, workDays, basis) {
      const sbDuration = document.getElementById('sbCoverProjectDuration');
      const docDuration = document.getElementById('coverProjectDuration');
      const basisLabel = basis === '5-day' ? '5-day work week' : (basis === 'consecutive' ? 'consecutive calendar days' : '6-day work week');
      const newClause1 = `1. Contract Duration: The total project completion period is estimated at ${calDays} Calendar Days (approx. ${workDays} Working Days, based on a ${basisLabel}), commencing within seven (7) calendar days from receipt of Notice to Proceed (NTP) and site possession.`;

      [sbDuration, docDuration].forEach(el => {
        if (!el) return;
        let val = el.value || el.textContent || '';
        if (/^1\.\s*/.test(val)) {
          val = val.replace(/^1\.[^]*?(?=\n\s*\n\s*2\.|\n\s*2\.|$)/, newClause1);
        } else {
          val = newClause1 + (val ? '\n\n' + val : '');
        }
        el.value = val;
        el.dataset.edited = 'true';
      });

      resizeAllCoverTextareas();
      updateCoverPageCount();
      markUnsaved();
    }

    function onCoverDurationDaysChange() {
      const calInput = document.getElementById('sbCoverDurationDays');
      const workInput = document.getElementById('sbCoverWorkingDays');
      const basisSelect = document.getElementById('sbCoverDurationBasis');
      const basis = basisSelect ? basisSelect.value : '6-day';
      const cal = parseInt(calInput?.value, 10) || 120;
      const work = calcCoverWorkingDays(cal, basis);
      if (workInput) workInput.value = work;
      updateProjectDurationClause(cal, work, basis);
    }

    function onCoverWorkingDaysChange() {
      const calInput = document.getElementById('sbCoverDurationDays');
      const workInput = document.getElementById('sbCoverWorkingDays');
      const basisSelect = document.getElementById('sbCoverDurationBasis');
      const basis = basisSelect ? basisSelect.value : '6-day';
      const work = parseInt(workInput?.value, 10) || 102;
      const cal = calcCoverCalendarDays(work, basis);
      if (calInput) calInput.value = cal;
      updateProjectDurationClause(cal, work, basis);
    }

    function onCoverDurationBasisChange() {
      const calInput = document.getElementById('sbCoverDurationDays');
      const workInput = document.getElementById('sbCoverWorkingDays');
      const basisSelect = document.getElementById('sbCoverDurationBasis');
      const basis = basisSelect ? basisSelect.value : '6-day';
      const cal = parseInt(calInput?.value, 10) || 120;
      const work = calcCoverWorkingDays(cal, basis);
      if (workInput) workInput.value = work;
      updateProjectDurationClause(cal, work, basis);
    }

    function syncCoverDurationFromGantt() {
      const range = (typeof getGanttLeafTasksDateRange === 'function') ? getGanttLeafTasksDateRange() : null;
      if (range && range.minStart && range.maxEnd) {
        const diffMs = Math.abs(range.maxEnd.getTime() - range.minStart.getTime());
        const calDays = Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60 * 24)) + 1);
        const basisSelect = document.getElementById('sbCoverDurationBasis');
        const basis = basisSelect ? basisSelect.value : '6-day';
        const workDays = calcCoverWorkingDays(calDays, basis);

        const calInput = document.getElementById('sbCoverDurationDays');
        const workInput = document.getElementById('sbCoverWorkingDays');
        if (calInput) calInput.value = calDays;
        if (workInput) workInput.value = workDays;

        updateProjectDurationClause(calDays, workDays, basis);
        alert(`Duration synchronized from Schedule: ${calDays} Calendar Days (${workDays} Working Days on ${basisSelect ? basisSelect.options[basisSelect.selectedIndex].text : '6-day basis'}).`);
      } else {
        alert('No active scheduled tasks with valid start/finish dates were found in the Gantt schedule. You can set the project duration days manually using the input fields.');
      }
    }

    function getBOQConditionItems() {
      const osmItems = [];
      const byOtherItems = [];
      const notIncludedItems = [];

      if (Array.isArray(boqData)) {
        boqData.forEach((row, idx) => {
          if (!row) return;
          const cond = (row.condition || '').trim();
          if (!cond || cond === 'CPM') return;

          const code = (row.code || '').trim();
          const codeStr = code ? `[${code}] ` : '';
          const title = (row.title || '').trim();
          if (!title) return;
          const fullDesc = `${codeStr}${title}`;

          if (cond === 'OSM' || cond.toUpperCase() === 'OSM') {
            if (!osmItems.includes(fullDesc)) osmItems.push(fullDesc);
          } else if (cond === 'By other Contractor' || cond.toLowerCase().includes('other contractor') || cond.toLowerCase().includes('by other') || cond.toLowerCase().includes('by others')) {
            if (!byOtherItems.includes(fullDesc)) byOtherItems.push(fullDesc);
          } else if (cond === 'Not included in Work' || cond.toLowerCase().includes('not included') || cond.toLowerCase().includes('excluded')) {
            if (!notIncludedItems.includes(fullDesc)) notIncludedItems.push(fullDesc);
          }
        });
      }

      return { osmItems, byOtherItems, notIncludedItems };
    }

    function generateCoverExclusionsFromBOQ() {
      const { osmItems, byOtherItems, notIncludedItems } = getBOQConditionItems();
      const clauses = [];

      // 1. Specific Works Not Included in BOQ
      if (notIncludedItems.length > 0) {
        clauses.push(`1. Specific Works Not Included in Contract (as identified in BOQ): Complete execution, labor, and materials for the following items marked as "Not included in Work" in the Bill of Quantities are strictly excluded from this proposal: ${notIncludedItems.join('; ')}.`);
      } else {
        clauses.push(`1. Specific Works Not Included in Contract: Any scope of work, trade discipline, or task not explicitly scheduled and priced in the approved Bill of Quantities (BOQ) is deemed excluded from the Contractor's contractual scope.`);
      }

      // 2. Owner-Supplied Materials (OSM)
      if (osmItems.length > 0) {
        clauses.push(`2. Owner-Supplied Materials (OSM - as identified in BOQ): Direct procurement and supply of the following materials/equipment marked as "OSM" in the BOQ shall be furnished solely by the Owner/Client at their expense, and are excluded from the Contractor's pricing: ${osmItems.join('; ')}.`);
      } else {
        clauses.push(`2. Owner-Supplied Materials (OSM): Any specialized decorative fixtures, client-specified specialty equipment, or materials designated as Owner-Supplied shall be furnished directly by the Client at their expense.`);
      }

      // 3. Works by Other Contractors
      if (byOtherItems.length > 0) {
        clauses.push(`3. Works Executed by Other Contractors (as identified in BOQ): The following packages marked as "By other Contractor" in the BOQ shall be carried out directly by the Client's other independent contractors and are excluded from this contract: ${byOtherItems.join('; ')}.`);
      } else {
        clauses.push(`3. Works Executed by Other Contractors: Specialty installations contracted separately by the Client (e.g. elevator installation, telecom/data backbone, security integration) are excluded from the Contractor's scope.`);
      }

      // 4. Government & Municipal Statutory Assessment Fees
      clauses.push(`4. Government Permits & Assessment Fees: Building permits, occupancy clearances, fire safety inspection fees, zoning clearances, and local government assessment fees (unless explicitly itemized in the approved BOQ).`);

      // 5. Permanent Utility Infrastructure
      clauses.push(`5. Permanent Utility Infrastructure: Permanent electric transformer installations/tapping fees, permanent water meter connection charges, and permanent sewer connection fees assessed by utility concessionaires.`);

      // 6. Specialist Engineering & External Civil Works
      clauses.push(`6. Specialist Engineering & Off-Site Works: Geotechnical soil investigations, seismic soundness audits, structural retrofitting of existing adjacent structures, and civil works outside the designated property boundaries.`);

      return clauses.join('\n\n');
    }

    function generateCoverOSMFromBOQ() {
      const { osmItems } = getBOQConditionItems();
      const clauses = [];

      if (osmItems.length > 0) {
        clauses.push(`1. Designated Owner-Supplied Materials (OSM): The following items marked in the BOQ as "OSM" shall be supplied, delivered to the site, unloaded, and hoisted at the Owner's expense: ${osmItems.join('; ')}.`);
      } else {
        clauses.push(`1. Supply & Delivery: All Owner-Supplied Materials (OSM) and client-furnished equipment shall be delivered to the jobsite freight-prepaid, properly crated, and aligned with the agreed project procurement timeline.`);
      }

      clauses.push(`2. Quality & Specifications: The Client warrants that all OSM comply with project engineering specifications, building codes, and manufacturer quality standards.`);
      clauses.push(`3. Site Handling & Storage: The Contractor shall provide reasonable protection and secure storage for OSM upon turnover, exercising standard care against loss or weather damage.`);
      clauses.push(`4. Delivery Delays & Compensation: Any delay in OSM turnover, defective materials requiring replacement, or manufacturer shortages impacting the critical path shall entitle the Contractor to a day-for-day time extension and reimbursement of verified standby labor/equipment costs.`);

      return clauses.join('\n\n');
    }

    function generateCoverOtherContractorsFromBOQ() {
      const { byOtherItems } = getBOQConditionItems();
      const clauses = [];

      if (byOtherItems.length > 0) {
        clauses.push(`1. Designated Works by Other Contractors: The following trade packages marked in the BOQ as "By other Contractor" shall be executed by the Client's other independent contractors: ${byOtherItems.join('; ')}.`);
      } else {
        clauses.push(`1. Interface Coordination: Works executed by the Client's independent trade contractors (e.g. structured cabling, specialty HVAC, elevator equipment, interior fitters) must be pre-coordinated with the Contractor's site management.`);
      }

      clauses.push(`2. Protection of Installed Works: Independent trade contractors must respect completed works. Any damage inflicted onto finished finishes, MEPF lines, or waterproofing shall be rectified at the Client's expense.`);
      clauses.push(`3. Shared Hoisting & Temporary Power: Access to vertical hoisting equipment, craneage, temporary power, and staging yards must be scheduled in advance with the Contractor's project superintendent.`);
      clauses.push(`4. Performance & Liability Disclaimer: The Contractor assumes no liability for operational failures, schedule delays, or warranty liabilities originating from works performed by the Client's independent trade contractors.`);

      return clauses.join('\n\n');
    }

    function syncCoverConditionScopesFromBOQ() {
      const exclText = generateCoverExclusionsFromBOQ();
      const osmText = generateCoverOSMFromBOQ();
      const otherText = generateCoverOtherContractorsFromBOQ();

      const sbExcl = document.getElementById('sbCoverExcludedItems');
      const docExcl = document.getElementById('coverExcludedItems');
      const sbOsm = document.getElementById('sbCoverClientMaterials');
      const docOsm = document.getElementById('coverClientMaterials');
      const sbOther = document.getElementById('sbCoverOtherContractors');
      const docOther = document.getElementById('coverOtherContractors');

      if (sbExcl) sbExcl.value = exclText;
      if (docExcl) { docExcl.value = exclText; docExcl.dataset.edited = 'true'; }
      if (sbOsm) sbOsm.value = osmText;
      if (docOsm) { docOsm.value = osmText; docOsm.dataset.edited = 'true'; }
      if (sbOther) sbOther.value = otherText;
      if (docOther) { docOther.value = otherText; docOther.dataset.edited = 'true'; }
    }

    function regenerateCoverProposalFromData() {
      // 1. Sync project meta
      syncCoverLetterFields();

      // 2. Re-render cover summary table (recomputes categories and VAT totals)
      renderCoverLetter();

      // 3. Sync deliverables & methodologies from BOQ
      const delivText = generateCoverDeliverablesFromBOQ();
      const methodText = generateCoverMethodologiesFromBOQ();
      const sbDeliv = document.getElementById('sbCoverKeyDeliverables');
      const docDeliv = document.getElementById('coverKeyDeliverables');
      const sbMethod = document.getElementById('sbCoverMethodologies');
      const docMethod = document.getElementById('coverMethodologies');
      if (sbDeliv) sbDeliv.value = delivText;
      if (docDeliv) { docDeliv.value = delivText; docDeliv.dataset.edited = 'true'; }
      if (sbMethod) sbMethod.value = methodText;
      if (docMethod) { docMethod.value = methodText; docMethod.dataset.edited = 'true'; }

      // 4. Sync condition scopes (Exclusions, OSM, By Others)
      syncCoverConditionScopesFromBOQ();

      // 5. Sync duration from schedule if available
      const range = (typeof getGanttLeafTasksDateRange === 'function') ? getGanttLeafTasksDateRange() : null;
      if (range && range.minStart && range.maxEnd) {
        const diffMs = Math.abs(range.maxEnd.getTime() - range.minStart.getTime());
        const calDays = Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60 * 24)) + 1);
        const basisSelect = document.getElementById('sbCoverDurationBasis');
        const basis = basisSelect ? basisSelect.value : '6-day';
        const workDays = calcCoverWorkingDays(calDays, basis);
        const calInput = document.getElementById('sbCoverDurationDays');
        const workInput = document.getElementById('sbCoverWorkingDays');
        if (calInput) calInput.value = calDays;
        if (workInput) workInput.value = workDays;
        updateProjectDurationClause(calDays, workDays, basis);
      }

      // 6. Resize textareas & update badges
      resizeAllCoverTextareas();
      updateCoverPageCount();
      markUnsaved();

      alert('Cost Proposal and Cover Letter have been regenerated successfully based on current BOQ and Schedule data.');
    }

    let coverAttachments = [];

    // Initialize PDF.js worker safely
    if (typeof window !== 'undefined' && window.pdfjsLib) {
      try {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'pdf.worker.min.js';
      } catch (e) {
        console.warn('PDF.js worker initialization note:', e);
      }
    }

    function formatAttachmentFileSize(bytes) {
      if (!bytes || isNaN(bytes)) return '0 B';
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function compressImageIfLarge(dataUrl, maxDim = 2000) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round(h * (maxDim / w));
              w = maxDim;
            } else {
              w = Math.round(w * (maxDim / h));
              h = maxDim;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          resolve({
            dataUrl: canvas.toDataURL('image/jpeg', 0.88),
            width: w,
            height: h,
            aspectRatio: w / h,
            orientation: w > h ? 'landscape' : 'portrait'
          });
        };
        img.onerror = () => resolve({
          dataUrl,
          width: 800,
          height: 1100,
          aspectRatio: 800 / 1100,
          orientation: 'portrait'
        });
        img.src = dataUrl;
      });
    }

    async function parsePdfAttachmentPages(pdfDataUrlOrBytes) {
      if (typeof window === 'undefined' || !window.pdfjsLib) {
        console.warn('PDF.js not available on window.pdfjsLib');
        return [];
      }
      try {
        let loadingTask;
        if (typeof pdfDataUrlOrBytes === 'string' && pdfDataUrlOrBytes.startsWith('data:')) {
          const base64 = pdfDataUrlOrBytes.split(',')[1];
          const binaryStr = atob(base64);
          const len = binaryStr.length;
          const bytes = new Uint8Array(len);
          for (let i = 0; i < len; i++) {
            bytes[i] = binaryStr.charCodeAt(i);
          }
          loadingTask = window.pdfjsLib.getDocument({ data: bytes });
        } else {
          loadingTask = window.pdfjsLib.getDocument({ url: pdfDataUrlOrBytes });
        }

        const pdfDoc = await loadingTask.promise;
        const numPages = pdfDoc.numPages;
        const pages = [];

        for (let p = 1; p <= numPages; p++) {
          const page = await pdfDoc.getPage(p);
          const unscaledVp = page.getViewport({ scale: 1.0 });
          const isLandscape = unscaledVp.width > unscaledVp.height;
          const orientation = isLandscape ? 'landscape' : 'portrait';

          // Render at 1.8x scale for crisp visual fidelity in preview and print
          const renderScale = 1.8;
          const viewport = page.getViewport({ scale: renderScale });
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(viewport.width);
          canvas.height = Math.round(viewport.height);
          const ctx = canvas.getContext('2d');

          await page.render({ canvasContext: ctx, viewport: viewport }).promise;
          const pageDataUrl = canvas.toDataURL('image/jpeg', 0.88);

          pages.push({
            pageNum: p,
            totalPages: numPages,
            orientation: orientation,
            width: Math.round(unscaledVp.width),
            height: Math.round(unscaledVp.height),
            aspectRatio: unscaledVp.width / unscaledVp.height,
            dataUrl: pageDataUrl
          });
        }

        return pages;
      } catch (err) {
        console.error('Failed to parse PDF attachment pages via PDF.js:', err);
        return [];
      }
    }

    async function handleCoverAttachmentUpload(event) {
      const files = event.target.files;
      if (!files || files.length === 0) return;

      const fileList = Array.from(files);
      event.target.value = '';

      for (const file of fileList) {
        const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
        const isImage = file.type.startsWith('image/');

        if (!isPdf && !isImage) {
          alert(`File "${file.name}" is not an image or PDF document. Only images and PDFs can be attached.`);
          continue;
        }

        const defaultCaption = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]+/g, ' ');
        const fileId = 'att_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);

        try {
          const rawDataUrl = await readFileAsDataUrl(file);

          if (isImage) {
            const comp = await compressImageIfLarge(rawDataUrl, 2000);
            const pages = [
              {
                pageNum: 1,
                totalPages: 1,
                orientation: comp.orientation,
                width: comp.width,
                height: comp.height,
                aspectRatio: comp.aspectRatio,
                dataUrl: comp.dataUrl
              }
            ];

            coverAttachments.push({
              id: fileId,
              name: file.name,
              size: formatAttachmentFileSize(file.size),
              type: 'image',
              dataUrl: comp.dataUrl,
              caption: defaultCaption,
              orientation: comp.orientation,
              pages: pages
            });
          } else if (isPdf) {
            let pages = await parsePdfAttachmentPages(rawDataUrl);
            if (!pages || pages.length === 0) {
              // Fallback single page
              pages = [
                {
                  pageNum: 1,
                  totalPages: 1,
                  orientation: 'portrait',
                  dataUrl: rawDataUrl
                }
              ];
            }

            const overallOrientation = pages.length === 1
              ? pages[0].orientation
              : (pages.every(p => p.orientation === 'landscape') ? 'landscape' : (pages.every(p => p.orientation === 'portrait') ? 'portrait' : 'mixed'));

            coverAttachments.push({
              id: fileId,
              name: file.name,
              size: formatAttachmentFileSize(file.size),
              type: 'pdf',
              dataUrl: rawDataUrl,
              caption: defaultCaption,
              orientation: overallOrientation,
              pages: pages
            });
          }
        } catch (err) {
          console.error('Error processing attachment file:', file.name, err);
          alert(`Failed to load attachment "${file.name}": ${err.message || err}`);
        }
      }

      renderCoverAttachments();
      markUnsaved();
    }

    function removeCoverAttachment(id) {
      coverAttachments = coverAttachments.filter(a => a.id !== id);
      renderCoverAttachments();
      markUnsaved();
    }

    function clearAllCoverAttachments() {
      if (coverAttachments.length === 0) return;
      if (confirm('Remove all attachments from this proposal?')) {
        coverAttachments = [];
        renderCoverAttachments();
        markUnsaved();
      }
    }

    function moveCoverAttachment(index, direction) {
      const target = index + direction;
      if (target < 0 || target >= coverAttachments.length) return;
      const item = coverAttachments.splice(index, 1)[0];
      coverAttachments.splice(target, 0, item);
      renderCoverAttachments();
      markUnsaved();
    }

    function updateCoverAttachmentCaption(id, newCaption) {
      const item = coverAttachments.find(a => a.id === id);
      if (item) {
        item.caption = newCaption;
        const sheets = document.querySelectorAll(`.cover-attachment-sheet[data-attachment-id="${id}"] .cover-attachment-sheet-title`);
        sheets.forEach(titleEl => {
          titleEl.textContent = newCaption || item.name;
        });
        markUnsaved();
      }
    }

    function renderCoverAttachments() {
      // 1. Render in Sidebar List
      const sbList = document.getElementById('coverSidebarAttachmentList');
      if (sbList) {
        if (coverAttachments.length === 0) {
          sbList.innerHTML = `
            <div class="cover-attachment-empty-hint" style="font-size: 11px; color: #94a3b8; text-align: center; padding: 12px 6px; border: 1px dashed var(--line); border-radius: 4px;">
              No files attached yet.<br><span style="font-size: 10px;">Click &ldquo;Attach PDF or Images&rdquo; to add drawings, perspectives, or annex PDFs.</span>
            </div>`;
        } else {
          sbList.innerHTML = coverAttachments.map((att, idx) => {
            const annexLetter = String.fromCharCode(65 + (idx % 26));
            const pageCount = (att.pages && att.pages.length) ? att.pages.length : (att.type === 'pdf' ? 'PDF' : 1);
            const orientLabel = att.orientation ? (att.orientation.charAt(0).toUpperCase() + att.orientation.slice(1)) : 'Auto';
            return `
            <div class="cover-sidebar-attachment-item" data-attachment-id="${att.id}">
              <div class="cover-sidebar-attachment-top">
                <div class="cover-sidebar-attachment-thumb">
                  ${att.type === 'image' || (att.pages && att.pages[0] && att.pages[0].dataUrl && att.pages[0].dataUrl.startsWith('data:image'))
                    ? `<img src="${(att.pages && att.pages[0] && att.pages[0].dataUrl) || att.dataUrl}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 3px;" alt="thumb">`
                    : `<span style="color: #dc2626; font-size: 20px;">&#128196;</span>`}
                </div>
                <div class="cover-sidebar-attachment-info">
                  <div class="cover-sidebar-attachment-name" title="${escapeAttr(att.name)}">
                    <strong style="color: #1e3a8a;">[Annex ${annexLetter}]</strong> ${escapeHtml(att.name)}
                  </div>
                  <div class="cover-sidebar-attachment-size">
                    ${escapeHtml(att.size)} &bull; ${att.type.toUpperCase()}${typeof pageCount === 'number' && pageCount > 1 ? ` (${pageCount} Pgs)` : ''} &bull; <span style="font-weight: 600; color: #0284c7;">${escapeHtml(orientLabel)}</span>
                  </div>
                </div>
                <div class="cover-sidebar-attachment-actions">
                  ${idx > 0 ? `<button type="button" class="btn-small" onclick="moveCoverAttachment(${idx}, -1)" title="Move Up" style="padding: 2px 5px; font-size: 10px;">&uarr;</button>` : ''}
                  ${idx < coverAttachments.length - 1 ? `<button type="button" class="btn-small" onclick="moveCoverAttachment(${idx}, 1)" title="Move Down" style="padding: 2px 5px; font-size: 10px;">&darr;</button>` : ''}
                  <button type="button" class="btn-danger btn-small" onclick="removeCoverAttachment('${att.id}')" title="Delete attachment" style="padding: 2px 5px; font-size: 10px;">&times;</button>
                </div>
              </div>
              <input type="text" class="cover-sidebar-attachment-caption-input" value="${escapeAttr(att.caption || '')}" placeholder="Caption / Annex Title (e.g. Annex ${annexLetter}: Site Development Plan)" oninput="updateCoverAttachmentCaption('${att.id}', this.value)">
            </div>
          `}).join('');
        }
      }

      // 2. Render Dedicated Multi-Sheet Pages in Live Preview
      const docContainer = document.getElementById('coverAttachmentsContainer');
      if (docContainer) {
        if (coverAttachments.length === 0) {
          docContainer.innerHTML = '';
          docContainer.style.display = 'none';
        } else {
          docContainer.style.display = 'flex';

          const dims = (typeof getCoverPageDimensions === 'function')
            ? getCoverPageDimensions()
            : { widthMm: 210, heightMm: 297, sizeKey: 'A4' };
          const baseDim = COVER_PAPER_DIMENSIONS[dims.sizeKey] || COVER_PAPER_DIMENSIONS['A4'];
          const pWidth = baseDim.widthMm;
          const pHeight = baseDim.heightMm;
          const lWidth = baseDim.heightMm;
          const lHeight = baseDim.widthMm;

          const docNo = document.getElementById('coverDocNo')?.textContent || 'FM-OPN-01-06';
          const projectName = document.getElementById('coverProjectName')?.textContent || 'PROJECT COST PROPOSAL';

          let sheetsHtml = '';
          let globalAnnexIdx = 0;

          coverAttachments.forEach(att => {
            const annexLetter = String.fromCharCode(65 + (globalAnnexIdx % 26));
            globalAnnexIdx++;

            const pages = (Array.isArray(att.pages) && att.pages.length > 0)
              ? att.pages
              : [{ pageNum: 1, totalPages: 1, orientation: att.orientation || 'portrait', dataUrl: att.dataUrl }];

            const totalPagesInAtt = pages.length;

            pages.forEach(page => {
              const isLandscape = page.orientation === 'landscape';
              const wMm = isLandscape ? lWidth : pWidth;
              const hMm = isLandscape ? lHeight : pHeight;
              const orientationClass = isLandscape ? 'orientation-landscape' : 'orientation-portrait';

              const displayTitle = att.caption
                ? escapeHtml(att.caption)
                : escapeHtml(att.name.replace(/\.[^/.]+$/, '').replace(/[-_]+/g, ' '));

              const multiPageTag = totalPagesInAtt > 1
                ? `<span class="cover-attachment-page-tag">Page ${page.pageNum} of ${totalPagesInAtt}</span>`
                : '';

              sheetsHtml += `
                <div class="cover-letter-page cover-attachment-sheet ${orientationClass}"
                     data-attachment-id="${att.id}"
                     data-page-num="${page.pageNum}"
                     data-orientation="${page.orientation}"
                     style="width: ${wMm}mm; min-width: ${wMm}mm; max-width: ${wMm}mm; min-height: ${hMm}mm; height: ${hMm}mm; padding: 3mm 5mm 3mm 5mm !important;">
                  
                  <!-- Corporate Header Bar -->
                  <div class="cover-attachment-sheet-header">
                    <div class="cover-attachment-header-left">
                      <span class="cover-attachment-badge">ANNEX ${annexLetter}</span>
                      <span class="cover-attachment-sheet-title">${displayTitle}</span>
                      ${multiPageTag}
                    </div>
                    <div class="cover-attachment-header-right">
                      <span>${escapeHtml(docNo)} &bull; ${escapeHtml(projectName)}</span>
                    </div>
                  </div>

                  <!-- Corporate Sheet Media Body -->
                  <div class="cover-attachment-sheet-body">
                    ${page.dataUrl && (page.dataUrl.startsWith('data:image') || page.dataUrl.startsWith('http') || page.dataUrl.startsWith('blob'))
                      ? `<img src="${page.dataUrl}" alt="${displayTitle}" class="cover-attachment-sheet-img">`
                      : (att.type === 'pdf'
                         ? `<iframe src="${att.dataUrl}#toolbar=0&navpanes=0" class="cover-attachment-pdf-frame" style="width:100%; height:100%; border:none;" title="${displayTitle}"></iframe>`
                         : `<img src="${att.dataUrl}" alt="${displayTitle}" class="cover-attachment-sheet-img">`
                        )
                    }
                  </div>

                  <!-- Corporate Footer Bar -->
                  <div class="cover-attachment-sheet-footer">
                    <div class="cover-attachment-footer-left">
                      <span>${escapeHtml(att.name)}</span> &bull; <span>${escapeHtml(att.size)}</span>
                    </div>
                    <div class="cover-attachment-footer-center">
                      <span>CONFIDENTIAL &bull; CONSTRUCTION COST PROPOSAL ANNEX</span>
                    </div>
                    <div class="cover-attachment-footer-right">
                      <span class="cover-attachment-footer-page-val">Page -- of --</span>
                    </div>
                  </div>

                </div>
              `;
            });
          });

          docContainer.innerHTML = sheetsHtml;
        }
      }

      updateCoverPageCount();
    }

    function toggleAllCoverSidebarGroups() {
      const groups = document.querySelectorAll('.cover-sidebar .cover-sidebar-group');
      const anyClosed = Array.from(groups).some(g => !g.hasAttribute('open'));
      groups.forEach(g => {
        if (anyClosed) {
          g.setAttribute('open', '');
        } else {
          g.removeAttribute('open');
        }
      });
      const btnText = document.getElementById('btnToggleAllSidebarGroupsText');
      if (btnText) {
        btnText.textContent = anyClosed ? 'Collapse All' : 'Expand All';
      }
    }
    window.toggleAllCoverSidebarGroups = toggleAllCoverSidebarGroups;

    function initCoverSidebar() {
      applyCoverPageSetup();
      COVER_SYNC_MAPPINGS.forEach(m => {
        const sbEl = document.getElementById(m.sbId);
        const docEl = document.getElementById(m.docId);
        if (!sbEl || !docEl) return;

        // Sidebar input -> Document preview
        sbEl.addEventListener('input', () => {
          if (isSyncingCoverFields) return;
          isSyncingCoverFields = true;
          try {
            if (m.isDate) {
              docEl.textContent = formatDisplayDate(sbEl.value);
              const headerDate = document.getElementById('proposalDate');
              if (headerDate) headerDate.value = sbEl.value;
            } else if (m.isMeta) {
              docEl.textContent = sbEl.value;
              fitCoverMetaSingleLine();
              if (m.sbId === 'sbCoverProjectName') {
                const headerProj = document.getElementById('projectName');
                if (headerProj) headerProj.value = sbEl.value;
                const subj = document.getElementById('coverSubject');
                const sbSubj = document.getElementById('sbCoverSubject');
                if (subj && !subj.dataset.edited) {
                  const sText = sbEl.value ? `Cost Proposal for ${sbEl.value}` : 'Cost Proposal';
                  subj.textContent = sText;
                  if (sbSubj) sbSubj.value = sText;
                }
              } else if (m.sbId === 'sbCoverClientName') {
                const headerClient = document.getElementById('clientName');
                if (headerClient) headerClient.value = sbEl.value;
                const acc = document.getElementById('coverAcceptedBy');
                const sbAcc = document.getElementById('sbCoverAcceptedBy');
                if (acc && !acc.dataset.edited) {
                  acc.value = sbEl.value;
                  if (sbAcc) sbAcc.value = sbEl.value;
                }
              }
            } else if (m.isValue) {
              docEl.value = sbEl.value;
              docEl.dataset.edited = 'true';
            } else {
              docEl.textContent = sbEl.value;
            }
            markUnsaved();
            updateCoverPageCount();
          } finally {
            isSyncingCoverFields = false;
          }
        });

        // Document preview -> Sidebar input
        docEl.addEventListener('input', () => {
          if (isSyncingCoverFields) return;
          isSyncingCoverFields = true;
          try {
            if (m.isValue) {
              sbEl.value = docEl.value;
            } else {
              sbEl.value = (docEl.textContent || '').trim();
            }
            markUnsaved();
            updateCoverPageCount();
          } finally {
            isSyncingCoverFields = false;
          }
        });
      });

      // Deliverables & Duration event wiring
      const btnSyncDeliv = document.getElementById('btnSyncCoverDeliverablesBOQ');
      if (btnSyncDeliv) {
        btnSyncDeliv.onclick = syncCoverDeliverablesFromBOQ;
      }
      const durDaysInput = document.getElementById('sbCoverDurationDays');
      if (durDaysInput) {
        durDaysInput.addEventListener('input', onCoverDurationDaysChange);
      }
      const workDaysInput = document.getElementById('sbCoverWorkingDays');
      if (workDaysInput) {
        workDaysInput.addEventListener('input', onCoverWorkingDaysChange);
      }
      const durBasisSelect = document.getElementById('sbCoverDurationBasis');
      if (durBasisSelect) {
        durBasisSelect.addEventListener('change', onCoverDurationBasisChange);
      }
      const btnSyncDuration = document.getElementById('btnSyncCoverDurationGantt');
      if (btnSyncDuration) {
        btnSyncDuration.onclick = syncCoverDurationFromGantt;
      }

      // Window resize re-fit preview
      window.addEventListener('resize', () => {
        const coverSheet = document.getElementById('coverLetterSheet');
        if (coverSheet && coverSheet.style.display !== 'none' && !coverSheet.classList.contains('hidden')) {
          updateCoverPageCount();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCoverSidebar);
    } else {
      initCoverSidebar();
    }

    function renderCoverLetter() {
      clearBOQCaches();
      syncCoverLetterFields();
      const tbody = document.querySelector('#coverSummaryTable tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      let totalVat = 0, totalCost = 0;
      boqData.forEach((row, index) => {
        if (row.type !== 'category' && row.type !== 'subcategory') return;
        const summary = computeBOQCategorySummary(index);
        if (row.type === 'category') {
          totalVat += summary.vatCost;
          totalCost += summary.totalCost;
        }
        const isSub = row.type === 'subcategory';
        const tr = document.createElement('tr');
        tr.className = isSub ? 'row-subcategory' : 'row-category';
        tr.innerHTML = `
          <td style="text-align:center;">${escapeHtml(summary.itemCode)}</td>
          <td style="${isSub ? 'padding-left: 20px;' : ''}">${escapeHtml(summary.workDescription)}</td>
          <td class="number">${peso(summary.totalCost)}</td>`;
        tbody.appendChild(tr);
      });
      const totalRow = document.createElement('tr');
      totalRow.className = 'summary-total-row';
      totalRow.innerHTML = `
        <td></td>
        <td>Total Proposal Cost</td>
        <td class="number">${peso(totalCost)}</td>`;
      tbody.appendChild(totalRow);
      updateCoverVatMode(totalVat);
      resizeAllCoverTextareas();
      updateCoverPageCount();
      syncSidebarFromCover();
      fitCoverDocTitle();
    }

    let coverPdfTextareaReplacements = [];

    function restoreCoverProposalAfterPdf() {
      coverPdfTextareaReplacements.forEach(item => {
        if (item.replacement && item.replacement.parentNode) {
          item.replacement.parentNode.replaceChild(item.textarea, item.replacement);
        }
      });
      coverPdfTextareaReplacements = [];
      document.body.classList.remove('print-cover-proposal');
      updateCoverPageCount();
    }

    function prepareCoverProposalForPdf() {
      // Keep PDF output tied to the exact live cover letter content and styling.
      renderCoverLetter();
      cleanupLegacyCoverLetterText();
      restoreCoverProposalAfterPdf();

      // Textareas often print only their visible viewport even when resized.
      // Replace them temporarily with normal expanding divs so every line is shown in PDF.
      document.querySelectorAll('#coverLetterSheet textarea').forEach(textarea => {
        const replacement = document.createElement('div');
        replacement.className = 'cover-print-textarea';
        replacement.textContent = textarea.value || textarea.textContent || '';
        replacement.dataset.sourceTextareaId = textarea.id || '';

        // Preserve the user's manually resized textarea box height in the PDF.
        // Use the larger of the visible box height and the scroll height so the
        // printed box never clips content, but also does not shrink when enlarged.
        const rectHeight = Math.ceil(textarea.getBoundingClientRect().height || 0);
        const computedHeight = parseFloat(window.getComputedStyle(textarea).height) || 0;
        const scrollHeight = Math.ceil(textarea.scrollHeight || 0);
        const preservedHeight = Math.max(rectHeight, computedHeight, scrollHeight, 84);
        replacement.style.setProperty('--cover-print-box-height', preservedHeight + 'px');
        replacement.style.minHeight = preservedHeight + 'px';

        textarea.parentNode.replaceChild(replacement, textarea);
        coverPdfTextareaReplacements.push({ textarea, replacement });
      });

      // In single column view, textareas scale to their natural height.

      document.querySelectorAll('.cover-letter-page [contenteditable="true"]').forEach(el => {
        el.style.border = '0';
        el.style.padding = '0';
        el.style.background = 'transparent';
        el.style.boxShadow = 'none';
        el.style.textAlign = 'justify';
        el.style.fontSize = '10pt';
        el.style.lineHeight = '1.45';
      });
      updateCoverPageCount();
    }

    function printCoverProposalPdf(overrideScope) {
      const scopeSelect = document.getElementById('sbCoverPrintScope') || document.getElementById('toolbarCoverPrintScope');
      const scope = overrideScope || (scopeSelect ? (scopeSelect.value || 'all') : 'all');

      prepareCoverProposalForPdf();
      document.body.classList.add('print-cover-proposal');
      document.body.dataset.printScope = scope;

      const dims = (typeof getCoverPageDimensions === 'function')
        ? getCoverPageDimensions()
        : { sizeKey: 'A4', orientKey: 'portrait', widthMm: 210, heightMm: 297 };
      const baseDim = COVER_PAPER_DIMENSIONS[dims.sizeKey] || COVER_PAPER_DIMENSIONS['A4'];

      const style = document.createElement('style');
      style.id = 'cover-print-style';

      let scopeRules = '';
      if (scope === 'proposal') {
        scopeRules = `
          body.print-cover-proposal .cover-attachment-sheet,
          body.print-cover-proposal #coverAttachmentsContainer {
            display: none !important;
            visibility: hidden !important;
          }
        `;
      } else if (scope === 'attachments') {
        scopeRules = `
          body.print-cover-proposal .cover-letter-page:not(.cover-attachment-sheet) {
            display: none !important;
            visibility: hidden !important;
          }
          body.print-cover-proposal .cover-attachment-sheet:first-child {
            page-break-before: auto !important;
            break-before: auto !important;
          }
        `;
      }

      style.innerHTML = `
        @page {
          size: ${dims.sizeKey.toLowerCase()} ${dims.orientKey} !important;
          margin: 10mm !important;
        }
        @page landscape-sheet {
          size: ${dims.sizeKey.toLowerCase()} landscape !important;
          margin: 6mm 8mm 6mm 8mm !important;
        }
        @page portrait-sheet {
          size: ${dims.sizeKey.toLowerCase()} portrait !important;
          margin: 8mm 6mm 8mm 6mm !important;
        }
        body.print-cover-proposal .cover-preview-wrapper {
          display: block !important;
          transform: none !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
        }
        body.print-cover-proposal .cover-attachments-container {
          display: block !important;
          width: 100% !important;
        }
        body.print-cover-proposal .cover-letter-page:not(.cover-attachment-sheet) {
          width: ${dims.widthMm - 20}mm !important;
          page-break-after: always !important;
          break-after: page !important;
        }
        body.print-cover-proposal .cover-attachment-sheet {
          box-shadow: none !important;
          border: none !important;
          page-break-before: always !important;
          break-before: page !important;
          page-break-after: always !important;
          break-after: page !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          margin: 0 auto !important;
          padding: 3mm 4mm 2mm 4mm !important;
          box-sizing: border-box !important;
        }
        body.print-cover-proposal .cover-attachment-sheet.orientation-landscape {
          page: landscape-sheet !important;
          width: calc(var(--cover-page-landscape-width, ${baseDim.heightMm}mm) - 16mm) !important;
          height: calc(var(--cover-page-landscape-height, ${baseDim.widthMm}mm) - 12mm) !important;
        }
        body.print-cover-proposal .cover-attachment-sheet.orientation-portrait {
          page: portrait-sheet !important;
          width: calc(var(--cover-page-portrait-width, ${baseDim.widthMm}mm) - 12mm) !important;
          height: calc(var(--cover-page-portrait-height, ${baseDim.heightMm}mm) - 16mm) !important;
        }
        body.print-cover-proposal .cover-attachment-sheet-body {
          background: transparent !important;
          border: none !important;
          padding: 0 !important;
        }
        body.print-cover-proposal .cover-attachment-sheet-img {
          max-width: 100% !important;
          max-height: 100% !important;
          width: 100% !important;
          height: 100% !important;
          object-fit: contain !important;
        }
        .cover-letter-terms {
          display: flex !important;
          flex-direction: column !important;
          gap: 12px !important;
          margin-top: 12px !important;
        }
        .cover-letter-terms > div {
          display: flex !important;
          flex-direction: column !important;
          width: 100% !important;
          box-sizing: border-box !important;
          background: transparent !important;
          border: none !important;
          box-shadow: none !important;
          padding: 0 !important;
          margin-bottom: 4mm !important;
        }
        .cover-letter-terms > div::before {
          display: none !important;
        }
        .cover-letter-signatures {
          display: flex !important;
          flex-direction: column !important;
          gap: 24px !important;
          margin-top: 28px !important;
        }
        ${scopeRules}
      `;
      document.head.appendChild(style);
      const cleanup = () => {
        restoreCoverProposalAfterPdf();
        const injectedStyle = document.getElementById('cover-print-style');
        if (injectedStyle) injectedStyle.remove();
        window.removeEventListener('afterprint', cleanup);
      };
      window.addEventListener('afterprint', cleanup);
      window.print();
      setTimeout(cleanup, 1500);
    }

    function getBOQPrintableCellText(cell) {
      const editor = cell.querySelector('textarea, input, select');
      if (editor) {
        if (editor.tagName === 'SELECT') {
          return editor.options[editor.selectedIndex]?.text || editor.value || '';
        }
        return editor.value || editor.textContent || '';
      }
      return (cell.innerText || cell.textContent || '').replace(/\n\s*\n/g, '\n').trim();
    }

    function prepareBOQWrappedSpecificationForPdf() {
      // Replace printable BOQ cell contents with one clean print-only value.
      // This removes live inputs/textareas and any hidden mirror text from the print flow,
      // preventing Specification values from duplicating or aligning at the bottom.
      document.querySelectorAll('#boqTable tbody td, #boqSummaryTable tbody td').forEach((cell) => {
        if (cell.dataset.boqPrintOriginalHtml !== undefined) return;
        cell.dataset.boqPrintOriginalHtml = cell.innerHTML;
        const suffixEl = cell.querySelector('.boq-desc-suffix');
        const inputEl = cell.querySelector('input');
        if (suffixEl && inputEl) {
          const text = inputEl.value;
          const suffixText = suffixEl.textContent;
          cell.querySelectorAll('input, textarea, select, .boq-print-wrapped-text, .boq-print-cell-text, .boq-desc-suffix').forEach(el => el.remove());
          cell.innerHTML = '';
          const span = document.createElement('span');
          span.className = 'boq-print-wrapped-text';
          span.textContent = text;
          const suffixSpan = document.createElement('span');
          suffixSpan.className = 'boq-desc-suffix';
          suffixSpan.style.color = '#ff0000';
          suffixSpan.style.fontWeight = 'bold';
          suffixSpan.style.marginLeft = '4px';
          suffixSpan.textContent = suffixText;
          span.appendChild(suffixSpan);
          cell.appendChild(span);
        } else {
          const text = getBOQPrintableCellText(cell);
          cell.querySelectorAll('input, textarea, select, .boq-print-wrapped-text, .boq-print-cell-text').forEach(el => el.remove());
          cell.innerHTML = '';
          const span = document.createElement('span');
          span.className = 'boq-print-wrapped-text';
          span.textContent = text;
          cell.appendChild(span);
        }
      });
    }

    function restoreBOQWrappedSpecificationAfterPdf() {
      document.querySelectorAll('#boqTable tbody td[data-boq-print-original-html], #boqSummaryTable tbody td[data-boq-print-original-html]').forEach((cell) => {
        cell.innerHTML = cell.dataset.boqPrintOriginalHtml || '';
        delete cell.dataset.boqPrintOriginalHtml;
      });
      setTimeout(() => {
        document.querySelectorAll('#boqTable textarea.boq-specification-input').forEach(autoResizeTextarea);
      }, 0);
    }

    function printBOQWithSummaryPdf() {
      renderBOQTable();
      renderBOQSummaryTable();
      prepareBOQWrappedSpecificationForPdf();
      document.body.classList.add('print-boq-pdf');
      let cleaned = false;
      const cleanup = () => {
        if (cleaned) return;
        cleaned = true;
        restoreBOQWrappedSpecificationAfterPdf();
        document.body.classList.remove('print-boq-pdf');
        window.removeEventListener('afterprint', cleanup);
      };
      window.addEventListener('afterprint', cleanup);
      window.print();
      setTimeout(cleanup, 15000);
    }

    function printGanttPdf(orientation) {
      const modal = document.getElementById('ganttPrintModal');
      if (!modal) {
        executeGanttPrint(orientation, 'fit');
        return;
      }
      
      modal.style.display = 'flex';
      
      const confirmBtn = document.getElementById('confirmGanttPrintBtn');
      confirmBtn.onclick = () => {
        const fitOption = document.querySelector('input[name="ganttPrintFitOption"]:checked').value;
        modal.style.display = 'none';
        executeGanttPrint(orientation, fitOption);
      };
    }

    function closeGanttPrintModal() {
      const modal = document.getElementById('ganttPrintModal');
      if (modal) modal.style.display = 'none';
    }

    function executeGanttPrint(orientation, fitOption) {
      ganttTimeCache.clear();
      const leftPanel = document.querySelector('.gantt-left-panel');
      const leftW = leftPanel ? (leftPanel.offsetWidth - (ganttSettings.showCoordinates ? 40 : 0)) : 480;
      
      const activeCols = ganttColumns.filter(c => c.visible);
      let cumulativeW = 0;
      const printedCols = [];
      const coveredColIndices = [];
      
      activeCols.forEach((col, idx) => {
        if (cumulativeW < leftW) {
          printedCols.push(col);
        } else {
          coveredColIndices.push(idx + 1 + (ganttSettings.showCoordinates ? 1 : 0));
        }
        cumulativeW += col.width;
      });
      
      const printedW = printedCols.reduce((sum, c) => sum + c.width, 0);
      const currentWidth = printedW + 'px';
      const sizeStr = (orientation === 'landscape') ? 'A3 landscape' : 'A3 portrait';
      
      const timelineBodyEl = document.getElementById('ganttTimelineBody');
      let rightW = timelineBodyEl ? Math.max(timelineBodyEl.offsetWidth, timelineBodyEl.scrollWidth) : 0;
      
      const projStartStr = document.getElementById('ganttProjectStartInput')?.value || getTodayDateString();
      const projStartDate = parseSafeDate(projStartStr);
      let maxTaskEndDate = null;
      const taskInfos = boqData.map((row, index) => getGanttTaskTimeInfo(index));
      taskInfos.forEach(info => {
        if (info && info.endDate) {
          const d = parseSafeDate(info.endDate, null);
          if (d && (!maxTaskEndDate || d > maxTaskEndDate)) {
            maxTaskEndDate = new Date(d);
          }
        }
      });
      let totalDays = 60;
      if (maxTaskEndDate) {
        totalDays = Math.round((maxTaskEndDate - projStartDate) / (1000 * 60 * 60 * 24)) + 1;
        if (totalDays < 1) totalDays = 1;
      }
      
      const timelineEndDate = new Date(projStartDate);
      timelineEndDate.setDate(projStartDate.getDate() + totalDays - 1);
      
      const rightPanel = document.querySelector('.gantt-right-panel');
      const rightPanelWidth = rightPanel ? rightPanel.clientWidth : 0;
      
      let activeColW = 28;
      let totalWeeks = 0;
      let totalMonthsCols = 0;
      let totalQuartersCols = 0;
      
      if (!rightW) {
        if (ganttScale === 'days') {
          const minW = ganttSettings.colWidthDays !== undefined ? ganttSettings.colWidthDays : 28;
          activeColW = minW;
          rightW = totalDays * activeColW + 80;
        } else if (ganttScale === 'weeks') {
          totalWeeks = Math.ceil(totalDays / 7);
          const minW = ganttSettings.colWidthWeeks !== undefined ? ganttSettings.colWidthWeeks : 64;
          activeColW = minW;
          rightW = totalWeeks * activeColW + 80;
        } else if (ganttScale === 'quarters') {
          let tempQ = new Date(projStartDate);
          tempQ.setMonth(Math.floor(tempQ.getMonth() / 3) * 3, 1);
          while (tempQ <= timelineEndDate) {
            totalQuartersCols++;
            tempQ.setMonth(tempQ.getMonth() + 3);
          }
          const minW = ganttSettings.colWidthQuarters !== undefined ? ganttSettings.colWidthQuarters : 180;
          activeColW = minW;
          rightW = totalQuartersCols * activeColW + 80;
        } else {
          let tempMonth = new Date(projStartDate);
          tempMonth.setDate(1);
          while (tempMonth <= timelineEndDate) {
            totalMonthsCols++;
            tempMonth.setMonth(tempMonth.getMonth() + 1);
          }
          const minW = ganttSettings.colWidthMonths !== undefined ? ganttSettings.colWidthMonths : 120;
          activeColW = minW;
          rightW = totalMonthsCols * activeColW + 80;
        }
      }
      
      const oWeight = ganttSettings.gridOuterWeight !== undefined ? ganttSettings.gridOuterWeight : 1;
      const oStyle = ganttSettings.gridOuterStyle || 'solid';
      const oColor = ganttSettings.gridOuterColor || '#cbd5e1';

      const totalGanttW = printedW + rightW;
      
      let actualFitOption = fitOption;
      let clone = null;
      
      const printableWidth = (orientation === 'landscape') ? 1512 : 1047;
      const safety = 8;
      
      if (fitOption === 'fit2') {
        const rightW1 = Math.min(rightW, (printableWidth - safety) - printedW);
        const rightW2 = rightW - rightW1;
        
        if (rightW2 > 0) {
          const container = document.querySelector('.gantt-container');
          if (container) {
            clone = container.cloneNode(true);
            clone.classList.add('gantt-print-clone');
            container.parentNode.insertBefore(clone, container.nextSibling);
          }
        } else {
          actualFitOption = 'fit';
        }
      }
      
      const doFit = (actualFitOption === 'fit');
      let scaleFactor = 1;
      if (doFit) {
        scaleFactor = Math.min(1, (printableWidth - safety) / (totalGanttW + 2 * oWeight));
      }
      
      let toolbarW = (totalGanttW + 2 * oWeight) * scaleFactor;
      
      let fit2Styles = '';
      if (actualFitOption === 'fit2') {
        const rightW1 = Math.min(rightW, (printableWidth - safety) - printedW);
        const rightW2 = rightW - rightW1;
        const page1GanttW = printedW + rightW1 + 2 * oWeight;
        const page2GanttW = rightW2 + 2 * oWeight;
        
        const scaleFactor1 = Math.min(1, (printableWidth - safety) / page1GanttW);
        const scaleFactor2 = Math.min(1, (printableWidth - safety) / page2GanttW);
        const scaleFactorUnified = Math.min(scaleFactor1, scaleFactor2);
        
        toolbarW = page1GanttW * scaleFactorUnified;
        
        fit2Styles = `
          /* Page 1 (Original container) */
          body.print-gantt-pdf .gantt-container:not(.gantt-print-clone) {
            zoom: ${scaleFactorUnified} !important;
            width: ${page1GanttW}px !important;
            page-break-after: always !important;
            break-after: page !important;
          }
          body.print-gantt-pdf .gantt-container:not(.gantt-print-clone) .gantt-right-panel {
            width: ${rightW1}px !important;
            flex-grow: 0 !important;
            flex-shrink: 0 !important;
            overflow: hidden !important;
          }
          body.print-gantt-pdf .gantt-container:not(.gantt-print-clone) #ganttTimelineHeader,
          body.print-gantt-pdf .gantt-container:not(.gantt-print-clone) #ganttTimelineBody {
            width: ${rightW}px !important;
            min-width: ${rightW}px !important;
          }

          /* Page 2 (Cloned container - Hide table 1 and divider, only timeline columns) */
          body.print-gantt-pdf .gantt-container.gantt-print-clone {
            zoom: ${scaleFactorUnified} !important;
            width: ${page2GanttW}px !important;
            page-break-after: avoid !important;
            break-after: avoid !important;
          }
          body.print-gantt-pdf .gantt-container.gantt-print-clone .gantt-left-panel,
          body.print-gantt-pdf .gantt-container.gantt-print-clone .gantt-divider {
            display: none !important;
          }
          body.print-gantt-pdf .gantt-container.gantt-print-clone .gantt-right-panel {
            width: ${rightW2}px !important;
            flex-grow: 0 !important;
            flex-shrink: 0 !important;
            overflow: hidden !important;
          }
          body.print-gantt-pdf .gantt-container.gantt-print-clone #ganttTimelineHeader,
          body.print-gantt-pdf .gantt-container.gantt-print-clone #ganttTimelineBody {
            width: ${rightW}px !important;
            min-width: ${rightW}px !important;
            transform: translateX(-${rightW1}px) !important;
          }
        `;
      }
      
      let hideColumnsCss = '';
      coveredColIndices.forEach(nth => {
        hideColumnsCss += `
          body.print-gantt-pdf #ganttTaskTable th:nth-child(${nth}),
          body.print-gantt-pdf #ganttTaskTable td:nth-child(${nth}) {
            display: none !important;
          }
        `;
      });
      

      
      const cWeight = ganttSettings.gridColWeight !== undefined ? ganttSettings.gridColWeight : 1;
      const cStyle = ganttSettings.gridColStyle || 'solid';
      const cColor = ganttSettings.gridColColor || '#e2e8f0';

      const hHeight = ganttSettings.headerHeight !== undefined ? ganttSettings.headerHeight : 48;
      const hTopHeight = Math.floor(hHeight / 2);
      const hBottomHeight = hHeight - hTopHeight;
      const hTotalHeight = hTopHeight + hBottomHeight;

      const style = document.createElement('style');
      style.id = 'gantt-print-style';
      style.innerHTML = `
        @page {
          size: ${sizeStr} !important;
          margin: 10mm !important;
        }
        body.print-gantt-pdf * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        body.print-gantt-pdf {
          background: white !important;
          color: black !important;
          margin: 0 !important;
          padding: 0 !important;
        }
        body.print-gantt-pdf #ganttSheet {
          display: block !important;
          width: 100% !important;
          height: auto !important;
          background: white !important;
          padding: 0 !important;
          margin: 0 !important;
        }
        body.print-gantt-pdf .gantt-container {
          display: flex !important;
          height: auto !important;
          min-height: 0 !important;
          border: ${oWeight}px ${oStyle} ${oColor} !important;
          box-sizing: border-box !important;
          overflow: hidden !important;
          zoom: ${scaleFactor} !important;
          width: ${totalGanttW + 2 * oWeight}px !important;
        }
        body.print-gantt-pdf .gantt-left-panel {
          width: ${currentWidth} !important;
          flex-shrink: 0 !important;
          overflow: hidden !important;
          border-right: ${cWeight}px ${cStyle} ${cColor} !important;
          height: auto !important;
        }
        body.print-gantt-pdf #ganttTaskTable {
          width: ${printedW}px !important;
          table-layout: fixed !important;
          border-collapse: collapse !important;
        }
        body.print-gantt-pdf #ganttTaskTable thead {
          display: table-row-group !important;
        }
        body.print-gantt-pdf #ganttTaskTable thead tr:not(.gantt-coord-header-row),
        body.print-gantt-pdf #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          height: ${hHeight}px !important;
          box-sizing: border-box !important;
        }
        body.print-gantt-pdf #ganttTaskTable thead tr:not(.gantt-coord-header-row) th {
          padding: 0 4px !important;
          padding-top: 0 !important;
          padding-bottom: 0 !important;
          line-height: ${hHeight}px !important;
          vertical-align: middle !important;
          white-space: nowrap !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
        }
        body.print-gantt-pdf .gantt-coord-header-row,
        body.print-gantt-pdf .gantt-coord-cell,
        body.print-gantt-pdf .gantt-coord-th {
          display: none !important;
        }
        body.print-gantt-pdf #ganttTimelineHeader {
          height: ${hTotalHeight}px !important;
          box-sizing: border-box !important;
          border-bottom: none !important;
        }
        body.print-gantt-pdf .gantt-timeline-header-row.row-top {
          height: ${hTopHeight}px !important;
          line-height: ${hTopHeight}px !important;
          box-sizing: border-box !important;
        }
        body.print-gantt-pdf .gantt-timeline-header-row.row-bottom {
          height: ${hBottomHeight}px !important;
          line-height: ${hBottomHeight}px !important;
          box-sizing: border-box !important;
        }
        body.print-gantt-pdf .gantt-header-cell {
          height: 100% !important;
        }
        body.print-gantt-pdf .gantt-row,
        body.print-gantt-pdf .gantt-row td {
          height: ${ganttSettings.rowHeight}px !important;
          line-height: 1.3 !important;
          box-sizing: border-box !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
        body.print-gantt-pdf .gantt-timeline-row {
          height: ${ganttSettings.rowHeight}px !important;
          line-height: ${ganttSettings.rowHeight}px !important;
          box-sizing: border-box !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
        body.print-gantt-pdf .gantt-row td {
          padding: 0 4px !important;
          padding-top: 0 !important;
          padding-bottom: 0 !important;
          vertical-align: middle !important;
          white-space: nowrap !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
        }
        body.print-gantt-pdf .gantt-row td input {
          border: none !important;
          background: transparent !important;
          padding: 0 !important;
          text-align: center !important;
          pointer-events: none !important;
          height: ${ganttSettings.rowHeight - 6}px !important;
          line-height: ${ganttSettings.rowHeight - 6}px !important;
          box-sizing: border-box !important;
          margin: 0 !important;
          vertical-align: middle !important;
        }
        body.print-gantt-pdf .gantt-right-panel {
          flex-grow: 1 !important;
          overflow: visible !important;
          height: auto !important;
        }
        body.print-gantt-pdf #ganttTimelineHeader,
        body.print-gantt-pdf #ganttTimelineBody {
          overflow: visible !important;
        }
        body.print-gantt-pdf .gantt-bar-handle {
          display: none !important;
        }
        body.print-gantt-pdf .header,
        body.print-gantt-pdf .sheet-nav,
        body.print-gantt-pdf .summary-sheet-toolbar button,
        body.print-gantt-pdf .summary-sheet-toolbar .gantt-view-options,
        body.print-gantt-pdf section:not(#ganttSheet) {
          display: none !important;
          visibility: hidden !important;
        }
        body.print-gantt-pdf .summary-sheet-toolbar {
          display: flex !important;
          flex-direction: row !important;
          justify-content: space-between !important;
          align-items: center !important;
          width: ${toolbarW}px !important;
          margin-bottom: 10px !important;
        }
        body.print-gantt-pdf .summary-sheet-toolbar * {
          color: black !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        body.print-gantt-pdf .summary-sheet-toolbar input {
          border: none !important;
          background: transparent !important;
          color: black !important;
          font-family: inherit !important;
          font-size: 11px !important;
          font-weight: bold !important;
          padding: 0 !important;
          width: 100px !important;
          pointer-events: none !important;
        }
        body.print-gantt-pdf .summary-sheet-toolbar input::-webkit-calendar-picker-indicator {
          display: none !important;
          -webkit-appearance: none !important;
        }
        ${hideColumnsCss}
        ${fit2Styles}
      `;
      document.head.appendChild(style);
      
      document.body.classList.add('print-gantt-pdf');
      
      const cleanup = () => {
        document.body.classList.remove('print-gantt-pdf');
        const printStyle = document.getElementById('gantt-print-style');
        if (printStyle) printStyle.remove();
        if (clone) clone.remove();
        window.removeEventListener('afterprint', cleanup);
      };
      
      window.addEventListener('afterprint', cleanup);
      window.print();
      setTimeout(cleanup, 3000);
    }
    window.printGanttPdf = printGanttPdf;
    window.closeGanttPrintModal = closeGanttPrintModal;

    // --- GANTT UPDATE DATA DROPDOWN & MODAL FUNCTIONS ---
    // --- GANTT UPDATE DATA DROPDOWN & MODAL FUNCTIONS ---
    let activeGanttHighlightIdx = -1;
    let activeQtyHighlightIdx = -1;

    function toggleGanttHighlightDropdown(event) {
      event.stopPropagation();
      const updateDataDropdown = document.getElementById('ganttUpdateDataDropdown');
      if (updateDataDropdown) updateDataDropdown.style.display = 'none';
      const qtyHighlightDropdown = document.getElementById('qtyHighlightDropdown');
      if (qtyHighlightDropdown) qtyHighlightDropdown.style.display = 'none';
      
      const dropdown = document.getElementById('ganttHighlightDropdown');
      if (!dropdown) return;
      const isVisible = dropdown.style.display === 'block';
      dropdown.style.display = isVisible ? 'none' : 'block';
    }

    function toggleQtyHighlightDropdown(event) {
      event.stopPropagation();
      const ganttHighlightDropdown = document.getElementById('ganttHighlightDropdown');
      if (ganttHighlightDropdown) ganttHighlightDropdown.style.display = 'none';
      
      const dropdown = document.getElementById('qtyHighlightDropdown');
      if (!dropdown) return;
      const isVisible = dropdown.style.display === 'block';
      dropdown.style.display = isVisible ? 'none' : 'block';
    }

    function setGanttHighlightMode(mode, event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      ganttSettings.ganttHighlightMode = mode;
      saveGanttSettings();
      updateHighlightBtnLabels();
      
      // Re-apply highlight colors to current selection
      highlightGanttRow(activeGanttHighlightIdx);
      highlightQtyRow(activeQtyHighlightIdx);
    }

    function highlightGanttRow(index, event) {
      if (event && event.target.closest('input, select, button, .toggle-btn')) return;
      activeGanttHighlightIdx = index;
      
      document.querySelectorAll('.gantt-row-highlighted').forEach(el => {
        el.classList.remove('gantt-row-highlighted');
        el.style.backgroundColor = '';
      });
      
      if (index === -1 || ganttSettings.ganttHighlightMode === 'none') return;
      
      const leftRow = document.getElementById(`ganttLeftRow-${index}`);
      const rightRow = document.getElementById(`ganttRightRow-${index}`);
      
      if (leftRow) leftRow.classList.add('gantt-row-highlighted');
      if (rightRow) rightRow.classList.add('gantt-row-highlighted');
    }

    function highlightQtyRow(index, event) {
      if (event && event.target.closest('input, select, button')) return;
      activeQtyHighlightIdx = index;
      
      document.querySelectorAll('.qty-row-highlighted').forEach(el => {
        el.classList.remove('qty-row-highlighted');
        el.style.backgroundColor = '';
      });
      
      if (index === -1 || ganttSettings.ganttHighlightMode === 'none') return;
      
      const leftRow = document.getElementById(`qtyLeftRow-${index}`);
      const rightRow = document.getElementById(`qtyRightRow-${index}`);
      
      if (leftRow) leftRow.classList.add('qty-row-highlighted');
      if (rightRow) rightRow.classList.add('qty-row-highlighted');
    }

    function getHighlightColorValue(mode) {
      if (mode === 'blue') return '#bfdbfe';
      if (mode === 'green') return '#bbf7d0';
      if (mode === 'orange') return '#fed7aa';
      if (mode === 'yellow') return '#fef08a';
      return 'transparent';
    }

    window.toggleGanttHighlightDropdown = toggleGanttHighlightDropdown;
    window.toggleQtyHighlightDropdown = toggleQtyHighlightDropdown;
    window.setGanttHighlightMode = setGanttHighlightMode;
    window.highlightGanttRow = highlightGanttRow;
    window.highlightQtyRow = highlightQtyRow;

    function toggleGanttUpdateDataDropdown(event) {
      event.stopPropagation();
      const highlightDropdown = document.getElementById('ganttHighlightDropdown');
      if (highlightDropdown) highlightDropdown.style.display = 'none';
      
      const dropdown = document.getElementById('ganttUpdateDataDropdown');
      if (!dropdown) return;
      const isVisible = dropdown.style.display === 'block';
      dropdown.style.display = isVisible ? 'none' : 'block';
    }
    
    document.addEventListener('click', function(e) {
      const dropdown = document.getElementById('ganttUpdateDataDropdown');
      if (dropdown && dropdown.style.display === 'block') {
        if (!e.target.closest('.dropdown')) {
          dropdown.style.display = 'none';
        }
      }
      if (!e.target.closest('#ganttHighlightRowBtn') && !e.target.closest('#ganttHighlightDropdown')) {
        const drop = document.getElementById('ganttHighlightDropdown');
        if (drop) drop.style.display = 'none';
      }
      if (!e.target.closest('#qtyHighlightRowBtn') && !e.target.closest('#qtyHighlightDropdown')) {
        const drop = document.getElementById('qtyHighlightDropdown');
        if (drop) drop.style.display = 'none';
      }
    });

    let qtyModalScale = 'days';
    let qtyModalActiveView = 'quantity';
    function showUpdateQtyInst(event) {
      if (event) event.preventDefault();
      
      const dropdown = document.getElementById('ganttUpdateDataDropdown');
      if (dropdown) dropdown.style.display = 'none';
      
      const modal = document.getElementById('ganttQtyInstModal');
      if (modal) modal.style.display = 'flex';
      
      qtyModalScale = ganttScale || 'days';
      updateQtyModalScaleButtons();
      
      qtyModalActiveView = 'quantity';
      updateQtyModalViewTabs();
      
      // Sync scrolling between left and right panels
      const qtyLeftPanel = document.getElementById('qtyLeftPanel');
      const qtyRightPanel = document.getElementById('qtyRightPanel');
      if (qtyLeftPanel && qtyRightPanel && !qtyRightPanel.dataset.scrollListenerAttached) {
        qtyRightPanel.dataset.scrollListenerAttached = 'true';
        let activeQtyScroll = null;
        qtyRightPanel.addEventListener('scroll', () => {
          if (activeQtyScroll === 'left') {
            window.requestAnimationFrame(updateQtyTimelineViewport);
            return;
          }
          activeQtyScroll = 'right';
          window.requestAnimationFrame(() => {
            qtyLeftPanel.scrollTop = qtyRightPanel.scrollTop;
            updateQtyTimelineViewport();
            activeQtyScroll = null;
          });
        }, { passive: true });
        qtyLeftPanel.addEventListener('scroll', () => {
          if (activeQtyScroll === 'right') {
            window.requestAnimationFrame(updateQtyTimelineViewport);
            return;
          }
          activeQtyScroll = 'left';
          window.requestAnimationFrame(() => {
            qtyRightPanel.scrollTop = qtyLeftPanel.scrollTop;
            updateQtyTimelineViewport();
            activeQtyScroll = null;
          });
        }, { passive: true });
      }
      
      renderQtyModalTable();
      setupQtyDividerResize();
      setupGanttTimelineContextMenu();
    }

    function setupQtyDividerResize() {
      const container = document.querySelector('#ganttQtyInstModal .gantt-container');
      const leftPanel = document.getElementById('qtyLeftPanel');
      const divider = document.getElementById('qtyModalDivider');
      if (!container || !leftPanel || !divider) return;
      
      if (divider.dataset.resizeInitialized) return;
      divider.dataset.resizeInitialized = 'true';
      
      let isDragging = false;
      
      divider.addEventListener('mousedown', (e) => {
        isDragging = true;
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        
        const containerRect = container.getBoundingClientRect();
        let newWidth = e.clientX - containerRect.left;
        
        const minW = 150;
        const maxW = containerRect.width - 150;
        if (newWidth < minW) newWidth = minW;
        if (newWidth > maxW) newWidth = maxW;
        
        leftPanel.style.width = newWidth + 'px';
      });
      
      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
          localStorage.setItem('cost_estimate_gantt_left_width_v1', leftPanel.style.width);
        }
      });
    }
    
    function closeGanttQtyInstModal() {
      const modal = document.getElementById('ganttQtyInstModal');
      if (modal) modal.style.display = 'none';
      
      saveBOQSection(true);
      renderGanttChart();
      renderBOQTable();
    }
    
    function setQtyModalScale(scale) {
      qtyModalScale = scale;
      updateQtyModalScaleButtons();
      renderQtyModalTable();
    }
    
    function updateQtyModalScaleButtons() {
      ['days', 'weeks', 'months', 'quarters'].forEach(s => {
        const btn = document.getElementById('qtyScale' + s.charAt(0).toUpperCase() + s.slice(1));
        if (btn) {
          if (s === qtyModalScale) {
            btn.style.background = 'var(--accent)';
            btn.style.color = '#fff';
          } else {
            btn.style.background = '';
            btn.style.color = '';
          }
        }
      });
    }

    function setQtyModalView(viewName) {
      qtyModalActiveView = viewName;
      updateQtyModalViewTabs();
      renderQtyModalTable();
    }
    
    function updateQtyModalViewTabs() {
      const views = ['quantity', 'accomplishment', 'progress_cost', 'progress_day', 'cash_flow_estimated', 'cash_flow_day'];
      views.forEach(v => {
        const btn = document.getElementById(`qtyViewTab-${v}`);
        if (btn) {
          if (v === qtyModalActiveView) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        }
      });
    }

    function getLeafDescendents(parentIndex) {
      const leaves = [];
      const parentLevel = levelOf(boqData[parentIndex].type);
      let i = parentIndex + 1;
      while (i < boqData.length && levelOf(boqData[i].type) > parentLevel) {
        if (!hasChildRow(boqData, i)) {
          leaves.push(i);
        }
        i++;
      }
      return leaves;
    }
    
    function getParentEstQty(index) {
      if (!hasChildRow(boqData, index)) {
        const displayValues = computeBOQDisplayValues(boqData[index]);
        return displayValues ? displayValues.qty : 0;
      }
      const leaves = getLeafDescendents(index);
      let sum = 0;
      leaves.forEach(leafIdx => {
        const displayValues = computeBOQDisplayValues(boqData[leafIdx]);
        sum += displayValues ? displayValues.qty : 0;
      });
      return sum;
    }

    function getPeriodQtySingle(index, dateStr) {
      const row = boqData[index];
      if (!row) return 0;
      if (hasChildRow(boqData, index)) {
        const leaves = getLeafDescendents(index);
        let sum = 0;
        leaves.forEach(leafIdx => {
          const leafRow = boqData[leafIdx];
          if (leafRow && leafRow.ganttPeriodQty && leafRow.ganttPeriodQty[dateStr]) {
            sum += parseFloat(leafRow.ganttPeriodQty[dateStr]) || 0;
          }
        });
        return sum;
      }
      return (row.ganttPeriodQty && row.ganttPeriodQty[dateStr]) || 0;
    }
    
    function getPeriodQtyTotal(index) {
      const row = boqData[index];
      if (!row) return 0;
      if (hasChildRow(boqData, index)) {
        const leaves = getLeafDescendents(index);
        let sum = 0;
        leaves.forEach(leafIdx => {
          sum += getPeriodQtyTotal(leafIdx);
        });
        return sum;
      }
      if (!row.ganttPeriodQty) return 0;
      let sum = 0;
      for (const k in row.ganttPeriodQty) {
        sum += parseFloat(row.ganttPeriodQty[k]) || 0;
      }
      return sum;
    }

    function getAccumulatedPeriodQty(index, pStart, pEnd) {
      const start = new Date(pStart);
      const end = new Date(pEnd);
      start.setHours(0, 0, 0, 0);
      end.setHours(23, 59, 59, 999);
      
      if (hasChildRow(boqData, index)) {
        const leaves = getLeafDescendents(index);
        let sum = 0;
        leaves.forEach(leafIdx => {
          sum += getAccumulatedPeriodQty(leafIdx, start, end);
        });
        return sum;
      }
      
      const row = boqData[index];
      if (!row || !row.ganttPeriodQty) return 0;
      
      let sum = 0;
      for (const dateStr in row.ganttPeriodQty) {
        const d = parseSafeDate(dateStr);
        if (d && d >= start && d <= end) {
          sum += parseFloat(row.ganttPeriodQty[dateStr]) || 0;
        }
      }
      return sum;
    }

    function updatePeriodQty(index, dateStr, value) {
      const row = boqData[index];
      if (!row) return;
      row.ganttPeriodQty = row.ganttPeriodQty || {};
      const parsedVal = parseFloat(value);
      if (isNaN(parsedVal) || parsedVal <= 0) {
        delete row.ganttPeriodQty[dateStr];
      } else {
        row.ganttPeriodQty[dateStr] = parsedVal;
      }
      
      const newTotal = getPeriodQtyTotal(index);
      row.ganttInstalledQty = newTotal;
      
      const displayValues = computeBOQDisplayValues(row) || {};
      const estQty = displayValues.qty || 0;
      if (estQty > 0) {
        row.ganttProgress = Math.min(100, Math.max(0, (newTotal / estQty) * 100));
      }
      
      saveBOQSection(true);
      
      const totalCell = document.getElementById(`qtyInstTotal-${index}`);
      if (totalCell) totalCell.textContent = newTotal.toFixed(2);
      
      const pctCell = document.getElementById(`qtyProgressPercent-${index}`);
      if (pctCell) {
        const pct = estQty > 0 ? ((newTotal / estQty) * 100).toFixed(2) : '0.00';
        pctCell.textContent = pct + '%';
      }
      const rightPanel = document.getElementById('qtyRightPanel');
      const savedScrollTop = rightPanel ? rightPanel.scrollTop : 0;
      const savedScrollLeft = rightPanel ? rightPanel.scrollLeft : 0;
      renderQtyModalTable();
      
      if (rightPanel) {
        rightPanel.scrollTop = savedScrollTop;
        rightPanel.scrollLeft = savedScrollLeft;
      }
    }

    function updateQtyModalTask(index, field, value) {
      updateGanttTask(index, field, value);
      renderQtyModalTable();
    }

    function renderQtyModalTable() {
      ganttTimeCache.clear();
      const viewLabelMap = {
        'accomplishment': 'Summary of Accomplishment',
        'progress_cost': 'Progress % (Cost) Summary',
        'progress_day': 'Progress % (Day) Summary',
        'cash_flow_estimated': 'Cash Flow (Estimated)',
        'cash_flow_day': 'Cash Flow (Day)'
      };

      const taskTableBody = document.querySelector('#qtyTaskTable tbody');
      const timelineHeader = document.getElementById('qtyTimelineHeader');
      const timelineBody = document.getElementById('qtyTimelineBody');
      const rightPanel = document.getElementById('qtyRightPanel');
      if (!taskTableBody || !timelineHeader || !timelineBody || !rightPanel) return;
      
      ganttCoordinateValues = {};
      const coordH = ganttSettings.coordHeaderHeight !== undefined ? ganttSettings.coordHeaderHeight : 24;
      const hHeight = ganttSettings.headerHeight !== undefined ? ganttSettings.headerHeight : 48;
      const hTopHeight = Math.floor(hHeight / 2);
      const hBottomHeight = hHeight - hTopHeight;
      
      const leftPanel = document.getElementById('qtyLeftPanel');
      const savedLeftScrollTop = leftPanel ? leftPanel.scrollTop : 0;
      const savedLeftScrollLeft = leftPanel ? leftPanel.scrollLeft : 0;
      const savedRightScrollTop = rightPanel.scrollTop;
      const savedRightScrollLeft = rightPanel.scrollLeft;
      
      taskTableBody.innerHTML = '';
      const taskTableFragment = document.createDocumentFragment();
      timelineHeader.innerHTML = '';
      timelineBody.innerHTML = '';
      
      const projStartStr = document.getElementById('ganttProjectStartInput')?.value || getTodayDateString();
      const projStartDate = parseSafeDate(projStartStr);
      
      const taskInfos = boqData.map((row, index) => getGanttTaskTimeInfo(index));
      
      let maxTaskEndDate = null;
      taskInfos.forEach(info => {
        if (info && info.endDate) {
          const d = parseSafeDate(info.endDate, null);
          if (d && (!maxTaskEndDate || d > maxTaskEndDate)) {
            maxTaskEndDate = new Date(d);
          }
        }
      });
      
      const timelineStartDate = parseSafeDate(projStartDate);
      let totalDays = 60;
      if (maxTaskEndDate) {
        totalDays = Math.round((maxTaskEndDate - timelineStartDate) / (1000 * 60 * 60 * 24)) + 1;
        if (totalDays < 1) totalDays = 1;
      }
      
      const timelineEndDate = new Date(timelineStartDate);
      timelineEndDate.setDate(timelineStartDate.getDate() + totalDays - 1);
      
      let activeColW = 50;
      let totalWeeks = 0;
      let totalMonthsCols = 0;
      let totalQuartersCols = 0;
      
      if (qtyModalScale === 'days') {
        activeColW = ganttSettings.colWidthDays !== undefined ? ganttSettings.colWidthDays : 45;
      } else if (qtyModalScale === 'weeks') {
        totalWeeks = Math.ceil(totalDays / 7);
        activeColW = ganttSettings.colWidthWeeks !== undefined ? ganttSettings.colWidthWeeks : 65;
      } else if (qtyModalScale === 'quarters') {
        let tempQ = new Date(timelineStartDate);
        tempQ.setMonth(Math.floor(tempQ.getMonth() / 3) * 3, 1);
        while (tempQ <= timelineEndDate) {
          totalQuartersCols++;
          tempQ.setMonth(tempQ.getMonth() + 3);
        }
        activeColW = ganttSettings.colWidthQuarters !== undefined ? ganttSettings.colWidthQuarters : 120;
      } else {
        let tempMonth = new Date(timelineStartDate);
        tempMonth.setDate(1);
        while (tempMonth <= timelineEndDate) {
          totalMonthsCols++;
          tempMonth.setMonth(tempMonth.getMonth() + 1);
        }
        activeColW = ganttSettings.colWidthMonths !== undefined ? ganttSettings.colWidthMonths : 90;
      }
      
      const activeCols = ganttColumns.filter(c => c.visible);
      const extraWidthForCoords = ganttSettings.showCoordinates ? 40 : 0;
      const totalW = activeCols.reduce((sum, c) => sum + c.width, 0) + extraWidthForCoords;
      if (leftPanel) {
        const savedLeftWidth = localStorage.getItem('cost_estimate_gantt_left_width_v1');
        if (savedLeftWidth) {
          leftPanel.style.width = savedLeftWidth;
        } else {
          leftPanel.style.width = Math.min(550, totalW) + 'px';
        }
      }
      const qtyTaskTable = document.getElementById('qtyTaskTable');
      if (qtyTaskTable) {
        qtyTaskTable.style.width = totalW + 'px';
      }
      
      const taskTableHead = document.querySelector('#qtyTaskTable thead');
      if (taskTableHead) {
        let theadHtml = '';
        if (ganttSettings.showCoordinates) {
          theadHtml += '<tr class="gantt-coord-header-row" style="position: sticky; top: 0; z-index: 10; background: var(--bg);">';
          theadHtml += '<th style="width: 40px; border-right: 1px solid var(--accent);"></th>';
          activeCols.forEach((col, idx) => {
            const borderStyle = idx < activeCols.length - 1 ? 'border-right: 1px solid var(--accent);' : '';
            const colIdxInFull = ganttColumns.indexOf(col);
            theadHtml += `<th style="width: ${col.width}px; ${borderStyle}">${getColLetter(colIdxInFull)}</th>`;
          });
          theadHtml += '</tr>';
        }

        const topOffset = ganttSettings.showCoordinates ? `${coordH}px` : '0px';
        theadHtml += `<tr style="height: ${hTopHeight}px; border-bottom: 1px solid var(--line); background: var(--accent); position: sticky; top: ${topOffset}; z-index: 10; color: white;">`;
        if (ganttSettings.showCoordinates) {
          theadHtml += '<th class="gantt-coord-th" style="width: 40px; color: white; text-align: center; font-size: 10px; font-weight: bold; text-transform: uppercase; border-right: 1px solid var(--accent-dark);">#</th>';
        }
        activeCols.forEach((col, idx) => {
          const borderStyle = idx < activeCols.length - 1 ? 'border-right: 1px solid var(--accent-dark);' : '';
          const alignStyle = (col.id === 'title' || col.id === 'specification') ? 'text-align: left; padding-left: 8px;' : 'text-align: center;';
          const isDragging = (window.activeGanttDragColId === col.id);
          const dragStyle = isDragging ? 'opacity: 0.6; background: #3b82f6 !important; border: 1px dashed white !important;' : '';
          const cursorStyle = isDragging ? 'cursor: grabbing;' : 'cursor: grab;';
          theadHtml += `<th style="width: ${col.width}px; position: relative; color: white; ${alignStyle} font-size: 10px; font-weight: bold; text-transform: uppercase; ${borderStyle} ${dragStyle} ${cursorStyle}" data-col-id="${col.id}">
            ${escapeHtml(col.name)}
            <div class="gantt-col-resizer" style="position: absolute; right: 0; top: 0; width: 6px; height: 100%; cursor: col-resize; z-index: 2;"></div>
          </th>`;
        });
        theadHtml += '</tr>';

        // Add blank row below the main header row to align with the timeline's date rows
        const blankRowTopOffset = ganttSettings.showCoordinates ? `${coordH + hTopHeight}px` : `${hTopHeight}px`;
        theadHtml += `<tr style="height: ${hBottomHeight}px; border-bottom: 1px solid var(--line); background: var(--accent); position: sticky; top: ${blankRowTopOffset}; z-index: 10;">`;
        if (ganttSettings.showCoordinates) {
          theadHtml += '<th style="width: 40px; border-right: 1px solid var(--accent-dark);"></th>';
        }
        activeCols.forEach((col, idx) => {
          const borderStyle = idx < activeCols.length - 1 ? 'border-right: 1px solid var(--accent-dark);' : '';
          theadHtml += `<th style="width: ${col.width}px; ${borderStyle}"></th>`;
        });
        theadHtml += '</tr>';
        taskTableHead.innerHTML = theadHtml;

        if (!taskTableHead.dataset.listenersAttached) {
          taskTableHead.dataset.listenersAttached = 'true';
          
          taskTableHead.addEventListener('contextmenu', (e) => {
            const th = e.target.closest('th');
            if (!th) return;
            const colId = th.dataset.colId;
            if (!colId) return;
            e.preventDefault();
            showGanttHeaderContextMenu(e.clientX, e.clientY, colId);
          });
          
          taskTableHead.addEventListener('mousedown', (e) => {
            const resizer = e.target.closest('.gantt-col-resizer');
            if (resizer) {
              e.preventDefault();
              e.stopPropagation();
              
              const th = resizer.closest('th');
              const colId = th.dataset.colId;
              if (!colId) return;
              const col = ganttColumns.find(c => c.id === colId);
              if (!col) return;
              
              const startX = e.clientX;
              const startWidth = col.width;
              
              const onMouseMove = (moveEvent) => {
                const deltaX = moveEvent.clientX - startX;
                const newWidth = Math.max(30, startWidth + deltaX);
                col.width = newWidth;
                
                th.style.width = newWidth + 'px';
                
                const activeCols2 = ganttColumns.filter(c => c.visible);
                const extraWidthForCoords2 = ganttSettings.showCoordinates ? 40 : 0;
                const totalW2 = activeCols2.reduce((sum, c) => sum + c.width, 0) + extraWidthForCoords2;
                document.getElementById('qtyTaskTable').style.width = totalW2 + 'px';
                
                const leftPanel2 = document.getElementById('qtyLeftPanel');
                if (leftPanel2 && !localStorage.getItem('cost_estimate_gantt_left_width_v1')) {
                  leftPanel2.style.width = Math.min(550, totalW2) + 'px';
                }
              };
              
              const onMouseUp = () => {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
                saveGanttColumns();
                renderGanttChart();
              };
              
              document.addEventListener('mousemove', onMouseMove);
              document.addEventListener('mouseup', onMouseUp);
              return;
            }
            
            if (e.button !== 0) return; // Left click only
            const th = e.target.closest('th');
            if (!th) return;
            
            const colId = th.dataset.colId;
            if (!colId) return;
            const col = ganttColumns.find(c => c.id === colId);
            if (!col) return;
            
            e.preventDefault();
            
            window.activeGanttDragColId = colId;
            renderQtyModalTable();
            
            const onMouseMove = (moveEvent) => {
              const ths = Array.from(taskTableHead.querySelectorAll('th'));
              const hoveredTh = ths.find(otherTh => {
                const rect = otherTh.getBoundingClientRect();
                return moveEvent.clientX >= rect.left && moveEvent.clientX <= rect.right;
              });
              
              if (hoveredTh && hoveredTh.dataset.colId !== window.activeGanttDragColId) {
                const targetColId = hoveredTh.dataset.colId;
                if (targetColId) {
                  const dragIdx = ganttColumns.findIndex(c => c.id === window.activeGanttDragColId);
                  const targetIdx = ganttColumns.findIndex(c => c.id === targetColId);
                  
                  if (dragIdx !== -1 && targetIdx !== -1 && dragIdx !== targetIdx) {
                    const [draggedCol] = ganttColumns.splice(dragIdx, 1);
                    ganttColumns.splice(targetIdx, 0, draggedCol);
                    saveGanttColumns();
                    renderQtyModalTable();
                  }
                }
              }
            };
            
            const onMouseUp = () => {
              document.removeEventListener('mousemove', onMouseMove);
              document.removeEventListener('mouseup', onMouseUp);
              window.activeGanttDragColId = null;
              saveGanttColumns();
              renderGanttChart();
            };
            
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
          });
        }
      }
      
      // Auto-resize / stretch columns if there is space on the right to fit the container width
      if (rightPanel && rightPanel.clientWidth > 0) {
        const rightPanelWidth = rightPanel.clientWidth;
        let totalPeriods = 0;
        if (qtyModalScale === 'days') {
          totalPeriods = totalDays;
        } else if (qtyModalScale === 'weeks') {
          totalPeriods = totalWeeks;
        } else if (qtyModalScale === 'quarters') {
          totalPeriods = totalQuartersCols;
        } else {
          totalPeriods = totalMonthsCols;
        }
        
        if (totalPeriods > 0) {
          const minRequiredWidth = totalPeriods * activeColW;
          if (minRequiredWidth < rightPanelWidth) {
            const stretchedW = (rightPanelWidth - 5) / totalPeriods; // 5px buffer
            if (stretchedW > activeColW) {
              activeColW = Math.floor(stretchedW);
            }
          }
        }
      }

      let headerRow1Html = '';
      let headerRow2Html = '';
      const periods = [];
      const altBgColor = ganttSettings.headerAltBgColor || '#dbeafe';
      const rightBgColor = ganttSettings.headerRightBg || '#ffffff';
      
      if (qtyModalScale === 'days') {
        let currentMonth = '';
        let currentMonthCols = 0;
        let monthIndex = -1;
        const dayMonthIndices = [];
        for (let i = 0; i < totalDays; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          if (mLabel !== currentMonth) {
            monthIndex++;
            currentMonth = mLabel;
          }
          dayMonthIndices.push(monthIndex);
        }

        currentMonth = '';
        currentMonthCols = 0;
        monthIndex = -1;
        for (let i = 0; i < totalDays; i++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + i);
          const mLabel = d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
          const dayLabel = d.getDate();
          const dateStr = formatDateString(d);
          periods.push({ dateStr, label: dayLabel.toString() });
          const dayMonthIdx = dayMonthIndices[i];
          const dayBg = dayMonthIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (mLabel !== currentMonth) {
            if (currentMonth !== '') {
              const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentMonth}</div>`;
            }
            monthIndex++;
            currentMonth = mLabel;
            currentMonthCols = 1;
          } else {
            currentMonthCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; font-size: 9px; justify-content: center; text-align: center; border-right: 1px solid var(--line); ${dayBg}">${dayLabel}</div>`;
        }
        if (currentMonth !== '') {
          const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentMonth}</div>`;
        }
      } else if (qtyModalScale === 'weeks') {
        let currentMonth = '';
        let currentMonthCols = 0;
        let monthIndex = -1;
        const weekMonthIndices = [];
        for (let w = 0; w < totalWeeks; w++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + w * 7);
          const mLabel = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          if (mLabel !== currentMonth) {
            monthIndex++;
            currentMonth = mLabel;
          }
          weekMonthIndices.push(monthIndex);
        }

        currentMonth = '';
        currentMonthCols = 0;
        monthIndex = -1;
        for (let w = 0; w < totalWeeks; w++) {
          const d = new Date(timelineStartDate);
          d.setDate(timelineStartDate.getDate() + w * 7);
          const mLabel = d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
          const wkLabel = `W${w + 1}`;
          const dateStr = formatDateString(d);
          periods.push({ dateStr, label: wkLabel });
          const wkBg = w % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (mLabel !== currentMonth) {
            if (currentMonth !== '') {
              const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentMonth}</div>`;
            }
            monthIndex++;
            currentMonth = mLabel;
            currentMonthCols = 1;
          } else {
            currentMonthCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; font-size: 9px; justify-content: center; text-align: center; border-right: 1px solid var(--line); ${wkBg}" title="Starts ${dateStr}">${wkLabel}</div>`;
        }
        if (currentMonth !== '') {
          const bgStyle = monthIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentMonthCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentMonth}</div>`;
        }
      } else if (qtyModalScale === 'quarters') {
        let currentYear = '';
        let currentYearCols = 0;
        let yearIndex = -1;
        const qYearIndices = [];
        for (let q = 0; q < totalQuartersCols; q++) {
          const d = new Date(timelineStartDate);
          d.setMonth(d.getMonth() + q * 3);
          const yLabel = d.getFullYear().toString();
          if (yLabel !== currentYear) {
            yearIndex++;
            currentYear = yLabel;
          }
          qYearIndices.push(yearIndex);
        }

        currentYear = '';
        currentYearCols = 0;
        yearIndex = -1;
        let qDate = new Date(timelineStartDate);
        qDate.setMonth(Math.floor(qDate.getMonth() / 3) * 3, 1);
        for (let q = 0; q < totalQuartersCols; q++) {
          const yLabel = qDate.getFullYear();
          const qLabel = getQuarterLabel(qDate);
          const dateStr = formatDateString(qDate);
          periods.push({ dateStr, label: qLabel });
          const qBg = q % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (yLabel !== currentYear) {
            if (currentYear !== '') {
              const bgStyle = yearIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentYear}</div>`;
            }
            yearIndex++;
            currentYear = yLabel;
            currentYearCols = 1;
          } else {
            currentYearCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; justify-content: center; text-align: center; border-right: 1px solid var(--line); ${qBg}">${qLabel}</div>`;
          qDate.setMonth(qDate.getMonth() + 3);
        }
        if (currentYear !== '') {
          const bgStyle = yearIndex % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentYear}</div>`;
        }
      } else {
        let currentYear = '';
        let currentYearCols = 0;
        const mYearIndices = [];
        let yIdx = -1;
        let cMonth = new Date(timelineStartDate);
        cMonth.setDate(1);
        while (cMonth <= timelineEndDate) {
          const yLabel = cMonth.getFullYear();
          if (yLabel !== currentYear) {
            yIdx++;
            currentYear = yLabel;
          }
          mYearIndices.push(yIdx);
          cMonth.setMonth(cMonth.getMonth() + 1);
        }

        currentYear = '';
        currentYearCols = 0;
        yIdx = -1;
        cMonth = new Date(timelineStartDate);
        cMonth.setDate(1);
        let mIdx = 0;
        while (cMonth <= timelineEndDate) {
          const yLabel = cMonth.getFullYear();
          const mLabel = cMonth.toLocaleDateString('en-US', { month: 'short' });
          const dateStr = formatDateString(cMonth);
          periods.push({ dateStr, label: mLabel });
          const mBg = mIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          
          if (yLabel !== currentYear) {
            if (currentYear !== '') {
              const bgStyle = yIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
              headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentYear}</div>`;
            }
            yIdx++;
            currentYear = yLabel;
            currentYearCols = 1;
          } else {
            currentYearCols++;
          }
          headerRow2Html += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; justify-content: center; text-align: center; border-right: 1px solid var(--line); ${mBg}">${mLabel}</div>`;
          mIdx++;
          cMonth.setMonth(cMonth.getMonth() + 1);
        }
        if (currentYear !== '') {
          const bgStyle = yIdx % 2 === 0 ? 'background: ' + altBgColor + ' !important;' : 'background: ' + rightBgColor + ' !important;';
          headerRow1Html += `<div class="gantt-header-cell" style="width: ${currentYearCols * activeColW}px; flex-shrink: 0; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; text-align: center; ${bgStyle}">${currentYear}</div>`;
        }
      }
      
      if (ganttSettings.showCoordinates) {
        const startIdx = activeCols.length;
        let headerRowCoordHtml = '';
        for (let p = 0; p < periods.length; p++) {
          const colLetter = getColLetter(startIdx + p);
          headerRowCoordHtml += `<div class="gantt-header-cell" style="width: ${activeColW}px; flex-shrink: 0; text-align: center; border-right: 1px solid var(--line); font-size: 10px; font-weight: bold; justify-content: center; height: ${coordH}px; line-height: ${coordH}px;">${colLetter}</div>`;
        }
        timelineHeader.innerHTML = `
          <div class="gantt-timeline-header-row row-coord" style="height: ${coordH}px; line-height: ${coordH}px; display: flex; background: var(--bg); border-bottom: 1px solid var(--line);">${headerRowCoordHtml}</div>
          <div class="gantt-timeline-header-row row-top" style="height: ${hTopHeight}px; line-height: ${hTopHeight}px; display: flex;">${headerRow1Html}</div>
          <div class="gantt-timeline-header-row row-bottom" style="height: ${hBottomHeight}px; line-height: ${hBottomHeight}px; display: flex;">${headerRow2Html}</div>
        `;
        timelineHeader.style.height = (coordH + hHeight) + 'px';
      } else {
        timelineHeader.innerHTML = `
          <div class="gantt-timeline-header-row row-top" style="height: ${hTopHeight}px; line-height: ${hTopHeight}px; display: flex;">${headerRow1Html}</div>
          <div class="gantt-timeline-header-row row-bottom" style="height: ${hBottomHeight}px; line-height: ${hBottomHeight}px; display: flex;">${headerRow2Html}</div>
        `;
        timelineHeader.style.height = hHeight + 'px';
      }
      
      const widthStr = (periods.length * activeColW) + 'px';
      timelineBody.style.width = widthStr;
      timelineHeader.style.width = widthStr;
      
      let timelineHtml = '';
      let visibleRowIndex = 0;
      
      qtyVisibleIndices = [];
      boqData.forEach((row, index) => {
        if (!shouldHideQtyHierarchyRow(index)) {
          qtyVisibleIndices.push(index);
        }
      });
      
      boqData.forEach((row, index) => {
        if (shouldHideQtyHierarchyRow(index)) return;
        visibleRowIndex++;
        
        const isParent = hasChildRow(boqData, index);
        const taskInfo = getGanttTaskTimeInfo(index);
        
        populateGanttCoordinateValuesForTask(index, visibleRowIndex, activeCols, taskInfo, row);
        
        let rowClass = 'gantt-row';
        let indentStyle = '';
        if (row.type === 'category') {
          rowClass += ' row-category';
        } else if (row.type === 'subcategory') {
          rowClass += ' row-subcategory';
          indentStyle = 'padding-left: 12px;';
        } else if (row.type === 'subsubcategory') {
          rowClass += ' row-subsubcategory';
          indentStyle = 'padding-left: 24px;';
        } else {
          indentStyle = 'padding-left: 36px;';
        }
        
        const tr = document.createElement('tr');
        tr.className = rowClass;
        tr.id = `qtyLeftRow-${index}`;
        tr.style.height = (ganttSettings.rowHeight || 40) + 'px';
        tr.style.cursor = 'pointer';
        tr.onclick = (e) => {
          if (e.target.closest('input, select, button')) return;
          highlightQtyRow(index, e);
        };
        
        let cellsHtml = '';
        activeCols.forEach((col, colIdx) => {
          const colIdxInFull = ganttColumns.indexOf(col);
          const colLetter = getColLetter(colIdxInFull);
          const cellCoord = `${colLetter}${visibleRowIndex}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${cellCoord}` : '';
          
          if (col.id === 'predNo') {
            cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--text-muted);">${index + 1}</td>`;
          } else if (col.id === 'code') {
            cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold;">${escapeHtml(row.code || '')}</td>`;
          } else if (col.id === 'title') {
            const toggleBtnHtml = isParent && (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory')
              ? `<button class="toggle-btn ${row.qtyCollapsed ? 'collapsed' : ''}" type="button" onclick="toggleQtyRowCollapse(${index})" aria-label="Toggle row" style="margin-right: 6px; vertical-align: middle;"></button>`
              : '<span style="display: inline-block; width: 18px;"></span>';
            cellsHtml += `<td style="${indentStyle} font-weight: bold; border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(row.title || '')}${coordTooltip ? ' (' + coordTooltip + ')' : ''}">${toggleBtnHtml}<span style="vertical-align: middle;">${escapeHtml(row.title || '')}</span></td>`;
          } else if (col.id === 'specification') {
            const specVal = row.specification || '';
            const weightStyle = isParent ? 'font-weight: bold; color: var(--muted);' : 'font-size: 11px;';
            cellsHtml += `<td title="${escapeHtml(specVal)}${coordTooltip ? ' (' + coordTooltip + ')' : ''}" style="text-align: left; border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; ${weightStyle}">${escapeHtml(specVal)}</td>`;
          } else if (isParent) {
            if (col.id === 'startDate') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? formatDateString(taskInfo.startDate) : ''}</td>`;
            } else if (col.id === 'finishDate') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? formatDateString(taskInfo.endDate) : ''}</td>`;
            } else if (col.id === 'actualStartDate') {
              const actInfo = getGanttActualDates(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${actInfo.startDate}</td>`;
            } else if (col.id === 'actualFinishDate') {
              const actInfo = getGanttActualDates(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${actInfo.finishDate}</td>`;
            } else if (col.id === 'days') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${taskInfo ? taskInfo.duration : ''}</td>`;
            } else if (col.id === 'remainingDays') {
              const rem = getGanttRemainingDays(index, taskInfo);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${rem}</td>`;
            } else if (col.id === 'predecessors') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);"></td>`;
            } else if (col.id === 'cost') {
              const parentSummary = computeBOQCategorySummary(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold; color: var(--muted);">${parentSummary && parentSummary.totalCost ? peso(parentSummary.totalCost) : ''}</td>`;
            } else if (col.id === 'estQty') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);"></td>`;
            } else if (col.id === 'instQty') {
              const instQtyVal = getPeriodQtyTotal(index);
              cellsHtml += `<td id="qtyInstTotal-${index}" title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${instQtyVal > 0 ? instQtyVal.toFixed(2) : ''}</td>`;
            } else if (col.id === 'qtyAccmpCost') {
              const accmpCost = getGanttTaskAccomplishedCost(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold; color: var(--muted);">${accmpCost ? peso(accmpCost) : '₱0.00'}</td>`;
            } else if (col.id === 'progress') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; font-weight: bold; color: var(--muted);">${taskInfo ? taskInfo.progress : 0}%</td>`;
            } else if (col.id === 'progressDay') {
              const progressDay = getGanttTaskDayProgress(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; font-weight: bold; color: var(--muted);">${progressDay}%</td>`;
            } else if (col.isCustom) {
              const customVal = (row.ganttCustomValues && row.ganttCustomValues[col.id]) || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: left; border-right: 1px solid var(--line); font-weight: bold; color: var(--muted);">${escapeHtml(customVal)}</td>`;
            }
          } else {
            const startVal = taskInfo ? taskInfo.startStr : projStartStr;
            const durationVal = taskInfo ? taskInfo.duration : 5;
            const progressVal = taskInfo ? taskInfo.progress : 0;
            const predVal = row.ganttPredecessors || '';
            
            if (col.id === 'startDate') {
              if (taskInfo && taskInfo.hasPredecessors) {
                cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--muted);">${startVal}</td>`;
              } else {
                cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${startVal}" onchange="updateQtyModalTask(${index}, 'ganttStartDate', this.value)"></td>`;
              }
            } else if (col.id === 'finishDate') {
              const finishVal = taskInfo && taskInfo.endDate ? formatDateString(taskInfo.endDate) : '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${finishVal}" onchange="updateQtyModalTask(${index}, 'ganttFinishDate', this.value)"></td>`;
            } else if (col.id === 'actualStartDate') {
              const actStartVal = row.ganttActualStartDate || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${actStartVal}" onchange="updateQtyModalTask(${index}, 'ganttActualStartDate', this.value)"></td>`;
            } else if (col.id === 'actualFinishDate') {
              const actFinishVal = row.ganttActualFinishDate || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="date" value="${actFinishVal}" onchange="updateQtyModalTask(${index}, 'ganttActualFinishDate', this.value)"></td>`;
            } else if (col.id === 'days') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="number" min="1" value="${durationVal}" onchange="updateQtyModalTask(${index}, 'ganttDuration', this.value)"></td>`;
            } else if (col.id === 'remainingDays') {
              const rem = getGanttRemainingDays(index, taskInfo);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${rem}</td>`;
            } else if (col.id === 'predecessors') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line);"><input type="text" value="${predVal}" placeholder="e.g. 1" style="text-align: left; padding: 2px 6px;" onchange="updateQtyModalTask(${index}, 'ganttPredecessors', this.value)"></td>`;
            } else if (col.id === 'cost') {
              const leafValues = computeBOQDisplayValues(row);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-size: 11px; font-weight: bold; color: var(--text);">${leafValues && leafValues.grandTotalCost ? peso(leafValues.grandTotalCost) : '₱0.00'}</td>`;
            } else if (col.id === 'estQty') {
              const displayValues = computeBOQDisplayValues(row);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${displayValues ? displayValues.qty : 0}</td>`;
            } else if (col.id === 'instQty') {
              const instQtyVal = getPeriodQtyTotal(index);
              cellsHtml += `<td id="qtyInstTotal-${index}" title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${instQtyVal > 0 ? instQtyVal.toFixed(2) : '0.00'}</td>`;
            } else if (col.id === 'qtyAccmpCost') {
              const accmpCost = getGanttTaskAccomplishedCost(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-size: 11px; font-weight: bold; color: var(--text);">${accmpCost ? peso(accmpCost) : '₱0.00'}</td>`;
            } else if (col.id === 'progress') {
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--text);">${progressVal.toFixed(2)}%</td>`;
            } else if (col.id === 'progressDay') {
              const progressDay = getGanttTaskDayProgress(index);
              cellsHtml += `<td title="${coordTooltip}" style="text-align: center; border-right: 1px solid var(--line); font-size: 11px; font-weight: bold; color: var(--muted);">${progressDay}%</td>`;
            } else if (col.isCustom) {
              const customVal = (row.ganttCustomValues && row.ganttCustomValues[col.id]) || '';
              cellsHtml += `<td title="${coordTooltip}" style="text-align: left; border-right: 1px solid var(--line);"><input type="text" value="${escapeHtml(customVal)}" placeholder="Text..." style="text-align: left; padding: 2px 6px;" onchange="updateQtyModalTask(${index}, '${col.id}', this.value)"></td>`;
            }
          }
        });
        
        if (ganttSettings.showCoordinates) {
          cellsHtml = `<td class="gantt-coord-cell" style="width: 40px; text-align: center; font-weight: bold;">${visibleRowIndex}</td>` + cellsHtml;
        }
        tr.innerHTML = cellsHtml;
        taskTableFragment.appendChild(tr);
        
        let periodCellsHtml = '';
        periods.forEach((p, pIdx) => {
          const startIdx = activeCols.length;
          const colLetter = getColLetter(startIdx + pIdx);
          const cellCoord = `${colLetter}${visibleRowIndex}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${cellCoord}` : '';
          const leafBg = 'transparent';
          const parentBg = 'var(--bg)';

          if (qtyModalActiveView === 'quantity') {
            if (qtyModalScale === 'days') {
              const val = getPeriodQtySingle(index, p.dateStr);
              const inputVal = val > 0 ? val : '';
              ganttCoordinateValues[cellCoord] = val || 0;
              
              if (isParent) {
                const formattedVal = val > 0 ? val.toFixed(2) : '0.00';
                periodCellsHtml += `<div class="qty-period-cell" style="width: ${activeColW}px; background: ${parentBg}; font-weight: bold; display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text-muted);" title="${coordTooltip ? coordTooltip + ' - ' + formattedVal : formattedVal}">
                  ${formattedVal}
                </div>`;
              } else {
                periodCellsHtml += `<div class="qty-period-cell" style="width: ${activeColW}px; background: ${leafBg};" title="${coordTooltip}">
                  <input type="number" min="0" step="any" class="qty-period-input" value="${inputVal}" onchange="updatePeriodQty(${index}, '${p.dateStr}', this.value)" style="background: transparent;">
                </div>`;
              }
            } else {
              const { start: pStart, end: pEnd } = getGanttPeriodDateRange(pIdx, qtyModalScale, timelineStartDate);
              const val = getAccumulatedPeriodQty(index, pStart, pEnd);
              ganttCoordinateValues[cellCoord] = val || 0;
              
              const formattedVal = val > 0 ? val.toFixed(2) : '0.00';
              periodCellsHtml += `<div class="qty-period-cell" style="width: ${activeColW}px; background: ${parentBg}; font-weight: bold; display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text-muted);" title="${coordTooltip ? coordTooltip + ' - ' + formattedVal : formattedVal}">
                ${formattedVal}
              </div>`;
            }
          } else {
            const { start: pStart, end: pEnd } = getGanttPeriodDateRange(pIdx, qtyModalScale, timelineStartDate);
            const activeLabel = viewLabelMap[qtyModalActiveView];
            const val = getGanttSummaryTaskTimelineValue(index, activeLabel, pStart, pEnd);
            ganttCoordinateValues[cellCoord] = val !== null ? (val || 0) : '';
            
            let displayVal = '';
            if (val !== null) {
              if (qtyModalActiveView === 'accomplishment' || qtyModalActiveView === 'cash_flow_estimated') {
                displayVal = peso(val);
              } else if (qtyModalActiveView === 'progress_cost' || qtyModalActiveView === 'progress_day') {
                displayVal = val.toFixed(2) + '%';
              } else if (qtyModalActiveView === 'cash_flow_day') {
                displayVal = val.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
              }
            }
            
            periodCellsHtml += `<div class="qty-period-cell" style="width: ${activeColW}px; background: ${isParent ? parentBg : leafBg}; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: bold; color: var(--text);" title="${coordTooltip ? coordTooltip + ' - ' + displayVal : displayVal}">
              ${displayVal}
            </div>`;
          }
        });
        
        qtyRightRowHtmlCache[index] = periodCellsHtml;
        timelineHtml += `<div class="gantt-timeline-row" id="qtyRightRow-${index}" onclick="highlightQtyRow(${index}, event)" style="height: ${(ganttSettings.rowHeight || 40)}px; width: ${widthStr}; display: flex; box-sizing: border-box; border-bottom: 1px solid var(--line); position: relative;"></div>`;
      });
      
      let totalProjectCost = 0;
      boqData.forEach((row, idx) => {
        if (!hasChildRow(boqData, idx)) {
          const displayValues = computeBOQDisplayValues(row) || {};
          totalProjectCost += displayValues.grandTotalCost || 0;
        }
      });
      
      const accomplishmentLabels = [
        "Summary of Accomplishment",
        "Progress % (Cost) Summary",
        "Progress % (Day) Summary",
        "Cash Flow (Estimated)",
        "Cash Flow (Day)"
      ];
      
      const leafDateRange = getGanttLeafTasksDateRange();
      const minStartStr = leafDateRange.minStart ? formatDateString(leafDateRange.minStart) : '';
      const maxEndStr = leafDateRange.maxEnd ? formatDateString(leafDateRange.maxEnd) : '';

      accomplishmentLabels.forEach((label, labelIdx) => {
        visibleRowIndex++;
        
        const isActive = (viewLabelMap[qtyModalActiveView] === label);
        const rowBg = isActive ? '#dbeafe' : 'var(--bg)';
        const rowColor = isActive ? '#1e3a8a' : 'inherit';
        
        const tr = document.createElement('tr');
        tr.className = 'gantt-row gantt-accomplishment-row' + (isActive ? ' active-summary-row' : '');
        tr.id = `qtyLeftRow-${boqData.length + labelIdx}`;
        tr.style.height = (ganttSettings.rowHeight || 40) + 'px';
        tr.style.background = rowBg;
        tr.style.color = rowColor;
        tr.style.cursor = 'pointer';
        tr.onclick = (e) => {
          if (e.target.closest('input, select, button')) return;
          highlightQtyRow(boqData.length + labelIdx, e);
          if (label === 'Summary of Accomplishment') setQtyModalView('accomplishment');
          else if (label === 'Progress % (Cost) Summary') setQtyModalView('progress_cost');
          else if (label === 'Progress % (Day) Summary') setQtyModalView('progress_day');
          else if (label === 'Cash Flow (Estimated)') setQtyModalView('cash_flow_estimated');
          else if (label === 'Cash Flow (Day)') setQtyModalView('cash_flow_day');
        };

        let cellsHtml = '';
        activeCols.forEach((col, colIdx) => {
          const colIdxInFull = ganttColumns.indexOf(col);
          const colLetter = getColLetter(colIdxInFull);
          const cellCoord = `${colLetter}${boqData.length + labelIdx + 1}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${colLetter}${visibleRowIndex}` : '';
          if (col.id === 'title') {
            cellsHtml += `<td title="${coordTooltip}" style="font-weight: bold; border-right: 1px solid var(--line); padding-left: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: ${rowBg}; color: ${rowColor};" title="${escapeHtml(label)}${coordTooltip ? ' (' + coordTooltip + ')' : ''}">${escapeHtml(label)}</td>`;
          } else if (col.id === 'startDate') {
            cellsHtml += `<td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: ${rowBg}; color: ${rowColor}; vertical-align: middle; padding: 0 !important; height: 100%;"><div class="gantt-summary-cell-wrapper" style="justify-content: center; height: 100%; display: flex; align-items: center;"><span style="font-size: 10px; font-weight: bold;">${escapeHtml(minStartStr)}</span></div></td>`;
          } else if (col.id === 'finishDate') {
            cellsHtml += `<td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: ${rowBg}; color: ${rowColor}; vertical-align: middle; padding: 0 !important; height: 100%;"><div class="gantt-summary-cell-wrapper" style="justify-content: center; height: 100%; display: flex; align-items: center;"><span style="font-size: 10px; font-weight: bold;">${escapeHtml(maxEndStr)}</span></div></td>`;
          } else if (['days', 'remainingDays', 'cost', 'estQty', 'instQty', 'qtyAccmpCost', 'progress', 'progressDay'].includes(col.id)) {
            const func = getGanttSummaryCellFunction(label, col.id);
            const leafValues = [];
            boqData.forEach((row, idx) => {
              if (func === 'subtotal') {
                if (row.type === 'category') {
                  leafValues.push(getGanttSummaryTaskValue(idx, label, col.id));
                }
              } else {
                if (!hasChildRow(boqData, idx)) {
                  leafValues.push(getGanttSummaryTaskValue(idx, label, col.id));
                }
              }
            });
            const computedVal = aggregateSummaryValues(leafValues, func);
            
            let formulaStr = ganttSummaryFormulas[cellCoord] || '';
            let displayVal = '';
            let val = computedVal;
            
            if (formulaStr) {
              const evalRes = evaluateCellFormula(formulaStr, ganttCoordinateValues);
              val = typeof evalRes === 'number' ? evalRes : computedVal;
              if (typeof evalRes === 'number') {
                if (col.id === 'cost' || col.id === 'qtyAccmpCost') displayVal = peso(evalRes);
                else if (col.id === 'progress' || col.id === 'progressDay') displayVal = evalRes.toFixed(2) + '%';
                else displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              } else {
                displayVal = evalRes;
              }
            } else {
              if (func !== 'none') {
                if (col.id === 'cost' || col.id === 'qtyAccmpCost') {
                  displayVal = peso(computedVal);
                } else if (col.id === 'progress' || col.id === 'progressDay') {
                  displayVal = computedVal.toFixed(2) + '%';
                } else {
                  displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                }
              }
            }
            ganttCoordinateValues[cellCoord] = val;
            
            cellsHtml += `<td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: ${rowBg}; color: ${rowColor}; vertical-align: middle; padding: 0 !important; height: 100%;">
              <div class="gantt-summary-cell-wrapper" style="height: 100%; display: flex; align-items: center; justify-content: flex-end; padding: 0; box-sizing: border-box; position: relative;">
                <input type="text"
                       class="qty-summary-input"
                       value="${escapeHtml(formulaStr ? displayVal : (displayVal || ''))}"
                       data-formula="${escapeHtml(formulaStr)}"
                       onfocus="this.value = this.dataset.formula"
                       onblur="updateGanttSummaryFormula('${cellCoord}', this.value)"
                       style="width: 100%; height: 100%; border: none; background: transparent; padding: 0 4px; font-size: 10px; font-weight: bold; text-align: right; box-sizing: border-box; color: ${rowColor};"
                >
              </div>
            </td>`;
          } else {
            cellsHtml += `<td title="${coordTooltip}" style="border-right: 1px solid var(--line); background: ${rowBg}; padding: 0 !important;"></td>`;
          }
        });
        if (ganttSettings.showCoordinates) {
          cellsHtml = `<td class="gantt-coord-cell" style="width: 40px; text-align: center; font-weight: bold; color: ${rowColor};">${visibleRowIndex}</td>` + cellsHtml;
        }
        tr.innerHTML = cellsHtml;
        taskTableFragment.appendChild(tr);
        let lastActiveP = -1;
        if (['Summary of Accomplishment', 'Progress % (Cost) Summary'].includes(label)) {
          periods.forEach((p, pIdx) => {
            const { start: pStart, end: pEnd } = getGanttPeriodDateRange(pIdx, qtyModalScale, timelineStartDate);
            let periodAccomplishment = 0;
            boqData.forEach((row, idx) => {
              if (!hasChildRow(boqData, idx)) {
                periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
              }
            });
            if (periodAccomplishment > 0) {
              lastActiveP = pIdx;
            }
          });
        }

        let runningAccomplishment = 0;
        let runningCashFlowEstimated = 0;
        let periodCellsHtml = '';
        periods.forEach((p, pIdx) => {
          const { start: pStart, end: pEnd } = getGanttPeriodDateRange(pIdx, qtyModalScale, timelineStartDate);
          const colId = `period_${pIdx}`;
          const isFormulaRow = ['Summary of Accomplishment', 'Progress % (Cost) Summary', 'Progress % (Day) Summary', 'Cash Flow (Estimated)'].includes(label);
          let computedVal = 0;
          let displayVal = '';
          if (isFormulaRow) {
            if (label === 'Summary of Accomplishment') {
              let periodAccomplishment = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
                }
              });
              runningAccomplishment += periodAccomplishment;
              computedVal = runningAccomplishment;
              displayVal = peso(computedVal);
            } else if (label === 'Progress % (Cost) Summary') {
              let periodAccomplishment = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodAccomplishment += getGanttSummaryTaskTimelineValue(idx, 'Summary of Accomplishment', pStart, pEnd);
                }
              });
              runningAccomplishment += periodAccomplishment;
              computedVal = totalProjectCost > 0 ? (runningAccomplishment / totalProjectCost) * 100 : 0;
              displayVal = computedVal.toFixed(2) + '%';
            } else if (label === 'Progress % (Day) Summary') {
              let totalOverlapDays = 0;
              let totalDuration = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  const taskInfo = taskInfos[idx];
                  if (taskInfo && taskInfo.startDate && taskInfo.endDate) {
                    const tStart = taskInfo.startDate;
                    const duration = taskInfo.duration || 0;
                    if (duration > 0) {
                      const overlapDays = getGanttTaskOverlapDays(idx, tStart, pEnd);
                      totalOverlapDays += overlapDays;
                      totalDuration += duration;
                    }
                  }
                }
              });
              computedVal = totalDuration > 0 ? (totalOverlapDays / totalDuration) * 100 : 0;
              displayVal = computedVal.toFixed(2) + '%';
            } else if (label === 'Cash Flow (Estimated)') {
              let periodCostFlow = 0;
              boqData.forEach((row, idx) => {
                if (!hasChildRow(boqData, idx)) {
                  periodCostFlow += getGanttSummaryTaskTimelineValue(idx, 'Cash Flow (Estimated)', pStart, pEnd);
                }
              });
              runningCashFlowEstimated += periodCostFlow;
              computedVal = runningCashFlowEstimated;
              displayVal = peso(computedVal);
            }
          } else {
            const func = getGanttSummaryCellFunction(label, colId);
            const leafValues = [];
            boqData.forEach((row, idx) => {
              if (func === 'subtotal') {
                if (row.type === 'category') {
                  leafValues.push(getGanttSummaryTaskTimelineValue(idx, label, pStart, pEnd));
                }
              } else {
                if (!hasChildRow(boqData, idx)) {
                  leafValues.push(getGanttSummaryTaskTimelineValue(idx, label, pStart, pEnd));
                }
              }
            });
            computedVal = aggregateSummaryValues(leafValues, func);
            if (func !== 'none') {
              if (label === 'Cash Flow (Estimated)') {
                displayVal = peso(computedVal);
              } else if (label === 'Cash Flow (Day)') {
                displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
              } else {
                displayVal = computedVal.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              }
            }
          }
          const startIdx = activeCols.length;
          const colLetter = getColLetter(startIdx + pIdx);
          const cellCoord = `${colLetter}${boqData.length + labelIdx + 1}`;
          const coordTooltip = ganttSettings.showCoordinates ? `Coordinate: ${colLetter}${visibleRowIndex}` : '';
          
          let formulaStr = ganttSummaryFormulas[cellCoord] || '';
          let val = computedVal;
          if (formulaStr) {
            const evalRes = evaluateCellFormula(formulaStr, ganttCoordinateValues);
            val = typeof evalRes === 'number' ? evalRes : computedVal;
            if (typeof evalRes === 'number') {
              if (label === 'Summary of Accomplishment' || label === 'Cash Flow (Estimated)') {
                displayVal = peso(evalRes);
              } else if (label === 'Progress % (Cost) Summary' || label === 'Progress % (Day) Summary') {
                displayVal = evalRes.toFixed(2) + '%';
              } else if (label === 'Cash Flow (Day)') {
                displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 1 });
              } else {
                displayVal = evalRes.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
              }
            } else {
              displayVal = evalRes;
            }
          }
          if (['Summary of Accomplishment', 'Progress % (Cost) Summary'].includes(label)) {
            const curInput = document.getElementById('ganttCurrentDateInput');
            const curStr = (curInput && curInput.value) || localStorage.getItem('cost_estimate_gantt_current_date_v1');
            const current = curStr ? parseSafeDate(curStr) : new Date();
            
            const pStartCopy = new Date(pStart);
            pStartCopy.setHours(0, 0, 0, 0);
            
            const currentCopy = new Date(current);
            currentCopy.setHours(0, 0, 0, 0);
            
            if (pStartCopy.getTime() > currentCopy.getTime()) {
              displayVal = '';
            } else if (pIdx > lastActiveP) {
              displayVal = '';
            }
          }
          ganttCoordinateValues[cellCoord] = val;
          
          periodCellsHtml += `<div class="qty-period-cell" style="width: ${activeColW}px; background: ${rowBg}; color: ${rowColor} !important; font-weight: bold; font-size: 10px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 !important;" title="${coordTooltip ? coordTooltip + ' - ' + displayVal : displayVal}">
            <input type="text"
                   class="qty-summary-input"
                   value="${escapeHtml(formulaStr ? displayVal : (displayVal || ''))}"
                   data-formula="${escapeHtml(formulaStr)}"
                   onfocus="this.value = this.dataset.formula"
                   onblur="updateGanttSummaryFormula('${cellCoord}', this.value)"
                   style="width: 100%; height: 100%; border: none; background: transparent; padding: 0 2px; font-size: 10px; font-weight: bold; text-align: center; box-sizing: border-box; color: ${rowColor};"
            >
          </div>`;
        });
        qtyRightRowHtmlCache[boqData.length + labelIdx] = periodCellsHtml;
        timelineHtml += `<div class="gantt-timeline-row gantt-accomplishment-timeline-row" id="qtyRightRow-${boqData.length + labelIdx}" onclick="highlightQtyRow(${boqData.length + labelIdx}, event)" style="height: ${(ganttSettings.rowHeight || 40)}px; width: ${widthStr}; display: flex; box-sizing: border-box; border-bottom: 1px solid var(--line); background: ${rowBg}; position: relative;"></div>`;
      });
      taskTableBody.appendChild(taskTableFragment);
      timelineBody.innerHTML = timelineHtml;
      
      updateQtyTimelineViewport();
      setTimeout(updateQtyTimelineViewport, 50);
      setTimeout(updateQtyTimelineViewport, 200);
      
      if (activeQtyHighlightIdx !== -1) {
        highlightQtyRow(activeQtyHighlightIdx);
      }
      
      if (leftPanel) {
        leftPanel.scrollTop = savedLeftScrollTop;
        leftPanel.scrollLeft = savedLeftScrollLeft;
      }
      if (rightPanel) {
        rightPanel.scrollTop = savedRightScrollTop;
        rightPanel.scrollLeft = savedRightScrollLeft;
      }
    }

    function updateQtyTimelineViewport() {
      const rightPanel = document.getElementById('qtyRightPanel');
      if (!rightPanel) return;
      
      const scrollTop = rightPanel.scrollTop;
      const viewportHeight = rightPanel.clientHeight;
      const rowH = ganttSettings.rowHeight || 40;
      
      const totalTaskRows = qtyVisibleIndices.length;
      const totalRows = totalTaskRows + 5;
      
      const visibleStart = Math.floor(scrollTop / rowH);
      const visibleEnd = Math.ceil((scrollTop + viewportHeight) / rowH);
      
      const buffer = 8;
      const startIdx = Math.max(0, visibleStart - buffer);
      const endIdx = Math.min(totalRows - 1, visibleEnd + buffer);
      
      for (let i = 0; i < totalRows; i++) {
        const isVisible = (i >= startIdx && i <= endIdx);
        const index = i < totalTaskRows ? qtyVisibleIndices[i] : boqData.length + (i - totalTaskRows);
        const rowEl = document.getElementById(`qtyRightRow-${index}`);
        if (!rowEl) continue;
        
        if (isVisible) {
          if (rowEl.dataset.rendered !== 'true') {
            rowEl.innerHTML = qtyRightRowHtmlCache[index] || '';
            rowEl.dataset.rendered = 'true';
          }
        } else {
          if (rowEl.dataset.rendered === 'true') {
            rowEl.innerHTML = '';
            rowEl.dataset.rendered = 'false';
          }
        }
      }
    }

    window.updateQtyTimelineViewport = updateQtyTimelineViewport;

    function showBillingRecord(event) {
      if (event) event.preventDefault();
      
      const dropdown = document.getElementById('ganttUpdateDataDropdown');
      if (dropdown) dropdown.style.display = 'none';
      
      const modal = document.getElementById('ganttBillingRecordModal');
      if (modal) modal.style.display = 'flex';
      
      const projStartInput = document.getElementById('ganttProjectStartInput');
      const currentDateInput = document.getElementById('ganttCurrentDateInput');
      
      const prevInput = document.getElementById('billingPrevDate');
      const currInput = document.getElementById('billingCurrDate');
      
      if (prevInput && !prevInput.value) {
        prevInput.value = projStartInput?.value || getTodayDateString();
      }
      if (currInput && !currInput.value) {
        currInput.value = currentDateInput?.value || getTodayDateString();
      }
      
      recalculateBillingTable();
    }
    
    function closeGanttBillingRecordModal() {
      const modal = document.getElementById('ganttBillingRecordModal');
      if (modal) modal.style.display = 'none';
    }

    function recalculateBillingTable() {
      const tbody = document.querySelector('#billingRecordTable tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      
      const prevDateStr = document.getElementById('billingPrevDate')?.value || '';
      const currDateStr = document.getElementById('billingCurrDate')?.value || '';
      const retentionRate = (parseFloat(document.getElementById('billingRetentionRate')?.value) || 0) / 100;
      const dpRate = (parseFloat(document.getElementById('billingDPRate')?.value) || 0) / 100;
      
      const prevDate = prevDateStr ? parseSafeDate(prevDateStr) : null;
      const currDate = currDateStr ? parseSafeDate(currDateStr) : null;
      
      let grandContractAmt = 0;
      let grandPrevCost = 0;
      let grandCurrCost = 0;
      let grandCumCost = 0;
      let grandRetention = 0;
      let grandDP = 0;
      let grandNetBilling = 0;
      
      boqData.forEach((row, index) => {
        if (shouldHideGanttHierarchyRow(index)) return;
        
        const isParent = hasChildRow(boqData, index);
        const displayValues = computeBOQDisplayValues(row) || {};
        const estQty = displayValues.qty || 0;
        const contractAmt = isParent ? (computeBOQCategorySummary(index)?.totalCost || 0) : (displayValues.grandTotalCost || 0);
        
        let prevQty = 0;
        let currQty = 0;
        let cumQty = 0;
        
        if (!isParent) {
          if (row.ganttPeriodQty) {
            for (const dateStr in row.ganttPeriodQty) {
              const qDate = parseSafeDate(dateStr);
              const qtyVal = parseFloat(row.ganttPeriodQty[dateStr]) || 0;
              
              if (prevDate && qDate <= prevDate) {
                prevQty += qtyVal;
              } else if (prevDate && currDate && qDate > prevDate && qDate <= currDate) {
                currQty += qtyVal;
              } else if (!prevDate && currDate && qDate <= currDate) {
                currQty += qtyVal;
              }
            }
          } else {
            const totalInst = getInstalledQty(index);
            currQty = totalInst;
          }
          cumQty = prevQty + currQty;
        } else {
          const leaves = getLeafDescendents(index);
          leaves.forEach(lIdx => {
            const lRow = boqData[lIdx];
            if (lRow.ganttPeriodQty) {
              for (const dateStr in lRow.ganttPeriodQty) {
                const qDate = parseSafeDate(dateStr);
                const qtyVal = parseFloat(lRow.ganttPeriodQty[dateStr]) || 0;
                
                if (prevDate && qDate <= prevDate) {
                  prevQty += qtyVal;
                } else if (prevDate && currDate && qDate > prevDate && qDate <= currDate) {
                  currQty += qtyVal;
                } else if (!prevDate && currDate && qDate <= currDate) {
                  currQty += qtyVal;
                }
              }
            } else {
              const totalInst = getInstalledQty(lIdx);
              currQty += totalInst;
            }
          });
          cumQty = prevQty + currQty;
        }
        
        const unitCost = estQty > 0 ? (contractAmt / estQty) : 0;
        const prevCost = isParent ? getParentBillingSummary(index, 'prevCost', prevDate, currDate) : (prevQty * unitCost);
        const currCost = isParent ? getParentBillingSummary(index, 'currCost', prevDate, currDate) : (currQty * unitCost);
        const cumCost = prevCost + currCost;
        
        const retention = cumCost * retentionRate;
        const dpRecovery = cumCost * dpRate;
        const netBilling = cumCost - retention - dpRecovery;
        
        if (row.type === 'category') {
          grandContractAmt += contractAmt;
          grandPrevCost += prevCost;
          grandCurrCost += currCost;
          grandCumCost += cumCost;
          grandRetention += retention;
          grandDP += dpRecovery;
          grandNetBilling += netBilling;
        }
        
        let rowClass = 'gantt-row';
        let indentStyle = '';
        if (row.type === 'category') {
          rowClass += ' row-category';
        } else if (row.type === 'subcategory') {
          rowClass += ' row-subcategory';
          indentStyle = 'padding-left: 12px;';
        } else if (row.type === 'subsubcategory') {
          rowClass += ' row-subsubcategory';
          indentStyle = 'padding-left: 24px;';
        } else {
          indentStyle = 'padding-left: 36px;';
        }
        
        const tr = document.createElement('tr');
        tr.className = rowClass;
        tr.style.height = '32px';
        tr.style.borderBottom = '1px solid var(--line)';
        
        tr.innerHTML = `
          <td style="text-align: center; border-right: 1px solid var(--line); font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(row.code || '')}</td>
          <td style="${indentStyle} font-weight: bold; border-right: 1px solid var(--line); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${escapeHtml(row.title || '')}">${escapeHtml(row.title || '')}</td>
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold;">${peso(contractAmt)}</td>
          
          <td style="text-align: center; border-right: 1px solid var(--line);">${isParent ? '' : prevQty.toFixed(2)}</td>
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px;">${peso(prevCost)}</td>
          
          <td style="text-align: center; border-right: 1px solid var(--line);">${isParent ? '' : currQty.toFixed(2)}</td>
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px;">${peso(currCost)}</td>
          
          <td style="text-align: center; border-right: 1px solid var(--line); font-weight: bold;">${isParent ? '' : cumQty.toFixed(2)}</td>
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; font-weight: bold;">${peso(cumCost)}</td>
          
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; color: #b91c1c;">${peso(retention)}</td>
          <td style="text-align: right; border-right: 1px solid var(--line); padding-right: 8px; color: #b91c1c;">${peso(dpRecovery)}</td>
          <td style="text-align: right; padding-right: 8px; font-weight: bold; color: #047857;">${peso(netBilling)}</td>
        `;
        
        tbody.appendChild(tr);
      });
      
      let tfoot = document.querySelector('#billingRecordTable tfoot');
      if (!tfoot) {
        tfoot = document.createElement('tfoot');
        document.getElementById('billingRecordTable').appendChild(tfoot);
      }
      tfoot.innerHTML = `
        <tr style="height: 36px; background: var(--bg); font-weight: bold; border-top: 2px solid var(--line);">
          <td colspan="2" style="text-align: right; padding-right: 12px; border-right: 1px solid var(--line); font-size: 11px; text-transform: uppercase;">Grand Total:</td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line);">${peso(grandContractAmt)}</td>
          <td style="border-right: 1px solid var(--line);"></td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line);">${peso(grandPrevCost)}</td>
          <td style="border-right: 1px solid var(--line);"></td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line);">${peso(grandCurrCost)}</td>
          <td style="border-right: 1px solid var(--line);"></td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line);">${peso(grandCumCost)}</td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line); color: #b91c1c;">${peso(grandRetention)}</td>
          <td style="text-align: right; padding-right: 8px; border-right: 1px solid var(--line); color: #b91c1c;">${peso(grandDP)}</td>
          <td style="text-align: right; padding-right: 8px; color: #047857;">${peso(grandNetBilling)}</td>
        </tr>
      `;
    }
    
    function getParentBillingSummary(parentIndex, field, prevDate, currDate) {
      const leaves = getLeafDescendents(parentIndex);
      const retentionRate = (parseFloat(document.getElementById('billingRetentionRate')?.value) || 0) / 100;
      const dpRate = (parseFloat(document.getElementById('billingDPRate')?.value) || 0) / 100;
      
      let sum = 0;
      leaves.forEach(lIdx => {
        const lRow = boqData[lIdx];
        const displayValues = computeBOQDisplayValues(lRow) || {};
        const estQty = displayValues.qty || 0;
        const contractAmt = displayValues.grandTotalCost || 0;
        const unitCost = estQty > 0 ? (contractAmt / estQty) : 0;
        
        let prevQty = 0;
        let currQty = 0;
        
        if (lRow.ganttPeriodQty) {
          for (const dateStr in lRow.ganttPeriodQty) {
            const qDate = parseSafeDate(dateStr);
            const qtyVal = parseFloat(lRow.ganttPeriodQty[dateStr]) || 0;
            
            if (prevDate && qDate <= prevDate) {
              prevQty += qtyVal;
            } else if (prevDate && currDate && qDate > prevDate && qDate <= currDate) {
              currQty += qtyVal;
            } else if (!prevDate && currDate && qDate <= currDate) {
              currQty += qtyVal;
            }
          }
        } else {
          const totalInst = getInstalledQty(lIdx);
          currQty += totalInst;
        }
        
        if (field === 'prevCost') {
          sum += prevQty * unitCost;
        } else if (field === 'currCost') {
          sum += currQty * unitCost;
        } else if (field === 'cumCost') {
          sum += (prevQty + currQty) * unitCost;
        }
      });
      return sum;
    }

    function exportBillingToExcel() {
      const prevDateStr = document.getElementById('billingPrevDate')?.value || '';
      const currDateStr = document.getElementById('billingCurrDate')?.value || '';
      const retentionRate = document.getElementById('billingRetentionRate')?.value || '10';
      const dpRate = document.getElementById('billingDPRate')?.value || '15';
      
      let tableHtml = `<table border="1">
        <thead>
          <tr style="background-color: #dbeafe; font-weight: bold;">
            <th colspan="12" style="font-size: 14pt; padding: 10px; text-align: center;">PROGRESS BILLING RECORD</th>
          </tr>
          <tr style="background-color: #f1f5f9;">
            <th colspan="3" style="text-align: left;">Previous Cut-off Date: ${prevDateStr}</th>
            <th colspan="3" style="text-align: left;">Current Cut-off Date: ${currDateStr}</th>
            <th colspan="3" style="text-align: left;">Retention Rate: ${retentionRate}%</th>
            <th colspan="3" style="text-align: left;">DP Recovery Rate: ${dpRate}%</th>
          </tr>
          <tr style="background-color: #2563eb; color: white;">
            <th>Code</th>
            <th>Work Description</th>
            <th>Contract Amount</th>
            <th>Prev. Qty</th>
            <th>Prev. Cost</th>
            <th>Curr. Qty</th>
            <th>Curr. Cost</th>
            <th>Cum. Qty</th>
            <th>Cum. Cost</th>
            <th>Retention</th>
            <th>DP Recovery</th>
            <th>Net Billing</th>
          </tr>
        </thead>
        <tbody>`;
      
      const prevDate = prevDateStr ? parseSafeDate(prevDateStr) : null;
      const currDate = currDateStr ? parseSafeDate(currDateStr) : null;
      const retentionFrac = (parseFloat(retentionRate) || 0) / 100;
      const dpFrac = (parseFloat(dpRate) || 0) / 100;
      
      let grandContractAmt = 0;
      let grandPrevCost = 0;
      let grandCurrCost = 0;
      let grandCumCost = 0;
      let grandRetention = 0;
      let grandDP = 0;
      let grandNetBilling = 0;
      
      boqData.forEach((row, index) => {
        if (shouldHideGanttHierarchyRow(index)) return;
        
        const isParent = hasChildRow(boqData, index);
        const displayValues = computeBOQDisplayValues(row) || {};
        const estQty = displayValues.qty || 0;
        const contractAmt = isParent ? (computeBOQCategorySummary(index)?.totalCost || 0) : (displayValues.grandTotalCost || 0);
        
        let prevQty = 0;
        let currQty = 0;
        
        if (!isParent) {
          if (row.ganttPeriodQty) {
            for (const dateStr in row.ganttPeriodQty) {
              const qDate = parseSafeDate(dateStr);
              const qtyVal = parseFloat(row.ganttPeriodQty[dateStr]) || 0;
              
              if (prevDate && qDate <= prevDate) {
                prevQty += qtyVal;
              } else if (prevDate && currDate && qDate > prevDate && qDate <= currDate) {
                currQty += qtyVal;
              } else if (!prevDate && currDate && qDate <= currDate) {
                currQty += qtyVal;
              }
            }
          } else {
            const totalInst = getInstalledQty(index);
            currQty = totalInst;
          }
        } else {
          const leaves = getLeafDescendents(index);
          leaves.forEach(lIdx => {
            const lRow = boqData[lIdx];
            if (lRow.ganttPeriodQty) {
              for (const dateStr in lRow.ganttPeriodQty) {
                const qDate = parseSafeDate(dateStr);
                const qtyVal = parseFloat(lRow.ganttPeriodQty[dateStr]) || 0;
                
                if (prevDate && qDate <= prevDate) {
                  prevQty += qtyVal;
                } else if (prevDate && currDate && qDate > prevDate && qDate <= currDate) {
                  currQty += qtyVal;
                } else if (!prevDate && currDate && qDate <= currDate) {
                  currQty += qtyVal;
                }
              }
            } else {
              const totalInst = getInstalledQty(lIdx);
              currQty += totalInst;
            }
          });
        }
        
        const unitCost = estQty > 0 ? (contractAmt / estQty) : 0;
        const prevCost = isParent ? getParentBillingSummary(index, 'prevCost', prevDate, currDate) : (prevQty * unitCost);
        const currCost = isParent ? getParentBillingSummary(index, 'currCost', prevDate, currDate) : (currQty * unitCost);
        const cumCost = prevCost + currCost;
        
        const retention = cumCost * retentionFrac;
        const dpRecovery = cumCost * dpFrac;
        const netBilling = cumCost - retention - dpRecovery;
        
        if (row.type === 'category') {
          grandContractAmt += contractAmt;
          grandPrevCost += prevCost;
          grandCurrCost += currCost;
          grandCumCost += cumCost;
          grandRetention += retention;
          grandDP += dpRecovery;
          grandNetBilling += netBilling;
        }
        
        const indent = row.type === 'category' ? '' : (row.type === 'subcategory' ? '&nbsp;&nbsp;' : '&nbsp;&nbsp;&nbsp;&nbsp;');
        
        tableHtml += `<tr>
          <td style="text-align: center;">${row.code || ''}</td>
          <td>${indent}${row.title || ''}</td>
          <td style="text-align: right;">${contractAmt.toFixed(2)}</td>
          <td style="text-align: center;">${isParent ? '' : prevQty.toFixed(2)}</td>
          <td style="text-align: right;">${prevCost.toFixed(2)}</td>
          <td style="text-align: center;">${isParent ? '' : currQty.toFixed(2)}</td>
          <td style="text-align: right;">${currCost.toFixed(2)}</td>
          <td style="text-align: center;">${isParent ? '' : (prevQty+currQty).toFixed(2)}</td>
          <td style="text-align: right;">${cumCost.toFixed(2)}</td>
          <td style="text-align: right;">${retention.toFixed(2)}</td>
          <td style="text-align: right;">${dpRecovery.toFixed(2)}</td>
          <td style="text-align: right; font-weight: bold;">${netBilling.toFixed(2)}</td>
        </tr>`;
      });
      
      tableHtml += `<tr style="font-weight: bold; background-color: #f1f5f9;">
        <td colspan="2" style="text-align: right;">Grand Total:</td>
        <td style="text-align: right;">${grandContractAmt.toFixed(2)}</td>
        <td></td>
        <td style="text-align: right;">${grandPrevCost.toFixed(2)}</td>
        <td></td>
        <td style="text-align: right;">${grandCurrCost.toFixed(2)}</td>
        <td></td>
        <td style="text-align: right;">${grandCumCost.toFixed(2)}</td>
        <td style="text-align: right;">${grandRetention.toFixed(2)}</td>
        <td style="text-align: right;">${grandDP.toFixed(2)}</td>
        <td style="text-align: right;">${grandNetBilling.toFixed(2)}</td>
      </tr>
      </tbody></table>`;
      
      const blob = new Blob([tableHtml], { type: 'application/vnd.ms-excel' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Progress_Billing_${currDateStr || 'Report'}.xls`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Export new functions to global window namespace
    window.toggleGanttUpdateDataDropdown = toggleGanttUpdateDataDropdown;
    window.showUpdateQtyInst = showUpdateQtyInst;
    window.closeGanttQtyInstModal = closeGanttQtyInstModal;
    window.setQtyModalScale = setQtyModalScale;
    window.setQtyModalView = setQtyModalView;
    window.getAccumulatedPeriodQty = getAccumulatedPeriodQty;
    window.updatePeriodQty = updatePeriodQty;
    window.updateQtyModalTask = updateQtyModalTask;
    window.showBillingRecord = showBillingRecord;
    window.closeGanttBillingRecordModal = closeGanttBillingRecordModal;
    window.recalculateBillingTable = recalculateBillingTable;
    window.exportBillingToExcel = exportBillingToExcel;
    window.regenerateCoverProposalFromData = regenerateCoverProposalFromData;
    window.handleCoverAttachmentUpload = handleCoverAttachmentUpload;
    window.removeCoverAttachment = removeCoverAttachment;
    window.clearAllCoverAttachments = clearAllCoverAttachments;
    window.moveCoverAttachment = moveCoverAttachment;
    window.updateCoverAttachmentCaption = updateCoverAttachmentCaption;
    window.renderCoverAttachments = renderCoverAttachments;
    window.syncCoverPrintScope = syncCoverPrintScope;
    window.applyCoverPrintScopePreview = applyCoverPrintScopePreview;

    function buildCoverProposalExportHtml() {
      renderCoverLetter();
      updateCoverPageCount();
      const source = document.querySelector('.cover-letter-page');
      if (!source) return '';
      const clone = source.cloneNode(true);

      // Convert metadata grid to a simple borderless table for Word export.
      // MS Word does not reliably preserve CSS grid/flex nowrap, so this prevents
      // Project Name and Client / Owner from wrapping in the downloaded document.
      const meta = clone.querySelector('.cover-letter-meta');
      if (meta) {
        const rows = [
          ['Date', document.getElementById('coverProposalDate')?.textContent || ''],
          ['Project Name', document.getElementById('coverProjectName')?.textContent || ''],
          ['Client / Owner', document.getElementById('coverClientName')?.textContent || ''],
          ['Subject', document.getElementById('coverSubject')?.textContent || '']
        ];
        const table = document.createElement('table');
        table.className = 'cover-letter-meta-table';
        table.style.width = '100%';
        table.style.borderCollapse = 'collapse';
        table.style.tableLayout = 'auto';
        table.style.margin = '4px 0 6px 0';
        rows.forEach(([label, value]) => {
          const tr = document.createElement('tr');
          const tdLabel = document.createElement('td');
          const tdGapBeforeColon = document.createElement('td');
          const tdColon = document.createElement('td');
          const tdGapAfterColon = document.createElement('td');
          const tdValue = document.createElement('td');
          tdLabel.textContent = label;
          tdGapBeforeColon.textContent = '\u200c';
          tdColon.textContent = ':';
          tdGapAfterColon.textContent = '\u200c';
          tdValue.textContent = value;
          tdLabel.style.width = '32mm';
          tdGapBeforeColon.style.width = '5mm';
          tdColon.style.width = '3mm';
          tdGapAfterColon.style.width = '10mm';
          tdLabel.style.textAlign = 'left';
          tdColon.style.textAlign = 'left';
          tdLabel.style.whiteSpace = 'nowrap';
          tdValue.style.whiteSpace = 'nowrap';
          [tdLabel, tdGapBeforeColon, tdColon, tdGapAfterColon, tdValue].forEach(td => {
            td.style.border = '0';
            td.style.padding = '0 0 1px 0';
            td.style.lineHeight = '1';
            td.style.fontSize = '10pt';
            td.style.verticalAlign = 'middle';
          });
          tdLabel.style.fontWeight = '800';
          tdLabel.style.textTransform = 'uppercase';
          tdLabel.style.color = '#6b7280';
          tdColon.style.fontWeight = '800';
          tdColon.style.color = '#6b7280';
          tr.appendChild(tdLabel);
          tr.appendChild(tdGapBeforeColon);
          tr.appendChild(tdColon);
          tr.appendChild(tdGapAfterColon);
          tr.appendChild(tdValue);
          table.appendChild(tr);
        });
        meta.replaceWith(table);
      }

      // Convert signatures to 2-column table for Microsoft Word fidelity
      const sigBlock = clone.querySelector('.cover-letter-signatures');
      if (sigBlock) {
        const subName = document.getElementById('coverSubmittedBy')?.value || '';
        const subPos = document.getElementById('coverSubmittedPosition')?.value || '';
        const accName = document.getElementById('coverAcceptedBy')?.value || '';
        const accPos = document.getElementById('coverAcceptedPosition')?.value || '';
        const clientOrgText = document.getElementById('coverSignatureClientOrg')?.textContent || 'CLIENT / OWNER CONFORME';
        const table = document.createElement('table');
        table.style.width = '100%';
        table.style.borderCollapse = 'collapse';
        table.style.marginTop = '28px';
        table.style.borderTop = '1px solid #e2e8f0';
        table.style.paddingTop = '16px';
        table.innerHTML = `
          <tr>
            <td style="width: 48%; vertical-align: top; border: 0; padding: 12px 0 0 0;">
              <div style="font-size: 9pt; font-weight: 800; text-transform: uppercase; color: #475569; margin-bottom: 2px;">SUBMITTED &amp; CONFIRMED BY:</div>
              <div style="font-size: 9.5pt; font-weight: 700; color: #0f172a; margin-bottom: 30px;">FIRST CITYLAND DEVELOPMENT CORP.</div>
              <div style="border-bottom: 1.5px solid #0f172a; width: 100%; margin-bottom: 6px;"></div>
              <div style="font-size: 10pt; font-weight: 700; color: #0f172a;">${subName}</div>
              <div style="font-size: 9pt; color: #475569;">${subPos}</div>
              <div style="font-size: 8.5pt; color: #64748b; margin-top: 6px;">Date Signed: ____________________</div>
            </td>
            <td style="width: 4%; border: 0;"></td>
            <td style="width: 48%; vertical-align: top; border: 0; padding: 12px 0 0 0;">
              <div style="font-size: 9pt; font-weight: 800; text-transform: uppercase; color: #475569; margin-bottom: 2px;">ACCEPTED &amp; CONFORME:</div>
              <div style="font-size: 9.5pt; font-weight: 700; color: #0f172a; margin-bottom: 30px;">${clientOrgText}</div>
              <div style="border-bottom: 1.5px solid #0f172a; width: 100%; margin-bottom: 6px;"></div>
              <div style="font-size: 10pt; font-weight: 700; color: #0f172a;">${accName}</div>
              <div style="font-size: 9pt; color: #475569;">${accPos}</div>
              <div style="font-size: 8.5pt; color: #64748b; margin-top: 6px;">Date Signed: ____________________</div>
            </td>
          </tr>
        `;
        sigBlock.replaceWith(table);
      }

      clone.querySelectorAll('input').forEach(input => {
        const span = document.createElement('span');
        span.textContent = input.value || '';
        span.style.display = 'block';
        span.style.minHeight = '18px';
        span.style.borderBottom = '0';
        input.replaceWith(span);
      });
      clone.querySelectorAll('textarea').forEach(textarea => {
        const div = document.createElement('div');
        div.textContent = textarea.value || '';
        div.style.whiteSpace = 'pre-wrap';
        div.style.minHeight = '42px';
        div.style.border = '0';
        div.style.padding = '0';
        textarea.replaceWith(div);
      });
      clone.querySelectorAll('[contenteditable]').forEach(el => el.removeAttribute('contenteditable'));
      clone.querySelectorAll('*').forEach(el => {
        if (!el.closest('.cover-letter-meta-table') && (el.textContent || '').trim() === '') el.remove();
      });
      let resultHtml = clone.outerHTML;
      if (Array.isArray(coverAttachments) && coverAttachments.length > 0) {
        let annexIdx = 0;
        coverAttachments.forEach(att => {
          const annexLetter = String.fromCharCode(65 + (annexIdx % 26));
          annexIdx++;
          const pages = (Array.isArray(att.pages) && att.pages.length > 0)
            ? att.pages
            : [{ pageNum: 1, totalPages: 1, orientation: att.orientation || 'portrait', dataUrl: att.dataUrl }];

          pages.forEach(page => {
            const isLandscape = page.orientation === 'landscape';
            const displayTitle = att.caption || att.name.replace(/\.[^/.]+$/, '').replace(/[-_]+/g, ' ');
            resultHtml += `
              <br clear="all" style="mso-special-character:line-break; page-break-before:always">
              <div class="word-attachment-page" style="page-break-before:always; padding: 20px; font-family: Arial, sans-serif;">
                <div style="border-bottom: 2px solid #0f2744; padding-bottom: 8px; margin-bottom: 12px; display: flex; justify-content: space-between;">
                  <span style="font-weight: bold; color: #0f2744; font-size: 11pt;">ANNEX ${annexLetter}: ${escapeHtml(displayTitle)}${pages.length > 1 ? ` (Page ${page.pageNum} of ${pages.length})` : ''}</span>
                  <span style="font-size: 9pt; color: #64748b;">${escapeHtml(att.name)}</span>
                </div>
                <div style="text-align: center; margin: 20px 0;">
                  ${page.dataUrl && page.dataUrl.startsWith('data:image') ? `<img src="${page.dataUrl}" style="max-width: 100%; max-height: ${isLandscape ? '5.5in' : '7.5in'}; object-fit: contain;">` : `<p style="color:#64748b;">[Attached Document: ${escapeHtml(att.name)}]</p>`}
                </div>
                <div style="border-top: 1px solid #cbd5e1; padding-top: 6px; margin-top: 12px; font-size: 8pt; color: #64748b; display: flex; justify-content: space-between;">
                  <span>CONFIDENTIAL &bull; ATTACHMENT ANNEX</span>
                  <span>${escapeHtml(att.name)} (${escapeHtml(att.size)})</span>
                </div>
              </div>
            `;
          });
        });
      }
      return resultHtml;
    }

    function exportCoverProposalWord() {
      const proposalHtml = buildCoverProposalExportHtml();
      const projectName = (document.getElementById('projectName')?.value || document.getElementById('coverProjectName')?.textContent || 'Cost Proposal').trim();
      const safeName = projectName.replace(/[^a-z0-9_\- ]/gi, '').replace(/\s+/g, '_') || 'Cost_Proposal';
      const styles = `
        <style>
