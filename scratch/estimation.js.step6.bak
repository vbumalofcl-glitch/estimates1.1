    window.showBOQSummaryHeaderContextMenu = showBOQSummaryHeaderContextMenu;
    window.hideBOQSummaryColumn = hideBOQSummaryColumn;
    window.insertBOQSummaryColumn = insertBOQSummaryColumn;

    window.copiedCellsGrid = null;
    window.copiedCellsTable = null;

    function handleContextMenuCopy() {
      hideContextMenu();
      const tableId = window.contextMenuTargetTable;

      if (!window.selectedCells || window.selectedCells.size === 0) {
        return;
      }

      let minRow = Infinity, maxRow = -Infinity;
      let minCol = Infinity, maxCol = -Infinity;

      window.selectedCells.forEach(key => {
        const [r, c] = key.split(',').map(Number);
        if (r < minRow) minRow = r;
        if (r > maxRow) maxRow = r;
        if (c < minCol) minCol = c;
        if (c > maxCol) maxCol = c;
      });

      const table = document.getElementById(tableId);
      if (!table) return;

      const grid = [];
      for (let r = minRow; r <= maxRow; r++) {
        const tr = table.querySelector(`tbody tr[data-index="${r}"]`);
        const rowData = [];
        for (let c = minCol; c <= maxCol; c++) {
          if (tr && tr.children[c]) {
            rowData.push(getCellValue(tr.children[c]));
          } else {
            rowData.push('');
          }
        }
        grid.push(rowData);
      }

      window.copiedCellsGrid = grid;
      window.copiedCellsTable = tableId;

      if (window.selectedCells) window.selectedCells.clear();
      window.selectionStart = null;
      window.selectionEnd = null;
      updateCellSelectionVisuals();
    }
    window.handleContextMenuCopy = handleContextMenuCopy;

    function handleContextMenuPaste() {
      hideContextMenu();
      const tableId = window.contextMenuTargetTable;
      const targetRow = window.contextMenuTargetIndex;
      const targetCol = window.contextMenuTargetCol;

      if (targetRow === undefined || targetRow === null || targetRow < 0) return;
      if (targetCol === undefined || targetCol === null || targetCol < 0) return;

      if (!window.copiedCellsGrid || window.copiedCellsGrid.length === 0) {
        alert('No copied cells to paste.');
        return;
      }

      if (window.copiedCellsTable !== tableId) {
        if (!confirmAction('Pasting values from a different table. Proceed?')) return;
      }

      markUnsaved();
      let dataList = null;
      let recomputeFn = null;
      let renderFn = null;

      if (tableId === 'boqTable') {
        dataList = boqData;
        recomputeFn = () => recomputeCodes(boqData);
        renderFn = renderBOQTable;
      } else if (tableId === 'analysisTable') {
        dataList = analysisData;
        recomputeFn = recomputeAnalysisCodes;
        renderFn = renderAnalysisTable;
      } else if (tableId === 'priceListTable') {
        dataList = priceListData;
        recomputeFn = recomputePriceListCodes;
        renderFn = renderPriceListTable;
      }

      if (!dataList) return;

      window.copiedCellsGrid.forEach((rowValues, rOffset) => {
        const r = targetRow + rOffset;
        if (r >= dataList.length) return;
        const rowObj = dataList[r];

        rowValues.forEach((val, cOffset) => {
          const c = targetCol + cOffset;
          const field = getFieldNameByColIndex(tableId, c, rowObj.type);
          if (field) {
            if (field === 'qty' || field === 'materialUnitCost' || field === 'laborUnitCost' || field === 'pricePerUnit' || field === 'rentalPerUnit') {
              rowObj[field] = numberOrZero(val);
            } else {
              rowObj[field] = val;
            }
          }
        });
      });

      if (recomputeFn) recomputeFn();
      if (renderFn) renderFn();
    }
    window.handleContextMenuPaste = handleContextMenuPaste;

    function hideContextMenu() {
      const menu = document.getElementById('customContextMenu');
      if (menu) {
        menu.style.display = 'none';
      }
    }

    document.addEventListener('contextmenu', function(e) {
      const cell = e.target.closest('#boqTable tbody td, #analysisTable tbody td, #priceListTable tbody td');
      if (!cell) {
        const header = e.target.closest('#boqTable thead th');
        if (header) {
          e.preventDefault();
          window.showBOQHeaderContextMenu(e, header);
          return;
        }
        const summaryHeader = e.target.closest('#boqSummaryTable thead th');
        if (summaryHeader) {
          e.preventDefault();
          window.showBOQSummaryHeaderContextMenu(e, summaryHeader);
          return;
        }
        hideContextMenu();
        return;
      }
      
      const table = cell.closest('table');
      const tr = cell.closest('tr');
      if (!table || !tr) return;
      
      const tableId = table.id;
      const indexAttr = tr.getAttribute('data-index');
      if (indexAttr === null) return;
      const index = parseInt(indexAttr, 10);
      const colIndex = Array.from(tr.children).indexOf(cell);
      
      e.preventDefault();
      window.contextMenuTargetTable = tableId;
      window.contextMenuTargetIndex = index;
      window.contextMenuTargetCol = colIndex;
      
      const key = `${index},${colIndex}`;
      const isClickedInSelection = window.selectedCells && window.selectedCells.has(key);
      if (!isClickedInSelection) {
        selectedBOQRowIndices.clear();
        selectedAnalysisRowIndices.clear();
        selectedPriceListRowIndices.clear();

        window.selectionTable = tableId;
        window.selectionStart = { row: index, col: colIndex };
        window.selectionEnd = { row: index, col: colIndex };
        updateCellSelectionVisuals();
      }

      showContextMenu(e.clientX, e.clientY, 1);
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#customContextMenu')) {
        hideContextMenu();
      }
      if (!e.target.closest('#ganttHeaderContextMenu')) {
        if (typeof hideGanttHeaderContextMenu === 'function') {
          hideGanttHeaderContextMenu();
        }
      }
      if (!e.target.closest('#ganttTimelineContextMenu')) {
        if (typeof hideGanttTimelineContextMenu === 'function') {
          hideGanttTimelineContextMenu();
        }
      }
    });

    window.addEventListener('resize', function() {
      const ganttSheet = document.getElementById('ganttSheet');
      if (ganttSheet && ganttSheet.classList.contains('active')) {
        renderGanttChart();
      }
    });

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', applyFinalLocks);
      else applyFinalLocks();
      setTimeout(applyFinalLocks, 200);
      setTimeout(applyFinalLocks, 800);
    })();


    // Dynamic page count calculation on input and resize
    document.addEventListener('input', (e) => {
      if (e.target && e.target.closest && e.target.closest('#coverLetterSheet')) {
        updateCoverPageCount();
      }
    });
    window.addEventListener('resize', () => {
      const coverSheet = document.getElementById('coverLetterSheet');
      if (coverSheet && coverSheet.classList.contains('active')) {
        updateCoverPageCount();
      }
    });
