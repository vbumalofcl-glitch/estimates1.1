      { id: 'totalMaterialCost', name: 'Total Material Cost', width: '95px', visible: true },
      { id: 'leUnitCost', name: 'LE Unit Cost', width: '95px', visible: true },
      { id: 'totalLEC', name: 'Total LEC', width: '120px', visible: true },
      { id: 'grandTotalCost', name: 'Grand Total Cost', width: '100px', visible: true },
      { id: 'condition', name: 'Condition', width: '140px', visible: true },
      { id: 'action', name: 'Action', width: '70px', visible: true }
    ];
    let boqColumns = [];
    try {
      const savedCols = JSON.parse(localStorage.getItem('cost_estimate_boq_columns_v1'));
      if (Array.isArray(savedCols) && savedCols.length > 0) {
        const savedIds = savedCols.map(c => c.id);
        const missingDefaultCols = DEFAULT_BOQ_COLUMNS.filter(c => !savedIds.includes(c.id));
        const cleanedCols = savedCols.filter(c => DEFAULT_BOQ_COLUMNS.some(d => d.id === c.id));
        const actionIdx = cleanedCols.findIndex(c => c.id === 'action');
        if (actionIdx >= 0) {
          cleanedCols.splice(actionIdx, 0, ...missingDefaultCols);
        } else {
          cleanedCols.push(...missingDefaultCols);
        }
        boqColumns = cleanedCols;
      } else {
        boqColumns = JSON.parse(JSON.stringify(DEFAULT_BOQ_COLUMNS));
      }
    } catch (e) {
      boqColumns = JSON.parse(JSON.stringify(DEFAULT_BOQ_COLUMNS));
    }

    const DEFAULT_BOQ_SUMMARY_COLUMNS = [
      { id: 'code', name: 'Item Code', width: '10%', visible: true },
      { id: 'title', name: 'Work Description', width: '35%', visible: true },
      { id: 'overhead', name: 'Overhead Cost', width: '11%', visible: true },
      { id: 'profit', name: 'Profit', width: '11%', visible: true },
      { id: 'vat', name: 'VAT', width: '11%', visible: true },
      { id: 'total', name: 'Total Cost', width: '11%', visible: true },
      { id: 'costPerSqm', name: 'Cost per SQ.M.', width: '11%', visible: true }
    ];
    let boqSummaryColumns = [];
    try {
      const savedSummaryCols = JSON.parse(localStorage.getItem('cost_estimate_boq_summary_columns_v1'));
      if (Array.isArray(savedSummaryCols) && savedSummaryCols.length > 0) {
        const savedIds = savedSummaryCols.map(c => c.id);
        const missingDefaultCols = DEFAULT_BOQ_SUMMARY_COLUMNS.filter(c => !savedIds.includes(c.id));
        const cleanedCols = savedSummaryCols.filter(c => DEFAULT_BOQ_SUMMARY_COLUMNS.some(d => d.id === c.id));
        cleanedCols.push(...missingDefaultCols);
        boqSummaryColumns = cleanedCols;
      } else {
        boqSummaryColumns = JSON.parse(JSON.stringify(DEFAULT_BOQ_SUMMARY_COLUMNS));
      }
    } catch (e) {
      boqSummaryColumns = JSON.parse(JSON.stringify(DEFAULT_BOQ_SUMMARY_COLUMNS));
    }
    let appReady = false;
    let hasUnsavedChanges = false;

    function markUnsaved() {
      if (appReady) hasUnsavedChanges = true;
    }

    function confirmAction(message) {
      return window.confirm(message);
    }

    window.addEventListener('beforeunload', function(event) {
      if (!hasUnsavedChanges) return;
      event.preventDefault();
      event.returnValue = '';
    });
    
    document.addEventListener('keydown', function(event) {
      const ganttSheet = document.getElementById('ganttSheet');
      if (ganttSheet && ganttSheet.classList.contains('active')) {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'z') {
          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA' || document.activeElement.isContentEditable)) {
            return;
          }
          event.preventDefault();
          undoGanttAction();
        }
      }
    });
    let categoryOptions = JSON.parse(localStorage.getItem('boqCategoryOptions')) || ['General requirements','Earth works','Structural Works','Architectural Works','Electrical Works','Plumbing and Sanitary Works','Mechanical Works','Electronic Works'];
    const priceListCategories = ['Structural works','Architectural works','Electrical works','Plumbing & sanitary works','Mechanical works','Electronic works','Equipments and Tools','Consumable/Miscellaneous Items'];
    const priceListSubCategories = {
      'Structural works': ['Concrete','Rebars','Sand','Gravel','Tie wires'],
      'Architectural works': ['Masonry works','Painting works','Carpentry works','Tile works','Glass works','Steel works','Tinsmithry works'],
      'Electrical works': ['Wires','Lighting fixtures','Electrical conduits','Panel boards','Meters','Electrical hangers & support','Switches & outlets','Electrical motors'],
      'Plumbing & sanitary works': ['Sanitary pipes','Waterline pipes','Plumbing fixtures','Plumbing motors'],
      'Mechanical works': ['Fire protection system','Elevator system','Mechanical motors'],
      'Electronic works': ['FDAS','CCTV','Structured cabling'],
      'Equipments and Tools': ['Equipment','Tools'],
      'Consumable/Miscellaneous Items': ['Fastening & Drill Bits Consumables','Cutting & Abrasive Consumables','Welding Consumables','Adhesives & Sealants Consumables','Protection & Masking Consumables','Miscellaneous Consumables'],
    };

    function money(value) { const num = Number(value) || 0; return num.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function peso(value) { return `₱ ${money(value)}`; }
    function numberOrZero(value) {
      if (typeof value === 'string') {
        value = value.replace(/[^0-9.-]/g, '');
      }
      const num = parseFloat(value);
      return Number.isFinite(num) ? num : 0;
    }

    function roundUpNearestOne(value) {
      const num = Number(value) || 0;
      return Math.ceil(num);
    }

    function getPercentInputValue(id) {
      const input = document.getElementById(id);
      return input ? numberOrZero(input.value) : 0;
    }

    function applyPercentMultiplier(value, percent) {
      return roundUpNearestOne(numberOrZero(value) * (1 + (numberOrZero(percent) / 100)));
    }

    function getBOQMultipliers() {
      return {
        qty: getPercentInputValue('boqQtyMultiplier'),
        material: getPercentInputValue('boqMaterialMultiplier'),
        le: getPercentInputValue('boqLEMultiplier'),
        profit: getPercentInputValue('boqProfitMultiplier'),
        overhead: getPercentInputValue('boqOverheadMultiplier'),
        tax: getPercentInputValue('boqTaxMultiplier')
      };
    }

    function updateBOQMultipliers() {
      markUnsaved();
      renderBOQTable();
      renderBOQSummaryTable();
      renderCoverLetter();
    }

    const boqDisplayValuesCache = new Map();
    const boqCategorySummaryCache = new Map();

    function clearBOQCaches() {
      ganttTimeCache.clear();
      boqDisplayValuesCache.clear();
      boqCategorySummaryCache.clear();
    }

    function computeBOQDisplayValues(row) {
      if (boqDisplayValuesCache.has(row)) {
        return boqDisplayValuesCache.get(row);
      }
      const multipliers = getBOQMultipliers();
      const baseQty = numberOrZero(row.qty);
      const linkedDUPAMatch = getLinkedDUPAMatch(row);
      const linkedMaterialUnitCost = linkedDUPAMatch && linkedDUPAMatch.materialUnitCost !== null ? linkedDUPAMatch.materialUnitCost : null;
      const linkedLEUnitCost = linkedDUPAMatch && linkedDUPAMatch.leUnitCost !== null ? linkedDUPAMatch.leUnitCost : null;
      const baseMaterialUnitCost = linkedMaterialUnitCost !== null ? linkedMaterialUnitCost : numberOrZero(row.materialUnitCost);
      const baseLEUnitCost = linkedLEUnitCost !== null ? linkedLEUnitCost : numberOrZero(row.laborUnitCost);
      const qty = applyPercentMultiplier(baseQty, multipliers.qty);
      const baseDisplayMaterialUnitCost = applyPercentMultiplier(baseMaterialUnitCost, multipliers.material);
      const baseDisplayLEUnitCost = applyPercentMultiplier(baseLEUnitCost, multipliers.le);
      const markupPercent = numberOrZero(multipliers.profit) + numberOrZero(multipliers.overhead) + numberOrZero(multipliers.tax);
      const materialUnitCost = applyPercentMultiplier(baseDisplayMaterialUnitCost, markupPercent);
      const leUnitCost = applyPercentMultiplier(baseDisplayLEUnitCost, markupPercent);
      const totalMaterialCost = qty * materialUnitCost;
      const totalLEC = qty * leUnitCost;
      const grandTotalCost = roundUpNearestOne(totalMaterialCost + totalLEC);
      const res = {
        baseQty,
        baseMaterialUnitCost,
        baseLEUnitCost,
        linkedMaterialUnitCost,
        linkedLEUnitCost,
        linkedUnit: linkedDUPAMatch && linkedDUPAMatch.unit ? linkedDUPAMatch.unit : '',
        qty,
        baseDisplayMaterialUnitCost,
        baseDisplayLEUnitCost,
        markupPercent,
        materialUnitCost,
        leUnitCost,
        totalMaterialCost,
        totalLEC,
        grandTotalCost: grandTotalCost
      };
      boqDisplayValuesCache.set(row, res);
      return res;
    }

    function computeBOQBaseCost(row) {
      const multipliers = getBOQMultipliers();
      const baseQty = numberOrZero(row.qty);
      const linkedDUPAMatch = getLinkedDUPAMatch(row);
      const linkedMaterialUnitCost = linkedDUPAMatch && linkedDUPAMatch.materialUnitCost !== null ? linkedDUPAMatch.materialUnitCost : null;
      const linkedLEUnitCost = linkedDUPAMatch && linkedDUPAMatch.leUnitCost !== null ? linkedDUPAMatch.leUnitCost : null;
      const baseMaterialUnitCost = linkedMaterialUnitCost !== null ? linkedMaterialUnitCost : numberOrZero(row.materialUnitCost);
      const baseLEUnitCost = linkedLEUnitCost !== null ? linkedLEUnitCost : numberOrZero(row.laborUnitCost);
      const qty = applyPercentMultiplier(baseQty, multipliers.qty);
      const materialUnitCost = applyPercentMultiplier(baseMaterialUnitCost, multipliers.material);
      const leUnitCost = applyPercentMultiplier(baseLEUnitCost, multipliers.le);
      return (qty * materialUnitCost) + (qty * leUnitCost);
    }

    function computeBOQCategorySummary(categoryIndex) {
      if (boqCategorySummaryCache.has(categoryIndex)) {
        return boqCategorySummaryCache.get(categoryIndex);
      }
      const row = boqData[categoryIndex];
      const multipliers = getBOQMultipliers();
      let baseCost = 0;
      const categoryLevel = levelOf(row);
      let i = categoryIndex + 1;
      while (i < boqData.length && levelOf(boqData[i]) > categoryLevel) {
        const child = boqData[i];
        const childHasChildren = hasChildRow(boqData, i);
        const childEditable = child.type === 'subsubsubcategory' || (child.type === 'subsubcategory' && !childHasChildren) || (child.type === 'subcategory' && !childHasChildren);
        if (childEditable) baseCost += computeBOQBaseCost(child);
        i += 1;
      }
      const overheadCost = roundUpNearestOne(baseCost * (numberOrZero(multipliers.overhead) / 100));
      const profitCost = roundUpNearestOne(baseCost * (numberOrZero(multipliers.profit) / 100));
      const vatCost = roundUpNearestOne(baseCost * (numberOrZero(multipliers.tax) / 100));
      const totalCost = roundUpNearestOne(baseCost + overheadCost + profitCost + vatCost);
      const res = { itemCode: row.code || '', workDescription: row.title || '', overheadCost, profitCost, vatCost, totalCost };
      boqCategorySummaryCache.set(categoryIndex, res);
      return res;
    }

    function showBOQSummarySheet() {
      renderBOQTable();
      renderBOQSummaryTable();
      showSheet('boqSummarySheet');
    }

    function renderBOQSummaryTable() {
      clearBOQCaches();
      // 1. Render Headers
      const theadTr = document.querySelector('#boqSummaryTable thead tr');
      if (theadTr) {
        theadTr.innerHTML = '';
        boqSummaryColumns.forEach(col => {
          if (!col.visible) return;
          const th = document.createElement('th');
          th.style.width = col.width;
          th.textContent = col.name;
          theadTr.appendChild(th);
        });
      }

      // 2. Render Body Rows
      const tbody = document.querySelector('#boqSummaryTable tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      const area = numberOrZero(document.getElementById('boqSummaryArea')?.value || 0);
      let totalOverhead = 0, totalProfit = 0, totalVat = 0, totalCost = 0;
      
      boqData.forEach((row, index) => {
        if (row.type !== 'category' && row.type !== 'subcategory') return;
        const summary = computeBOQCategorySummary(index);
        if (row.type === 'category') {
          totalOverhead += summary.overheadCost;
          totalProfit += summary.profitCost;
          totalVat += summary.vatCost;
          totalCost += summary.totalCost;
        }
        
        const costPerSqm = area > 0 ? roundUpNearestOne(summary.totalCost / area) : '';
        const isSub = row.type === 'subcategory';
        const tr = document.createElement('tr');
        tr.dataset.index = index;
        tr.className = isSub ? 'row-subcategory' : 'row-category';
        
        let rowHtml = '';
        boqSummaryColumns.forEach(col => {
          if (!col.visible) return;
          switch (col.id) {
            case 'code':
              rowHtml += `<td style="text-align:center;">${escapeHtml(summary.itemCode)}</td>`;
              break;
            case 'title':
              rowHtml += `<td style="${isSub ? 'padding-left: 20px;' : ''}">${escapeHtml(summary.workDescription)}</td>`;
              break;
            case 'overhead':
              rowHtml += `<td class="number">${peso(summary.overheadCost)}</td>`;
              break;
            case 'profit':
              rowHtml += `<td class="number">${peso(summary.profitCost)}</td>`;
              break;
            case 'vat':
              rowHtml += `<td class="number">${peso(summary.vatCost)}</td>`;
              break;
            case 'total':
              rowHtml += `<td class="number">${peso(summary.totalCost)}</td>`;
              break;
            case 'costPerSqm':
              rowHtml += `<td class="number">${costPerSqm === '' ? '' : peso(costPerSqm)}</td>`;
              break;
          }
        });
        tr.innerHTML = rowHtml;
        tbody.appendChild(tr);
      });

      // 3. Render Total Row
      const totalCostPerSqm = area > 0 ? roundUpNearestOne(totalCost / area) : '';
      const amountEl = document.getElementById('coverProjectAmount');
      if (amountEl) amountEl.textContent = peso(totalCost);
      
      const totalRow = document.createElement('tr');
      totalRow.className = 'summary-total-row';
      let totalRowHtml = '';
      boqSummaryColumns.forEach(col => {
        if (!col.visible) return;
        switch (col.id) {
          case 'code':
            totalRowHtml += `<td></td>`;
            break;
          case 'title':
            totalRowHtml += `<td>Total</td>`;
            break;
          case 'overhead':
            totalRowHtml += `<td class="number">${peso(totalOverhead)}</td>`;
            break;
          case 'profit':
            totalRowHtml += `<td class="number">${peso(totalProfit)}</td>`;
            break;
          case 'vat':
            totalRowHtml += `<td class="number">${peso(totalVat)}</td>`;
            break;
          case 'total':
            totalRowHtml += `<td class="number">${peso(totalCost)}</td>`;
          case 'costPerSqm':
            totalRowHtml += `<td class="number">${totalCostPerSqm === '' ? '' : peso(totalCostPerSqm)}</td>`;
            break;
        }
      });
      totalRow.innerHTML = totalRowHtml;
      tbody.appendChild(totalRow);
    }

    const DEFAULT_GANTT_SETTINGS = {
      showCoordinates: false,
      rowHeight: 40,
      connectorColor: '#6b7280',
