          .cover-letter-page { width: 210mm; min-height: 297mm; max-width: 100%; line-height: 1.45; box-sizing: border-box; }
          .cover-letter-header { text-align: center; margin-bottom: 18px; }
          .cover-header-table { width: 100%; min-width: 0; height: 20mm; max-height: 20mm; border-collapse: collapse; table-layout: fixed; border: 1px solid #111827; margin: 0 0 14px 0; background: #ffffff; }
          .cover-header-table td { border: 1px solid #111827; padding: 0; vertical-align: middle; height: 20mm; max-height: 20mm; }
          .cover-header-col1 { width: 30%; height: 20mm; max-height: 20mm; text-align: center; vertical-align: middle; padding: 1mm; }
          .cover-header-col1 .cover-company-logo { max-height: 18mm; max-width: 95%; object-fit: contain; margin: 0 auto; display: block; }
          .cover-header-col2 { width: 45%; height: 20mm; max-height: 20mm; text-align: center; vertical-align: middle; font-size: 20pt; font-weight: 700; color: #111827; line-height: 1.15; text-transform: uppercase; }
          .cover-header-col3 { width: 25%; height: 20mm; max-height: 20mm; vertical-align: middle; padding: 0; }
          .cover-header-subtable { width: 100%; min-width: 0; height: 20mm; max-height: 20mm; border-collapse: collapse; border: none; margin: 0; }
          .cover-header-subtable tr { height: 5mm; max-height: 5mm; }
          .cover-header-subtable td { height: 5mm; max-height: 5mm; font-size: 8pt; font-weight: 700; color: #111827; padding: 0 4px; vertical-align: middle; text-align: left; border: none; border-bottom: none; white-space: nowrap; }
          .cover-header-subtable tr:last-child td { border-bottom: none; }
          .cover-company-logo { display: block; width: 760px; max-width: 100%; max-height: 92px; object-fit: contain; margin: 0 auto 14px; }
          h2 { text-transform: uppercase; margin: 0 0 8px; }
          .cover-letter-meta { display: grid; grid-template-columns: 32mm 5mm 3mm 10mm minmax(0, 1fr); row-gap: 1px; column-gap: 0; margin: 4px 0 6px; align-items: center; overflow: visible; }
          .cover-linked-value { display: flex; align-items: center; width: 100%; min-width: 0; min-height: 18px; border: 0; padding: 0; font-size: 9pt; line-height: 1.2; background: transparent; color: #1f2937; white-space: nowrap; word-break: normal; overflow-wrap: normal; }
          #coverProjectName, #coverClientName, #coverSubject { white-space: nowrap; overflow: visible; text-overflow: clip; word-break: normal; overflow-wrap: normal; }
          .cover-letter-meta-table { width: 100%; border-collapse: collapse; table-layout: auto; margin: 4px 0 6px 0; }
          .cover-letter-meta-table td { border: 0 !important; padding: 0 0 1px 0; font-size: 10pt; line-height: 1; vertical-align: middle; }
          .cover-letter-meta-table td:nth-child(1) { width: 32mm; font-size: 10pt; font-weight: 800; color: #6b7280; text-transform: uppercase; white-space: nowrap; text-align: left; }
          .cover-letter-meta-table td:nth-child(2) { width: 5mm; }
          .cover-letter-meta-table td:nth-child(3) { width: 3mm; font-size: 10pt; font-weight: 800; color: #6b7280; text-align: left; white-space: nowrap; }
          .cover-letter-meta-table td:nth-child(4) { width: 10mm; }
          .cover-letter-meta-table td:nth-child(5) { white-space: nowrap; word-break: normal; overflow-wrap: normal; }
          label { min-height: 18px; display: flex; align-items: center; line-height: 1.2; font-size: 10pt; color: #6b7280; font-weight: 800; text-transform: uppercase; }
          .cover-meta-label { min-height: 18px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0; font-size: 10pt; line-height: 1.2; color: #6b7280; font-weight: 800; text-transform: uppercase; }
          .cover-meta-colon { justify-self: end; text-align: right; }
          .cover-letter-body { display: grid; gap: 8px; margin: 12px 0; text-align: justify; font-size: 10pt; line-height: 1.45; }
          .proposal-amount-box { border: 1px solid #bfdbfe; background: #eff6ff; padding: 10px; font-weight: 700; }
          .proposal-amount-box span { font-size: 15px; font-weight: 900; }
          .proposal-vat-note { font-size: 11px; color: #6b7280; margin: -4px 0 4px; font-weight: 700; }
          .cover-letter-section-title { margin: 16px 0 6px; font-size: 12px; font-weight: 900; text-transform: uppercase; color: #111827; }
          .cover-letter-terms { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
          .cover-letter-terms > div {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 12px 14px;
            box-shadow: var(--card-shadow);
            position: relative;
            width: 100%;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 6px;
          }
          .cover-letter-terms > div::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 1px;
            background: rgba(255, 255, 255, 0.8);
            pointer-events: none;
            border-radius: 6px 6px 0 0;
          }
          table { border-collapse: collapse; width: 100%; table-layout: fixed; margin-top: 10px; }
          th, td { border: 1px solid #cfd8e3; padding: 4px 3px; font-size: 10px; box-sizing: border-box; }
          th { background: #eef4ff; text-transform: uppercase; white-space: nowrap; }
          .number { text-align: right; white-space: nowrap; }
          .cover-letter-signatures { display: flex; flex-direction: column; gap: 24px; margin-top: 28px; }
          .cover-letter-signature-line { border-bottom: 1px solid #111827; height: 38px; margin-bottom: 6px; }

    /* FINAL TYPOGRAPHY STANDARDIZATION: modern/minimal professional weight */
    body,
    .cover-letter-page,
    .cover-letter-page input,
    .cover-letter-page textarea,
    .cover-letter-body,
