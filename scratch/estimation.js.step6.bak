      }
    }

    function handlePriceListCellMouseEnter(event, index) {
      if (!isMouseDown || window.activeDragTable !== 'priceListTable') return;
      
      if (index !== dragStartIndex) {
        if (!isDragging) {
          isDragging = true;
          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) {
            document.activeElement.blur();
          }
        }
      }
      
      if (isDragging) {
        window.getSelection().removeAllRanges();
        const start = Math.min(dragStartIndex, index);
        const end = Math.max(dragStartIndex, index);
        const indices = [];
        for (let i = start; i <= end; i++) {
          indices.push(i);
        }
        selectPriceListRows(indices);
      }
    }

    // Global listeners for dragging state
    document.addEventListener('mouseup', function() {
      if (isDragging) {
        window.justDragged = true;
        setTimeout(() => {
          window.justDragged = false;
        }, 50);
      }
      isMouseDown = false;
      isDragging = false;
      window.activeDragTable = null;
    });

    document.addEventListener('selectstart', function(e) {
      if (isDragging) {
        e.preventDefault();
      }
    });

    document.addEventListener('dragstart', function(e) {
      if (isDragging || isMouseDown) {
        e.preventDefault();
      }
    });

    // Global cell-level selection state and delegation
    window.selectedCells = new Set();
    window.selectionStart = null;
    window.selectionEnd = null;
    window.selectionTable = null;
    window.justDragged = false;

    let isDraggingAppFillHandle = false;
    let appFillTargetEnd = null;

    function getCellValueFromTd(td) {
      if (!td) return '';
      const input = td.querySelector('input, select, textarea');
      if (input) return input.value;
      return td.textContent.trim();
    }

    function setCellValueInTd(td, value) {
      if (!td) return;
      const input = td.querySelector('input, select, textarea');
      if (input) {
        input.value = value;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function updateCellSelectionVisuals() {
      document.querySelectorAll('td.selected-cell').forEach(td => {
        td.classList.remove('selected-cell');
        const existingHandle = td.querySelector('.app-fill-handle');
        if (existingHandle) existingHandle.remove();
      });

      const statusBar = document.getElementById('appGridStatusBar');

      if (!window.selectionStart || !window.selectionEnd || !window.selectionTable) {
        if (statusBar) statusBar.style.display = 'none';
        return;
      }

      const tableId = window.selectionTable;
      const startRow = window.selectionStart.row;
      const startCol = window.selectionStart.col;
      const endRow = window.selectionEnd.row;
      const endCol = window.selectionEnd.col;

      const minRow = Math.min(startRow, endRow);
      const maxRow = Math.max(startRow, endRow);
      const minCol = Math.min(startCol, endCol);
      const maxCol = Math.max(startCol, endCol);

      window.selectedCells = new Set();

      const table = document.getElementById(tableId);
      if (!table) {
        if (statusBar) statusBar.style.display = 'none';
        return;
      }

      const allTrs = Array.from(table.querySelectorAll('tbody tr'));
      let endTd = null;
      let count = 0;
      let sum = 0;
      let min = Infinity;
      let max = -Infinity;
      let hasNumeric = false;

      for (let r = minRow; r <= maxRow; r++) {
        let tr = table.querySelector(`tbody tr[data-index="${r}"]`);
        if (!tr && r < allTrs.length) tr = allTrs[r];
        if (!tr) continue;
        for (let c = minCol; c <= maxCol; c++) {
          const td = tr.children[c];
          if (td) {
            td.classList.add('selected-cell');
            window.selectedCells.add(`${r},${c}`);

            if (r === maxRow && c === maxCol) endTd = td;

            const cellValStr = getCellValueFromTd(td);
            if (cellValStr !== '') {
              count++;
              // Extract numeric value from peso strings or numbers
              const cleanStr = cellValStr.replace(/[^0-9.-]/g, '');
              const num = Number(cleanStr);
              if (!isNaN(num) && cleanStr !== '') {
                hasNumeric = true;
                sum += num;
                if (num < min) min = num;
                if (num > max) max = num;
              }
            }
          }
        }
      }

      // Attach Excel Fill Handle Square directly to bottom-right cell of selection range
      if (endTd) {
        const handle = document.createElement('div');
        handle.id = 'appCellFillHandle';
        handle.className = 'app-fill-handle';
        handle.title = 'Drag to autofill cells';
        attachFillHandleDragEvents(handle);
        endTd.appendChild(handle);
      }

      // Update Selection Status Bar
      if (statusBar) {
        if (window.selectedCells.size > 0) {
          document.getElementById('appStatCount').textContent = count;
          if (hasNumeric && count > 0) {
            document.getElementById('appStatAverage').textContent = (sum / count).toLocaleString(undefined, { maximumFractionDigits: 2 });
            document.getElementById('appStatSum').textContent = Number.isInteger(sum) ? sum.toLocaleString() : sum.toLocaleString(undefined, { maximumFractionDigits: 2 });
            document.getElementById('appStatMin').textContent = min.toLocaleString();
            document.getElementById('appStatMax').textContent = max.toLocaleString();
          } else {
            document.getElementById('appStatAverage').textContent = '-';
            document.getElementById('appStatSum').textContent = '-';
            document.getElementById('appStatMin').textContent = '-';
            document.getElementById('appStatMax').textContent = '-';
          }
          statusBar.style.display = 'flex';
        } else {
          statusBar.style.display = 'none';
        }
      }
    }
    window.updateCellSelectionVisuals = updateCellSelectionVisuals;

    function attachFillHandleDragEvents(handle) {
      const previewBox = document.getElementById('appCellFillPreviewBox');
      if (!handle) return;

      handle.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        e.preventDefault();
        if (!window.selectionStart || !window.selectionTable) return;

        isDraggingAppFillHandle = true;

        const onMouseMove = (moveEvt) => {
          if (!isDraggingAppFillHandle) return;
          const element = document.elementFromPoint(moveEvt.clientX, moveEvt.clientY);
          if (!element) return;
          const td = element.closest(`#${window.selectionTable} tbody td`);
          if (!td) return;
          const tr = td.closest('tr');
          if (!tr) return;

          let indexAttr = tr.getAttribute('data-index');
          let r = indexAttr !== null ? parseInt(indexAttr, 10) : Array.from(tr.parentNode.children).indexOf(tr);
          const c = Array.from(tr.children).indexOf(td);
          if (isNaN(r) || c === -1) return;

          appFillTargetEnd = { row: r, col: c };

          // Update dashed boundary preview box
          const minR = Math.min(window.selectionStart.row, window.selectionEnd.row, appFillTargetEnd.row);
          const maxR = Math.max(window.selectionStart.row, window.selectionEnd.row, appFillTargetEnd.row);
          const minC = Math.min(window.selectionStart.col, window.selectionEnd.col, appFillTargetEnd.col);
          const maxC = Math.max(window.selectionStart.col, window.selectionEnd.col, appFillTargetEnd.col);

          const table = document.getElementById(window.selectionTable);
          const allTrs = table ? Array.from(table.querySelectorAll('tbody tr')) : [];
          const startTr = table ? (table.querySelector(`tbody tr[data-index="${minR}"]`) || allTrs[minR]) : null;
          const endTr = table ? (table.querySelector(`tbody tr[data-index="${maxR}"]`) || allTrs[maxR]) : null;

          if (startTr && endTr && startTr.children[minC] && endTr.children[maxC]) {
            const startRect = startTr.children[minC].getBoundingClientRect();
            const endRect = endTr.children[maxC].getBoundingClientRect();
            const scrollX = window.scrollX || window.pageXOffset;
            const scrollY = window.scrollY || window.pageYOffset;

            if (previewBox) {
              previewBox.style.left = `${startRect.left + scrollX}px`;
              previewBox.style.top = `${startRect.top + scrollY}px`;
              previewBox.style.width = `${endRect.right - startRect.left}px`;
              previewBox.style.height = `${endRect.bottom - startRect.top}px`;
              previewBox.style.display = 'block';
            }
          }
        };

        const onMouseUp = () => {
          if (!isDraggingAppFillHandle) return;
          isDraggingAppFillHandle = false;
          if (previewBox) previewBox.style.display = 'none';
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);

          performAppAutofill();
        };

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });
    }

    function performAppAutofill() {
      if (!appFillTargetEnd || !window.selectionStart || !window.selectionEnd || !window.selectionTable) return;

      const srcMinR = Math.min(window.selectionStart.row, window.selectionEnd.row);
      const srcMaxR = Math.max(window.selectionStart.row, window.selectionEnd.row);
      const srcMinC = Math.min(window.selectionStart.col, window.selectionEnd.col);
      const srcMaxC = Math.max(window.selectionStart.col, window.selectionEnd.col);

      const targetR = appFillTargetEnd.row;
      const targetC = appFillTargetEnd.col;
      const tableId = window.selectionTable;

      markUnsaved();

      const table = document.getElementById(tableId);
      if (!table) return;

      // Fill Downwards / Upwards across table data models
      if (targetR > srcMaxR) {
        const fillHeight = srcMaxR - srcMinR + 1;
        for (let r = srcMaxR + 1; r <= targetR; r++) {
          const offsetR = (r - srcMaxR - 1) % fillHeight;
          const sourceRowIdx = srcMinR + offsetR;

          for (let c = srcMinC; c <= srcMaxC; c++) {
            autofillAppCell(tableId, sourceRowIdx, c, r, c, (r - sourceRowIdx));
          }
        }
        window.selectionEnd.row = targetR;
      } else if (targetC > srcMaxC) {
        // Fill Rightwards across columns
        const fillWidth = srcMaxC - srcMinC + 1;
        for (let c = srcMaxC + 1; c <= targetC; c++) {
          const offsetC = (c - srcMaxC - 1) % fillWidth;
          const sourceColIdx = srcMinC + offsetC;

          for (let r = srcMinR; r <= srcMaxR; r++) {
            autofillAppCell(tableId, r, sourceColIdx, r, c, 0);
          }
        }
        window.selectionEnd.col = targetC;
      }

      // Refresh corresponding table model
      if (tableId === 'boqTable') {
        recomputeCodes(boqData);
        renderBOQTable();
      } else if (tableId === 'analysisTable') {
        renderAnalysisTable();
      } else if (tableId === 'priceListTable') {
        renderPriceListTable();
      } else if (tableId === 'boqSummaryTable') {
        renderBOQSummaryTable();
      } else if (tableId === 'ganttTaskTable') {
        renderGanttChart();
      } else if (tableId === 'qtyTaskTable') {
        renderQtyModalTable();
      }

      updateCellSelectionVisuals();
    }

    function autofillAppCell(tableId, srcR, srcC, destR, destC, rowOffset) {
      if (tableId === 'boqTable') {
        const srcRow = boqData[srcR];
        const destRow = boqData[destR];
        if (!srcRow || !destRow) return;

        const colFieldMap = ['plus', 'code', 'title', 'specification', 'qty', 'unit', 'materialUnitCost', 'totalMaterialCost', 'laborUnitCost', 'totalLEC', 'grandTotalCost', 'condition', 'action'];
        const field = colFieldMap[srcC];

        if (field && ['title', 'specification', 'qty', 'unit', 'materialUnitCost', 'laborUnitCost'].includes(field)) {
          let srcVal = srcRow[field];
          if (typeof srcVal === 'number') {
            const nextVal = srcVal + (typeof srcVal === 'number' ? rowOffset : 0);
            destRow[field] = nextVal;
          } else if (typeof srcVal === 'string') {
            destRow[field] = srcVal;
          }
        }
      } else if (tableId === 'analysisTable') {
        const srcRow = analysisData[srcR];
        const destRow = analysisData[destR];
        if (!srcRow || !destRow) return;

        const colFieldMap = ['code', 'title', 'specification', 'qty', 'unit', 'materialUnitCost', 'totalMaterialCost', 'laborUnitCost', 'totalLEC', 'grandTotalCost'];
        const field = colFieldMap[srcC];

        if (field && ['title', 'specification', 'qty', 'unit', 'materialUnitCost', 'laborUnitCost'].includes(field)) {
          destRow[field] = srcRow[field];
        }
      } else if (tableId === 'priceListTable') {
        const srcRow = priceListData[srcR];
        const destRow = priceListData[destR];
        if (!srcRow || !destRow) return;

        const colFieldMap = ['itemNo', 'category', 'description', 'unit', 'cost'];
        const field = colFieldMap[srcC];
        if (field && ['category', 'description', 'unit', 'cost'].includes(field)) {
          destRow[field] = srcRow[field];
        }
      } else if (tableId === 'ganttTaskTable' || tableId === 'qtyTaskTable') {
        const srcRow = boqData[srcR];
        const destRow = boqData[destR];
        if (!srcRow || !destRow) return;

        const activeCols = ganttColumns.filter(c => c.visible);
        const colObj = activeCols[srcC];
        if (!colObj) return;

        const colId = colObj.id;
        if (colId === 'startDate') {
          const srcVal = srcRow.ganttStartDate || srcRow.startDate;
          if (srcVal) {
            const srcDate = parseSafeDate(srcVal);
            const nextDate = new Date(srcDate);
            nextDate.setDate(srcDate.getDate() + rowOffset);
            updateGanttTaskStartDate(destR, formatDateString(nextDate));
          }
        } else if (colId === 'duration') {
          const tInfo = (typeof taskInfos !== 'undefined' && taskInfos[srcR]) ? taskInfos[srcR] : null;
          const srcVal = tInfo ? tInfo.duration : (srcRow.ganttDuration || 1);
          updateGanttTaskDuration(destR, srcVal);
        } else if (colId === 'predecessor') {
          const srcVal = srcRow.ganttPredecessor || '';
          updateGanttTaskPredecessor(destR, srcVal);
        } else if (['title', 'specification', 'qty', 'unit', 'materialUnitCost', 'laborUnitCost'].includes(colId)) {
          let srcVal = srcRow[colId];
          if (typeof srcVal === 'number') {
            destRow[colId] = srcVal + rowOffset;
          } else {
            destRow[colId] = srcVal;
          }
        }
      }
    }

    // --- Global Grid Keyboard Navigation ---
    document.addEventListener('keydown', function(e) {
      if (!window.selectionStart || !window.selectionTable) return;

      const activeEl = document.activeElement;
      const isInputActive = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT');

      const table = document.getElementById(window.selectionTable);
      if (!table) return;

      const tbodyTrs = Array.from(table.querySelectorAll('tbody tr'));
      if (tbodyTrs.length === 0) return;

      let r = window.selectionStart.row;
      let c = window.selectionStart.col;
      const maxRows = tbodyTrs.length;
      const maxCols = tbodyTrs[0] ? tbodyTrs[0].children.length : 0;

      if (!isInputActive) {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          r = Math.max(0, r - 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          r = Math.min(maxRows - 1, r + 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          c = Math.max(0, c - 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          c = Math.min(maxCols - 1, c + 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'Tab') {
          e.preventDefault();
          if (e.shiftKey) c = Math.max(0, c - 1);
          else c = Math.min(maxCols - 1, c + 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (e.shiftKey) r = Math.max(0, r - 1);
          else r = Math.min(maxRows - 1, r + 1);
          window.selectionStart = { row: r, col: c };
          window.selectionEnd = { row: r, col: c };
          updateCellSelectionVisuals();
        } else if (e.key === 'Delete' || e.key === 'Backspace') {
          if (window.selectedCells && window.selectedCells.size > 0) {
            e.preventDefault();
            markUnsaved();
            window.selectedCells.forEach(key => {
              const [cellR, cellC] = key.split(',').map(Number);
              const tr = table.querySelector(`tbody tr[data-index="${cellR}"]`) || tbodyTrs[cellR];
              if (tr && tr.children[cellC]) {
                setCellValueInTd(tr.children[cellC], '');
              }
            });
            if (window.selectionTable === 'boqTable') renderBOQTable();
            else if (window.selectionTable === 'analysisTable') renderAnalysisTable();
            else if (window.selectionTable === 'priceListTable') renderPriceListTable();
            else if (window.selectionTable === 'ganttTaskTable') renderGanttChart();
            updateCellSelectionVisuals();
          }
        } else if (e.key === 'Escape') {
          window.selectionStart = null;
          window.selectionEnd = null;
          window.selectionTable = null;
          updateCellSelectionVisuals();
        }
      } else if (isInputActive && e.key === 'Enter') {
        activeEl.blur();
        r = Math.min(maxRows - 1, r + 1);
        window.selectionStart = { row: r, col: c };
        window.selectionEnd = { row: r, col: c };
        setTimeout(updateCellSelectionVisuals, 20);
      }
    });

    document.addEventListener('click', function(e) {
      if (window.justDragged) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if (!e.target.closest('#boqTable tbody td, #analysisTable tbody td, #priceListTable tbody td, #boqSummaryTable tbody td, #ganttTaskTable tbody td, #qtyTaskTable tbody td, #customContextMenu, #appCellSelectionBox, #appCellFillHandle, .app-fill-handle')) {
        window.selectionStart = null;
        window.selectionEnd = null;
        window.selectionTable = null;
        if (window.selectedCells) window.selectedCells.clear();
        updateCellSelectionVisuals();
      }
    });

    document.addEventListener('mousedown', function(e) {
      const td = e.target.closest('#boqTable tbody td, #analysisTable tbody td, #priceListTable tbody td, #boqSummaryTable tbody td, #ganttTaskTable tbody td, #qtyTaskTable tbody td');
      if (!td) return;

      if (e.button !== 0) return;

      const tr = td.closest('tr');
      const table = td.closest('table');
      if (!tr || !table) return;

      let indexAttr = tr.getAttribute('data-index');
      let index = indexAttr !== null ? parseInt(indexAttr, 10) : Array.from(tr.parentNode.children).indexOf(tr);
      const colIndex = Array.from(tr.children).indexOf(td);

      isMouseDown = true;
      isDragging = false;
      window.activeDragTable = table.id;
      window.selectionTable = table.id;
      window.selectionStart = { row: index, col: colIndex };
      window.selectionEnd = { row: index, col: colIndex };

      // Clear row selection
      selectedBOQRowIndices.clear();
      selectedAnalysisRowIndices.clear();
      selectedPriceListRowIndices.clear();
      document.querySelectorAll('.selected-row').forEach(row => row.classList.remove('selected-row'));
      document.querySelectorAll('.selected-work-cell').forEach(c => c.classList.remove('selected-work-cell'));

      updateCellSelectionVisuals();
    });

    document.addEventListener('mouseover', function(e) {
      if (!isMouseDown || !window.activeDragTable || !window.selectionStart) return;

      const td = e.target.closest('#boqTable tbody td, #analysisTable tbody td, #priceListTable tbody td, #boqSummaryTable tbody td, #ganttTaskTable tbody td, #qtyTaskTable tbody td');
      if (!td) return;

      const tr = td.closest('tr');
      const table = td.closest('table');
      if (!tr || !table || table.id !== window.selectionTable) return;

      let indexAttr = tr.getAttribute('data-index');
      let index = indexAttr !== null ? parseInt(indexAttr, 10) : Array.from(tr.parentNode.children).indexOf(tr);
      const colIndex = Array.from(tr.children).indexOf(td);

      if (index !== window.selectionStart.row || colIndex !== window.selectionStart.col) {
        if (!isDragging) {
          isDragging = true;
          if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT' || document.activeElement.tagName === 'TEXTAREA')) {
            document.activeElement.blur();
          }
        }
      }

      if (isDragging) {
        window.getSelection().removeAllRanges();
        window.selectionEnd = { row: index, col: colIndex };
        updateCellSelectionVisuals();
      }
    });

    document.addEventListener('mouseup', function() {
      isMouseDown = false;
      if (isDragging) {
        window.justDragged = true;
        setTimeout(() => { window.justDragged = false; }, 50);
      }
      isDragging = false;
    });

    window.selectBOQRow = selectBOQRow;
    window.selectBOQRows = selectBOQRows;
    window.handleWorkCellMouseDown = handleWorkCellMouseDown;
    window.handleWorkCellMouseEnter = handleWorkCellMouseEnter;
    window.selectAnalysisRow = selectAnalysisRow;
    window.selectAnalysisRows = selectAnalysisRows;
    window.handleAnalysisCellMouseDown = handleAnalysisCellMouseDown;
    window.handleAnalysisCellMouseEnter = handleAnalysisCellMouseEnter;
    window.selectPriceListRow = selectPriceListRow;
    window.selectPriceListRows = selectPriceListRows;
    window.handlePriceListCellMouseDown = handlePriceListCellMouseDown;
    window.handlePriceListCellMouseEnter = handlePriceListCellMouseEnter;

    function indentSelectedBOQRow() {
      if (selectedBOQRowIndices.size === 0) {
        alert('Please select one or more Work Description cells in the Bill of Quantity table first.');
        return;
      }
      
      const sortedIndices = Array.from(selectedBOQRowIndices).sort((a, b) => a - b);
      let changed = false;
      
      sortedIndices.forEach(index => {
        const row = boqData[index];
        if (!row) return;
        if (row.type === 'category') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'subsubcategory';
          changed = true;
        } else if (row.type === 'subsubcategory') {
          row.type = 'subsubsubcategory';
          changed = true;
        }
      });
      
      if (changed) {
        markUnsaved();
        recomputeCodes(boqData);
        renderBOQTable();
        selectBOQRows(selectedBOQRowIndices);
      }
    }

    function outdentSelectedBOQRow() {
      if (selectedBOQRowIndices.size === 0) {
        alert('Please select one or more Work Description cells in the Bill of Quantity table first.');
        return;
      }
      
      const sortedIndices = Array.from(selectedBOQRowIndices).sort((a, b) => a - b);
      let changed = false;
      
      sortedIndices.forEach(index => {
        const row = boqData[index];
        if (!row) return;
        if (row.type === 'subsubsubcategory') {
          row.type = 'subsubcategory';
          changed = true;
        } else if (row.type === 'subsubcategory') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'category';
          changed = true;
        }
      });
      
      if (changed) {
        markUnsaved();
        recomputeCodes(boqData);
        renderBOQTable();
        selectBOQRows(selectedBOQRowIndices);
      }
    }

    function indentSelectedAnalysisRow() {
      if (selectedAnalysisRowIndices.size === 0) {
        alert('Please select one or more Work Description cells in the D.U.P.A. table first.');
        return;
      }
      const sortedIndices = Array.from(selectedAnalysisRowIndices).sort((a, b) => a - b);
      let changed = false;
      sortedIndices.forEach(index => {
        const row = analysisData[index];
        if (!row) return;
        if (row.type === 'category') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'subsubcategory';
          changed = true;
        }
      });
      if (changed) {
        markUnsaved();
        recomputeAnalysisCodes();
        renderAnalysisTable();
        selectAnalysisRows(selectedAnalysisRowIndices);
      }
    }

    function outdentSelectedAnalysisRow() {
      if (selectedAnalysisRowIndices.size === 0) {
        alert('Please select one or more Work Description cells in the D.U.P.A. table first.');
        return;
      }
      const sortedIndices = Array.from(selectedAnalysisRowIndices).sort((a, b) => a - b);
      let changed = false;
      sortedIndices.forEach(index => {
        const row = analysisData[index];
        if (!row) return;
        if (row.type === 'subsubcategory') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'category';
          changed = true;
        }
      });
      if (changed) {
        markUnsaved();
        recomputeAnalysisCodes();
        renderAnalysisTable();
        selectAnalysisRows(selectedAnalysisRowIndices);
      }
    }

    function indentSelectedPriceListRow() {
      if (selectedPriceListRowIndices.size === 0) {
        alert('Please select one or more Material List cells in the Price List table first.');
        return;
      }
      const sortedIndices = Array.from(selectedPriceListRowIndices).sort((a, b) => a - b);
      let changed = false;
      sortedIndices.forEach(index => {
        const row = priceListData[index];
        if (!row) return;
        if (row.type === 'category') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'material';
          changed = true;
        }
      });
      if (changed) {
        markUnsaved();
        recomputePriceListCodes();
        renderPriceListTable();
        selectPriceListRows(selectedPriceListRowIndices);
      }
    }

    function outdentSelectedPriceListRow() {
      if (selectedPriceListRowIndices.size === 0) {
        alert('Please select one or more Material List cells in the Price List table first.');
        return;
      }
      const sortedIndices = Array.from(selectedPriceListRowIndices).sort((a, b) => a - b);
      let changed = false;
      sortedIndices.forEach(index => {
        const row = priceListData[index];
        if (!row) return;
        if (row.type === 'material') {
          row.type = 'subcategory';
          changed = true;
        } else if (row.type === 'subcategory') {
          row.type = 'category';
          changed = true;
        }
      });
      if (changed) {
        markUnsaved();
        recomputePriceListCodes();
        renderPriceListTable();
        selectPriceListRows(selectedPriceListRowIndices);
      }
    }

    window.selectBOQRow = selectBOQRow;
    window.selectBOQRows = selectBOQRows;
    window.indentSelectedBOQRow = indentSelectedBOQRow;
    window.outdentSelectedBOQRow = outdentSelectedBOQRow;
    window.indentSelectedAnalysisRow = indentSelectedAnalysisRow;
    window.outdentSelectedAnalysisRow = outdentSelectedAnalysisRow;
    window.indentSelectedPriceListRow = indentSelectedPriceListRow;
    window.outdentSelectedPriceListRow = outdentSelectedPriceListRow;

    function buildWorkDescriptionCell(row, index, kind, childExists = false) {
      const indentClass = row.type === 'category' ? 'indent-1' : row.type === 'subcategory' ? 'indent-2' : row.type === 'subsubcategory' ? 'indent-3' : 'indent-4';
      const categoryOnchange = kind === 'analysis'
        ? `updateAnalysisField(${index}, 'title', this.value)`
        : `updateBOQCategorySelection(${index}, this.value)`;
      const textOnchange = kind === 'analysis'
        ? `updateAnalysisField(${index}, 'title', this.value)`
        : `updateBOQField(${index}, 'title', this.value)`;
      const toggleFunction = kind === 'analysis' ? 'toggleAnalysisRow' : 'toggleBOQRow';
      const toggleHtml = childExists && (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory')
        ? `<button class="toggle-btn ${row.collapsed ? 'collapsed' : ''}" type="button" onclick="${toggleFunction}(${index})" aria-label="Toggle row"></button>`
        : '';
      
      let inputHtml = '';
      if (row.type === 'category') {
        const selectHtml = buildCategorySelect(categoryOnchange, row.title);
        if (kind === 'boq') {
          inputHtml = selectHtml.replace('<select ', `<select onfocus="selectBOQRow(${index}, true)" `);
        } else if (kind === 'analysis') {
          inputHtml = selectHtml.replace('<select ', `<select onfocus="selectAnalysisRow(${index}, true)" `);
        } else {
          inputHtml = selectHtml;
        }
      } else {
        let focusAttr = '';
        if (kind === 'boq') {
          focusAttr = ` onfocus="selectBOQRow(${index}, true)"`;
        } else if (kind === 'analysis') {
          focusAttr = ` onfocus="selectAnalysisRow(${index}, true)"`;
        }
        let suffixHtml = '';
        if (kind === 'boq') {
          const condition = row.condition || 'CPM';
          if (condition !== 'CPM' && (condition === 'OSM' || condition === 'By other Contractor' || condition === 'Not included in Work')) {
            suffixHtml = `<span class="boq-desc-suffix" style="color: #ff0000; font-weight: bold; margin-left: 4px; font-style: normal; display: inline-block; white-space: nowrap;">(${condition})</span>`;
          }
        }
        inputHtml = `<input value="${escapeHtml(row.title)}" onchange="${textOnchange}"${focusAttr} placeholder="Work description">${suffixHtml}`;
      }
      return `<div class="inline-cell ${indentClass}" title="${escapeAttr(row.title || '')}">${toggleHtml}${inputHtml}</div>`;
    }

    function buildPriceListCategoryOptions(selectedValue) {
      const options = ['<option value="">Select category</option>'];
      priceListCategories.forEach(item => {
        options.push(`<option value="${escapeAttr(item)}" ${item === selectedValue ? 'selected' : ''}>${escapeHtml(item)}</option>`);
      });
      return options.join('');
    }

    function createPriceListCategoryRow(data = {}) {
      return {
        type: 'category',
        itemCode: '',
        mainCategory: data.mainCategory || '',
        subCategory: '',
        materialName: '',
        specification: '',
        unit: data.unit || '',
        pricePerUnit: 0,
        rentalPerUnit: 0,
        collapsed: !!data.collapsed
      };
    }

    function createPriceListSubCategoryRow(category, subCategory, data = {}) {
      return {
        type: 'subcategory',
        itemCode: '',
        mainCategory: category || '',
        subCategory: subCategory || '',
        materialName: '',
        specification: '',
        unit: data.unit || '',
        pricePerUnit: 0,
        rentalPerUnit: 0,
        collapsed: !!data.collapsed
      };
    }

    function createPriceListMaterialRow(mainCategory, subCategory, data = {}) {
      return {
        type: 'material',
        itemCode: '',
        mainCategory: mainCategory || '',
        subCategory: subCategory || '',
        materialName: data.materialName || '',
        specification: data.specification || '',
        unit: data.unit || '',
        pricePerUnit: data.pricePerUnit ?? 0,
        rentalPerUnit: data.rentalPerUnit ?? 0,
        dateUpdated: data.dateUpdated || ''
      };
    }

    function buildCategoryBlock(category, data = {}) {
      const block = [createPriceListCategoryRow({ ...data, mainCategory: category || '' })];
      const items = priceListSubCategories[category] || [];
      items.forEach(sub => block.push(createPriceListSubCategoryRow(category, sub)));
      return block;
    }

    function getCategoryBlockEnd(startIndex) {
      let end = startIndex + 1;
      while (end < priceListData.length && priceListData[end].type !== 'category') end += 1;
      return end;
    }

    function extractCategoryBlock(startIndex) {
      const end = getCategoryBlockEnd(startIndex);
      return priceListData.splice(startIndex, end - startIndex);
    }

    function insertCategoryBlockAtTop(block) {
      priceListData.unshift(...block);
    }

    function findCategoryIndexByName(category) {
      return priceListData.findIndex((row, idx) => row.type === 'category' && row.mainCategory === category);
    }

    function isBlankCategoryRow(index) {
      const row = priceListData[index];
      return row && row.type === 'category' && !row.mainCategory && !row.itemCode && getCategoryBlockEnd(index) === index + 1;
    }

    function addPriceListRow(data = {}) {
      markUnsaved();
      priceListData.unshift(createPriceListCategoryRow(data));
      renderPriceListTable();
    }

    function addPriceListRowAfter(index, data = {}) {
      markUnsaved();
      priceListData.unshift(createPriceListCategoryRow(data));
      renderPriceListTable();
    }

    function categoryBlockHasRows(index) {
      return index + 1 < priceListData.length && priceListData[index + 1].type !== 'category';
    }

    function populateSubCategoryRows(index, category) {
      const items = priceListSubCategories[category] || [];
      if (!items.length) return;
      if (categoryBlockHasRows(index)) return;
      let insertAt = index + 1;
      items.forEach(sub => {
        priceListData.splice(insertAt, 0, createPriceListSubCategoryRow(category, sub));
        insertAt += 1;
      });
    }

    function addPriceListMaterialRowBelow(index, data = {}) {
      markUnsaved();
      const base = priceListData[index];
      priceListData.splice(index + 1, 0, createPriceListMaterialRow(base.mainCategory, base.subCategory, data));
      renderPriceListTable();
    }

    function updatePriceListField(index, field, value) {
      markUnsaved();
      const row = priceListData[index];
      if (!row) return;

      if (row.type === 'category' && field === 'mainCategory') {
        const previousCategory = row.mainCategory;
        const selectedCategory = value;

        if (!selectedCategory) {
          row.mainCategory = '';
          renderPriceListTable();
          return;
        }

        if (selectedCategory === previousCategory) {
          const block = extractCategoryBlock(index);
          insertCategoryBlockAtTop(block);
          renderPriceListTable();
          return;
        }

        const existingIndex = findCategoryIndexByName(selectedCategory);
        if (existingIndex !== -1 && existingIndex !== index) {
          const existingBlock = extractCategoryBlock(existingIndex);
          if (isBlankCategoryRow(index)) {
            const adjustedIndex = existingIndex > index ? index : -1;
            if (adjustedIndex >= 0) {
              priceListData.splice(adjustedIndex, 1);
            } else if (index < priceListData.length && isBlankCategoryRow(index)) {
              priceListData.splice(index, 1);
            }
          }
          insertCategoryBlockAtTop(existingBlock);
          renderPriceListTable();
          return;
        }

        if (previousCategory) {
          const preservedBlock = JSON.parse(JSON.stringify(extractCategoryBlock(index)));
          const newBlock = buildCategoryBlock(selectedCategory);
          insertCategoryBlockAtTop(newBlock);
          priceListData.splice(newBlock.length, 0, ...preservedBlock);
          renderPriceListTable();
          return;
        }

        const currentBlock = extractCategoryBlock(index);
        const newBlock = buildCategoryBlock(selectedCategory);
        insertCategoryBlockAtTop(newBlock);
        renderPriceListTable();
        return;
      }

      row[field] = value;
      renderPriceListTable();
    }

    function removePriceListRow(index) {
      if (!confirmAction('Delete this Price List row? This action cannot be undone.')) return;
      markUnsaved();
      const row = priceListData[index];
      if (row.type === 'category') {
        let end = index + 1;
        while (end < priceListData.length && priceListData[end].type !== 'category') end += 1;
        priceListData.splice(index, end - index);
      } else {
        priceListData.splice(index, 1);
      }
      renderPriceListTable();
    }

    function togglePriceListCategory(index) {
      priceListData[index].collapsed = !priceListData[index].collapsed;
      renderPriceListTable();
    }

    function togglePriceListSubCategory(index) {
      priceListData[index].collapsed = !priceListData[index].collapsed;
      renderPriceListTable();
    }

    function renderPriceListTable() {
      recomputePriceListCodes();
      const tbody = document.querySelector('#priceListTable tbody');
      tbody.innerHTML = '';

      let priceListCategorySeen = false;

      priceListData.forEach((row, index) => {
        const shouldHide = shouldHideHierarchyRow(priceListData, index);

        if (shouldHide) {
          return;
        }

        if (row.type === 'category' && priceListCategorySeen) {
          appendSpacerRow(tbody, 9);
        }

        const tr = document.createElement('tr');
        tr.dataset.index = index;
        if (selectedPriceListRowIndices.has(index)) {
          tr.classList.add('selected-row');
        }
        if (row.type === 'category') {
          priceListCategorySeen = true;
          tr.className = 'row-category' + (tr.className ? ' ' + tr.className : '');
          const icon = row.collapsed ? '▸' : '▾';
          tr.innerHTML = `
            <td class="plus-cell"><button class="btn-secondary plus-btn" type="button" onclick="addPriceListRow()">+</button></td>
            <td class="number" style="text-align:center;">${escapeHtml(row.itemCode || '')}</td>
            <td class="work-cell${selectedPriceListRowIndices.has(index) ? ' selected-work-cell' : ''}" data-index="${index}" onmousedown="handlePriceListCellMouseDown(event, ${index})" onmouseenter="handlePriceListCellMouseEnter(event, ${index})">
              <div class="inline-cell">
                <button class="toggle-btn ${row.collapsed ? 'collapsed' : ''}" type="button" onclick="togglePriceListCategory(${index})" aria-label="Toggle category"></button>
                <select onfocus="selectPriceListRow(${index}, true)" onchange="updatePriceListField(${index}, 'mainCategory', this.value)">${buildPriceListCategoryOptions(row.mainCategory)}</select>
              </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td><button class="btn-danger btn-small" type="button" onclick="removePriceListRow(${index})">Delete</button></td>`;
        } else if (row.type === 'subcategory') {
          tr.className = 'row-subcategory' + (tr.className ? ' ' + tr.className : '');
          const icon = row.collapsed ? '▸' : '▾';
          tr.innerHTML = `
            <td class="plus-cell"><button class="btn-secondary plus-btn" type="button" onclick="addPriceListMaterialRowBelow(${index})">+</button></td>
            <td class="number" style="text-align:center;">${escapeHtml(row.itemCode || '')}</td>
            <td class="work-cell${selectedPriceListRowIndices.has(index) ? ' selected-work-cell' : ''}" data-index="${index}" onmousedown="handlePriceListCellMouseDown(event, ${index})" onmouseenter="handlePriceListCellMouseEnter(event, ${index})">
              <div class="inline-cell indent-2">
                <button class="toggle-btn ${row.collapsed ? 'collapsed' : ''}" type="button" onclick="togglePriceListSubCategory(${index})" aria-label="Toggle sub-category"></button>
                <span>${escapeHtml(row.subCategory)}</span>
              </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td><button class="btn-danger btn-small" type="button" onclick="removePriceListRow(${index})">Delete</button></td>`;
        } else {
          tr.className = 'row-subsubcategory' + (tr.className ? ' ' + tr.className : '');
          tr.innerHTML = `
            <td class="plus-cell"></td>
            <td class="number" style="text-align:center;">${escapeHtml(row.itemCode || '')}</td>
            <td class="work-cell${selectedPriceListRowIndices.has(index) ? ' selected-work-cell' : ''}" data-index="${index}" onmousedown="handlePriceListCellMouseDown(event, ${index})" onmouseenter="handlePriceListCellMouseEnter(event, ${index})">
              <div class="price-inline indent-3">
                <span class="subcat-label">${escapeHtml(row.subCategory)}</span>
                <input class="material-input" onfocus="selectPriceListRow(${index}, true)" value="${escapeHtml(row.materialName)}" onchange="updatePriceListField(${index}, 'materialName', this.value)" placeholder="Material input">
              </div>
            </td>
            <td><input value="${escapeHtml(row.specification)}" onchange="updatePriceListField(${index}, 'specification', this.value)" placeholder="Specification"></td>
            <td><input value="${escapeHtml(row.unit || '')}" onchange="updatePriceListField(${index}, 'unit', this.value)" placeholder="Unit"></td>
            <td><input class="number" type="text" value="${peso(row.pricePerUnit)}" onfocus="this.value = numberOrZero(row.pricePerUnit)" onblur="updatePriceListField(${index}, 'pricePerUnit', numberOrZero(this.value))"></td>
            <td><input class="number" type="text" value="${peso(row.rentalPerUnit)}" onfocus="this.value = numberOrZero(row.rentalPerUnit)" onblur="updatePriceListField(${index}, 'rentalPerUnit', numberOrZero(this.value))"></td>
            <td><input type="date" value="${escapeHtml(row.dateUpdated || '')}" onchange="updatePriceListField(${index}, 'dateUpdated', this.value)"></td>
            <td><button class="btn-danger btn-small" type="button" onclick="removePriceListRow(${index})">Delete</button></td>`;
        }
        tbody.appendChild(tr);
      });
      if (window.updateCellSelectionVisuals) window.updateCellSelectionVisuals();
    }

    function createAnalysisRow(type, data = {}) {
      return {
        type,
        title: data.title || '',
        specification: data.specification || '',
        qty: data.qty ?? 0,
        unit: data.unit || '',
        materialUnitCost: data.materialUnitCost ?? 0,
        laborUnitCost: data.laborUnitCost ?? 0,
        code: data.code || '',
        collapsed: !!data.collapsed
      };
    }

    function getAnalysisBlockEnd(startIndex) {
      let end = startIndex + 1;
      while (end < analysisData.length && analysisData[end].type !== 'category') end += 1;
      return end;
    }

    function extractAnalysisBlock(startIndex) {
      const end = getAnalysisBlockEnd(startIndex);
      return analysisData.splice(startIndex, end - startIndex);
    }

    function insertAnalysisBlockAtTop(block) {
      analysisData.unshift(...block);
    }

    function findAnalysisCategoryIndexByName(category) {
      return analysisData.findIndex((row) => row.type === 'category' && row.title === category);
    }

    function isBlankAnalysisCategoryRow(index) {
      const row = analysisData[index];
      return row && row.type === 'category' && !row.title && getAnalysisBlockEnd(index) === index + 1;
    }

    function addAnalysisCategoryRow(name = '') {
      markUnsaved();
      analysisData.unshift(createAnalysisRow('category', { title: name || '' }));
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function addAnalysisCategoryRowAfter(index, name = '') {
      markUnsaved();
      analysisData.unshift(createAnalysisRow('category', { title: name || '' }));
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function addAnalysisSubCategoryRow(parentIndex, name = '') {
      markUnsaved();
      const insertIndex = findInsertIndex(analysisData, parentIndex);
      analysisData.splice(insertIndex, 0, createAnalysisRow('subcategory', { title: name || '' }));
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function addAnalysisSubSubCategoryRow(parentIndex, name = '') {
      markUnsaved();
      const insertIndex = findInsertIndex(analysisData, parentIndex);
      analysisData.splice(insertIndex, 0, createAnalysisRow('subsubcategory', { title: name || '' }));
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function updateAnalysisField(index, field, value) {
      if (field === 'title' && value === '__manage_categories__') {
        renderAnalysisTable();
        openManageCategoriesModal();
        return;
      }
      markUnsaved();
      const row = analysisData[index];
      if (!row) return;

      if (row.type === 'category' && field === 'title') {
        const previousCategory = row.title;
        const selectedCategory = value;

        if (!selectedCategory) {
          row.title = '';
          renderAnalysisTable();
          return;
        }

        if (selectedCategory === previousCategory) {
          const block = extractAnalysisBlock(index);
          insertAnalysisBlockAtTop(block);
          recomputeAnalysisCodes();
          renderAnalysisTable();
          return;
        }

        const existingIndex = findAnalysisCategoryIndexByName(selectedCategory);
        if (existingIndex !== -1 && existingIndex !== index) {
          const existingBlock = extractAnalysisBlock(existingIndex);
          if (isBlankAnalysisCategoryRow(index)) {
            const adjustedIndex = existingIndex > index ? index : -1;
            if (adjustedIndex >= 0) {
              analysisData.splice(adjustedIndex, 1);
            } else if (index < analysisData.length && isBlankAnalysisCategoryRow(index)) {
              analysisData.splice(index, 1);
            }
          }
          insertAnalysisBlockAtTop(existingBlock);
          recomputeAnalysisCodes();
          renderAnalysisTable();
          return;
        }

        if (previousCategory) {
          const preservedBlock = JSON.parse(JSON.stringify(extractAnalysisBlock(index)));
          const newBlock = [createAnalysisRow('category', { title: selectedCategory })];
          insertAnalysisBlockAtTop(newBlock);
          analysisData.splice(newBlock.length, 0, ...preservedBlock);
          recomputeAnalysisCodes();
          renderAnalysisTable();
          return;
        }

        const currentBlock = extractAnalysisBlock(index);
        const newBlock = [createAnalysisRow('category', { title: selectedCategory })];
        insertAnalysisBlockAtTop(newBlock);
        recomputeAnalysisCodes();
        renderAnalysisTable();
        return;
      }

      row[field] = value;
      if (field === 'title') recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function removeAnalysisRow(index) {
      if (!confirmAction('Delete this D.U.P.A. row? This action cannot be undone.')) return;
      markUnsaved();
      const row = analysisData[index];
      if (row.type === 'category') {
        const end = getAnalysisBlockEnd(index);
        analysisData.splice(index, end - index);
      } else {
        analysisData.splice(index, 1);
      }
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }


    function normalizeMatchValue(value) {
      return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
    }

    function isEquipmentOrToolPriceListRow(row, analysisRow) {
      const values = [
        analysisRow && analysisRow.title,
        row && row.materialName,
        row && row.subCategory,
        row && row.mainCategory
      ].map(normalizeMatchValue);
      return values.some(value => value === 'equipment' || value === 'equipments' || value === 'tool' || value === 'tools' || value === 'equipments and tools');
    }

    function getLinkedPriceListMatch(analysisRow) {
      const title = normalizeMatchValue(analysisRow.title);
      const specification = normalizeMatchValue(analysisRow.specification);
      const unit = normalizeMatchValue(analysisRow.unit);
      if (!title || !specification) return null;

      const match = priceListData.find((row) => {
        if (row.type !== 'material') return false;
        const materialName = normalizeMatchValue(row.materialName);
        const rowSpec = normalizeMatchValue(row.specification);
        const rowUnit = normalizeMatchValue(row.unit);
        const unitMatches = !unit || !rowUnit || rowUnit === unit;
        return materialName === title && rowSpec === specification && unitMatches;
      });

      if (!match) return null;
      const isRental = isEquipmentOrToolPriceListRow(match, analysisRow);
      return {
        row: match,
        unit: match.unit || '',
        materialUnitCost: isRental ? null : numberOrZero(match.pricePerUnit),
        leUnitCost: isRental ? numberOrZero(match.rentalPerUnit) : null,
        isRental
      };
    }

    function getLinkedPriceListValue(analysisRow) {
      const match = getLinkedPriceListMatch(analysisRow);
      return match && match.materialUnitCost !== null ? match.materialUnitCost : null;
    }

    function getDUPADisplayUnitCosts(row, index) {
      const childExists = hasChildRow(analysisData, index);
      const linkedPriceListMatch = getLinkedPriceListMatch(row);
      const displayUnit = linkedPriceListMatch && linkedPriceListMatch.unit ? linkedPriceListMatch.unit : (row.unit || '');
      if (row.type === 'subcategory' && childExists) {
        const totals = computeGroupTotals(analysisData, index, false);
        const qty = numberOrZero(row.qty);
        return {
          unit: displayUnit,
          materialUnitCost: qty ? totals.material / qty : 0,
          leUnitCost: qty ? totals.lec / qty : 0
        };
      }
      return {
        unit: displayUnit,
        materialUnitCost: linkedPriceListMatch && linkedPriceListMatch.materialUnitCost !== null ? linkedPriceListMatch.materialUnitCost : numberOrZero(row.materialUnitCost),
        leUnitCost: linkedPriceListMatch && linkedPriceListMatch.leUnitCost !== null ? linkedPriceListMatch.leUnitCost : numberOrZero(row.laborUnitCost)
      };
    }

    function getLinkedDUPAMatch(boqRow) {
      const title = normalizeMatchValue(boqRow.title);
      const specification = normalizeMatchValue(boqRow.specification);
      const unit = normalizeMatchValue(boqRow.unit);
      if (!title || !specification || !unit) return null;

      for (let index = 0; index < analysisData.length; index += 1) {
        const row = analysisData[index];
        if (!row || row.type === 'category') continue;
        const display = getDUPADisplayUnitCosts(row, index);
        const rowTitle = normalizeMatchValue(row.title);
        const rowSpec = normalizeMatchValue(row.specification);
        const rowUnit = normalizeMatchValue(display.unit);
        if (rowTitle === title && rowSpec === specification && rowUnit === unit) {
          return {
            row,
            unit: display.unit || '',
            materialUnitCost: numberOrZero(display.materialUnitCost),
            leUnitCost: numberOrZero(display.leUnitCost)
          };
        }
      }
      return null;
    }

    function toggleAnalysisRow(index) {
      if (!analysisData[index]) return;
      const row = analysisData[index];
      const willExpand = !!row.collapsed;
      row.collapsed = !row.collapsed;

      if (willExpand) {
        let parentIndex = getParentRowIndex(analysisData, index);
        while (parentIndex !== -1) {
          analysisData[parentIndex].collapsed = false;
          parentIndex = getParentRowIndex(analysisData, parentIndex);
        }
      }

      renderAnalysisTable();
    }


    function computeRowCost(row, useBOQMultipliers = false) {
      if (useBOQMultipliers) {
        const values = computeBOQDisplayValues(row);
        return { material: values.totalMaterialCost, lec: values.totalLEC, grand: values.grandTotalCost };
      }
      const qty = numberOrZero(row.qty);
      const linkedPriceListMatch = getLinkedPriceListMatch(row);
      const materialUnitCost = linkedPriceListMatch && linkedPriceListMatch.materialUnitCost !== null ? linkedPriceListMatch.materialUnitCost : numberOrZero(row.materialUnitCost);
      const leUnitCost = linkedPriceListMatch && linkedPriceListMatch.leUnitCost !== null ? linkedPriceListMatch.leUnitCost : numberOrZero(row.laborUnitCost);
      const totalMaterialCost = qty * materialUnitCost;
      const totalLEC = qty * leUnitCost;
      return { material: totalMaterialCost, lec: totalLEC, grand: totalMaterialCost + totalLEC };
    }

    function computeGroupTotals(rows, parentIndex, useBOQMultipliers = false) {
      const parentLevel = levelOf(rows[parentIndex].type);
      let material = 0, lec = 0, grand = 0;
      let i = parentIndex + 1;
      while (i < rows.length && levelOf(rows[i].type) > parentLevel) {
        const child = rows[i];
        const childHasChildren = hasChildRow(rows, i);
        const childEditable = child.type === 'subsubsubcategory' || (child.type === 'subsubcategory' && !childHasChildren) || (child.type === 'subcategory' && !childHasChildren);
        if (childEditable) {
          const cost = computeRowCost(child, useBOQMultipliers);
          material += cost.material;
          lec += cost.lec;
          grand += cost.grand;
        }
        i += 1;
      }
      return { material, lec, grand };
    }


    function appendSpacerRow(tbody, columnCount) {
      const tr = document.createElement('tr');
      tr.className = 'row-spacer';
      let cellsHtml = '';
      for (let i = 0; i < columnCount; i++) {
        cellsHtml += '<td></td>';
      }
      tr.innerHTML = cellsHtml;
      tbody.appendChild(tr);
    }

    function appendTotalCostRow(tbody, label, totals, isBOQ = false) {
      const tr = document.createElement('tr');
      tr.className = 'row-total';
      if (isBOQ) {
        let cellsHtml = '';
        boqColumns.forEach(col => {
          if (!col.visible) return;
          if (col.id === 'title') {
            cellsHtml += `<td class="total-label">${escapeHtml(label)}</td>`;
          } else if (col.id === 'totalMaterialCost') {
            cellsHtml += `<td class="number">${peso(totals.material)}</td>`;
          } else if (col.id === 'totalLEC') {
            cellsHtml += `<td class="number">${peso(totals.lec)}</td>`;
          } else if (col.id === 'grandTotalCost') {
            cellsHtml += `<td class="number">${peso(totals.grand)}</td>`;
          } else {
            cellsHtml += '<td></td>';
          }
        });
        tr.innerHTML = cellsHtml;
      } else {
        tr.innerHTML = `
          <td></td>
          <td></td>
          <td class="total-label">${escapeHtml(label)}</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td class="number">${peso(totals.material)}</td>
          <td></td>
          <td class="number">${peso(totals.lec)}</td>
          <td class="number">${peso(totals.grand)}</td>
          <td></td>`;
      }
      tbody.appendChild(tr);
    }


    function appendBOQGrandTotalRow(tbody, totals) {
      const tr = document.createElement('tr');
      tr.className = 'row-total row-grand-total';
      let cellsHtml = '';
      boqColumns.forEach(col => {
        if (!col.visible) return;
        if (col.id === 'title') {
          cellsHtml += `<td class="total-label">Grand Total Cost</td>`;
        } else if (col.id === 'totalMaterialCost') {
          cellsHtml += `<td class="number">${peso(totals.material)}</td>`;
        } else if (col.id === 'totalLEC') {
          cellsHtml += `<td class="number">${peso(totals.lec)}</td>`;
        } else if (col.id === 'grandTotalCost') {
          cellsHtml += `<td class="number">${peso(totals.grand)}</td>`;
        } else {
          cellsHtml += '<td></td>';
        }
      });
      tr.innerHTML = cellsHtml;
      tbody.appendChild(tr);
    }

    function getHierarchyBlockEnd(rows, parentIndex) {
      if (parentIndex < 0 || parentIndex >= rows.length) return parentIndex + 1;
      const parentLevel = levelOf(rows[parentIndex].type);
      let end = parentIndex + 1;
      while (end < rows.length && levelOf(rows[end].type) > parentLevel) end += 1;
      return end;
    }

    function appendEndingTotalRows(rows, currentIndex, tbody, allowedTypes = ['category', 'subcategory']) {
      const endingParents = [];
      for (let parentIndex = 0; parentIndex < currentIndex; parentIndex += 1) {
        const parent = rows[parentIndex];
        if (!parent || !allowedTypes.includes(parent.type)) continue;
        if (!hasChildRow(rows, parentIndex) || parent.collapsed) continue;
        if (shouldHideHierarchyRow(rows, parentIndex)) continue;
        if (getHierarchyBlockEnd(rows, parentIndex) === currentIndex + 1) {
          endingParents.push(parentIndex);
        }
      }

      endingParents
        .sort((a, b) => levelOf(rows[b].type) - levelOf(rows[a].type))
        .forEach(parentIndex => {
          const parent = rows[parentIndex];
          const labelPrefix = parent.type === 'subsubcategory' ? 'Sub Total for' : 'Total Cost for';
          appendTotalCostRow(tbody, `${labelPrefix} ${parent.title || ''}`, computeGroupTotals(rows, parentIndex, rows === boqData), rows === boqData);
          
          const columnCount = rows === priceListData ? 9 : (rows === boqData ? boqColumns.filter(c => c.visible).length : 12);
          appendSpacerRow(tbody, columnCount);
        });
    }

    function renderAnalysisTable() {
      recomputeAnalysisCodes();
      const tbody = document.querySelector('#analysisTable tbody');
      tbody.innerHTML = '';
      let analysisCategorySeen = false;
      let previousVisibleAnalysisRowType = '';
      analysisData.forEach((row, index) => {
        if (shouldHideHierarchyRow(analysisData, index)) return;
        const qty = numberOrZero(row.qty);
        const linkedPriceListMatch = getLinkedPriceListMatch(row);
        const linkedMaterialUnitCost = linkedPriceListMatch && linkedPriceListMatch.materialUnitCost !== null ? linkedPriceListMatch.materialUnitCost : null;
        const linkedLEUnitCost = linkedPriceListMatch && linkedPriceListMatch.leUnitCost !== null ? linkedPriceListMatch.leUnitCost : null;
        const linkedUnit = linkedPriceListMatch && linkedPriceListMatch.unit ? linkedPriceListMatch.unit : '';
        const displayUnit = linkedUnit || row.unit;
        const materialUnitCost = linkedMaterialUnitCost !== null ? linkedMaterialUnitCost : numberOrZero(row.materialUnitCost);
        const leUnitCost = linkedLEUnitCost !== null ? linkedLEUnitCost : numberOrZero(row.laborUnitCost);
        let totalMaterialCost = qty * materialUnitCost;
        let totalLEC = qty * leUnitCost;
        let grandTotalCost = totalMaterialCost + totalLEC;
        let subcategoryDerivedMaterialUnitCost = null;
        let subcategoryDerivedLEUnitCost = null;
        const childExists = hasChildRow(analysisData, index);
        const rowEditable = row.type === 'subsubsubcategory' || (row.type === 'subsubcategory' && !childExists) || (row.type === 'subcategory' && !childExists);
        const isCategoryRow = row.type === 'category';
        const isSummarySubcategoryRow = row.type === 'subcategory' && childExists;
        const showSubcategoryUnit = row.type === 'subcategory';

        if (row.type === 'subcategory' && childExists) {
          totalMaterialCost = 0;
          totalLEC = 0;
          grandTotalCost = 0;
          let childIndex = index + 1;
          while (childIndex < analysisData.length && levelOf(analysisData[childIndex].type) > levelOf(row.type)) {
            const childRow = analysisData[childIndex];
            if (childRow.type === 'subsubcategory') {
              const childCost = computeRowCost(childRow);
              totalMaterialCost += childCost.material;
              totalLEC += childCost.lec;
              grandTotalCost += childCost.grand;
            }
            childIndex += 1;
          }
          subcategoryDerivedMaterialUnitCost = qty > 0 ? totalMaterialCost / qty : 0;
          subcategoryDerivedLEUnitCost = qty > 0 ? totalLEC / qty : 0;
        }

        const plusButtons = row.type === 'category'
          ? `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addAnalysisCategoryRowAfter(${index})">+</button><button class="btn-secondary plus-btn" type="button" onclick="addAnalysisSubCategoryRow(${index})">+</button></div>`
          : row.type === 'subcategory'
            ? `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addAnalysisSubSubCategoryRow(${index})">+</button></div>`
            : '';




        const tr = document.createElement('tr');
        tr.dataset.index = index;
        if (selectedAnalysisRowIndices.has(index)) {
          tr.classList.add('selected-row');
        }
        if (row.type === 'category') analysisCategorySeen = true;
        tr.className = row.type === 'category'
          ? 'row-category' + (tr.className ? ' ' + tr.className : '')
          : row.type === 'subcategory'
            ? `row-subcategory${childExists ? ' has-children' : ''}`
            : row.type === 'subsubcategory'
              ? `row-subsubcategory${childExists ? ' has-children' : ''}`
              : 'row-subsubsubcategory';
        tr.innerHTML = `
          <td class="plus-cell">${plusButtons}</td>
          <td class="number" style="text-align:center;">${escapeHtml(row.code || '')}</td>
          <td class="work-cell${selectedAnalysisRowIndices.has(index) ? ' selected-work-cell' : ''}" data-index="${index}" onmousedown="handleAnalysisCellMouseDown(event, ${index})" onmouseenter="handleAnalysisCellMouseEnter(event, ${index})">${buildWorkDescriptionCell(row, index, 'analysis', childExists)}</td>
          <td>${isCategoryRow ? '' : `<input value="${escapeHtml(row.specification || '')}" onchange="updateAnalysisField(${index}, 'specification', this.value)" placeholder="Specification">`}</td>
          <td>${isCategoryRow ? '' : `<input type="number" min="0" step="0.01" value="${row.qty}" style="text-align:center;" onchange="updateAnalysisField(${index}, 'qty', this.value)">`}</td>
          <td>${isCategoryRow ? '' : `<input value="${escapeHtml(displayUnit)}" onchange="updateAnalysisField(${index}, 'unit', this.value)" placeholder="Unit" ${linkedUnit ? 'readonly title="Linked from Price List"' : ''}>`}</td>
          <td>${isCategoryRow ? '' : isSummarySubcategoryRow ? `<input class="number" type="text" value="${peso(subcategoryDerivedMaterialUnitCost)}" readonly title="Formula: Total Material Cost of Subcategory / Qty" style="font-weight:700;color:#1d4ed8;">` : rowEditable ? `<input class="number" type="text" value="${peso(materialUnitCost)}" onfocus="this.value = numberOrZero(this.value)" onblur="updateAnalysisField(${index}, 'materialUnitCost', numberOrZero(this.value))" ${linkedMaterialUnitCost !== null ? 'readonly title="Linked from Price List Price per Unit"' : ''}>` : ''}</td>
          <td class="number" style="${isSummarySubcategoryRow ? 'font-weight:700;color:#1d4ed8;text-align:center;' : ''}">${isCategoryRow ? '' : isSummarySubcategoryRow ? `Amount per ${escapeHtml(displayUnit || '')}` : (rowEditable ? peso(totalMaterialCost) : '')}</td>
          <td>${isCategoryRow ? '' : isSummarySubcategoryRow ? `<input class="number" type="text" value="${peso(subcategoryDerivedLEUnitCost)}" readonly title="Formula: Total LEC of Subcategory / Qty" style="font-weight:700;color:#b45309;">` : rowEditable ? `<input class="number" type="text" value="${peso(leUnitCost)}" onfocus="this.value = numberOrZero(this.value)" onblur="updateAnalysisField(${index}, 'laborUnitCost', numberOrZero(this.value))" ${linkedLEUnitCost !== null ? 'readonly title="Linked from Price List Rental per Unit"' : ''}>` : ''}</td>
          <td class="number" style="${isSummarySubcategoryRow ? 'font-weight:700;color:#b45309;text-align:center;' : ''}">${isCategoryRow ? '' : isSummarySubcategoryRow ? `Amount per ${escapeHtml(displayUnit || '')}` : (rowEditable ? peso(totalLEC) : '')}</td>
          <td class="number">${(isCategoryRow || isSummarySubcategoryRow) ? '' : (rowEditable ? peso(grandTotalCost) : '')}</td>
          <td><button class="btn-danger btn-small" type="button" onclick="removeAnalysisRow(${index})">Delete</button></td>`;
        tbody.appendChild(tr);
        previousVisibleAnalysisRowType = row.type;

        appendEndingTotalRows(analysisData, index, tbody, ['subcategory']);
      });
      const analysisCountEl = document.getElementById('analysisCount');
      if (analysisCountEl) analysisCountEl.textContent = analysisData.length;
      if (window.updateCellSelectionVisuals) window.updateCellSelectionVisuals();
    }

    function addBOQCategoryRow(name = '') { addBOQCategoryRowAtTop(name); }
    function addBOQCategoryRowAfter(index, name = '') {
      markUnsaved();
      boqData.splice(index + 1, 0, createBOQCategoryRow(name));
      recomputeCodes(boqData);
      renderBOQTable();
    }
    function addBOQSubCategoryRow(parentIndex, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, parentIndex); boqData.splice(insertIndex, 0, { type: 'subcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function addBOQSubCategoryRowAfter(index, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, index); boqData.splice(insertIndex, 0, { type: 'subcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function addBOQSubSubCategoryRow(parentIndex, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, parentIndex); boqData.splice(insertIndex, 0, { type: 'subsubcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function addBOQSubSubCategoryRowAfter(index, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, index); boqData.splice(insertIndex, 0, { type: 'subsubcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function addBOQSubSubSubCategoryRow(parentIndex, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, parentIndex); boqData.splice(insertIndex, 0, { type: 'subsubsubcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function addBOQSubSubSubCategoryRowAfter(index, name = '') { markUnsaved(); const insertIndex = findInsertIndex(boqData, index); boqData.splice(insertIndex, 0, { type: 'subsubsubcategory', title: name || '', qty: 0, unit: '', materialUnitCost: 0, laborUnitCost: 0, code: '', collapsed: false, condition: 'CPM' }); recomputeCodes(boqData); renderBOQTable(); }
    function updateBOQField(index, field, value) {
      markUnsaved();
      if (!boqData[index]) return;
      boqData[index][field] = value;

      // Do not re-render while typing in the BOQ Specification textarea.
      // Re-rendering replaces the active textarea node and causes the cursor
      // to lose focus after each character, forcing repeated clicks.
      if (field === 'specification') {
        return;
      }

      renderBOQTable();
    }
    function removeBOQRow(index) { if (!confirmAction('Delete this BOQ row? This action cannot be undone.')) return; markUnsaved(); boqData.splice(index, 1); recomputeCodes(boqData); renderBOQTable(); }

    function toggleBOQRow(index) {
      if (!boqData[index]) return;
      const row = boqData[index];
      const willExpand = !!row.collapsed;
      row.collapsed = !row.collapsed;

      if (willExpand) {
        let parentIndex = getParentRowIndex(boqData, index);
        while (parentIndex !== -1) {
          boqData[parentIndex].collapsed = false;
          parentIndex = getParentRowIndex(boqData, parentIndex);
        }
      }

      renderBOQTable();
    }

    function areAllBOQParentRowsCollapsed() {
      const parentRows = boqData.filter((row, index) => (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory') && hasChildRow(boqData, index));
      return parentRows.length > 0 && parentRows.every(row => !!row.collapsed);
    }

    function toggleAllBOQRows() {
      const collapseAll = !areAllBOQParentRowsCollapsed();
      boqData.forEach((row, index) => {
        if ((row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory') && hasChildRow(boqData, index)) {
          row.collapsed = collapseAll;
        }
      });
      renderBOQTable();
    }

    function updateBOQMasterToggleButton() {
      const btn = document.getElementById('boqMasterToggle');
      if (!btn) return;
      const hasParents = boqData.some((row, index) => (row.type === 'category' || row.type === 'subcategory' || row.type === 'subsubcategory') && hasChildRow(boqData, index));
      const allCollapsed = areAllBOQParentRowsCollapsed();
      btn.classList.toggle('collapsed', allCollapsed);
      btn.disabled = !hasParents;
      btn.title = allCollapsed ? 'Expand all BOQ rows' : 'Collapse all BOQ rows';
    }

    function autoResizeTextarea(el) {
      // No-op: Specification column now uses standard input elements
    }

    function resizeAllBOQSpecificationTextareas() {
      // No-op: Specification column now uses standard input elements
    }

    function getConditionColor(value) {
      if (!value) return 'inherit';
      const val = value.trim().toLowerCase();
      if (val === 'osm' || val === 'by other contractor' || val === 'not included in work') {
        return '#ff0000';
      }
      return 'inherit';
    }

    function setupBOQHeaderListeners() {
      const theadTr = document.querySelector('#boqTable thead tr');
      if (!theadTr) return;
      if (theadTr.dataset.listenersAttached) return;
      theadTr.dataset.listenersAttached = 'true';
      
      theadTr.addEventListener('mousedown', (e) => {
        const resizer = e.target.closest('.boq-col-resizer');
        if (resizer) {
          e.preventDefault();
          e.stopPropagation();
          
          const th = resizer.closest('th');
          const colId = th.dataset.colId;
          const col = boqColumns.find(c => c.id === colId);
          if (!col) return;
          
          const startX = e.clientX;
          let startWidth = parseInt(col.width, 10);
          if (isNaN(startWidth)) {
            startWidth = th.offsetWidth;
          }
          
          const onMouseMove = (moveEvent) => {
            const deltaX = moveEvent.clientX - startX;
            const newWidth = Math.max(30, startWidth + deltaX);
            col.width = newWidth + 'px';
            th.style.width = newWidth + 'px';
            if (col.id === 'title') {
              th.style.minWidth = newWidth + 'px';
            }
          };
          
          const onMouseUp = () => {
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            localStorage.setItem('cost_estimate_boq_columns_v1', JSON.stringify(boqColumns));
            renderBOQTable();
          };
          
          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        }
      });
    }

    function renderBOQHeaders() {
      const theadTr = document.querySelector('#boqTable thead tr');
      if (!theadTr) return;
      theadTr.innerHTML = '';
      boqColumns.forEach(col => {
        if (!col.visible) return;
        const th = document.createElement('th');
        th.style.position = 'relative';
        th.dataset.colId = col.id;
        
        let w = col.width;
        if (typeof w === 'number') {
          th.style.width = w + 'px';
        } else {
          th.style.width = w;
        }
        
        if (col.id === 'title') {
          th.style.minWidth = typeof w === 'number' ? w + 'px' : w;
          th.innerHTML = `<button id="boqMasterToggle" class="toggle-btn" type="button" onclick="toggleAllBOQRows()" aria-label="Collapse or expand all BOQ rows"></button> ${col.name}`;
        } else {
          th.textContent = col.name;
        }
        
        const resizer = document.createElement('div');
        resizer.className = 'boq-col-resizer';
        resizer.style.position = 'absolute';
        resizer.style.right = '0';
        resizer.style.top = '0';
        resizer.style.width = '6px';
        resizer.style.cursor = 'col-resize';
        resizer.style.zIndex = '2';
        th.appendChild(resizer);
        
        theadTr.appendChild(th);
      });
      updateBOQMasterToggleButton();
      setupBOQHeaderListeners();
    }

    function renderBOQTable() {
      clearBOQCaches();
      renderBOQHeaders();
      const tbody = document.querySelector('#boqTable tbody');
      tbody.innerHTML = '';
      const fragment = document.createDocumentFragment();
      let sumMaterialCost = 0, sumLEC = 0, sumGrandTotal = 0;
      let boqCategorySeen = false;
      let previousVisibleBOQRowType = '';
      boqData.forEach((row, index) => {
        if (shouldHideHierarchyRow(boqData, index)) return;
        const boqValues = computeBOQDisplayValues(row);
        const qty = boqValues.qty;
        const linkedMaterialUnitCost = boqValues.linkedMaterialUnitCost;
        const materialUnitCost = boqValues.materialUnitCost;
        const leUnitCost = boqValues.leUnitCost;
        const totalMaterialCost = boqValues.totalMaterialCost;
        const totalLEC = boqValues.totalLEC;
        const grandTotalCost = boqValues.grandTotalCost;
        const childExists = hasChildRow(boqData, index);
        const currentCondition = row.condition || 'CPM';
        const rowEditable = row.type === 'subsubsubcategory' || (row.type === 'subsubcategory' && !childExists) || (row.type === 'subcategory' && !childExists);
        if (rowEditable) { sumMaterialCost += totalMaterialCost; sumLEC += totalLEC; sumGrandTotal += grandTotalCost; }

        const tr = document.createElement('tr');
        tr.dataset.index = index;
        if (selectedBOQRowIndices.has(index)) {
          tr.classList.add('selected-row');
        }
        if (row.type === 'category') boqCategorySeen = true;
        tr.className = row.type === 'category'
          ? 'row-category' + (tr.className ? ' ' + tr.className : '')
          : row.type === 'subcategory'
            ? `row-subcategory${childExists ? ' has-children' : ''}`
            : row.type === 'subsubcategory'
              ? `row-subsubcategory${childExists ? ' has-children' : ''}`
              : 'row-subsubsubcategory';

        let rowHtml = '';
        boqColumns.forEach(col => {
          if (!col.visible) return;
          
          switch (col.id) {
            case 'plus':
              const plusButtons = row.type === 'category'
                ? `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addBOQCategoryRowAfter(${index})" title="Add Category">+</button><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubCategoryRow(${index})" title="Add Subcategory">+</button></div>`
                : row.type === 'subcategory'
                  ? `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubCategoryRowAfter(${index})" title="Add Sibling Subcategory">+</button><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubSubCategoryRow(${index})" title="Add Child Sub-subcategory">+</button></div>`
                  : row.type === 'subsubcategory'
                    ? `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubSubCategoryRowAfter(${index})" title="Add Sibling Sub-subcategory">+</button><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubSubSubCategoryRow(${index})" title="Add Item">+</button></div>`
                    : `<div class="work-actions"><button class="btn-secondary plus-btn" type="button" onclick="addBOQSubSubSubCategoryRowAfter(${index})" title="Add Item">+</button></div>`;
              rowHtml += `<td class="plus-cell">${plusButtons}</td>`;
              break;
              
            case 'code':
              rowHtml += `<td class="number" style="text-align:center;">${escapeHtml(row.code || '')}</td>`;
              break;
              
            case 'title':
              rowHtml += `<td class="work-cell${selectedBOQRowIndices.has(index) ? ' selected-work-cell' : ''}" data-index="${index}" onmousedown="handleWorkCellMouseDown(event, ${index})" onmouseenter="handleWorkCellMouseEnter(event, ${index})">${buildWorkDescriptionCell(row, index, 'boq', childExists)}</td>`;
              break;
              
            case 'specification':
              rowHtml += `<td class="boq-specification-cell">${rowEditable ? `<input class="boq-specification-input" value="${escapeHtml(row.specification || '')}" onchange="updateBOQField(${index}, 'specification', this.value)" placeholder="Specification">` : ''}</td>`;
              break;
              
            case 'qty':
              rowHtml += `<td>${(row.type === 'category' || ((row.type === 'subcategory' || row.type === 'subsubcategory') && childExists)) ? '' : `<input type="text" value="${qty}" style="text-align:center;" onfocus="this.value = numberOrZero(boqData[${index}].qty)" onblur="updateBOQField(${index}, 'qty', numberOrZero(this.value))">`}</td>`;
              break;
              
            case 'unit':
              rowHtml += `<td style="position: relative;">${rowEditable ? `${!boqValues.linkedUnit ? '<span class="manual-indicator">*</span>' : ''}<input value="${escapeHtml(boqValues.linkedUnit || row.unit)}" onchange="updateBOQField(${index}, 'unit', this.value)" placeholder="Unit" ${boqValues.linkedUnit ? 'readonly title="Linked from D.U.P.A."' : ''}>` : ''}</td>`;
              break;
              
            case 'materialUnitCost':
              rowHtml += `<td class="number" style="position: relative;">${rowEditable ? `${linkedMaterialUnitCost === null ? '<span class="manual-indicator">*</span>' : ''}<input class="number" type="text" value="${peso(materialUnitCost)}" onfocus="this.value = numberOrZero(boqData[${index}].materialUnitCost)" onblur="updateBOQField(${index}, 'materialUnitCost', numberOrZero(this.value))" ${linkedMaterialUnitCost !== null ? 'readonly title="Linked from D.U.P.A. Material Unit Cost"' : ''}>` : ''}</td>`;
              break;
              
            case 'totalMaterialCost':
              rowHtml += `<td class="number">${rowEditable ? peso(totalMaterialCost) : ''}</td>`;
              break;
              
            case 'leUnitCost':
              rowHtml += `<td class="number" style="position: relative;">${rowEditable ? `${boqValues.linkedLEUnitCost === null ? '<span class="manual-indicator">*</span>' : ''}<input class="number" type="text" value="${peso(leUnitCost)}" onfocus="this.value = numberOrZero(boqData[${index}].laborUnitCost)" onblur="updateBOQField(${index}, 'laborUnitCost', numberOrZero(this.value))" ${boqValues.linkedLEUnitCost !== null ? 'readonly title="Linked from D.U.P.A. LE Unit Cost"' : ''}>` : ''}</td>`;
              break;
              
            case 'totalLEC':
              rowHtml += `<td class="number">${rowEditable ? peso(totalLEC) : ''}</td>`;
              break;
              
            case 'grandTotalCost':
              rowHtml += `<td class="number">${rowEditable ? peso(grandTotalCost) : ''}</td>`;
              break;
              
            case 'condition':
              rowHtml += `<td style="color: ${getConditionColor(currentCondition)}; text-align: center;">${rowEditable ? `
                <select class="boq-condition-select" style="color: inherit; text-align: center; text-align-last: center; width: 100%; border: none; background: transparent; font-family: inherit; font-size: inherit; font-style: inherit; font-weight: inherit;" onchange="updateBOQField(${index}, 'condition', this.value)">
                  <option value="CPM" style="color: black;" ${currentCondition === 'CPM' ? 'selected' : ''}>CPM</option>
                  <option value="OSM" style="color: #ff0000;" ${currentCondition === 'OSM' ? 'selected' : ''}>OSM</option>
                  <option value="By other Contractor" style="color: #ff0000;" ${currentCondition === 'By other Contractor' ? 'selected' : ''}>By other Contractor</option>
                  <option value="Not included in Work" style="color: #ff0000;" ${currentCondition === 'Not included in Work' ? 'selected' : ''}>Not included in Work</option>
                </select>
              ` : ''}</td>`;
              break;
              
            case 'action':
              rowHtml += `<td class="action-cell"><button class="btn-danger btn-small" type="button" onclick="removeBOQRow(${index})">Delete</button></td>`;
              break;
          }
        });
        tr.innerHTML = rowHtml;
        fragment.appendChild(tr);
        previousVisibleBOQRowType = row.type;

        appendEndingTotalRows(boqData, index, fragment, ['category', 'subcategory', 'subsubcategory']);
      });
      appendBOQGrandTotalRow(fragment, { material: sumMaterialCost, lec: sumLEC, grand: sumGrandTotal });
      tbody.appendChild(fragment);
      const sumMaterialCostEl = document.getElementById('sumMaterialCost');
      if (sumMaterialCostEl) sumMaterialCostEl.textContent = money(sumMaterialCost);
      const sumLaborEquipmentCostEl = document.getElementById('sumLaborEquipmentCost');
      if (sumLaborEquipmentCostEl) sumLaborEquipmentCostEl.textContent = money(sumLEC);
      const sumGrandTotalEl = document.getElementById('sumGrandTotal');
      if (sumGrandTotalEl) sumGrandTotalEl.textContent = money(sumGrandTotal);
      const boqCountEl = document.getElementById('boqCount');
      if (boqCountEl) boqCountEl.textContent = boqData.length;
      const summaryMaterialEl = document.getElementById('summaryMaterial');
      if (summaryMaterialEl) summaryMaterialEl.textContent = money(sumMaterialCost);
      const summaryGrandEl = document.getElementById('summaryGrand');
      if (summaryGrandEl) summaryGrandEl.textContent = money(sumGrandTotal);
      document.querySelectorAll('#boqTable textarea.boq-specification-input').forEach(autoResizeTextarea);
      updateBOQMasterToggleButton();
      renderBOQSummaryTable();
      if (window.updateCellSelectionVisuals) window.updateCellSelectionVisuals();
    }

    function clearAllData() {
      if (!confirmAction('Clear all data from Price List, D.U.P.A., and BOQ? This action cannot be undone.')) return;
      markUnsaved();
      priceListData.length = 0; analysisData.length = 0; boqData.length = 0;
      localStorage.removeItem('cost_estimate_gantt_start_v1');
      const startInput = document.getElementById('ganttProjectStartInput');
      if (startInput) startInput.value = '';
      renderPriceListTable(); renderAnalysisTable(); renderBOQTable(); renderBOQSummaryTable(); showSheet('priceListSheet');
    }
    const APP_STORAGE_KEYS = {
      priceList: 'cost_estimate_price_list_section_v1',
      dupa: 'cost_estimate_dupa_section_v1',
      boq: 'cost_estimate_boq_section_v1',
      cover: 'cost_estimate_cover_letter_section_v1'
    };

    function getElementValue(id) {
      const el = document.getElementById(id);
      if (!el) return '';
      return ('value' in el) ? el.value : (el.textContent || '');
    }

    function setElementValue(id, value) {
      const el = document.getElementById(id);
      if (!el) return;
      if ('value' in el) el.value = value ?? '';
      else el.textContent = value ?? '';
    }

    function collectValuesById(ids) {
      const values = {};
      ids.forEach(id => { values[id] = getElementValue(id); });
      return values;
    }

    function applyValuesById(values = {}) {
      Object.keys(values || {}).forEach(id => setElementValue(id, values[id]));
    }

    function isRemovedProposalSubtitle(value) {
      const textValue = String(value || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/gi, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
      const removedWords = ['construction','cost','proposal','based','on','the','summary','of','bill','of'];
      const base = removedWords.join(' ');
      return textValue === base + ' quantity' ||
             textValue === base + ' quantities' ||
             textValue === '' ||
             textValue === '';
    }

    function sanitizeCoverEditableValues(values = []) {
      return Array.isArray(values) ? values.filter(value => !isRemovedProposalSubtitle(value)) : [];
    }

    function cleanRemovedProposalSubtitleFromDom() {
      document.querySelectorAll('#coverLetterSheet [contenteditable="true"]').forEach(el => {
        if (isRemovedProposalSubtitle(el.innerHTML) || isRemovedProposalSubtitle(el.textContent)) {
          el.remove();
        }
      });
    }

    function collectEditableHtml(selector) {
      const values = Array.from(document.querySelectorAll(selector)).map(el => el.innerHTML);
      return selector && selector.indexOf('#coverLetterSheet') !== -1 ? sanitizeCoverEditableValues(values) : values;
    }

    function applyEditableHtml(selector, values = []) {
      const safeValues = selector && selector.indexOf('#coverLetterSheet') !== -1 ? sanitizeCoverEditableValues(values) : values;
      Array.from(document.querySelectorAll(selector)).forEach((el, index) => {
        if (safeValues && safeValues[index] !== undefined) el.innerHTML = safeValues[index];
      });
      if (selector && selector.indexOf('#coverLetterSheet') !== -1) cleanRemovedProposalSubtitleFromDom();
    }

    function collectReviewTableValues() {
      return Array.from(document.querySelectorAll('#boqReviewTable tbody tr')).map(row => {
        const fields = Array.from(row.querySelectorAll('input, textarea, select'));
        return fields.map(field => field.value);
      });
    }

    function applyReviewTableValues(values = []) {
      Array.from(document.querySelectorAll('#boqReviewTable tbody tr')).forEach((row, rowIndex) => {
        const fields = Array.from(row.querySelectorAll('input, textarea, select'));
        fields.forEach((field, fieldIndex) => {
          if (values && values[rowIndex] && values[rowIndex][fieldIndex] !== undefined) {
            field.value = values[rowIndex][fieldIndex];
          }
        });
      });
    }

    function cloneData(value) {
      return JSON.parse(JSON.stringify(value));
    }

    function getPriceListPayload() {
      return { priceListData: cloneData(priceListData) };
    }

    function getDUPAPayload() {
      return { analysisData: cloneData(analysisData) };
    }

    function getBOQPayload() {
      return {
        boqData: cloneData(boqData),
        projectFields: collectValuesById(['projectName', 'projectLocation', 'documentNo', 'clientName', 'preparedBy', 'proposalDate', 'projectSubject']),
        multiplierFields: collectValuesById(['boqQtyMultiplier', 'boqMaterialMultiplier', 'boqLEMultiplier', 'boqProfitMultiplier', 'boqOverheadMultiplier', 'boqTaxMultiplier']),
        summaryFields: collectValuesById(['boqSummaryArea']),
        signatureFields: collectValuesById(['submittedBySignatureName', 'submittedByPosition', 'acceptedBySignatureName', 'acceptedByPosition']),
        signatureEdited: {
          submittedBySignatureName: document.getElementById('submittedBySignatureName')?.dataset.edited || '',
          acceptedBySignatureName: document.getElementById('acceptedBySignatureName')?.dataset.edited || ''
        },
        reviewTable: collectReviewTableValues(),
        ganttSummaryCellFunctions: ganttSummaryCellFunctions,
        ganttSummaryFormulas: ganttSummaryFormulas
      };
    }

    function getCoverPayload() {
      return {
        coverFields: collectValuesById([
          'coverPaymentTerms', 'coverQuotationDuration', 'coverProjectDuration', 'coverSpecialConditions',
          'coverExcludedItems', 'coverClientMaterials', 'coverOtherContractors', 'coverSubmittedBy',
          'coverSubmittedPosition', 'coverAcceptedBy', 'coverAcceptedPosition',
          'coverDocTitle', 'coverDocNo', 'coverRevNo', 'coverEffectiveDate',
          'sbCoverPaperSize', 'sbCoverOrientation',
          'coverKeyDeliverables', 'coverMethodologies',
          'sbCoverDurationDays', 'sbCoverWorkingDays', 'sbCoverDurationBasis',
          'coverAttachedDocuments'
        ]),
        editableHtml: collectEditableHtml('.cover-letter-page [contenteditable="true"]'),
        attachments: coverAttachments,
        printScope: document.getElementById('sbCoverPrintScope')?.value || 'all'
      };
    }

    function getSectionPayload(section) {
      if (section === 'priceList') return getPriceListPayload();
      if (section === 'dupa') return getDUPAPayload();
      if (section === 'boq') return getBOQPayload();
      if (section === 'cover') return getCoverPayload();
      return null;
    }

    function sectionLabel(section) {
      return {
        priceList: 'Price List',
        dupa: 'D.U.P.A.',
        boq: 'BOQ',
        cover: 'Cover Letter'
      }[section] || 'Section';
    }

    function sectionFileName(section) {
      const label = sectionLabel(section).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const today = new Date().toISOString().slice(0, 10);
      return `${label}-${today}.json`;
    }


    function plainTextFromHtml(value) {
      const tmp = document.createElement('div');
      tmp.innerHTML = String(value ?? '');
      return (tmp.textContent || tmp.innerText || '').trim();
    }

    function excelEscape(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function parseExcelNumber(value) {
      const cleaned = String(value ?? '').replace(/[₱,\s]/g, '').replace(/[^0-9.\-]/g, '');
      const parsed = parseFloat(cleaned);
      return Number.isFinite(parsed) ? parsed : 0;
    }

    function buildBOQExcelRows() {
      return boqData.map((row, index) => {
        const computed = computeBOQDisplayValues(row);
        const childExists = hasChildRow(boqData, index);
        const rowEditable = row.type === 'subsubsubcategory' || (row.type === 'subsubcategory' && !childExists) || (row.type === 'subcategory' && !childExists);
        const groupTotals = !rowEditable && row.type !== 'category' ? computeGroupTotals(boqData, index, true) : null;
        
        let title = row.title || '';
        if (rowEditable) {
          const cond = row.condition || 'CPM';
          if (cond !== 'CPM' && (cond === 'OSM' || cond === 'By other Contractor' || cond === 'Not included in Work')) {
            title += ` (${cond})`;
          }
        }
        
        return {
          type: row.type || '',
          code: row.code || '',
          title: title,
          specification: row.specification || '',
          qty: rowEditable ? computed.qty : '',
          unit: rowEditable ? (computed.linkedUnit || row.unit || '') : '',
          materialUnitCost: rowEditable ? computed.materialUnitCost : '',
          totalMaterialCost: rowEditable ? computed.totalMaterialCost : (groupTotals ? groupTotals.material : ''),
          leUnitCost: rowEditable ? computed.leUnitCost : '',
          totalLEC: rowEditable ? computed.totalLEC : (groupTotals ? groupTotals.lec : ''),
          grandTotalCost: rowEditable ? computed.grandTotalCost : (groupTotals ? groupTotals.grand : ''),
          condition: rowEditable ? (row.condition || 'CPM') : ''
        };
      });
    }

    function exportBOQAsXLSX(config, formatted = false) {
      if (typeof XLSX === 'undefined') return false;
      const headers = config.headers;
      const aoa = [headers];
      config.rows.forEach(row => {
        const qty = numberOrZero(row.qty);
        const materialUnitCost = numberOrZero(row.materialUnitCost);
        const leUnitCost = numberOrZero(row.leUnitCost);
        const totalMaterialCost = numberOrZero(row.totalMaterialCost) || (qty && materialUnitCost ? qty * materialUnitCost : 0);
        const totalLEC = numberOrZero(row.totalLEC) || (qty && leUnitCost ? qty * leUnitCost : 0);
        const grandTotalCost = numberOrZero(row.grandTotalCost) || (totalMaterialCost + totalLEC);
        aoa.push([
          row.type || '', row.code || '', row.title || '', row.specification || '',
          row.qty === '' ? '' : qty, row.unit || '',
          row.materialUnitCost === '' ? '' : materialUnitCost,
          totalMaterialCost || '',
          row.leUnitCost === '' ? '' : leUnitCost,
          totalLEC || '',
          grandTotalCost || '',
          row.condition || ''
        ]);
      });
      const worksheet = XLSX.utils.aoa_to_sheet(aoa);
      worksheet['!cols'] = [
        { wch: 18 }, { wch: 14 }, { wch: 36 }, { wch: 26 }, { wch: 10 }, { wch: 10 },
        { wch: 18 }, { wch: 20 }, { wch: 16 }, { wch: 16 }, { wch: 18 }, { wch: 18 }
      ];
      const range = XLSX.utils.decode_range(worksheet['!ref']);
      for (let R = 1; R <= range.e.r; ++R) {
        [4, 6, 7, 8, 9, 10].forEach(C => {
          const addr = XLSX.utils.encode_cell({ r: R, c: C });
          if (worksheet[addr] && worksheet[addr].v !== '') {
            worksheet[addr].t = 'n';
            worksheet[addr].z = '#,##0.00';
          }
        });
      }
      const workbook = XLSX.utils.book_new();
      workbook.Props = { Title: 'Bill of Quantity', Subject: 'BOQ export compatible with BOQ Excel import', CreatedDate: new Date() };
      XLSX.utils.book_append_sheet(workbook, worksheet, 'BOQ');
      XLSX.writeFile(workbook, sectionSafeFileName('boq') + '-boq-' + new Date().toISOString().slice(0, 10) + '.xlsx');
      return true;
    }

    function exportBOQToExcel() {
      if (!boqData.length) {
        alert('There is no BOQ data to export.');
        return;
      }
      const headers = ['Type', 'Item Code', 'Work Description', 'Specification', 'Qty', 'Unit', 'Material Unit Cost', 'Total Material Cost', 'LE Unit Cost', 'Total LEC', 'Grand Total Cost', 'Condition'];
      const rows = buildBOQExcelRows();
      const tableRows = [
        '<tr>' + headers.map(header => '<th>' + excelEscape(header) + '</th>').join('') + '</tr>',
        ...rows.map(row => '<tr>' + [
          row.type,
          row.code,
          row.title,
          row.specification,
          row.qty,
          row.unit,
          row.materialUnitCost,
          row.totalMaterialCost,
          row.leUnitCost,
          row.totalLEC,
          row.grandTotalCost,
          row.condition
        ].map(value => '<td>' + excelEscape(value) + '</td>').join('') + '</tr>')
      ].join('\n');
      const projectName = getElementValue('projectName') || 'BOQ';
      const html = '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>table{border-collapse:collapse;font-family:Arial,sans-serif;font-size:11pt;}th,td{border:1px solid #999;padding:4px 6px;}th{background:#e6f2fb;font-weight:700;}</style></head><body><table>' + tableRows + '</table></body></html>';
      const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const safeName = String(projectName).trim().replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '') || 'boq';
      link.href = url;
      link.download = safeName + '-boq-' + new Date().toISOString().slice(0, 10) + '.xls';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function openBOQExcelFile() {
      const input = document.getElementById('boqExcelFileInput');
      if (!input) return;
      input.dataset.section = 'boq';
      input.value = '';
      input.click();
    }

    function inferBOQTypeFromCode(code) {
      const parts = String(code || '').split('.').map(s => s.trim()).filter(s => s && s !== '00' && s !== '0');
      if (parts.length <= 1) return 'category';
      if (parts.length === 2) return 'subcategory';
      if (parts.length === 3) return 'subsubcategory';
      return 'subsubsubcategory';
    }

    function normalizeBOQHeader(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    function findBOQHeaderIndex(headers, aliases) {
      const normalizedHeaders = headers.map(normalizeBOQHeader);
      for (const alias of aliases) {
        const normalizedAlias = normalizeBOQHeader(alias);
        const exactIndex = normalizedHeaders.findIndex(header => header === normalizedAlias);
        if (exactIndex >= 0) return exactIndex;
      }
      for (const alias of aliases) {
        const normalizedAlias = normalizeBOQHeader(alias);
        const looseIndex = normalizedHeaders.findIndex(header => header && (header.includes(normalizedAlias) || normalizedAlias.includes(header)));
        if (looseIndex >= 0) return looseIndex;
      }
      return -1;
    }

    function normalizeBOQType(value, code, title, rowIndex) {
      const typeText = normalizeBOQHeader(value).replace(/\s+/g, '');
      if (['category', 'maincategory', 'main', 'cat'].includes(typeText)) return 'category';
      if (['subcategory', 'subcat', 'sub'].includes(typeText)) return 'subcategory';
      if (['subsubcategory', 'subsub'].includes(typeText)) return 'subsubcategory';
      if (['subsubsubcategory', 'subsubsub', 'item', 'workitem', 'lineitem'].includes(typeText)) return 'subsubsubcategory';
      const inferred = inferBOQTypeFromCode(code);
      if (String(code || '').trim()) return inferred;
      if (rowIndex === 0 && title) return 'category';
      return 'subsubsubcategory';
    }

    function isEmptyBOQHeaderCell(value) {
      return !String(value || '').trim();
    }

    function scoreBOQHeaderCells(cells) {
      const normalized = cells.map(normalizeBOQHeader);
      const joined = normalized.join(' | ');
      let score = 0;
      if (normalized.some(h => ['type', 'row type', 'level'].includes(h))) score += 1;
      if (normalized.some(h => ['item code', 'code', 'item no', 'item number'].includes(h))) score += 4;
      if (normalized.some(h => ['work description', 'description', 'scope of work', 'work item', 'item description'].includes(h))) score += 4;
      if (normalized.some(h => ['specification', 'specs', 'remarks'].includes(h))) score += 2;
      if (normalized.some(h => ['qty', 'quantity', 'quan'].includes(h))) score += 2;
      if (normalized.some(h => ['unit', 'uom'].includes(h))) score += 2;
      if (joined.includes('material unit cost')) score += 3;
      if (joined.includes('total material cost')) score += 3;
      if (joined.includes('le unit cost') || joined.includes('lec unit cost') || joined.includes('labor equipment')) score += 3;
      if (joined.includes('total lec') || joined.includes('grand total cost') || joined.includes('total cost')) score += 3;
      return score;
    }

    function looksLikeBOQHeader(cells) {
      const normalized = cells.map(normalizeBOQHeader).filter(Boolean);
      if (!normalized.length) return false;
      const joined = normalized.join(' | ');
      // Avoid treating title rows like "Bill of Quantity" as headers just because they contain "quantity".
      const hasIdentityColumn = normalized.some(h => ['item code', 'code', 'item no', 'item number', 'work description', 'description', 'scope of work', 'work item', 'item description'].includes(h));
      const hasNumericColumn = normalized.some(h => ['qty', 'quantity', 'quan', 'unit', 'uom'].includes(h)) || /material unit cost|total material cost|le unit cost|total lec|grand total cost|total cost/.test(joined);
      return hasIdentityColumn && hasNumericColumn && scoreBOQHeaderCells(cells) >= 6;
    }

    function rowsFromDelimitedText(text, delimiter) {
      const lines = String(text || '').split(/\r?\n/).filter(line => line.trim());
      return lines.map(line => {
        const cells = [];
        let current = '';
        let inQuotes = false;
        for (let i = 0; i < line.length; i++) {
          const ch = line[i];
          if (ch === '"' && line[i + 1] === '"') { current += '"'; i++; }
          else if (ch === '"') inQuotes = !inQuotes;
          else if (ch === delimiter && !inQuotes) { cells.push(current.trim()); current = ''; }
          else current += ch;
        }
        cells.push(current.trim());
        return cells;
      });
    }

    function rowsFromHtmlTable(text) {
      const doc = new DOMParser().parseFromString(String(text || ''), 'text/html');
      const tables = Array.from(doc.querySelectorAll('table'));
      if (!tables.length) return [];
      const scored = tables.map(table => {
        const rows = Array.from(table.querySelectorAll('tr')).map(tr => Array.from(tr.children).map(cell => plainTextFromHtml(cell.innerHTML)));
        const score = rows.slice(0, 5).reduce((sum, row) => sum + (looksLikeBOQHeader(row) ? 10 : 0) + row.filter(Boolean).length, 0);
        return { rows, score };
      });
      scored.sort((a, b) => b.score - a.score);
      return scored[0].rows;
    }

    function rowsFromXLSXSheet(sheet) {
      if (!sheet || !sheet['!ref']) return [];
      const range = XLSX.utils.decode_range(sheet['!ref']);
      const rows = [];
      for (let r = range.s.r; r <= range.e.r; r += 1) {
        const row = [];
        let hasContent = false;
        for (let c = range.s.c; c <= range.e.c; c += 1) {
          const cell = sheet[XLSX.utils.encode_cell({ r, c })];
          let value = '';
          if (cell) {
            if (cell.v !== undefined && cell.v !== null) value = cell.v;
            else if (cell.w !== undefined && cell.w !== null) value = cell.w;
            else value = '';
          }
          if (String(value || '').trim()) hasContent = true;
          row.push(value);
        }
        if (hasContent) rows.push(row);
      }
      return rows;
    }

    function rowsFromXLSXWorkbook(workbook) {
      let bestRows = [];
      let bestScore = -1;
      workbook.SheetNames.forEach(sheetName => {
        const sheet = workbook.Sheets[sheetName];
        const rows = rowsFromXLSXSheet(sheet);
        const score = rows.slice(0, 40).reduce((sum, row) => sum + (looksLikeBOQHeader(row) ? 100 : 0) + scoreBOQHeaderCells(row) + row.filter(cell => String(cell || '').trim()).length, 0);
        if (score > bestScore) {
          bestScore = score;
          bestRows = rows;
        }
      });
      return bestRows;
    }


    function findDUPAMatchForImportedBOQRow(code, title, specification, unit) {
      const normalizedCode = normalizeMatchValue(code);
      const normalizedTitle = normalizeMatchValue(title);
      const normalizedSpec = normalizeMatchValue(specification);
      const normalizedUnit = normalizeMatchValue(unit);
      for (let index = 0; index < analysisData.length; index += 1) {
        const row = analysisData[index];
        if (!row || row.type === 'category') continue;
        const display = getDUPADisplayUnitCosts(row, index);
        const codeMatch = normalizedCode && normalizeMatchValue(row.code) === normalizedCode;
        const textMatch = normalizedTitle && normalizeMatchValue(row.title) === normalizedTitle && (!normalizedSpec || normalizeMatchValue(row.specification) === normalizedSpec) && (!normalizedUnit || normalizeMatchValue(display.unit) === normalizedUnit);
        if (codeMatch || textMatch) {
          return {
            title: row.title || '',
            specification: row.specification || '',
            unit: display.unit || row.unit || '',
            materialUnitCost: numberOrZero(display.materialUnitCost),
            leUnitCost: numberOrZero(display.leUnitCost)
          };
        }
      }
      return null;
    }

    function parseBOQRowsFromMatrix(tableRows) {
      if (!tableRows.length) throw new Error('The Excel file has no rows.');
      let headerRowIndex = -1;
      let bestHeaderScore = -1;
      tableRows.forEach((row, index) => {
        const score = scoreBOQHeaderCells(row);
        if (looksLikeBOQHeader(row) && score > bestHeaderScore) {
          bestHeaderScore = score;
          headerRowIndex = index;
        }
      });
      if (headerRowIndex < 0) {
        const sampleRows = tableRows.slice(0, 8).map(row => row.filter(cell => String(cell || '').trim()).join(' | ')).filter(Boolean).join(' / ');
        throw new Error('No BOQ columns were detected. Please include a header row with Item Code and Work Description/Description. First rows found: ' + (sampleRows || 'blank rows only'));
      }
      const headers = tableRows[headerRowIndex].map(h => String(h || '').trim());
      const dataRows = tableRows.slice(headerRowIndex + 1);
      const idx = {
        type: findBOQHeaderIndex(headers, ['type', 'row type', 'level']),
        code: findBOQHeaderIndex(headers, ['item code', 'code', 'item no', 'item number']),
        title: findBOQHeaderIndex(headers, ['work description', 'description', 'scope of work', 'work item', 'item description', 'material list']),
        specification: findBOQHeaderIndex(headers, ['specification', 'specs', 'remarks']),
        qty: findBOQHeaderIndex(headers, ['qty', 'quantity', 'quan']),
        unit: findBOQHeaderIndex(headers, ['unit', 'uom']),
        materialUnitCost: findBOQHeaderIndex(headers, ['material unit cost', 'material cost', 'material unit price', 'unit material cost']),
        totalMaterialCost: findBOQHeaderIndex(headers, ['total material cost', 'material total', 'total materials']),
        leUnitCost: findBOQHeaderIndex(headers, ['le unit cost', 'labor and equipment cost', 'labor equipment cost', 'labor/equipment unit cost', 'labor unit cost', 'equipment unit cost', 'lec unit cost']),
        totalLEC: findBOQHeaderIndex(headers, ['total lec', 'total le cost', 'labor equipment total', 'total labor and equipment']),
        grandTotalCost: findBOQHeaderIndex(headers, ['grand total cost', 'grand total', 'total cost']),
        condition: findBOQHeaderIndex(headers, ['condition', 'sourcing', 'source'])
      };
      if (idx.title < 0 && idx.code < 0) {
        throw new Error('No BOQ columns were detected. Please include at least Item Code or Work Description/Description.');
      }
      return dataRows
        .filter(cells => cells.some(cell => String(cell || '').trim()))
        .map((cells, rowIndex) => {
          const code = idx.code >= 0 ? cells[idx.code] : '';
          const title = idx.title >= 0 ? (cells[idx.title] || '') : '';
          const typeValue = idx.type >= 0 ? cells[idx.type] : '';
          const type = normalizeBOQType(typeValue, code, title, rowIndex);
          const qty = idx.qty >= 0 ? parseExcelNumber(cells[idx.qty]) : 0;
          const totalMaterialCost = idx.totalMaterialCost >= 0 ? parseExcelNumber(cells[idx.totalMaterialCost]) : 0;
          const totalLEC = idx.totalLEC >= 0 ? parseExcelNumber(cells[idx.totalLEC]) : 0;
          const linked = findDUPAMatchForImportedBOQRow(code, title, idx.specification >= 0 ? cells[idx.specification] : '', idx.unit >= 0 ? cells[idx.unit] : '');
          const materialUnitCostRaw = idx.materialUnitCost >= 0 ? parseExcelNumber(cells[idx.materialUnitCost]) : 0;
          const leUnitCostRaw = idx.leUnitCost >= 0 ? parseExcelNumber(cells[idx.leUnitCost]) : 0;
          const conditionRaw = idx.condition >= 0 ? String(cells[idx.condition] || '').trim() : '';
          let condition = 'CPM';
          if (conditionRaw) {
            const lowerCond = conditionRaw.toLowerCase();
            if (lowerCond === 'osm') {
              condition = 'OSM';
            } else if (lowerCond === 'cpm') {
              condition = 'CPM';
            } else if (lowerCond.includes('by other') || lowerCond.includes('other contractor')) {
              condition = 'By other Contractor';
            } else if (lowerCond.includes('not included') || lowerCond.includes('not in work')) {
              condition = 'Not included in Work';
            } else {
              condition = conditionRaw;
            }
          }
          return {
            type,
            code: code || '',
            title: title || (linked ? linked.title : ''),
            specification: idx.specification >= 0 ? (cells[idx.specification] || '') : (linked ? linked.specification : ''),
            qty,
            unit: idx.unit >= 0 ? (cells[idx.unit] || '') : (linked ? linked.unit : ''),
            materialUnitCost: materialUnitCostRaw || (qty && totalMaterialCost ? totalMaterialCost / qty : 0) || (linked ? linked.materialUnitCost : 0),
            laborUnitCost: leUnitCostRaw || (qty && totalLEC ? totalLEC / qty : 0) || (linked ? linked.leUnitCost : 0),
            condition,
            collapsed: false
          };
        })
        .filter(row => String(row.title || row.code || row.specification || row.unit || '').trim() || row.qty || row.materialUnitCost || row.laborUnitCost);
    }

    function parseBOQTableFromText(text, fileName = '') {
      const lowerName = String(fileName || '').toLowerCase();
      let tableRows = [];
      if (/\.csv$/i.test(lowerName)) {
        tableRows = rowsFromDelimitedText(text, ',');
      } else if (/\.tsv$/i.test(lowerName)) {
        tableRows = rowsFromDelimitedText(text, '\t');
      } else {
        tableRows = rowsFromHtmlTable(text);
      }
      if (!tableRows.length) throw new Error('No readable BOQ rows were found. Use .xlsx, .csv, or the BOQ Excel file exported from this tool.');
      return parseBOQRowsFromMatrix(tableRows);
    }

    function normalizeImportedBOQRows(importedRows) {
      return importedRows.map(row => {
        const qty = numberOrZero(row.qty);
        const materialUnitCost = numberOrZero(row.materialUnitCost);
        const laborUnitCost = numberOrZero(row.laborUnitCost);
        let condition = row.condition || 'CPM';
        const lowerCond = String(condition).trim().toLowerCase();
        if (lowerCond === 'osm') {
          condition = 'OSM';
        } else if (lowerCond === 'cpm') {
          condition = 'CPM';
        } else if (lowerCond.includes('by other') || lowerCond.includes('other contractor')) {
          condition = 'By other Contractor';
        } else if (lowerCond.includes('not included') || lowerCond.includes('not in work')) {
          condition = 'Not included in Work';
        }
        return {
          ...row,
          qty,
          materialUnitCost,
          laborUnitCost,
          condition,
          collapsed: false
        };
      });
    }

    function loadParsedBOQRows(importedRows) {
      if (!importedRows.length) throw new Error('No valid BOQ rows found in the Excel file.');
      if (boqData.length && !confirmAction('Load Excel will replace the current BOQ table. Continue?')) return;
      const normalizedRows = normalizeImportedBOQRows(importedRows);
      boqData.splice(0, boqData.length, ...normalizedRows);
      recomputeCodes(boqData);
      renderBOQTable();
      renderBOQSummaryTable();
      syncCoverLetterFields();
      renderCoverLetter();
      markUnsaved();
      showSheet('boqSheet');
      alert('BOQ Excel loaded successfully. Imported ' + normalizedRows.length + ' row(s). Missing totals are recalculated automatically from Qty, Material Unit Cost, and LE Unit Cost.');
    }

    function textFromArrayBuffer(buffer) {
      try { return new TextDecoder('utf-8').decode(buffer); }
      catch (error) {
        let out = '';
        const bytes = new Uint8Array(buffer);
        for (let i = 0; i < bytes.length; i++) out += String.fromCharCode(bytes[i]);
        return out;
      }
    }

    function looksLikeExcelHtmlFrameset(text) {
      const source = String(text || '').toLowerCase();
      return source.includes('excel workbook frameset') || (source.includes('<frameset') && source.includes('sheet001.htm'));
    }

    function loadBOQExcelFromFile(input) {
      if (input) input.dataset.section = 'boq';
      const file = input.files && input.files[0];
      if (!file) return;
      const fileName = file.name || '';
      const readAsWorkbook = shouldReadAsWorkbook(fileName, file.type || '');
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const buffer = event.target.result;
          const previewText = textFromArrayBuffer(buffer.slice ? buffer.slice(0, Math.min(buffer.byteLength || 0, 4096)) : buffer);
          const isHtmlContent = /^\s*(?:﻿)?\s*</.test(previewText) || /<html|<table|<frameset/i.test(previewText);
          let importedRows = [];
          if (isHtmlContent) {
            const fullText = textFromArrayBuffer(buffer);
            if (looksLikeExcelHtmlFrameset(fullText)) {
              throw new Error('This .xls is an Excel HTML frameset. The actual BOQ data is stored in a separate _files/sheet001.htm file that was not included, so the BOQ table cannot be read. Please re-save/export the BOQ as .xlsx, CSV, or a single-file HTML .xls from this tool, then load it again.');
            }
            importedRows = parseBOQTableFromText(fullText, fileName);
          } else if (readAsWorkbook) {
            if (typeof XLSX === 'undefined') {
              throw new Error('The Excel parser did not load. Please connect to the internet, reopen this HTML file, and try again. You can also use CSV as a fallback.');
            }
            const workbook = XLSX.read(new Uint8Array(buffer), { type: 'array', cellFormula: true, cellNF: true, cellText: false });
            importedRows = parseBOQRowsFromMatrix(rowsFromXLSXWorkbook(workbook));
          } else {
            importedRows = parseBOQTableFromText(textFromArrayBuffer(buffer), fileName);
          }
          loadParsedBOQRows(importedRows);
        } catch (error) {
          alert(error.message || 'Unable to load Excel file. Please use the exported BOQ template or a normal .xlsx/.xls/.csv file with BOQ headers.');
        } finally {
          input.value = '';
        }
      };
      reader.readAsArrayBuffer(file);
    }


    function sectionDisplayName(section) {
      if (section === 'priceList') return 'Price List';
      if (section === 'dupa') return 'Detailed Unit Price Analysis';
      if (section === 'boq') return 'Bill of Quantity';
      return 'Table';
    }
    function sectionSafeFileName(section) {
      const projectName = getElementValue('projectName') || sectionDisplayName(section);
      return String(projectName).trim().replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '').toLowerCase() || section;
    }
    function buildPriceListExcelRows() {
      return priceListData.map(row => ({
        type: row.type || '', code: row.itemCode || '',
        materialList: row.type === 'category' ? (row.mainCategory || '') : row.type === 'subcategory' ? (row.subCategory || '') : (row.materialName || ''),
        specification: row.specification || '', unit: row.unit || '',
        pricePerUnit: row.type === 'material' ? numberOrZero(row.pricePerUnit) : '',
        rentalPerUnit: row.type === 'material' ? numberOrZero(row.rentalPerUnit) : '',
        dateUpdated: row.dateUpdated || ''
      }));
    }
    function buildDUPAExcelRows() {
      return analysisData.map((row, index) => {
        const childExists = hasChildRow(analysisData, index);
        const qty = numberOrZero(row.qty);
        const linkedPriceListMatch = getLinkedPriceListMatch(row);
        const materialUnitCost = linkedPriceListMatch && linkedPriceListMatch.materialUnitCost !== null ? linkedPriceListMatch.materialUnitCost : numberOrZero(row.materialUnitCost);
        const leUnitCost = linkedPriceListMatch && linkedPriceListMatch.leUnitCost !== null ? linkedPriceListMatch.leUnitCost : numberOrZero(row.laborUnitCost);
        const rowEditable = row.type === 'subsubsubcategory' || (row.type === 'subsubcategory' && !childExists) || (row.type === 'subcategory' && !childExists);
        return { type: row.type || '', code: row.code || '', title: row.title || '', specification: row.specification || '', qty: row.type === 'category' ? '' : qty, unit: row.type === 'category' ? '' : (linkedPriceListMatch && linkedPriceListMatch.unit ? linkedPriceListMatch.unit : row.unit || ''), materialUnitCost: rowEditable ? materialUnitCost : '', totalMaterialCost: rowEditable ? qty * materialUnitCost : '', leUnitCost: rowEditable ? leUnitCost : '', totalLEC: rowEditable ? qty * leUnitCost : '', grandTotalCost: rowEditable ? (qty * materialUnitCost) + (qty * leUnitCost) : '' };
      });
    }
    function getExcelSectionConfig(section) {
      if (section === 'priceList') return { sheetName:'Price List', headers:['Type','Item Code','Material List','Specification','Unit','Price per Unit','Rental per Unit','Date Updated'], keys:['type','code','materialList','specification','unit','pricePerUnit','rentalPerUnit','dateUpdated'], rows:buildPriceListExcelRows(), emptyMessage:'There is no Price List data to export.' };
      if (section === 'dupa') return { sheetName:'D.U.P.A.', headers:['Type','Item Code','Work Description','Specification','Qty','Unit','Material Unit Cost','Total Material Cost','LE Unit Cost','Total LEC','Grand Total Cost'], keys:['type','code','title','specification','qty','unit','materialUnitCost','totalMaterialCost','leUnitCost','totalLEC','grandTotalCost'], rows:buildDUPAExcelRows(), emptyMessage:'There is no D.U.P.A. data to export.' };
      return { sheetName:'BOQ', headers:['Type','Item Code','Work Description','Specification','Qty','Unit','Material Unit Cost','Total Material Cost','LE Unit Cost','Total LEC','Grand Total Cost','Condition'], keys:['type','code','title','specification','qty','unit','materialUnitCost','totalMaterialCost','leUnitCost','totalLEC','grandTotalCost','condition'], rows:buildBOQExcelRows(), emptyMessage:'There is no BOQ data to export.' };
    }
    function exportSectionToExcel(section, formatted = false) {
      const config = getExcelSectionConfig(section);
      if (!config.rows.length) { alert(config.emptyMessage); return; }
      if (section === 'boq' && exportBOQAsXLSX(config, formatted)) return;
      const numberKeys = ['qty','pricePerUnit','rentalPerUnit','materialUnitCost','totalMaterialCost','leUnitCost','totalLEC','grandTotalCost'];
      const tableHeader = '<tr>' + config.headers.map(h => '<th>' + excelEscape(h) + '</th>').join('') + '</tr>';
      const tableBody = config.rows.map(row => '<tr>' + config.keys.map(key => '<td' + (numberKeys.includes(key) ? ' class="number"' : '') + '>' + excelEscape(row[key]) + '</td>').join('') + '</tr>').join('\\n');
      const style = formatted ? 'body{font-family:Arial,sans-serif;}h2{background:#e6f2fb;padding:8px;text-align:center;}table{border-collapse:collapse;font-family:Arial,sans-serif;font-size:10pt;width:100%;}th,td{border:1px solid #7f8c8d;padding:5px 7px;}th{background:#dbeafe;font-weight:700;text-align:center;}td.number{text-align:right;mso-number-format:"#,##0.00";}tr:nth-child(even) td{background:#f8fafc;}.meta{font-size:9pt;margin:6px 0 10px;color:#333;}' : 'table{border-collapse:collapse;font-family:Arial,sans-serif;font-size:11pt;}th,td{border:1px solid #999;padding:4px 6px;}th{background:#e6f2fb;font-weight:700;}td.number{text-align:right;mso-number-format:"#,##0.00";}';
      const meta = formatted ? '<div class="meta">Exported: ' + excelEscape(new Date().toLocaleString()) + '</div>' : '';
      const title = sectionDisplayName(section);
      const html = '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>' + style + '</style></head><body>' + (formatted ? '<h2>' + excelEscape(title) + '</h2>' + meta : '') + '<table>' + tableHeader + tableBody + '</table></body></html>';
      const blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const url = URL.createObjectURL(blob); const link = document.createElement('a');
      link.href = url; link.download = sectionSafeFileName(section) + '-' + section + (formatted ? '-formatted' : '') + '-' + new Date().toISOString().slice(0, 10) + '.xls';
      document.body.appendChild(link); link.click(); link.remove(); URL.revokeObjectURL(url);
    }
    function openSectionExcelFile(section) {
      if (section === 'boq') { openBOQExcelFile(); return; }
      const input = document.getElementById('sectionExcelFileInput'); if (!input) return;
      input.dataset.section = section; input.value = ''; input.click();
    }
    function parsePriceListRowsFromMatrix(tableRows) {
      if (!tableRows.length) throw new Error('The Excel file has no rows.');
      let headerRowIndex = tableRows.findIndex(row => /material list|price per unit|rental per unit|item code/i.test(row.join(' | ')));
      if (headerRowIndex < 0) headerRowIndex = 0;
      const headers = tableRows[headerRowIndex].map(h => String(h || '').trim()); const dataRows = tableRows.slice(headerRowIndex + 1);
      const idx = { type: findBOQHeaderIndex(headers, ['type','row type','level']), code: findBOQHeaderIndex(headers, ['item code','code']), material: findBOQHeaderIndex(headers, ['material list','material','description','item description']), specification: findBOQHeaderIndex(headers, ['specification','specs']), unit: findBOQHeaderIndex(headers, ['unit','uom']), price: findBOQHeaderIndex(headers, ['price per unit','price','unit price','material unit cost']), rental: findBOQHeaderIndex(headers, ['rental per unit','rental','le unit cost']), date: findBOQHeaderIndex(headers, ['date updated','date']) };
      if (idx.material < 0 && idx.code < 0) throw new Error('No Price List columns were detected. Please include Material List or Item Code.');
      return dataRows.filter(cells => cells.some(cell => String(cell || '').trim())).map(cells => {
        const code = idx.code >= 0 ? cells[idx.code] : ''; const rawType = idx.type >= 0 ? normalizeBOQHeader(cells[idx.type]).replace(/s+/g, '') : ''; const depth = String(code || '').split('.').filter(Boolean).length;
        const type = ['category','subcategory','material'].includes(rawType) ? rawType : (depth <= 1 ? 'category' : depth === 2 ? 'subcategory' : 'material'); const name = idx.material >= 0 ? (cells[idx.material] || '') : '';
        return { type, itemCode: code || '', mainCategory: type === 'category' ? name : '', subCategory: type === 'subcategory' ? name : '', materialName: type === 'material' ? name : '', specification: idx.specification >= 0 ? (cells[idx.specification] || '') : '', unit: idx.unit >= 0 ? (cells[idx.unit] || '') : '', pricePerUnit: idx.price >= 0 ? parseExcelNumber(cells[idx.price]) : 0, rentalPerUnit: idx.rental >= 0 ? parseExcelNumber(cells[idx.rental]) : 0, dateUpdated: idx.date >= 0 ? (cells[idx.date] || '') : '', collapsed: false };
      }).filter(row => String(row.mainCategory || row.subCategory || row.materialName || row.itemCode).trim());
    }
    function shouldReadAsWorkbook(fileName, fileType = '') {
      const name = String(fileName || '').toLowerCase();
      const type = String(fileType || '').toLowerCase();
      if (/\.(csv|tsv|html|htm)$/i.test(name) || /text\/(csv|tab-separated-values|html)/i.test(type)) return false;
      return /\.(xlsx|xlsm|xlsb|xls)$/i.test(name) || /spreadsheet|excel|ms-excel/i.test(type);
    }

    function rowsFromAnyExcelFileContent(event, fileName, readAsWorkbook) {
      if (readAsWorkbook) {
        if (typeof XLSX === 'undefined') throw new Error('The Excel parser did not load. Please connect to the internet, reopen this HTML file, and try again. You can also use CSV as a fallback.');
        const workbook = XLSX.read(new Uint8Array(event.target.result), { type: 'array' });
        return rowsFromXLSXWorkbook(workbook);
      }
      const text = event.target.result;
      if (/.csv$/i.test(fileName)) return rowsFromDelimitedText(text, ',');
      if (/.tsv$/i.test(fileName)) return rowsFromDelimitedText(text, '\t');
      return rowsFromHtmlTable(text);
    }
    function loadSectionExcelFromFile(input) {
      const section = input.dataset.section || 'priceList';
      const file = input.files && input.files[0];
      if (!file) return;
      if (section === 'boq') {
        loadBOQExcelFromFile(input);
        return;
      }
      const fileName = file.name || '';
      const readAsWorkbook = shouldReadAsWorkbook(fileName, file.type || '');
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const matrix = rowsFromAnyExcelFileContent(event, fileName, readAsWorkbook);
          if (!matrix.length) throw new Error('No readable rows were found. Use .xlsx, .xls, .csv, or an Excel file exported from this tool.');
          if (section === 'priceList') {
            const rows = parsePriceListRowsFromMatrix(matrix);
            if (!rows.length) throw new Error('No valid Price List rows found.');
            if (priceListData.length && !confirmAction('Load Excel will replace the current Price List table. Continue?')) return;
            priceListData.splice(0, priceListData.length, ...rows);
            recomputePriceListCodes();
            renderPriceListTable();
            renderAnalysisTable();
            renderBOQTable();
            markUnsaved();
            showSheet('priceListSheet');
            alert('Price List Excel loaded successfully. Imported ' + rows.length + ' row(s).');
          } else if (section === 'dupa') {
            const rows = parseBOQRowsFromMatrix(matrix);
            if (!rows.length) throw new Error('No valid D.U.P.A. rows found.');
            if (analysisData.length && !confirmAction('Load Excel will replace the current D.U.P.A. table. Continue?')) return;
            analysisData.splice(0, analysisData.length, ...rows);
            recomputeAnalysisCodes();
            renderAnalysisTable();
            renderBOQTable();
            markUnsaved();
            showSheet('estimateSheet');
            alert('D.U.P.A. Excel loaded successfully. Imported ' + rows.length + ' row(s).');
          }
        } catch (error) {
          alert(error.message || 'Unable to load Excel file. Please use an exported template or a normal .xlsx/.csv file with matching headers.');
        } finally {
          input.value = '';
        }
      };
      if (readAsWorkbook) reader.readAsArrayBuffer(file); else reader.readAsText(file);
    }

    function exportSectionJson(section) {
      const payload = getSectionPayload(section);
      if (!payload) return;
      const filePayload = {
        app: 'Comprehensive Cost Estimation',
        version: 1,
        section,
        savedAt: new Date().toISOString(),
        data: payload
      };
      const blob = new Blob([JSON.stringify(filePayload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = sectionFileName(section);
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function openSectionJsonFile(section) {
      const input = document.getElementById('sectionJsonFileInput');
      if (!input) return;
      input.dataset.section = section;
      input.value = '';
      input.click();
    }

    function applyPriceListPayload(payload) {
      if (!payload || !Array.isArray(payload.priceListData)) throw new Error('Invalid Price List JSON file.');
      priceListData.splice(0, priceListData.length, ...payload.priceListData);
      recomputePriceListCodes();
      renderPriceListTable();
    }

    function applyDUPAPayload(payload) {
      if (!payload || !Array.isArray(payload.analysisData)) throw new Error('Invalid D.U.P.A. JSON file.');
      analysisData.splice(0, analysisData.length, ...payload.analysisData);
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function applyBOQPayload(payload) {
      if (!payload || !Array.isArray(payload.boqData)) throw new Error('Invalid BOQ JSON file.');
      boqData.splice(0, boqData.length, ...payload.boqData);
      applyValuesById(payload.projectFields);
      applyValuesById(payload.multiplierFields);
      applyValuesById(payload.summaryFields);
      applyValuesById(payload.signatureFields);
      if (payload.signatureEdited) {
        Object.keys(payload.signatureEdited).forEach(id => {
          const input = document.getElementById(id);
          if (input) input.dataset.edited = payload.signatureEdited[id] || '';
        });
      }
      applyReviewTableValues(payload.reviewTable);
      if (payload.ganttSummaryCellFunctions) {
        ganttSummaryCellFunctions = payload.ganttSummaryCellFunctions;
        saveGanttSummaryCellFunctions();
      }
      if (payload.ganttSummaryFormulas) {
        ganttSummaryFormulas = payload.ganttSummaryFormulas;
        saveGanttSummaryFormulas();
      }
      recomputeCodes(boqData);
      renderBOQTable();
      renderBOQSummaryTable();
      syncBOQSignatureNames();
      syncCoverLetterFields();
      renderCoverLetter();
    }

    function applyCoverPayload(payload) {
      if (!payload || (!payload.coverFields && !payload.editableHtml)) throw new Error('Invalid Cover Letter JSON file.');
      if (payload.editableHtml) payload.editableHtml = sanitizeCoverEditableValues(payload.editableHtml);
      applyValuesById(payload.coverFields);
      applyEditableHtml('.cover-letter-page [contenteditable="true"]', payload.editableHtml);
      applyCoverPageSetup();
      coverAttachments = Array.isArray(payload.attachments) ? payload.attachments : [];
      renderCoverAttachments();
      if (payload.printScope) syncCoverPrintScope(payload.printScope);
      renderCoverLetter();
      syncSidebarFromCover();
      cleanRemovedProposalSubtitleFromDom();
    }

    function applySectionPayload(section, payload) {
      if (section === 'priceList') applyPriceListPayload(payload);
      else if (section === 'dupa') applyDUPAPayload(payload);
      else if (section === 'boq') applyBOQPayload(payload);
      else if (section === 'cover') applyCoverPayload(payload);
      else throw new Error('Unknown JSON section.');
    }

    function loadSectionJsonFromFile(input) {
      const file = input.files && input.files[0];
      const section = input.dataset.section;
      if (!file || !section) return;
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const parsed = JSON.parse(event.target.result);
          const payload = parsed && parsed.data ? parsed.data : parsed;
          const fileSection = parsed && parsed.section ? parsed.section : section;
          if (fileSection !== section && !confirmAction(`This JSON file appears to be for ${sectionLabel(fileSection)}. Load it into ${sectionLabel(section)} anyway?`)) return;
          applySectionPayload(section, payload);
          markUnsaved();
          alert(sectionLabel(section) + ' JSON loaded successfully.');
        } catch (error) {
          alert(error.message || 'Unable to load JSON file. Please check the file format.');
        }
      };
      reader.readAsText(file);
    }

    function saveToBrowser(key, payload, label, silent = false) {
      try {
        localStorage.setItem(key, JSON.stringify(payload));
        hasUnsavedChanges = false;
        if (!silent) {
          alert(label + " saved successfully in this browser.");
        }
      } catch (error) {
        alert("Unable to save " + label + ". Your browser storage may be full or disabled. Error: " + error.message);
      }
    }

    function readFromBrowser(key) {
      try {
        const localRaw = localStorage.getItem(key);
        return localRaw ? JSON.parse(localRaw) : null;
      } catch (e) {
        console.error("Error reading key " + key + " from storage: ", e);
        return null;
      }
    }

    function savePriceListSection() {
      saveToBrowser(APP_STORAGE_KEYS.priceList, getPriceListPayload(), 'Price List');
    }

    function saveDUPASection() {
      saveToBrowser(APP_STORAGE_KEYS.dupa, getDUPAPayload(), 'D.U.P.A.');
    }

    function saveBOQSection(silent = false) {
      saveToBrowser(APP_STORAGE_KEYS.boq, getBOQPayload(), 'BOQ', silent);
    }

    function saveCoverLetterSection() {
      saveToBrowser(APP_STORAGE_KEYS.cover, getCoverPayload(), 'Cover Letter');
    }

    function loadSavedSections() {
      const savedPriceList = readFromBrowser(APP_STORAGE_KEYS.priceList);
      if (savedPriceList && Array.isArray(savedPriceList.priceListData)) {
        priceListData.splice(0, priceListData.length, ...savedPriceList.priceListData);
      }
      const savedDUPA = readFromBrowser(APP_STORAGE_KEYS.dupa);
      if (savedDUPA && Array.isArray(savedDUPA.analysisData)) {
        analysisData.splice(0, analysisData.length, ...savedDUPA.analysisData);
      }
      const savedBOQ = readFromBrowser(APP_STORAGE_KEYS.boq);
      if (savedBOQ) {
        if (Array.isArray(savedBOQ.boqData)) boqData.splice(0, boqData.length, ...savedBOQ.boqData);
        applyValuesById(savedBOQ.projectFields);
        applyValuesById(savedBOQ.multiplierFields);
        applyValuesById(savedBOQ.summaryFields);
        applyValuesById(savedBOQ.signatureFields);
        if (savedBOQ.signatureEdited) {
          Object.keys(savedBOQ.signatureEdited).forEach(id => {
            const input = document.getElementById(id);
            if (input && savedBOQ.signatureEdited[id]) input.dataset.edited = savedBOQ.signatureEdited[id];
          });
        }
        applyReviewTableValues(savedBOQ.reviewTable);
        if (savedBOQ.ganttSummaryCellFunctions) {
          ganttSummaryCellFunctions = savedBOQ.ganttSummaryCellFunctions;
        } else {
          loadGanttSummaryCellFunctions();
        }
        if (savedBOQ.ganttSummaryFormulas) {
          ganttSummaryFormulas = savedBOQ.ganttSummaryFormulas;
        } else {
          loadGanttSummaryFormulas();
        }
      } else {
        loadGanttSummaryCellFunctions();
        loadGanttSummaryFormulas();
      }
      const savedCover = readFromBrowser(APP_STORAGE_KEYS.cover);
      if (savedCover) {
        if (savedCover.editableHtml) savedCover.editableHtml = sanitizeCoverEditableValues(savedCover.editableHtml);
        applyValuesById(savedCover.coverFields);
        applyEditableHtml('#coverLetterSheet [contenteditable="true"]', savedCover.editableHtml);
        if (Array.isArray(savedCover.attachments)) {
          coverAttachments = savedCover.attachments;
          renderCoverAttachments();
        }
        if (savedCover.printScope) syncCoverPrintScope(savedCover.printScope);
      }
      syncCoverLetterFields();
      cleanRemovedProposalSubtitleFromDom();
    }

    function syncBOQSignatureNames() {
      const preparedBy = document.getElementById('preparedBy')?.value || '';
      const clientName = document.getElementById('clientName')?.value || '';
      const submittedName = document.getElementById('submittedBySignatureName');
      const acceptedName = document.getElementById('acceptedBySignatureName');
      if (submittedName && !submittedName.dataset.edited) submittedName.value = preparedBy.trim();
      if (acceptedName && !acceptedName.dataset.edited) acceptedName.value = clientName.trim();
    }

    ['submittedBySignatureName', 'acceptedBySignatureName', 'submittedByPosition', 'acceptedByPosition', 'coverSubmittedBy', 'coverAcceptedBy', 'coverSubmittedPosition', 'coverAcceptedPosition'].forEach(id => {
      const input = document.getElementById(id);
      if (input) {
        input.addEventListener('input', () => {
          input.dataset.edited = 'true';
          markUnsaved();
        });
      }
    });

    ['preparedBy', 'clientName', 'projectName', 'projectLocation', 'documentNo', 'proposalDate', 'projectSubject', 'submittedByPosition', 'acceptedByPosition'].forEach(id => {
      const input = document.getElementById(id);
      if (input) {
        input.addEventListener('input', () => {
          syncBOQSignatureNames();
          syncCoverLetterFields();
          renderCoverLetter();
          markUnsaved();
        });
      }
    });


    function capitalizeWordsPreserveRest(value) {
      return String(value ?? '').replace(/(^|[\s\-/])([a-zA-Z])/g, (match, prefix, letter) => prefix + letter.toUpperCase());
    }

    function capitalizeTextInputElement(input) {
      if (!input || input.tagName !== 'INPUT') return;
      const type = String(input.getAttribute('type') || 'text').toLowerCase();
      if (['number', 'date', 'hidden', 'checkbox', 'radio', 'button', 'submit', 'reset'].includes(type)) return;
      const nextValue = capitalizeWordsPreserveRest(input.value);
      if (input.value !== nextValue) input.value = nextValue;
    }

    document.addEventListener('change', (event) => {
      capitalizeTextInputElement(event.target);
    }, true);

    document.addEventListener('blur', (event) => {
      capitalizeTextInputElement(event.target);
    }, true);

    (() => {
      document.getElementById('proposalDate').valueAsDate = new Date();
      loadSavedSections();
      if (!priceListData.length) addPriceListRow();
      if (!analysisData.length) addAnalysisCategoryRow();
      if (!boqData.length) addBOQCategoryRow();
      recomputePriceListCodes();
      recomputeAnalysisCodes();
      recomputeCodes(boqData);
      renderPriceListTable();
      renderAnalysisTable();
      renderBOQTable();
      syncBOQSignatureNames();
      syncCoverLetterFields();
      renderCoverLetter();
      updateHeaderSaveButtons(document.querySelector('.sheet.active')?.id || 'estimateSheet');
      hasUnsavedChanges = false;
      appReady = true;
    })();

    // Remove any legacy redundant closing from old saved browser data.
    function removeLegacyRedundantClosing(root = document) {
      const phrase = ['Respectfully', 'submitted'].join(' ');
      const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const pattern = new RegExp(escaped + '\\s*,?', 'gi');
      try {
        Object.keys(localStorage || {}).forEach(key => {
          const value = localStorage.getItem(key);
          if (value && pattern.test(value)) {
            localStorage.setItem(key, value.replace(pattern, '').replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n'));
          }
        });
      } catch (error) {}
      const scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('#coverLetterSheet [contenteditable="true"], #coverLetterSheet div').forEach(el => {
        if (!el || !el.textContent) return;
        const text = el.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
        if (text === phrase.toLowerCase() || text === (phrase + ',').toLowerCase()) {
          el.remove();
        } else if (pattern.test(el.innerHTML)) {
          el.innerHTML = el.innerHTML.replace(pattern, '').replace(/(<br\s*\/?>\s*){2,}/gi, '<br>');
        }
      });
    }
    document.addEventListener('DOMContentLoaded', () => {
      removeLegacyRedundantClosing();
      setTimeout(removeLegacyRedundantClosing, 250);
      setTimeout(removeLegacyRedundantClosing, 1000);
      document.querySelectorAll('#coverLetterSheet textarea').forEach(textarea => {
        textarea.addEventListener('input', () => {
          textarea.style.height = 'auto';
          textarea.style.height = (textarea.scrollHeight + 4) + 'px';
        });
      });
    });

    window.addEventListener('resize', () => {
      resizeAllBOQSpecificationTextareas();
    });



    /* FINAL FIX: BOQ Excel import is isolated from Price List and D.U.P.A. import paths. */
    function openBOQExcelFile() {
      const boqInput = document.getElementById('boqExcelFileInput');
      if (!boqInput) {
        alert('BOQ Excel file input was not found.');
        return;
      }
      boqInput.dataset.section = 'boq';
      boqInput.value = '';
      boqInput.click();
    }

    function loadBOQExcelFromFile(input) {
      const boqInput = input || document.getElementById('boqExcelFileInput');
      if (!boqInput) return;
      boqInput.dataset.section = 'boq';
      const file = boqInput.files && boqInput.files[0];
      if (!file) return;
      const fileName = file.name || '';
      const readAsWorkbook = shouldReadAsWorkbook(fileName, file.type || '');
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const buffer = event.target.result;
          const previewText = textFromArrayBuffer(buffer.slice ? buffer.slice(0, Math.min(buffer.byteLength || 0, 4096)) : buffer);
          const isHtmlContent = /^\s*(?:\ufeff)?\s*</.test(previewText) || /<html|<table|<frameset/i.test(previewText);
          let importedRows = [];
          if (isHtmlContent) {
            const fullText = textFromArrayBuffer(buffer);
            if (looksLikeExcelHtmlFrameset(fullText)) {
              throw new Error('This .xls is an Excel HTML frameset. The actual BOQ data is stored in a separate _files/sheet001.htm file that was not included, so the BOQ table cannot be read. Please re-save/export the BOQ as .xlsx, CSV, or a single-file HTML .xls from this tool, then load it again.');
            }
            importedRows = parseBOQTableFromText(fullText, fileName);
          } else if (readAsWorkbook) {
            if (typeof XLSX === 'undefined') {
              throw new Error('The Excel parser did not load. Please connect to the internet, reopen this HTML file, and try again. You can also use CSV as a fallback.');
            }
            const workbook = XLSX.read(new Uint8Array(buffer), { type: 'array', cellFormula: true, cellNF: true, cellText: false });
            importedRows = parseBOQRowsFromMatrix(rowsFromXLSXWorkbook(workbook));
          } else {
            importedRows = parseBOQTableFromText(textFromArrayBuffer(buffer), fileName);
          }

          if (!importedRows.length) throw new Error('No valid BOQ rows found in the Excel file.');
          if (boqData.length && !confirmAction('Load Excel will replace the current BOQ table only. D.U.P.A. will not be changed. Continue?')) return;
          const normalizedRows = normalizeImportedBOQRows(importedRows);
          boqData.splice(0, boqData.length, ...normalizedRows);
          recomputeCodes(boqData);
          renderBOQTable();
          renderBOQSummaryTable();
          syncCoverLetterFields();
          renderCoverLetter();
          markUnsaved();
          showSheet('boqSheet');
          alert('BOQ Excel loaded successfully into the Bill of Quantity sheet only. Imported ' + normalizedRows.length + ' row(s).');
        } catch (error) {
          alert(error.message || 'Unable to load Excel file into BOQ. Please use the exported BOQ template or a normal .xlsx/.xls/.csv file with BOQ headers.');
        } finally {
          boqInput.value = '';
          boqInput.dataset.section = 'boq';
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function openSectionExcelFile(section) {
      if (section === 'boq') {
        openBOQExcelFile();
        return;
      }
      const input = document.getElementById('sectionExcelFileInput');
      if (!input) return;
      input.dataset.section = section;
      input.value = '';
      input.click();
    }

    document.addEventListener('DOMContentLoaded', function() {
      const boqButton = document.getElementById('loadBOQExcelBtn');
      const boqInput = document.getElementById('boqExcelFileInput');
      if (boqButton) boqButton.onclick = openBOQExcelFile;
      if (boqInput) {
        boqInput.dataset.section = 'boq';
        boqInput.onchange = function() { loadBOQExcelFromFile(boqInput); };
      }
    });



    /* FINAL FIX: Excel import follows the button/sheet context.
       - BOQ Load Excel -> BOQ table only.
       - D.U.P.A. Load Excel -> D.U.P.A. table only.
       - Price List Load Excel -> Price List table only.
       This overrides older shared handlers that could route to the wrong table. */
    function getActiveEstimateSectionForExcelImport() {
      const boqSheet = document.getElementById('boqSheet');
      const dupaSheet = document.getElementById('estimateSheet');
      const priceListSheet = document.getElementById('priceListSheet');
      if (boqSheet && boqSheet.classList.contains('active')) return 'boq';
      if (dupaSheet && dupaSheet.classList.contains('active')) return 'dupa';
      if (priceListSheet && priceListSheet.classList.contains('active')) return 'priceList';
      return 'priceList';
    }

    function openSectionExcelFile(section) {
      const targetSection = section || getActiveEstimateSectionForExcelImport();
      if (targetSection === 'boq') {
        const boqInput = document.getElementById('boqExcelFileInput');
        if (!boqInput) { alert('BOQ Excel file input was not found.'); return; }
        boqInput.dataset.section = 'boq';
        boqInput.value = '';
        boqInput.onchange = function() { loadBOQExcelFromFile(boqInput); };
        boqInput.click();
        return;
      }
      const input = document.getElementById('sectionExcelFileInput');
      if (!input) { alert('Excel file input was not found.'); return; }
      input.dataset.section = targetSection;
      input.value = '';
      input.onchange = function() { loadSectionExcelFromFile(input); };
      input.click();
    }

    function openBOQExcelFile() {
      openSectionExcelFile('boq');
    }

    function loadSectionExcelFromFile(input) {
      const section = (input && input.dataset && input.dataset.section) || getActiveEstimateSectionForExcelImport();
      if (section === 'boq') {
        loadBOQExcelFromFile(input);
        return;
      }
      const file = input && input.files && input.files[0];
      if (!file) return;
      const fileName = file.name || '';
      const readAsWorkbook = shouldReadAsWorkbook(fileName, file.type || '');
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const matrix = rowsFromAnyExcelFileContent(event, fileName, readAsWorkbook);
          if (!matrix.length) throw new Error('No readable rows were found. Use .xlsx, .xls, .csv, or an Excel file exported from this tool.');

          if (section === 'priceList') {
            const rows = parsePriceListRowsFromMatrix(matrix);
            if (!rows.length) throw new Error('No valid Price List rows found.');
            if (priceListData.length && !confirmAction('Load Excel will replace the current Price List table only. Continue?')) return;
            priceListData.splice(0, priceListData.length, ...rows);
            recomputePriceListCodes();
            renderPriceListTable();
            renderAnalysisTable();
            renderBOQTable();
            markUnsaved();
            showSheet('priceListSheet');
            alert('Price List Excel loaded successfully into the Price List sheet only. Imported ' + rows.length + ' row(s).');
            return;
          }

          if (section === 'dupa') {
            const rows = parseBOQRowsFromMatrix(matrix);
            if (!rows.length) throw new Error('No valid D.U.P.A. rows found.');
            if (analysisData.length && !confirmAction('Load Excel will replace the current D.U.P.A. table only. BOQ will not be replaced. Continue?')) return;
            analysisData.splice(0, analysisData.length, ...rows);
            recomputeAnalysisCodes();
            renderAnalysisTable();
            renderBOQTable();
            markUnsaved();
            showSheet('estimateSheet');
            alert('D.U.P.A. Excel loaded successfully into the D.U.P.A. sheet only. Imported ' + rows.length + ' row(s).');
            return;
          }

          throw new Error('Unknown Excel import target. Please open Price List, D.U.P.A., or BOQ and click its Load Excel button again.');
        } catch (error) {
          alert(error.message || 'Unable to load Excel file. Please use an exported template or a normal .xlsx/.csv file with matching headers.');
        } finally {
          if (input) input.value = '';
        }
      };
      if (readAsWorkbook) reader.readAsArrayBuffer(file); else reader.readAsText(file);
    }

    document.addEventListener('DOMContentLoaded', function() {
      const priceBtn = document.getElementById('loadPriceListExcelBtn');
      const dupaBtn = document.getElementById('loadDUPAExcelBtn');
      const boqBtn = document.getElementById('loadBOQExcelBtn');
      const sharedInput = document.getElementById('sectionExcelFileInput');
      const boqInput = document.getElementById('boqExcelFileInput');
      if (priceBtn) priceBtn.onclick = function() { openSectionExcelFile('priceList'); };
      if (dupaBtn) dupaBtn.onclick = function() { openSectionExcelFile('dupa'); };
      if (boqBtn) boqBtn.onclick = function() { openSectionExcelFile('boq'); };
      if (sharedInput) sharedInput.onchange = function() { loadSectionExcelFromFile(sharedInput); };
      if (boqInput) {
        boqInput.dataset.section = 'boq';
        boqInput.onchange = function() { loadBOQExcelFromFile(boqInput); };
      }
    });

  

    /* FINAL TARGET LOCK: Excel import buttons must always load into their own table.
       This capture-phase override prevents older inline/shared handlers from also firing.
       - Price List Load Excel -> #priceListTable only via shared input tagged priceList
       - D.U.P.A. Load Excel -> #analysisTable only via shared input tagged dupa
       - BOQ Load Excel -> #boqTable only via dedicated BOQ input tagged boq
    */
    (function lockExcelImportTargets() {
      function byId(id) { return document.getElementById(id); }

      function openSharedExcelFor(section) {
        const input = byId('sectionExcelFileInput');
        if (!input) { alert('Excel file input was not found.'); return; }
        input.value = '';
        input.dataset.section = section;
        input.onchange = function() {
          input.dataset.section = section;
          loadSectionExcelFromFile(input);
        };
        input.click();
      }

      function openDedicatedBOQExcel() {
        const input = byId('boqExcelFileInput');
        if (!input) { alert('BOQ Excel file input was not found.'); return; }
        input.value = '';
        input.dataset.section = 'boq';
        input.onchange = function() {
          input.dataset.section = 'boq';
          loadBOQExcelFromFile(input);
        };
        input.click();
      }

      window.openBOQExcelFile = openDedicatedBOQExcel;
      window.openSectionExcelFile = function(section) {
        if (section === 'boq') return openDedicatedBOQExcel();
        if (section === 'dupa') return openSharedExcelFor('dupa');
        return openSharedExcelFor('priceList');
      };

      const previousLoadSectionExcelFromFile = window.loadSectionExcelFromFile;
      window.loadSectionExcelFromFile = function(input) {
        const section = input && input.dataset ? input.dataset.section : '';
        if (section === 'boq') return loadBOQExcelFromFile(input);
        if (section === 'dupa' || section === 'priceList') return previousLoadSectionExcelFromFile(input);
        alert('Excel import target is missing. Please click the Load Excel button from Price List, D.U.P.A., or BOQ again.');
      };

      function interceptButton(buttonId, section) {
        const btn = byId(buttonId);
        if (!btn || btn.dataset.targetLockApplied === '1') return;
        btn.dataset.targetLockApplied = '1';
        btn.removeAttribute('onclick');
        btn.addEventListener('click', function(event) {
          event.preventDefault();
          event.stopImmediatePropagation();
          if (section === 'boq') openDedicatedBOQExcel();
          else openSharedExcelFor(section);
        }, true);
      }

      function applyLocks() {
        interceptButton('loadPriceListExcelBtn', 'priceList');
        interceptButton('loadDUPAExcelBtn', 'dupa');
        interceptButton('loadBOQExcelBtn', 'boq');
        const sharedInput = byId('sectionExcelFileInput');
        if (sharedInput) {
          sharedInput.onchange = function() {
            loadSectionExcelFromFile(sharedInput);
          };
        }
        const boqInput = byId('boqExcelFileInput');
        if (boqInput) {
          boqInput.dataset.section = 'boq';
          boqInput.onchange = function() {
            boqInput.dataset.section = 'boq';
            loadBOQExcelFromFile(boqInput);
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyLocks);
      } else {
        applyLocks();
      }
      setTimeout(applyLocks, 250);
      setTimeout(applyLocks, 1000);
    })();

    /* FINAL REFINEMENT: hard-lock each Excel Load button to its own table.
       This is intentionally last in the script so it overrides older duplicated handlers.
       BOQ never uses the shared section input and never writes to D.U.P.A. or Price List. */
    (function finalExcelImportTargetHardLock() {
      function byId(id) { return document.getElementById(id); }

      function importExcelToBOQFromInput(input) {
        const file = input && input.files && input.files[0];
        if (!file) return;
        const fileName = file.name || '';
        const readAsWorkbook = shouldReadAsWorkbook(fileName, file.type || '');
        const reader = new FileReader();
        reader.onload = function(event) {
          try {
            const buffer = event.target.result;
            const previewText = textFromArrayBuffer(buffer.slice ? buffer.slice(0, Math.min(buffer.byteLength || 0, 4096)) : buffer);
            const isHtmlContent = /^\s*(?:\ufeff)?\s*</.test(previewText) || /<html|<table|<frameset/i.test(previewText);
            let importedRows = [];
            if (isHtmlContent) {
              const fullText = textFromArrayBuffer(buffer);
              if (looksLikeExcelHtmlFrameset(fullText)) {
                throw new Error('This .xls is an Excel HTML frameset. Please save/export it as .xlsx, CSV, or single-file HTML before loading into BOQ.');
              }
              importedRows = parseBOQTableFromText(fullText, fileName);
            } else if (readAsWorkbook) {
              if (typeof XLSX === 'undefined') {
                throw new Error('The Excel parser did not load. Please connect to the internet, reopen this HTML file, and try again.');
              }
              const workbook = XLSX.read(new Uint8Array(buffer), { type: 'array', cellFormula: true, cellNF: true, cellText: false });
              importedRows = parseBOQRowsFromMatrix(rowsFromXLSXWorkbook(workbook));
            } else {
              importedRows = parseBOQTableFromText(textFromArrayBuffer(buffer), fileName);
            }

            if (!importedRows.length) throw new Error('No valid BOQ rows found in the Excel file.');
            if (boqData.length && !confirmAction('Load Excel will replace the current Bill of Quantity table only. D.U.P.A. and Price List will not be changed. Continue?')) return;
            const normalizedRows = normalizeImportedBOQRows(importedRows);
            boqData.splice(0, boqData.length, ...normalizedRows);
            recomputeCodes(boqData);
            renderBOQTable();
            renderBOQSummaryTable();
            syncCoverLetterFields();
            renderCoverLetter();
            markUnsaved();
            showSheet('boqSheet');
            setTimeout(resizeAllBOQSpecificationTextareas, 0);
            alert('BOQ Excel loaded successfully into the Bill of Quantity table only. Imported ' + normalizedRows.length + ' row(s).');
          } catch (error) {
            alert(error.message || 'Unable to load Excel file into BOQ. Please use the exported BOQ template or a normal .xlsx/.xls/.csv file with BOQ headers.');
          } finally {
            input.value = '';
            input.dataset.section = 'boq';
          }
        };
        reader.readAsArrayBuffer(file);
      }

      function openBOQOnlyInput() {
        const input = byId('boqExcelFileInput');
        if (!input) { alert('BOQ Excel file input was not found.'); return; }
        input.value = '';
        input.dataset.section = 'boq';
        input.onchange = function() { importExcelToBOQFromInput(input); };
        input.click();
      }

      function openSharedInputFor(section) {
        const input = byId('sectionExcelFileInput');
        if (!input) { alert('Excel file input was not found.'); return; }
        input.value = '';
        input.dataset.section = section;
        input.onchange = function() {
          input.dataset.section = section;
          loadSectionExcelFromFile(input);
        };
        input.click();
      }

      window.openBOQExcelFile = openBOQOnlyInput;
      window.loadBOQExcelFromFile = importExcelToBOQFromInput;
      window.openSectionExcelFile = function(section) {
        if (section === 'boq') return openBOQOnlyInput();
        if (section === 'dupa') return openSharedInputFor('dupa');
        return openSharedInputFor('priceList');
      };

      function applyFinalLocks() {
        const priceBtn = byId('loadPriceListExcelBtn');
        const dupaBtn = byId('loadDUPAExcelBtn');
        const boqBtn = byId('loadBOQExcelBtn');
        const boqInput = byId('boqExcelFileInput');
        const sharedInput = byId('sectionExcelFileInput');
        if (priceBtn) { priceBtn.removeAttribute('onclick'); priceBtn.onclick = function(e) { if (e) e.preventDefault(); openSharedInputFor('priceList'); return false; }; }
        if (dupaBtn) { dupaBtn.removeAttribute('onclick'); dupaBtn.onclick = function(e) { if (e) e.preventDefault(); openSharedInputFor('dupa'); return false; }; }
        if (boqBtn) { boqBtn.removeAttribute('onclick'); boqBtn.onclick = function(e) { if (e) e.preventDefault(); openBOQOnlyInput(); return false; }; }
        if (boqInput) { boqInput.dataset.section = 'boq'; boqInput.onchange = function() { importExcelToBOQFromInput(boqInput); }; }
        if (sharedInput) { sharedInput.onchange = function() { loadSectionExcelFromFile(sharedInput); }; }
      }

      document.addEventListener('click', function(event) {
        const btn = event.target && event.target.closest ? event.target.closest('#loadBOQExcelBtn') : null;
        if (!btn) return;
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        openBOQOnlyInput();
      }, true);

    function addBOQRows(indices) {
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => a - b); // Ascending
      let shift = 0;
      const newSelectedIndices = new Set();
      
      sortedIndices.forEach(index => {
        const adjustedIndex = index + shift;
        const currentRow = boqData[adjustedIndex];
        if (!currentRow) return;
        const insertIndex = findInsertIndex(boqData, adjustedIndex);
        const newRow = {
          type: currentRow.type,
          title: '',
          qty: 0,
          unit: '',
          materialUnitCost: 0,
          laborUnitCost: 0,
          code: '',
          collapsed: false
        };
        boqData.splice(insertIndex, 0, newRow);
        newSelectedIndices.add(insertIndex);
        shift += 1;
      });
      
      recomputeCodes(boqData);
      renderBOQTable();
      selectBOQRows(newSelectedIndices);
    }

    function deleteBOQRows(indices) {
      if (indices.size === 0) return;
      const count = indices.size;
      const msg = count === 1 ? 'Delete this BOQ row? This action cannot be undone.' : `Delete these ${count} BOQ rows? This action cannot be undone.`;
      if (!confirmAction(msg)) return;
      
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => b - a); // Descending
      sortedIndices.forEach(index => {
        if (index >= 0 && index < boqData.length) {
          boqData.splice(index, 1);
        }
      });
      
      selectedBOQRowIndices.clear();
      recomputeCodes(boqData);
      renderBOQTable();
    }

    function addAnalysisRows(indices) {
      if (indices.size === 0) return;
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => a - b); // Ascending
      let shift = 0;
      const newSelectedIndices = new Set();
      
      sortedIndices.forEach(index => {
        const adjustedIndex = index + shift;
        const currentRow = analysisData[adjustedIndex];
        if (!currentRow) return;
        const insertIndex = findInsertIndex(analysisData, adjustedIndex);
        const newRow = createAnalysisRow(currentRow.type);
        analysisData.splice(insertIndex, 0, newRow);
        newSelectedIndices.add(insertIndex);
        shift += 1;
      });
      
      recomputeAnalysisCodes();
      renderAnalysisTable();
      selectAnalysisRows(newSelectedIndices);
    }

    function deleteAnalysisRows(indices) {
      if (indices.size === 0) return;
      const count = indices.size;
      const msg = count === 1 ? 'Delete this D.U.P.A. row? This action cannot be undone.' : `Delete these ${count} D.U.P.A. rows? This action cannot be undone.`;
      if (!confirmAction(msg)) return;
      
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => b - a); // Descending
      sortedIndices.forEach(index => {
        if (index >= 0 && index < analysisData.length) {
          analysisData.splice(index, 1);
        }
      });
      
      selectedAnalysisRowIndices.clear();
      recomputeAnalysisCodes();
      renderAnalysisTable();
    }

    function addPriceListRows(indices) {
      if (indices.size === 0) return;
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => a - b); // Ascending
      let shift = 0;
      const newSelectedIndices = new Set();
      
      sortedIndices.forEach(index => {
        const adjustedIndex = index + shift;
        const base = priceListData[adjustedIndex];
        if (!base) return;
        
        let newRow;
        if (base.type === 'category') {
          newRow = createPriceListCategoryRow();
        } else if (base.type === 'subcategory') {
          newRow = createPriceListSubCategoryRow(base.mainCategory, '');
        } else {
          newRow = createPriceListMaterialRow(base.mainCategory, base.subCategory);
        }
        
        priceListData.splice(adjustedIndex + 1, 0, newRow);
        newSelectedIndices.add(adjustedIndex + 1);
        shift += 1;
      });
      
      recomputePriceListCodes();
      renderPriceListTable();
      selectPriceListRows(newSelectedIndices);
    }

    function deletePriceListRows(indices) {
      if (indices.size === 0) return;
      const count = indices.size;
      const msg = count === 1 ? 'Delete this Price List row? This action cannot be undone.' : `Delete these ${count} Price List rows? This action cannot be undone.`;
      if (!confirmAction(msg)) return;
      
      markUnsaved();
      const sortedIndices = Array.from(indices).sort((a, b) => b - a); // Descending
      sortedIndices.forEach(index => {
        if (index >= 0 && index < priceListData.length) {
          priceListData.splice(index, 1);
        }
      });
      
      selectedPriceListRowIndices.clear();
      recomputePriceListCodes();
      renderPriceListTable();
    }

    // Context Menu Logic
    window.contextMenuTargetTable = null;
    window.contextMenuTargetIndex = -1;

    function handleContextMenuAddRow() {
      const tableId = window.contextMenuTargetTable;
      const index = window.contextMenuTargetIndex;
      hideContextMenu();
      if (index === undefined || index === null || index < 0) return;
      
      if (tableId === 'boqTable') {
        addBOQRows(selectedBOQRowIndices);
      } else if (tableId === 'analysisTable') {
        addAnalysisRows(selectedAnalysisRowIndices);
      } else if (tableId === 'priceListTable') {
        addPriceListRows(selectedPriceListRowIndices);
      }
    }
    window.handleContextMenuAddRow = handleContextMenuAddRow;

    function handleContextMenuDeleteRow() {
      const tableId = window.contextMenuTargetTable;
      const index = window.contextMenuTargetIndex;
      hideContextMenu();
      if (index === undefined || index === null || index < 0) return;
      
      if (tableId === 'boqTable') {
        deleteBOQRows(selectedBOQRowIndices);
      } else if (tableId === 'analysisTable') {
        deleteAnalysisRows(selectedAnalysisRowIndices);
      } else if (tableId === 'priceListTable') {
        deletePriceListRows(selectedPriceListRowIndices);
      }
    }
    window.handleContextMenuDeleteRow = handleContextMenuDeleteRow;

    function handleContextMenuAddCategory() {
      const index = window.contextMenuTargetIndex;
      hideContextMenu();
      if (index === undefined || index === null || index < 0) return;

      addBOQCategoryRowAfter(index);
      setTimeout(() => {
        const selectEl = document.querySelector(`#boqTable tbody tr[data-index="${index + 1}"] select.boq-category-select`);
        if (selectEl) {
          selectEl.focus();
        }
      }, 50);
    }
    window.handleContextMenuAddCategory = handleContextMenuAddCategory;

    // Category List Management Modal Logic
    let tempCategoryOptions = [];

    function openManageCategoriesModal() {
      let overlay = document.getElementById('manageCategoriesOverlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'manageCategoriesOverlay';
        overlay.className = 'mc-overlay';
        document.body.appendChild(overlay);
      }
      tempCategoryOptions = [...categoryOptions];
      overlay.style.display = 'flex';
      renderManageCategoriesModal();
    }
    window.openManageCategoriesModal = openManageCategoriesModal;

    function closeManageCategoriesModal() {
      const overlay = document.getElementById('manageCategoriesOverlay');
      if (overlay) {
        overlay.style.display = 'none';
      }
    }
    window.closeManageCategoriesModal = closeManageCategoriesModal;

    function renderManageCategoriesModal() {
      const overlay = document.getElementById('manageCategoriesOverlay');
      if (!overlay) return;

      let listHtml = '';
      tempCategoryOptions.forEach((option, idx) => {
        listHtml += `
          <div class="mc-list-item">
            <input type="text" value="${escapeAttr(option)}" oninput="window.updateManageCategoryValue(${idx}, this.value)" onchange="window.updateManageCategoryValue(${idx}, this.value)" placeholder="Category name">
            <div class="mc-item-actions">
              <button class="mc-item-btn" onclick="window.deleteManageCategory(${idx})" title="Delete category">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>
        `;
      });

      overlay.innerHTML = `
        <div class="mc-modal">
          <div class="mc-header">
            <h3>Add/Edit Category List</h3>
            <button class="mc-close-btn" onclick="window.closeManageCategoriesModal()">&times;</button>
          </div>
          <div class="mc-body">
            <div class="mc-add-row">
              <input type="text" id="newCategoryInput" placeholder="Enter new category name..." onkeydown="if(event.key === 'Enter') window.addManageCategory()">
              <button class="btn-primary" onclick="window.addManageCategory()">Add</button>
            </div>
            <div class="mc-list-container">
              ${listHtml || '<div style="padding: 10px; font-size: 11px; text-align: center; color: var(--muted);">No custom categories. Add one above.</div>'}
            </div>
          </div>
          <div class="mc-footer">
            <button class="btn-secondary" onclick="window.resetManageCategories()" style="margin-right: auto; border-color: #fecaca; color: var(--danger); font-weight: 600;">Reset Defaults</button>
            <button class="btn-primary" onclick="window.saveManageCategories()">Save & Close</button>
          </div>
        </div>
      `;

      setTimeout(() => {
        const input = document.getElementById('newCategoryInput');
        if (input) input.focus();
      }, 50);
    }
    window.renderManageCategoriesModal = renderManageCategoriesModal;

    function addManageCategory() {
      const input = document.getElementById('newCategoryInput');
      if (!input) return;
      const val = input.value.trim();
      if (!val) return;
      if (tempCategoryOptions.some(item => item.toLowerCase() === val.toLowerCase())) {
        alert('This category already exists.');
        return;
      }
      tempCategoryOptions.push(val);
      renderManageCategoriesModal();
    }
    window.addManageCategory = addManageCategory;

    function updateManageCategoryValue(index, value) {
      const val = value.trim();
      if (!val) return;
      tempCategoryOptions[index] = val;
    }
    window.updateManageCategoryValue = updateManageCategoryValue;

    function deleteManageCategory(index) {
      tempCategoryOptions.splice(index, 1);
      renderManageCategoriesModal();
    }
    window.deleteManageCategory = deleteManageCategory;

    function resetManageCategories() {
      if (!confirmAction('Are you sure you want to reset categories to default? This will overwrite your custom list.')) return;
      tempCategoryOptions = [
        'General requirements',
        'Earth works',
        'Structural Works',
        'Architectural Works',
        'Electrical Works',
        'Plumbing and Sanitary Works',
        'Mechanical Works',
        'Electronic Works'
      ];
      renderManageCategoriesModal();
    }
    window.resetManageCategories = resetManageCategories;

    function saveManageCategories() {
      const modalInputs = document.querySelectorAll('.mc-list-item input');
      modalInputs.forEach((inp, idx) => {
        const val = (inp.value || '').trim();
        if (val) {
          tempCategoryOptions[idx] = val;
        }
      });

      const oldOptions = [...categoryOptions];
      const newOptions = [...tempCategoryOptions];

      const renames = new Map();
      oldOptions.forEach((oldCat, idx) => {
        const newCat = newOptions[idx];
        if (oldCat && newCat && oldCat.trim() !== newCat.trim()) {
          const oldClean = oldCat.trim();
          const newClean = newCat.trim();
          renames.set(oldClean, newClean);
          renames.set(oldClean.toLowerCase(), newClean);
        }
      });

      categoryOptions = [...newOptions];
      localStorage.setItem('boqCategoryOptions', JSON.stringify(categoryOptions));

      if (renames.size > 0) {
        boqData.forEach(row => {
          if (row.type === 'category') {
            const currentTitle = String(row.title || '').trim();
            if (renames.has(currentTitle)) {
              row.title = renames.get(currentTitle);
            } else if (renames.has(currentTitle.toLowerCase())) {
              row.title = renames.get(currentTitle.toLowerCase());
            }
          }
        });
        analysisData.forEach(row => {
          if (row.type === 'category') {
            const currentTitle = String(row.title || '').trim();
            if (renames.has(currentTitle)) {
              row.title = renames.get(currentTitle);
            } else if (renames.has(currentTitle.toLowerCase())) {
              row.title = renames.get(currentTitle.toLowerCase());
            }
          }
        });
      }

      closeManageCategoriesModal();
      markUnsaved();
      renderBOQTable();
      renderAnalysisTable();
    }
    window.saveManageCategories = saveManageCategories;

    function showContextMenu(x, y, count) {
      let menu = document.getElementById('customContextMenu');
      if (!menu) {
        menu = document.createElement('div');
        menu.id = 'customContextMenu';
        menu.className = 'custom-context-menu';
        document.body.appendChild(menu);
      }
      
      const addText = count > 1 ? 'Add Rows' : 'Add Row';
      const deleteText = count > 1 ? 'Delete Rows' : 'Delete Row';
      const tableId = window.contextMenuTargetTable;
      
      let itemsHtml = `
        <div class="custom-context-menu-item" onclick="window.handleContextMenuAddRow()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          ${addText}
        </div>
      `;
      
      if (tableId === 'boqTable') {
        itemsHtml += `
          <div class="custom-context-menu-item" onclick="window.handleContextMenuAddCategory()">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            Add Category
          </div>
        `;
      }
      
      itemsHtml += `
        <div class="custom-context-menu-item" onclick="window.handleContextMenuCopy()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy
        </div>
      `;

      const hasCopied = !!(window.copiedCellsGrid && window.copiedCellsGrid.length > 0);
      const pasteStyle = hasCopied ? '' : 'style="opacity: 0.5; pointer-events: none;"';
      itemsHtml += `
        <div class="custom-context-menu-item" ${pasteStyle} onclick="window.handleContextMenuPaste()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
          Paste
        </div>
      `;
      
      itemsHtml += `
        <div class="custom-context-menu-item" onclick="window.handleContextMenuDeleteRow()">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          ${deleteText}
        </div>
      `;
      
      menu.innerHTML = itemsHtml;
      
      const winWidth = window.innerWidth;
      const winHeight = window.innerHeight;
      const menuWidth = 130;
      const menuHeight = tableId === 'boqTable' ? 160 : 135;
      
      let left = x;
      let top = y;
      
      if (x + menuWidth > winWidth) {
        left = winWidth - menuWidth - 10;
      }
      if (y + menuHeight > winHeight) {
        top = winHeight - menuHeight - 10;
      }
      
      menu.style.left = left + 'px';
      menu.style.top = top + 'px';
      menu.style.display = 'block';
    }

    function getCellValue(td) {
      const input = td.querySelector('input');
      if (input) return input.value;
      const textarea = td.querySelector('textarea');
      if (textarea) return textarea.value;
      const select = td.querySelector('select');
      if (select) return select.value;
      return td.innerText.trim();
    }

    function getFieldNameByColIndex(tableId, colIndex, rowType) {
      if (tableId === 'boqTable') {
        const visibleCols = boqColumns.filter(c => c.visible);
        if (colIndex < 0 || colIndex >= visibleCols.length) return null;
        const colId = visibleCols[colIndex].id;
        switch(colId) {
          case 'title': return 'title';
          case 'specification': return 'specification';
          case 'qty': return 'qty';
          case 'unit': return 'unit';
          case 'materialUnitCost': return 'materialUnitCost';
          case 'leUnitCost': return 'laborUnitCost';
          case 'condition': return 'condition';
          default: return null;
        }
      } else if (tableId === 'analysisTable') {
        switch(colIndex) {
          case 2: return 'title';
          case 3: return 'specification';
          case 4: return 'qty';
          case 5: return 'unit';
          case 6: return 'materialUnitCost';
          case 8: return 'laborUnitCost';
          default: return null;
        }
      } else if (tableId === 'priceListTable') {
        switch(colIndex) {
          case 1: return 'itemCode';
          case 2: return 'materialName';
          case 3: return 'specification';
          case 4: return 'unit';
          case 5: return 'pricePerUnit';
          case 6: return 'rentalPerUnit';
          default: return null;
        }
      }
      return null;
    }

    function showBOQHeaderContextMenu(event, header) {
      let menu = document.getElementById('customContextMenu');
      if (!menu) {
        menu = document.createElement('div');
        menu.id = 'customContextMenu';
        menu.className = 'custom-context-menu';
        document.body.appendChild(menu);
      }
      
      const visibleCols = boqColumns.filter(c => c.visible);
      const ths = Array.from(header.parentElement.children);
      const visibleColIndex = ths.indexOf(header);
      const clickedCol = visibleCols[visibleColIndex];
      if (!clickedCol) return;
      
      const hiddenCols = boqColumns.filter(c => !c.visible);
      const canHide = clickedCol.id !== 'plus' && clickedCol.id !== 'title' && clickedCol.id !== 'action';
      
      let itemsHtml = '';
      if (canHide) {
        itemsHtml += `
          <div class="custom-context-menu-item" onclick="window.hideBOQColumn('${clickedCol.id}')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            Hide Column
          </div>
        `;
      }
      
      if (hiddenCols.length > 0) {
        if (canHide) {
          itemsHtml += `<div style="border-top: 1px solid var(--line, #cfd8e3); margin: 4px 0;"></div>`;
        }
        hiddenCols.forEach(col => {
          itemsHtml += `
            <div class="custom-context-menu-item" onclick="window.insertBOQColumn('${col.id}', '${clickedCol.id}')">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Insert ${col.name}
            </div>
          `;
        });
      }
      
      if (!itemsHtml) {
        itemsHtml = `<div class="custom-context-menu-item" style="opacity: 0.5; pointer-events: none;">No actions available</div>`;
      }
      
      menu.innerHTML = itemsHtml;
      window.contextMenuTargetTable = 'boqTable';
      
      const winWidth = window.innerWidth;
      const winHeight = window.innerHeight;
      const menuWidth = 160;
      const menuHeight = (canHide ? 30 : 0) + (hiddenCols.length * 30) + (canHide && hiddenCols.length > 0 ? 10 : 0) || 30;
      
      let left = event.clientX;
      let top = event.clientY;
      
      if (left + menuWidth > winWidth) {
        left = winWidth - menuWidth - 10;
      }
      if (top + menuHeight > winHeight) {
        top = winHeight - menuHeight - 10;
      }
      
      menu.style.left = left + 'px';
      menu.style.top = top + 'px';
      menu.style.display = 'block';
    }

    function hideBOQColumn(colId) {
      hideContextMenu();
      const col = boqColumns.find(c => c.id === colId);
      if (col) {
        col.visible = false;
        localStorage.setItem('cost_estimate_boq_columns_v1', JSON.stringify(boqColumns));
        markUnsaved();
        renderBOQTable();
      }
    }

    function insertBOQColumn(colId, targetColId) {
      hideContextMenu();
      const colIndex = boqColumns.findIndex(c => c.id === colId);
      if (colIndex < 0) return;
      
      boqColumns[colIndex].visible = true;
      const colObj = boqColumns.splice(colIndex, 1)[0];
      
      const targetIndex = boqColumns.findIndex(c => c.id === targetColId);
      if (targetIndex >= 0) {
        boqColumns.splice(targetIndex + 1, 0, colObj);
      } else {
        boqColumns.push(colObj);
      }
      
      localStorage.setItem('cost_estimate_boq_columns_v1', JSON.stringify(boqColumns));
      markUnsaved();
      renderBOQTable();
    }

    window.showBOQHeaderContextMenu = showBOQHeaderContextMenu;
    window.hideBOQColumn = hideBOQColumn;
    window.insertBOQColumn = insertBOQColumn;

